:"english-ctc-fallback","text":"One Monday, there were fewer people in the shop than usual when the woman came in,","start":38.43,"end":44.08,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-005-p02","sourceId":"b2-032-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[16,26],"wordModel":"english-ctc-fallback","text":"so it was easier for the detective to watch her.","start":45.25,"end":48.52,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-006","sourceId":"b2-032-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The woman first bought a few small articles.","start":50.4,"end":53.95,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-007-p01","sourceId":"b2-032-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"After a little time, she chose one of the most expensive dresses in the shop and handed it to an assistant","start":55.15,"end":63.57,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-007-p02","sourceId":"b2-032-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[21,31],"wordModel":"mms-fa","text":"who wrapped it up for her as quickly as possible.","start":63.93,"end":67.3,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-008","sourceId":"b2-032-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Then the woman simply took the parcel and walked out of the shop without paying.","start":68.98,"end":74.8,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-009","sourceId":"b2-032-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When she was arrested, the detective found out that the shop assistant was her daughter.","start":76.7,"end":83.37,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-032-010","sourceId":"b2-032-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The girl 'gave' her mother a free dress once a week!","start":84.8,"end":89.23,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
