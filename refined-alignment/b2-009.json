rt":81.582,"end":81.883,"score":1.0}]],"cues":[{"id":"b2-009-001","sourceId":"b2-009-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What does 'a cold welcome' refer to?","start":13.143,"end":18.14,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-002","sourceId":"b2-009-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"On Wednesday evening, we went to the Town Hall.","start":20.79,"end":24.37,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-003","sourceId":"b2-009-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"It was the last day of the year and a large crowd of people had gathered under the Town Hall clock.","start":25.24,"end":32.72,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-004","sourceId":"b2-009-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It would strike twelve in twenty minutes' time.","start":34.5,"end":38.0,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-005","sourceId":"b2-009-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"Fifteen minutes passed and then, at five to twelve, the clock stopped.","start":39.18,"end":46.21,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-006","sourceId":"b2-009-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The big minute hand did not move.","start":47.77,"end":51.55,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-007","sourceId":"b2-009-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"We waited and waited, but nothing happened.","start":52.58,"end":56.46,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-008","sourceId":"b2-009-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"Suddenly someone shouted.","start":57.72,"end":59.7,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-009","sourceId":"b2-009-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'It's two minutes past twelve!","start":60.61,"end":63.96,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-010","sourceId":"b2-009-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"The clock has stopped!'","start":64.52,"end":67.183,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-011","sourceId":"b2-009-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I looked at my watch.","start":68.78,"end":70.153,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-012","sourceId":"b2-009-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"It was true.","start":70.33,"end":71.1,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-013","sourceId":"b2-009-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The big clock refused to welcome the New Year.","start":71.682,"end":75.83,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-009-014","sourceId":"b2-009-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"At that moment, everybody began to laugh and sing.","start":76.822,"end":82.16,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
