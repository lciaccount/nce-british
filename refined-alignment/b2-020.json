3,"start":82.183,"end":82.383,"score":0.859}]],"cues":[{"id":"b2-020-001","sourceId":"b2-020-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Why is fishing the writer's favourite sport?","start":15.23,"end":19.37,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-002","sourceId":"b2-020-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Fishing is my favourite sport.","start":22.26,"end":25.03,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-003","sourceId":"b2-020-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"I often fish for hours without catching anything.","start":26.27,"end":30.88,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-004","sourceId":"b2-020-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"But this does not worry me.","start":31.64,"end":33.55,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-005","sourceId":"b2-020-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"Some fishermen are unlucky.","start":35.03,"end":37.25,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-006","sourceId":"b2-020-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Instead of catching fish, they catch old boots and rubbish.","start":38.18,"end":42.82,"score":0.918,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-007","sourceId":"b2-020-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I am even less lucky.","start":44.583,"end":46.803,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-008","sourceId":"b2-020-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"I never catch anything  --  not even old boots.","start":47.043,"end":50.4,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-009","sourceId":"b2-020-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"After having spent whole mornings on the river, I always go home with an empty bag.","start":52.46,"end":59.18,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-010","sourceId":"b2-020-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'You must give up fishing!'","start":60.86,"end":63.18,"score":0.992,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-020-011","sourceId":"b2-020-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"my friends say.","start":63.44,"end":64.77,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-012","sourceId":"b2-020-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'It's a waste of time.'","start":65.66,"end":67.61,"score":0.889,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-013","sourceId":"b2-020-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"But they don't realize one important thing.","start":69.12,"end":72.8,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-014","sourceId":"b2-020-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"I'm not really interested in fishing.","start":74.29,"end":76.65,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-020-015","sourceId":"b2-020-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"I am only interested in sitting in a boat and doing nothing at all!","start":77.