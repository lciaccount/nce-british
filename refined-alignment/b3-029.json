{"text":"much","offset":77,"start":143.162,"end":143.442,"score":0.974},{"text":"he","offset":82,"start":143.502,"end":143.582,"score":0.89},{"text":"hated","offset":85,"start":143.722,"end":144.042,"score":0.999},{"text":"hospitals.","offset":91,"start":144.102,"end":144.642,"score":0.998}],[{"text":"He","offset":0,"start":145.303,"end":145.362,"score":0.966},{"text":"was","offset":3,"start":145.403,"end":145.502,"score":0.995},{"text":"still","offset":7,"start":145.523,"end":145.702,"score":0.947},{"text":"mumbling","offset":13,"start":145.843,"end":146.322,"score":0.976},{"text":"something","offset":22,"start":146.442,"end":146.762,"score":0.975},{"text":"about","offset":32,"start":146.803,"end":147.022,"score":0.999},{"text":"hospitals","offset":38,"start":147.083,"end":147.622,"score":0.999},{"text":"at","offset":48,"start":147.882,"end":147.962,"score":0.999},{"text":"the","offset":51,"start":147.982,"end":148.082,"score":0.956},{"text":"end","offset":55,"start":148.183,"end":148.342,"score":1.0},{"text":"of","offset":59,"start":148.403,"end":148.462,"score":0.999},{"text":"the","offset":62,"start":148.482,"end":148.562,"score":0.982},{"text":"party","offset":66,"start":148.583,"end":148.862,"score":1.0},{"text":"when","offset":72,"start":149.542,"end":149.702,"score":0.973},{"text":"he","offset":77,"start":149.762,"end":149.842,"score":0.998},{"text":"slipped","offset":80,"start":150.023,"end":150.402,"score":0.941},{"text":"on","offset":88,"start":150.683,"end":150.762,"score":0.903},{"text":"a","offset":91,"start":150.803,"end":150.822,"score":0.999},{"text":"piece","offset":93,"start":150.903,"end":151.122,"score":0.803},{"text":"of","offset":99,"start":151.123,"end":151.202,"score":0.999},{"text":"ice","offset":102,"start":151.382,"end":151.542,"score":0.99},{"text":"and","offset":106,"start":151.982,"end":152.122,"score":0.953},{"text":"broke","offset":110,"start":152.222,"end":152.562,"score":0.986},{"text":"his","offset":116,"start":152.642,"end":152.822,"score":0.992},{"text":"left","offset":120,"start":152.982,"end":153.242,"score":1.0},{"text":"leg.","offset":125,"start":153.382,"end":153.642,"score":0.993}]],"cues":[{"id":"b3-029-001","sourceId":"b3-029-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What is the basis of 'sick' humour?","start":12.1,"end":14.85,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-002","sourceId":"b3-029-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Whether we find a joke funny or not largely depends on where we have been brought up.","start":17.2,"end":22.83,"score":0.911,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-003","sourceId":"b3-029-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The sense of humour is mysteriously bound up with national characteristics.","start":23.9,"end":28.63,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-004","sourceId":"b3-029-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"A Frenchman, for instance, might find it hard to laugh at a Russian joke.","start":29.73,"end":33.7,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-005","sourceId":"b3-029-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"In the same way, a Russian might fail to see anything amusing in a joke which would make an Englishman laugh to tears.","start":34.36,"end":41.51,"score":0.908,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-006","sourceId":"b3-029-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Most funny stories are based on comic situations.","start":42.77,"end":45.98,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-007","sourceId":"b3-029-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"In spite of national differences, certain funny situations have a universal appeal.","start":46.84,"end":52.61,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-008","sourceId":"b3-029-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"No matter where you live, you would find it difficult not to laugh at, say, Charlie Chaplin's early films.","start":53.65,"end":60.27,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-009","sourceId":"b3-029-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"However, a new type of humour, which stems largely from U.S., has recently come into fashion.","start":61.0,"end":67.38,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-010","sourceId":"b3-029-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"It is called 'sick humour'.","start":67.93,"end":69.88,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-011","sourceId":"b3-029-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Comedians base their jokes on tragic situations like violent death or serious accidents.","start":70.37,"end":77.01,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-012","sourceId":"b3-029-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Many people find this sort of joke distasteful.","start":77.58,"end":80.07,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-013","sourceId":"b3-029-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The following example of 'sick humour' will enable you to judge for yourself.","start":80.62,"end":84.65,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-014","sourceId":"b3-029-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"A man who had broken his right leg was taken to hospital a few weeks before Christmas.","start":85.68,"end":91.68,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-015","sourceId":"b3-029-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"From the moment he arrived there, he kept on pestering his doctor to tell him when he would be able to go home.","start":92.4,"end":98.73,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-016","sourceId":"b3-029-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He dreaded having to spend Christmas in hospital.","start":99.24,"end":101.92,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-017","sourceId":"b3-029-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Though the doctor did his best, the patient's recovery was slow.","start":102.46,"end":106.49,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-018","sourceId":"b3-029-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"On Christmas day, the man still had his right leg in plaster.","start":107.17,"end":110.92,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-019","sourceId":"b3-029-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"He spent a miserable day in bed thinking of all the fun he was missing.","start":111.51,"end":115.58,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-020-p01","sourceId":"b3-029-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"The following day, however, the doctor consoled him by telling him","start":116.06,"end":119.762,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-020-p02","sourceId":"b3-029-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[11,28],"wordModel":"english-ctc-fallback","text":"that his chances of being able to leave hospital in time for New Year celebrations were good.","start":119.86,"end":124.45,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-021","sourceId":"b3-029-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"The man took heart and sure enough, on New Year's Eve he was able to hobble along to a party.","start":124.94,"end":130.92,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-022","sourceId":"b3-029-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"To compensate for his unpleasant experiences in hospital, the man drank a little more than was good for him.","start":131.44,"end":138.39,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-023","sourceId":"b3-029-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"In the process, he enjoyed himself thoroughly and kept telling everybody how much he hated hospitals.","start":138.66,"end":144.72,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-024-p01","sourceId":"b3-029-024","sourceIndex":23,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"He was still mumbling something about hospitals at the end of the party","start":145.24,"end":149.08,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-029-024-p02","sourceId":"b3-029-024","sourceIndex":23,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"when he slipped on a piece of ice and broke his left leg.","start":149.48,"end":153.75,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
