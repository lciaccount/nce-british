score":0.977},{"text":"at","offset":11,"start":166.702,"end":166.802,"score":0.999},{"text":"last","offset":14,"start":166.903,"end":167.262,"score":0.997},{"text":"gives","offset":19,"start":167.322,"end":167.542,"score":0.997},{"text":"up","offset":25,"start":167.602,"end":167.722,"score":0.999},{"text":"by","offset":28,"start":168.023,"end":168.182,"score":0.999},{"text":"pulling","offset":31,"start":168.303,"end":168.602,"score":0.999},{"text":"his","offset":39,"start":168.642,"end":168.762,"score":0.999},{"text":"feet","offset":43,"start":168.822,"end":169.022,"score":1.0},{"text":"under","offset":48,"start":169.162,"end":169.362,"score":0.875},{"text":"his","offset":54,"start":169.403,"end":169.522,"score":0.429},{"text":"shell","offset":58,"start":169.562,"end":169.822,"score":0.847},{"text":"and","offset":64,"start":170.303,"end":170.422,"score":0.996},{"text":"the","offset":68,"start":170.463,"end":170.542,"score":0.987},{"text":"game","offset":72,"start":170.642,"end":171.002,"score":0.996},{"text":"is","offset":77,"start":171.162,"end":171.302,"score":0.997},{"text":"over.","offset":80,"start":171.463,"end":171.762,"score":0.986}]],"cues":[{"id":"b4-018-001","sourceId":"b4-018-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"What would you say is the main characteristic of porpoises?","start":10.522,"end":14.4,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-002-p01","sourceId":"b4-018-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"There has long been a superstition among mariners that porpoises will save drowning men by pushing them to the surface,","start":16.95,"end":24.98,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-002-p02","sourceId":"b4-018-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[20,31],"wordModel":"mms-fa","text":"or protect them from sharks by surrounding them in defensive formation.","start":25.61,"end":30.22,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-003-p01","sourceId":"b4-018-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"Marine Studio biologists have pointed out that, however intelligent they may be,","start":31.79,"end":36.53,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-003-p02","sourceId":"b4-018-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"english-ctc-fallback","text":"it is probably a mistake to credit dolphins with any motive of life-saving.","start":36.92,"end":41.55,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-004-p01","sourceId":"b4-018-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,26],"wordModel":"mms-fa","text":"On the occasions when they have pushed to shore an unconscious human being they have much more likely done it out of curiosity or for sport,","start":43.58,"end":52.97,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-004-p02","sourceId":"b4-018-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[26,35],"wordModel":"mms-fa","text":"as in riding the bow waves of a ship.","start":53.61,"end":55.99,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-005","sourceId":"b4-018-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"In 1928 some porpoises were photographed working like beavers to push ashore a waterlogged mattress.","start":57.61,"end":65.17,"score":0.987,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b4-018-006-p01","sourceId":"b4-018-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"If, as has been reported, they have protected humans from sharks,","start":66.23,"end":70.64,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-006-p02","sourceId":"b4-018-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[11,30],"wordModel":"mms-fa","text":"it may have been because curiosity attracted them and because the scent of a possible meal attracted the sharks.","start":71.12,"end":78.07,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-007","sourceId":"b4-018-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"Porpoises and sharks are natural enemies.","start":78.96,"end":81.82,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-008","sourceId":"b4-018-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"It is possible that upon such an occasion a battle ensued, with the sharks being driven away or killed.","start":82.53,"end":89.92,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-009","sourceId":"b4-018-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Whether it be bird, fish or beast, the porpoise is intrigued with anything that is alive.","start":91.21,"end":97.26,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-010","sourceId":"b4-018-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"They are constantly after the turtles, who peacefully submit to all sorts of indignities.","start":97.982,"end":103.69,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-011-p01","sourceId":"b4-018-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"One young calf especially enjoyed raising a turtle to the surface with his snout,","start":104.88,"end":109.78,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-011-p02","sourceId":"b4-018-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[14,24],"wordModel":"mms-fa","text":"and then shoving him across the tank like an aquaplane.","start":110.26,"end":113.46,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-012","sourceId":"b4-018-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,33],"wordModel":"mms-fa","text":"Almost any day a young porpoises may be seen trying to turn a 300-pound sea turtle over by sticking his snout under the edge of his shell and pushing up for dear life.","start":114.67,"end":126.02,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-013","sourceId":"b4-018-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"This is not easy, and may require two porpoises working together.","start":126.74,"end":131.28,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-014-p01","sourceId":"b4-018-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"In another game, as the turtle swims across the oceanarium,","start":132.3,"end":136.13,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-014-p02","sourceId":"b4-018-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"the first porpoise swoops down from above and butts his shell with his belly.","start":136.71,"end":141.7,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-015","sourceId":"b4-018-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This knocks the turtle down several feet.","start":142.63,"end":144.98,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-016","sourceId":"b4-018-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He no sooner recovers his equilibrium than the next porpoises comes along and hits him another crack.","start":145.45,"end":151.94,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-017","sourceId":"b4-018-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Eventually the turtle has been butted all the way down to the floor of the tank.","start":152.79,"end":157.27,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-018","sourceId":"b4-018-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"He is now satisfied merely to try to stand up, but as soon as he does so a porpoise knocks him flat.","start":157.962,"end":165.36,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-018-019","sourceId":"b4-018-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The turtle at last gives up by pulling his feet under his shell and the game is over.","start":166.04,"end":172.05,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
