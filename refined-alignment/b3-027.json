","offset":67,"start":131.762,"end":132.102,"score":0.958},{"text":"than","offset":74,"start":132.403,"end":132.562,"score":1.0},{"text":"most","offset":79,"start":132.642,"end":132.862,"score":1.0},{"text":"of","offset":84,"start":132.903,"end":132.962,"score":0.999},{"text":"us","offset":87,"start":133.002,"end":133.102,"score":0.998},{"text":"ever","offset":90,"start":133.243,"end":133.422,"score":0.998},{"text":"do.","offset":95,"start":133.482,"end":133.582,"score":1.0}],[{"text":"He","offset":0,"start":135.002,"end":135.062,"score":0.978},{"text":"may","offset":3,"start":135.142,"end":135.262,"score":1.0},{"text":"hunt,","offset":7,"start":135.363,"end":135.582,"score":0.983},{"text":"beg,","offset":13,"start":136.303,"end":136.602,"score":0.821},{"text":"or","offset":18,"start":137.083,"end":137.162,"score":0.999},{"text":"steal","offset":21,"start":137.243,"end":137.562,"score":0.931},{"text":"occasionally","offset":27,"start":137.583,"end":138.182,"score":0.837},{"text":"to","offset":40,"start":138.502,"end":138.582,"score":0.999},{"text":"keep","offset":43,"start":138.642,"end":138.822,"score":0.999},{"text":"himself","offset":48,"start":138.843,"end":139.162,"score":0.961},{"text":"alive;","offset":56,"start":139.202,"end":139.662,"score":0.999},{"text":"he","offset":63,"start":140.343,"end":140.402,"score":0.96},{"text":"may","offset":66,"start":140.482,"end":140.602,"score":0.98},{"text":"even,","offset":70,"start":140.722,"end":141.022,"score":0.998},{"text":"in","offset":76,"start":141.123,"end":141.202,"score":0.998},{"text":"times","offset":79,"start":141.282,"end":141.642,"score":0.999},{"text":"of","offset":85,"start":141.683,"end":141.762,"score":0.998},{"text":"real","offset":88,"start":141.822,"end":142.042,"score":0.994},{"text":"need,","offset":93,"start":142.102,"end":142.322,"score":1.0},{"text":"do","offset":99,"start":142.743,"end":142.822,"score":0.997},{"text":"a","offset":102,"start":142.882,"end":142.902,"score":0.988},{"text":"little","offset":104,"start":142.942,"end":143.182,"score":0.996},{"text":"work;","offset":111,"start":143.243,"end":143.522,"score":1.0},{"text":"but","offset":117,"start":144.243,"end":144.382,"score":0.997},{"text":"he","offset":121,"start":144.662,"end":144.722,"score":0.999},{"text":"will","offset":124,"start":144.803,"end":144.962,"score":0.923},{"text":"never","offset":129,"start":145.042,"end":145.302,"score":0.992},{"text":"sacrifice","offset":135,"start":145.463,"end":146.082,"score":1.0},{"text":"his","offset":145,"start":146.102,"end":146.222,"score":0.991},{"text":"freedom.","offset":149,"start":146.282,"end":146.622,"score":1.0}],[{"text":"We","offset":0,"start":148.062,"end":148.142,"score":0.999},{"text":"often","offset":3,"start":148.282,"end":148.562,"score":0.995},{"text":"speak","offset":9,"start":148.642,"end":149.002,"score":1.0},{"text":"of","offset":15,"start":149.083,"end":149.162,"score":0.998},{"text":"tramps","offset":18,"start":149.262,"end":149.622,"score":0.999},{"text":"with","offset":25,"start":149.702,"end":149.842,"score":0.997},{"text":"contempt","offset":30,"start":149.882,"end":150.342,"score":0.973},{"text":"and","offset":39,"start":150.922,"end":151.022,"score":0.991},{"text":"put","offset":43,"start":151.102,"end":151.242,"score":1.0},{"text":"them","offset":47,"start":151.303,"end":151.442,"score":0.987},{"text":"in","offset":52,"start":151.762,"end":151.822,"score":0.999},{"text":"the","offset":55,"start":151.843,"end":151.922,"score":0.999},{"text":"same","offset":59,"start":152.002,"end":152.222,"score":1.0},{"text":"class","offset":64,"start":152.262,"end":152.582,"score":0.984},{"text":"as","offset":70,"start":152.662,"end":152.762,"score":0.993},{"text":"beggars,","offset":73,"start":152.882,"end":153.322,"score":0.85},{"text":"but","offset":82,"start":154.322,"end":154.422,"score":0.999},{"text":"how","offset":86,"start":154.502,"end":154.662,"score":0.995},{"text":"many","offset":90,"start":154.743,"end":154.942,"score":1.0},{"text":"of","offset":95,"start":155.023,"end":155.102,"score":1.0},{"text":"us","offset":98,"start":155.162,"end":155.322,"score":0.878},{"text":"can","offset":101,"start":155.602,"end":155.742,"score":0.989},{"text":"honestly","offset":105,"start":155.863,"end":156.242,"score":0.968},{"text":"say","offset":114,"start":156.343,"end":156.562,"score":1.0},{"text":"that","offset":118,"start":157.083,"end":157.222,"score":0.999},{"text":"we","offset":123,"start":157.262,"end":157.342,"score":0.999},{"text":"have","offset":126,"start":157.403,"end":157.542,"score":1.0},{"text":"not","offset":131,"start":157.602,"end":157.742,"score":1.0},{"text":"felt","offset":135,"start":157.843,"end":158.122,"score":0.979},{"text":"a","offset":140,"start":158.183,"end":158.202,"score":0.996},{"text":"little","offset":142,"start":158.322,"end":158.562,"score":0.999},{"text":"envious","offset":149,"start":158.702,"end":159.082,"score":0.912},{"text":"of","offset":157,"start":159.142,"end":159.202,"score":0.998},{"text":"their","offset":160,"start":159.222,"end":159.362,"score":0.865},{"text":"simple","offset":166,"start":159.463,"end":159.762,"score":0.999},{"text":"way","offset":173,"start":159.803,"end":159.942,"score":0.999},{"text":"of","offset":177,"start":159.982,"end":160.042,"score":0.998},{"text":"life","offset":180,"start":160.123,"end":160.442,"score":0.975},{"text":"and","offset":185,"start":160.922,"end":161.042,"score":0.997},{"text":"their","offset":189,"start":161.083,"end":161.222,"score":0.976},{"text":"freedom","offset":195,"start":161.322,"end":161.642,"score":0.999},{"text":"from","offset":203,"start":161.702,"end":161.862,"score":0.987},{"text":"care?","offset":208,"start":161.922,"end":162.222,"score":0.757}]],"cues":[{"id":"b3-027-001","sourceId":"b3-027-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"What is the most important thing for a tramp?","start":13.53,"end":15.93,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-002","sourceId":"b3-027-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"It has been said that everyone lives by selling something.","start":18.54,"end":22.06,"score":0.898,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-003","sourceId":"b3-027-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"In the light of this statement, teachers live by selling knowledge, philosophers by selling wisdom and priests by selling spiritual comfort.","start":23.21,"end":33.79,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-004-p01","sourceId":"b3-027-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Though it may be possible to measure the value of material goods in terms of money,","start":35.15,"end":39.79,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-004-p02","sourceId":"b3-027-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[16,33],"wordModel":"mms-fa","text":"it is extremely difficult to estimate the true value of the services which people perform for us.","start":40.48,"end":46.79,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-005-p01","sourceId":"b3-027-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"There are times when we would willingly give everything we possess to save our lives,","start":47.92,"end":52.97,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-005-p02","sourceId":"b3-027-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[15,31],"wordModel":"mms-fa","text":"yet we might grudge paying a surgeon a high fee for offering us precisely this service.","start":53.46,"end":59.64,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-006-p01","sourceId":"b3-027-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"The conditions of society are such","start":60.55,"end":62.88,"score":0.999,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-006-p02","sourceId":"b3-027-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[6,25],"wordModel":"english-ctc-fallback","text":"that skills have to be paid for in the same way that goods are paid for at a shop.","start":63.06,"end":68.07,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-007","sourceId":"b3-027-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Everyone has something to sell.","start":69.12,"end":71.33,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-008","sourceId":"b3-027-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Tramps seem to be the only exception to this general rule.","start":72.76,"end":76.89,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-009","sourceId":"b3-027-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Beggars almost sell themselves as human beings to arouse the pity of passers-by.","start":77.902,"end":83.3,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-010","sourceId":"b3-027-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"But real tramps are not beggars.","start":84.32,"end":86.58,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-011","sourceId":"b3-027-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"They have nothing to sell and require nothing from others.","start":87.31,"end":90.6,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-012","sourceId":"b3-027-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"In seeking independence, they do not sacrifice their human dignity.","start":91.68,"end":96.31,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-013","sourceId":"b3-027-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A tramp may ask you for money, but he will never ask you to feel sorry for him.","start":97.46,"end":102.53,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-014","sourceId":"b3-027-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He has deliberately chosen to lead the life he leads and is fully aware of the consequences.","start":103.81,"end":110.07,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-015-p01","sourceId":"b3-027-015","sourceIndex":14,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"He may never be sure where the next meal is coming from,","start":111.52,"end":114.58,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-015-p02","sourceId":"b3-027-015","sourceIndex":14,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"mms-fa","text":"but he is free from the thousands of anxieties which afflict other people.","start":115.1,"end":119.86,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-016","sourceId":"b3-027-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"His few material possessions make it possible for him to move from place to place with ease.","start":121.0,"end":126.38,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-017","sourceId":"b3-027-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"By having to sleep in the open, he gets far closer to the world of nature than most of us ever do.","start":127.74,"end":133.84,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-018-p01","sourceId":"b3-027-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"He may hunt, beg, or steal occasionally to keep himself alive;","start":134.94,"end":139.9,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-018-p02","sourceId":"b3-027-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[11,30],"wordModel":"mms-fa","text":"he may even, in times of real need, do a little work; but he will never sacrifice his freedom.","start":140.28,"end":146.73,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-019-p01","sourceId":"b3-027-019","sourceIndex":18,"part":1,"parts":3,"wordRange":[0,16],"wordModel":"mms-fa","text":"We often speak of tramps with contempt and put them in the same class as beggars,","start":148.0,"end":153.642,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-019-p02","sourceId":"b3-027-019","sourceIndex":18,"part":2,"parts":3,"wordRange":[16,24],"wordModel":"mms-fa","text":"but how many of us can honestly say","start":154.26,"end":156.822,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-027-019-p03","sourceId":"b3-027-019","sourceIndex":18,"part":3,"parts":3,"wordRange":[24,43],"wordModel":"mms-fa","text":"that we have not felt a little envious of their simple way of life and their freedom from care?","start":157.02,"end":162.31,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
