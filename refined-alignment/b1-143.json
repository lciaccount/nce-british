score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-143-007","sourceId":"b1-143-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Last Wednesday, I went for a walk in the woods.","start":47.42,"end":50.3,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-143-008","sourceId":"b1-143-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What I saw made me very sad.","start":51.32,"end":53.86,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-143-009","sourceId":"b1-143-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"I counted seven old cars and three old refrigerators.","start":54.83,"end":59.35,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-143-010","sourceId":"b1-143-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The little baskets were empty and the ground was covered with pieces of paper, cigarette ends, old tyres, empty bottles and rusty tins.","start":60.22,"end":71.48,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-143-011","sourceId":"b1-143-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Among the rubbish, I found a sign which said, 'Anyone who leaves litter in these woods will be prosecuted!'","start":72.7,"end":80.62,"score":0.977,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
