141.762,"score":0.998},{"text":"recluse.","offset":37,"start":141.843,"end":142.402,"score":0.945}],[{"text":"He","offset":0,"start":143.262,"end":143.322,"score":1.0},{"text":"used","offset":3,"start":143.463,"end":143.642,"score":0.999},{"text":"to","offset":8,"start":143.662,"end":143.722,"score":0.996},{"text":"sleep","offset":11,"start":143.803,"end":144.062,"score":1.0},{"text":"during","offset":17,"start":144.123,"end":144.342,"score":1.0},{"text":"the","offset":24,"start":144.363,"end":144.442,"score":0.993},{"text":"day","offset":28,"start":144.482,"end":144.702,"score":1.0},{"text":"and","offset":32,"start":145.243,"end":145.362,"score":0.999},{"text":"work","offset":36,"start":145.422,"end":145.642,"score":0.998},{"text":"at","offset":41,"start":145.683,"end":145.762,"score":0.951},{"text":"night,","offset":44,"start":145.822,"end":146.062,"score":0.911},{"text":"quite","offset":51,"start":146.562,"end":146.882,"score":0.996},{"text":"unaware","offset":57,"start":146.963,"end":147.442,"score":0.987},{"text":"of","offset":65,"start":147.463,"end":147.522,"score":0.999},{"text":"the","offset":68,"start":147.562,"end":147.642,"score":0.988},{"text":"fact","offset":72,"start":147.702,"end":147.982,"score":1.0},{"text":"that","offset":77,"start":148.382,"end":148.522,"score":0.969},{"text":"he","offset":82,"start":148.562,"end":148.642,"score":0.963},{"text":"had","offset":85,"start":148.762,"end":148.922,"score":0.999},{"text":"become","offset":89,"start":149.002,"end":149.402,"score":1.0},{"text":"the","offset":96,"start":149.463,"end":149.562,"score":0.927},{"text":"ghost","offset":100,"start":149.702,"end":150.042,"score":0.858},{"text":"of","offset":106,"start":150.102,"end":150.202,"score":0.998},{"text":"Endley.","offset":109,"start":150.343,"end":150.662,"score":0.732}],[{"text":"When","offset":0,"start":151.502,"end":151.642,"score":0.946},{"text":"he","offset":5,"start":151.683,"end":151.742,"score":0.995},{"text":"died,","offset":8,"start":151.863,"end":152.142,"score":0.999},{"text":"however,","offset":14,"start":152.183,"end":152.522,"score":0.973},{"text":"his","offset":23,"start":153.042,"end":153.182,"score":1.0},{"text":"brothers","offset":27,"start":153.262,"end":153.582,"score":0.999},{"text":"found","offset":36,"start":153.642,"end":153.862,"score":1.0},{"text":"it","offset":42,"start":153.882,"end":153.962,"score":0.998},{"text":"impossible","offset":45,"start":154.102,"end":154.742,"score":1.0},{"text":"to","offset":56,"start":154.782,"end":154.862,"score":0.999},{"text":"keep","offset":59,"start":154.922,"end":155.082,"score":1.0},{"text":"the","offset":64,"start":155.102,"end":155.182,"score":0.999},{"text":"secret","offset":68,"start":155.243,"end":155.562,"score":1.0},{"text":"any","offset":75,"start":155.662,"end":155.802,"score":0.999},{"text":"longer.","offset":79,"start":155.882,"end":156.202,"score":0.996}]],"cues":[{"id":"b3-030-001","sourceId":"b3-030-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Why did the two brothers keep the secret?","start":11.94,"end":14.43,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-002","sourceId":"b3-030-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"For years, villagers believed that Endley farm was haunted.","start":17.08,"end":21.38,"score":0.828,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-003","sourceId":"b3-030-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The farm was owned by two brothers, Joe and Bob Cox.","start":22.07,"end":26.39,"score":0.907,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-004","sourceId":"b3-030-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"They employed a few farmhands, but no one was willing to work there long.","start":26.92,"end":31.25,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-005","sourceId":"b3-030-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Every time a worker gave up his job, he told the same story.","start":31.91,"end":36.07,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-006","sourceId":"b3-030-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Farm labourers said that they always woke up to find that work had been done overnight.","start":36.73,"end":42.45,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-007","sourceId":"b3-030-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Hay had been cut and cowsheds had been cleaned.","start":43.2,"end":46.66,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-008","sourceId":"b3-030-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"A farm worker, who stayed up all night, claimed to have seen a figure cutting corn in the moonlight.","start":47.22,"end":53.58,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-009","sourceId":"b3-030-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"In time, it became an accepted fact that the Cox brothers employed a conscientious ghost that did most of their work for them.","start":54.23,"end":62.95,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-010","sourceId":"b3-030-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"No one suspected that there might be someone else on the farm who had never been seen.","start":64.06,"end":69.26,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-011","sourceId":"b3-030-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"This was indeed the case.","start":69.95,"end":71.26,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-012","sourceId":"b3-030-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"A short time ago, villagers were astonished to learn that the ghost of Endley had died.","start":71.82,"end":78.06,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-013-p01","sourceId":"b3-030-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,5],"wordModel":"mms-fa","text":"Everyone went to the funeral,","start":79.02,"end":80.46,"score":0.91,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-013-p02","sourceId":"b3-030-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[5,27],"wordModel":"mms-fa","text":"for the 'ghost' was none other than Eric Cox, a third brother who was supposed to have died as a young man.","start":81.03,"end":88.18,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-014","sourceId":"b3-030-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"After the funeral, Joe and Bob revealed a secret which they had kept for over fifty years.","start":88.86,"end":95.25,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-015","sourceId":"b3-030-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Eric had been the eldest son of the family, very much older than his two brothers.","start":96.27,"end":101.34,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-016","sourceId":"b3-030-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He had been obliged to join the army during the Second World War.","start":101.98,"end":105.52,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-017","sourceId":"b3-030-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"As he hated army life, he decided to desert his regiment.","start":105.98,"end":109.78,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-018-p01","sourceId":"b3-030-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"When he learnt that he would be sent abroad,","start":110.36,"end":112.74,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-018-p02","sourceId":"b3-030-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[9,25],"wordModel":"mms-fa","text":"he returned to the farm and his father hid him until the end of the war.","start":113.26,"end":117.76,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-019","sourceId":"b3-030-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Fearing the authorities, Eric remained in hiding after the war as well.","start":118.35,"end":122.51,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-020","sourceId":"b3-030-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"His father told everybody that Eric had been killed in action.","start":123.12,"end":126.76,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-021","sourceId":"b3-030-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The only other people who knew the secret were Joe and Bob.","start":127.44,"end":131.43,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-022","sourceId":"b3-030-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"They did not even tell their wives.","start":131.98,"end":134.11,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-023","sourceId":"b3-030-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"When their father died they thought it their duty to keep Eric in hiding.","start":134.66,"end":138.6,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-024","sourceId":"b3-030-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"All these years, Eric had lived as a recluse.","start":139.16,"end":142.49,"score":0.878,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-025-p01","sourceId":"b3-030-025","sourceIndex":24,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"He used to sleep during the day and work at night,","start":143.2,"end":146.15,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-025-p02","sourceId":"b3-030-025","sourceIndex":24,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"mms-fa","text":"quite unaware of the fact that he had become the ghost of Endley.","start":146.42,"end":150.85,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-030-026","sourceId":"b3-030-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When he died, however, his brothers found it impossible to keep the secret any longer.","start":151.44,"end":156.33,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
