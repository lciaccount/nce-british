art":91.403,"end":91.623,"score":0.999},{"text":"time","offset":61,"start":91.742,"end":92.123,"score":0.999},{"text":"will","offset":66,"start":92.142,"end":92.283,"score":0.974},{"text":"tell.","offset":71,"start":92.343,"end":92.723,"score":1.0}],[{"text":"Meanwhile,","offset":0,"start":93.763,"end":94.303,"score":0.999},{"text":"they","offset":11,"start":94.802,"end":94.903,"score":1.0},{"text":"should","offset":16,"start":94.942,"end":95.123,"score":0.935},{"text":"encourage","offset":23,"start":95.142,"end":95.663,"score":0.968},{"text":"those","offset":33,"start":95.703,"end":95.943,"score":0.999},{"text":"among","offset":39,"start":95.983,"end":96.243,"score":0.947},{"text":"us","offset":45,"start":96.282,"end":96.443,"score":0.996},{"text":"who","offset":48,"start":96.502,"end":96.583,"score":1.0},{"text":"cannot","offset":52,"start":96.662,"end":97.003,"score":0.999},{"text":"swim","offset":59,"start":97.082,"end":97.343,"score":0.959},{"text":"five","offset":64,"start":97.542,"end":97.883,"score":0.943},{"text":"yards","offset":69,"start":97.942,"end":98.443,"score":0.999},{"text":"before","offset":75,"start":98.722,"end":99.062,"score":0.991},{"text":"they","offset":82,"start":99.082,"end":99.183,"score":0.998},{"text":"are","offset":87,"start":99.222,"end":99.343,"score":0.909},{"text":"gasping","offset":91,"start":99.382,"end":99.923,"score":0.998},{"text":"for","offset":99,"start":99.963,"end":100.063,"score":0.664},{"text":"air.","offset":103,"start":100.203,"end":100.443,"score":0.734}]],"cues":[{"id":"b2-094-001","sourceId":"b2-094-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"What kind of race do the children compete in?","start":14.06,"end":17.55,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-002","sourceId":"b2-094-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Experiments have proved that children can be instructed in swimming at a very early age.","start":20.62,"end":27.38,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-003","sourceId":"b2-094-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"At a special swimming pool in Los Angeles, children become expert at holding their breath under water even before they can walk.","start":29.06,"end":38.14,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-004","sourceId":"b2-094-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Babies of two months old do not appear to be reluctant to enter the water.","start":39.5,"end":44.36,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-005","sourceId":"b2-094-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"It is not long before they are so accustomed to swimming that they can pick up weights from the floor of the pool.","start":45.45,"end":52.58,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-006","sourceId":"b2-094-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"A game that is very popular with these young swimmers is the underwater tricycle race.","start":54.16,"end":60.22,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-007","sourceId":"b2-094-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Tricycles are lined up on the floor of the pool seven feet under water.","start":61.38,"end":66.65,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-008","sourceId":"b2-094-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The children compete against each other to reach the other end of the pool.","start":67.83,"end":72.43,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-009","sourceId":"b2-094-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Many pedal their tricycles but most of them prefer to push or drag them.","start":73.48,"end":79.49,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-010","sourceId":"b2-094-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Some children can cover the whole length of the pool without coming up for breath even once.","start":80.99,"end":86.59,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-011","sourceId":"b2-094-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Whether they will ever become future Olympic champions, only time will tell.","start":87.84,"end":92.86,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-094-012","sourceId":"b2-094-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Meanwhile, they should encourage those among us who cannot swim five yards before they are gasping for air.","start":93.7,"end":100.65,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
