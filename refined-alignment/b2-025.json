1,"wordRange":[0,14],"wordModel":"mms-fa","text":"I did not know the way to my hotel, so I asked a porter.","start":33.47,"end":38.05,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-006","sourceId":"b2-025-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"I not only spoke English very carefully, but very clearly as well.","start":39.83,"end":46.18,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-007","sourceId":"b2-025-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The porter, however, could not understand me.","start":47.64,"end":50.84,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-008","sourceId":"b2-025-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"I repeated my question several times and at last he understood.","start":52.55,"end":58.55,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-009","sourceId":"b2-025-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"he answered me, but he spoke neither slowly nor clearly.","start":60.34,"end":65.823,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-010","sourceId":"b2-025-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'I am a foreigner,' I said.","start":67.81,"end":70.52,"score":0.991,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-025-011","sourceId":"b2-025-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Then he spoke slowly, but I could not understand him.","start":71.82,"end":77.08,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-012","sourceId":"b2-025-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"My teacher never spoke English like that!","start":77.92,"end":80.79,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-013","sourceId":"b2-025-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The porter and I looked at each other and smiled.","start":82.46,"end":86.52,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-014","sourceId":"b2-025-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Then he said something and I understood it.","start":88.22,"end":90.97,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-015","sourceId":"b2-025-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"'You'll soon learn English!'","start":92.79,"end":95.07,"score":0.961,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-025-016","sourceId":"b2-025-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"he said.","start":95.86,"end":96.54,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-017","sourceId":"b2-025-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"I wonder.","start":98.01,"end":98.84,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-018","sourceId":"b2-025-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"In England, each person speaks a different language.","start":99.86,"end":103.8,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-025-019","sourceId":"b2-025-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The English understand each other, but I don't understand them!","start":104.64,"end":10