"needsReview":false,"reviewReasons":[]},{"id":"b2-066-006","sourceId":"b2-066-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The French authorities had the plane packaged and moved in parts back to France.","start":65.82,"end":72.2,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-066-007","sourceId":"b2-066-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Now a group of enthusiasts are going to have the plane restored.","start":73.33,"end":77.76,"score":0.877,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-066-008","sourceId":"b2-066-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"It has four Rolls-Royce Merlin engines but the group will need to have only three of them rebuilt.","start":78.84,"end":86.07,"score":0.864,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-066-009-p01","sourceId":"b2-066-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,5],"wordModel":"mms-fa","text":"Imagine their surprise and delight","start":87.53,"end":90.35,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-066-009-p02","sourceId":"b2-066-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[5,25],"wordModel":"mms-fa","text":"when they broke open the packing cases and found that the fourth engine was sweet as honey--still in perfect condition.","start":90.94,"end":101.38,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-066-010","sourceId":"b2-066-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A colony of bees had turned the engine into a hive and it was totally preserved in beeswax!","start":102.74,"end":112.02,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
