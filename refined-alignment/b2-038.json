"id":"b2-038-005-p01","sourceId":"b2-038-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"Almost immediately he began to complain about the weather,","start":47.88,"end":51.85,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-005-p02","sourceId":"b2-038-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[9,25],"wordModel":"english-ctc-fallback","text":"for even though it was still summer, it rained continually and it was often bitterly cold.","start":52.78,"end":60.57,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-006","sourceId":"b2-038-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"After so many years of sunshine, Harrison got a shock.","start":61.983,"end":66.77,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-007","sourceId":"b2-038-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He acted as if he had never lived in England before.","start":68.02,"end":71.18,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-008","sourceId":"b2-038-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"In the end, it was more than he could bear.","start":72.58,"end":75.45,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-009","sourceId":"b2-038-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He had hardly had time to settle down when he sold the house and left the country.","start":77.02,"end":82.25,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-010","sourceId":"b2-038-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The dream he had had for so many years ended there.","start":83.66,"end":87.29,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-038-011","sourceId":"b2-038-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Harrison had thought of everything except the weather.","start":88.62,"end":92.14,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
