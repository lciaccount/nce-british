s":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Debbie is only eleven years old and she hopes to set up a new world record.","start":33.523,"end":40.21,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-005","sourceId":"b2-036-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"She is a strong swimmer and many people feel that she is sure to succeed.","start":41.2,"end":47.02,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-006","sourceId":"b2-036-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Debbie's father will set out with her in a small boat.","start":48.86,"end":53.05,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-007","sourceId":"b2-036-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Mr. Hart has trained his daughter for years.","start":54.58,"end":58.11,"score":0.882,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-008","sourceId":"b2-036-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"Tomorrow he will be watching her anxiously as she swims the long distance to England.","start":59.203,"end":66.09,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-009","sourceId":"b2-036-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Debbie intends to take short rests every two hours.","start":67.82,"end":72.19,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-010","sourceId":"b2-036-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"She will have something to drink but she will not eat any solid food.","start":73.29,"end":78.3,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-011","sourceId":"b2-036-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"Most of Debbie's school friends will be waiting for her on the English coast.","start":79.5,"end":84.42,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-036-012","sourceId":"b2-036-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Among them will be Debbie's mother, who swam the Channel herself when she was a girl.","start":85.6,"end":92.13,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
