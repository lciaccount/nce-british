d":74.963,"score":1.0}]],"cues":[{"id":"b2-017-001","sourceId":"b2-017-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Why doesn't Aunt Jennifer tell anyone how old she is?","start":13.71,"end":19.09,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-002","sourceId":"b2-017-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"My aunt Jennifer is an actress.","start":21.87,"end":24.7,"score":0.849,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-003","sourceId":"b2-017-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"She must be at least thirty-five years old.","start":25.73,"end":30.73,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-004","sourceId":"b2-017-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"In spite of this, she often appears on the stage as a young girl.","start":32.16,"end":38.002,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-005","sourceId":"b2-017-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Jennifer will have to take part in a new play soon.","start":39.46,"end":42.9,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-006","sourceId":"b2-017-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"This time, she will be a girl of seventeen.","start":43.72,"end":47.25,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-007","sourceId":"b2-017-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"In the play, she must appear in a bright red dress and long black stockings.","start":48.3,"end":54.76,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-008","sourceId":"b2-017-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Last year in another play, she had to wear short socks and a bright, orange-coloured dress.","start":55.92,"end":63.69,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-017-009","sourceId":"b2-017-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"If anyone ever asks her how old she is, she always answers, 'Darling, it must be terrible to be grown up!'","start":65.37,"end":75.19,"score":0.992,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
