103,"start":95.922,"end":96.062,"score":0.999},{"text":"him!","offset":106,"start":96.123,"end":96.303,"score":1.0}]],"cues":[{"id":"b2-063-001","sourceId":"b2-063-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Why did Jenny want to leave the wedding reception?","start":13.782,"end":17.04,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-002","sourceId":"b2-063-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Jeremy Hampden has a large circle of friends and is very popular at parties.","start":19.75,"end":25.79,"score":0.855,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b2-063-003","sourceId":"b2-063-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Everybody admires him for his great sense of humour--everybody, that is, except his six-year-old daughter, Jenny.","start":26.79,"end":35.96,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-004","sourceId":"b2-063-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Recently, one of Jeremy's closest friends asked him to make a speech at a wedding reception.","start":37.62,"end":44.47,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-005","sourceId":"b2-063-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"This is the sort of thing that Jeremy loves.","start":45.46,"end":48.45,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-006","sourceId":"b2-063-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"He prepared the speech carefully and went to the wedding with Jenny.","start":49.53,"end":54.37,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-007","sourceId":"b2-063-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"He had included a large number of funny stories in the speech and, of course, it was a great success.","start":55.56,"end":62.6,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-008","sourceId":"b2-063-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"As soon as he had finished Jenny told him she wanted to go home.","start":63.643,"end":68.71,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-009","sourceId":"b2-063-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Jeremy was a little disappointed by this but he did as his daughter asked.","start":70.34,"end":75.88,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-010","sourceId":"b2-063-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"On the way home, he asked Jenny if she had enjoyed the speech.","start":76.74,"end":81.3,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-011","sourceId":"b2-063-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"To his surprise she said she hadn't.","start":82.96,"end":85.91,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-012-p01","sourceId":"b2-063-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"Jeremy asked her why this was so and she told him","start":87.78,"end":92.603,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-063-012-p02","sourceId":"b2-063-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"mms-fa","text":"that she did not like to see so many people laughing at him!","start":92.603,"end":96.41,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
