.67,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-006-p01","sourceId":"b2-072-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Although Campbell reached a speed of over 304 miles per hour,","start":54.38,"end":59.64,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-006-p02","sourceId":"b2-072-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[11,27],"wordModel":"english-ctc-fallback","text":"he had great difficulty in controlling the car because a tyre burst during the first run.","start":60.58,"end":67.65,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-007","sourceId":"b2-072-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"After his attempt, Campbell was disappointed to learn that his average speed had been 299 miles per hour.","start":69.322,"end":78.65,"score":0.976,"timingValid":true,"needsReview":true,"reviewReasons":["stretched-word"]},{"id":"b2-072-008","sourceId":"b2-072-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"However, a few days later, he was told that a mistake had been made.","start":79.822,"end":85.18,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-009","sourceId":"b2-072-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"His average speed had been 301 miles per hour.","start":85.77,"end":90.28,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-010","sourceId":"b2-072-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Since that time, racing drivers have reached speeds over 600 miles an hour.","start":91.782,"end":98.79,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-011","sourceId":"b2-072-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Following in his father's footsteps many years later, Sir Malcolm's son, Donald, also set up a world record.","start":99.83,"end":108.85,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-072-012","sourceId":"b2-072-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Like his father, he was driving a car called Bluebird.","start":109.98,"end":114.1,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
