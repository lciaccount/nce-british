.243,"end":157.562,"score":0.825},{"text":"cheerfully","offset":58,"start":157.903,"end":158.302,"score":0.848},{"text":"announced","offset":69,"start":158.343,"end":158.782,"score":0.975},{"text":"that","offset":79,"start":159.262,"end":159.402,"score":0.909},{"text":"there","offset":84,"start":159.442,"end":159.602,"score":0.946},{"text":"was","offset":90,"start":159.623,"end":159.762,"score":0.974},{"text":"no","offset":94,"start":159.822,"end":159.902,"score":0.887},{"text":"oil","offset":97,"start":160.183,"end":160.442,"score":0.954},{"text":"in","offset":101,"start":160.743,"end":160.822,"score":0.999},{"text":"the","offset":104,"start":160.882,"end":160.962,"score":0.996},{"text":"engine!","offset":108,"start":161.123,"end":161.482,"score":0.824}]],"cues":[{"id":"b3-039-001","sourceId":"b3-039-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"What was the differnce between Bruce's behaviour and that of other people?","start":12.18,"end":17.11,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-002-p01","sourceId":"b3-039-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"The rough road across the plain soon became so bad","start":19.76,"end":23.48,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-002-p02","sourceId":"b3-039-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[10,26],"wordModel":"english-ctc-fallback","text":"that we tried to get Bruce to drive back to the village we had come from.","start":23.66,"end":27.39,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-003","sourceId":"b3-039-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Even though the road was littered with boulders and pitted with holes, Bruce was not in the least perturbed.","start":28.48,"end":35.28,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-004","sourceId":"b3-039-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"Glancing at his map, he informed us that the next village was a mere twenty miles away.","start":36.66,"end":42.63,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-005","sourceId":"b3-039-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It was not that Bruce always underestimated difficulties.","start":43.72,"end":47.14,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-006","sourceId":"b3-039-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"He simply had no sense of danger at all.","start":47.76,"end":50.29,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-007","sourceId":"b3-039-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"No matter what the conditions were, he believed that a car should be driven as fast as it could possibly go.","start":51.03,"end":58.06,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-008","sourceId":"b3-039-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"As we bumped over the dusty track, we swerved to avoid large boulders.","start":59.34,"end":64.09,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-009","sourceId":"b3-039-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The wheels scooped up stones which hammered ominously under the car.","start":64.95,"end":68.97,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-010","sourceId":"b3-039-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"We felt sure that sooner or later a stone would rip a hole in our petrol tank or damage the engine.","start":69.71,"end":76.13,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-011","sourceId":"b3-039-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Because of this, we kept looking back, wondering if we were leaving a trail of oil and petrol behind us.","start":77.14,"end":84.32,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-012-p01","sourceId":"b3-039-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"What a relief it was when the boulders suddenly disappeared,","start":85.78,"end":89.5,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-012-p02","sourceId":"b3-039-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"giving way to a stretch of plain where the only obstacles were clumps bushes.","start":90.1,"end":95.13,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-013","sourceId":"b3-039-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"But there was worse to come.","start":96.04,"end":97.72,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-014","sourceId":"b3-039-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Just ahead of us there was a huge fissure.","start":98.44,"end":101.12,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-015","sourceId":"b3-039-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"In response to renewed pleadings, Bruce stopped.","start":101.78,"end":105.23,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-016","sourceId":"b3-039-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Though we all got out to examine the fissure, he remained in the car.","start":105.79,"end":109.75,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-017","sourceId":"b3-039-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"We informed him that the fissure extended for fifty yards and was two feet wide and four feet deep.","start":110.3,"end":117.27,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-018","sourceId":"b3-039-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Even this had no effect.","start":117.87,"end":119.4,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-019-p01","sourceId":"b3-039-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"Bruce went into a low gear and drove at a terrifying speed,","start":119.88,"end":124.15,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-019-p02","sourceId":"b3-039-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"mms-fa","text":"keeping the front wheels astride the crack as he followed its zigzag course.","start":124.48,"end":128.9,"score":0.907,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-020","sourceId":"b3-039-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Before we had time to worry about what might happen, we were back on the plain again.","start":129.6,"end":134.91,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-021","sourceId":"b3-039-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Bruce consulted the map once more and told us that the village was now only fifteen miles away.","start":135.44,"end":141.47,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-022","sourceId":"b3-039-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Our next obstacle was a shallow pool of water about half a mile across.","start":142.08,"end":147.21,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-023","sourceId":"b3-039-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Bruce charged at it, but in the middle, the car came to a grinding halt.","start":148.26,"end":152.76,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-039-024","sourceId":"b3-039-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"A yellow light on the dashboard flashed angrily and Bruce cheerfully announced that there was no oil in the engine!","start":153.72,"end":161.58,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
