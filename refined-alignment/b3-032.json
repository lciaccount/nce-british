ffset":30,"start":145.702,"end":145.722,"score":0.992},{"text":"convoy","offset":32,"start":145.822,"end":146.242,"score":0.999},{"text":"to","offset":39,"start":146.303,"end":146.362,"score":0.996},{"text":"Russia","offset":42,"start":146.502,"end":146.782,"score":0.958},{"text":"when","offset":49,"start":147.422,"end":147.562,"score":0.937},{"text":"she","offset":54,"start":147.602,"end":147.702,"score":0.979},{"text":"was","offset":58,"start":147.782,"end":147.922,"score":0.997},{"text":"torpedoed","offset":62,"start":147.982,"end":148.622,"score":0.816},{"text":"by","offset":72,"start":148.882,"end":149.022,"score":0.999},{"text":"an","offset":75,"start":149.102,"end":149.182,"score":0.993},{"text":"enemy","offset":78,"start":149.282,"end":149.542,"score":0.985},{"text":"submarine.","offset":84,"start":149.662,"end":150.302,"score":0.993}],[{"text":"This","offset":0,"start":151.403,"end":151.562,"score":0.978},{"text":"was","offset":5,"start":151.623,"end":151.742,"score":0.996},{"text":"later","offset":9,"start":151.822,"end":152.082,"score":0.975},{"text":"confirmed","offset":15,"start":152.123,"end":152.622,"score":0.922},{"text":"by","offset":25,"start":152.642,"end":152.782,"score":0.992},{"text":"a","offset":28,"start":152.863,"end":152.882,"score":0.983},{"text":"naval","offset":30,"start":153.002,"end":153.282,"score":0.52},{"text":"official","offset":36,"start":153.343,"end":153.722,"score":0.983},{"text":"at","offset":45,"start":154.123,"end":154.202,"score":0.987},{"text":"the","offset":48,"start":154.243,"end":154.302,"score":0.982},{"text":"Ministry","offset":52,"start":154.382,"end":154.702,"score":0.998},{"text":"of","offset":61,"start":154.743,"end":154.782,"score":0.995},{"text":"Defence","offset":64,"start":154.843,"end":155.322,"score":0.865},{"text":"after","offset":72,"start":155.843,"end":156.062,"score":0.992},{"text":"the","offset":78,"start":156.102,"end":156.182,"score":0.982},{"text":"Elkor","offset":82,"start":156.343,"end":156.782,"score":0.74},{"text":"had","offset":88,"start":157.083,"end":157.202,"score":0.994},{"text":"returned","offset":92,"start":157.262,"end":157.662,"score":0.997},{"text":"home.","offset":101,"start":157.702,"end":157.962,"score":0.963}],[{"text":"All","offset":0,"start":158.882,"end":158.982,"score":0.573},{"text":"the","offset":4,"start":159.023,"end":159.122,"score":0.674},{"text":"items","offset":8,"start":159.343,"end":159.602,"score":0.636},{"text":"that","offset":14,"start":159.642,"end":159.762,"score":0.585},{"text":"were","offset":19,"start":159.803,"end":159.922,"score":0.51},{"text":"found","offset":24,"start":159.982,"end":160.302,"score":0.905},{"text":"were","offset":30,"start":160.623,"end":160.782,"score":0.996},{"text":"sent","offset":35,"start":160.843,"end":161.042,"score":0.998},{"text":"to","offset":40,"start":161.083,"end":161.162,"score":0.994},{"text":"the","offset":43,"start":161.222,"end":161.302,"score":0.923},{"text":"War","offset":47,"start":161.382,"end":161.582,"score":0.971},{"text":"Museum.","offset":51,"start":161.642,"end":162.102,"score":0.959}]],"cues":[{"id":"b3-032-001","sourceId":"b3-032-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Did the crew of the Elkor find what they were looking for?","start":12.26,"end":16.38,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-002","sourceId":"b3-032-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"Why?","start":17.23,"end":17.83,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-003","sourceId":"b3-032-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The salvage operation had been a complete failure.","start":20.45,"end":23.69,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-004","sourceId":"b3-032-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The small ship, Elkor, which had been searching the Barents Sea for weeks, was on its way home.","start":24.16,"end":30.64,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-005","sourceId":"b3-032-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"A radio message from the mainland had been received by the ship's captain instructing him to give up the search.","start":31.42,"end":38.76,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-006-p01","sourceId":"b3-032-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"The captain knew that another attempt would be made later,","start":39.72,"end":43.09,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-006-p02","sourceId":"b3-032-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"for the sunken ship he was trying to find had been carrying a precious cargo of gold bullion.","start":43.68,"end":50.23,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-007","sourceId":"b3-032-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Despite the message, the captain of the Elkor decided to try once more.","start":51.4,"end":56.53,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-008","sourceId":"b3-032-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The sea bed was scoured with powerful nets and there was tremendous excitement on board when a chest was raised from the bottom.","start":57.61,"end":65.89,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-009-p01","sourceId":"b3-032-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Though the crew were at first under the impression that the lost ship had been found,","start":66.81,"end":71.0,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-009-p02","sourceId":"b3-032-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[16,24],"wordModel":"mms-fa","text":"the contents of the chest proved them wrong.","start":71.68,"end":74.39,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-010","sourceId":"b3-032-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"What they had in fact found was a ship which had been sunk many years before.","start":75.08,"end":80.31,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-011","sourceId":"b3-032-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The chest contained the personal belongings of a seaman, Alan Fielding.","start":81.16,"end":86.07,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-012","sourceId":"b3-032-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"There were books, clothing and photographs, together with letters which the seaman had once received from his wife.","start":86.66,"end":94.06,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-013","sourceId":"b3-032-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The captain of the Elkor ordered his men to salvage as much as possible from the wreck.","start":94.58,"end":99.67,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-014","sourceId":"b3-032-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Nothing of value was found, but the numerous items which were brought to the surface proved to be of great interest.","start":100.26,"end":107.05,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-015","sourceId":"b3-032-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"From a heavy gun that was raised, the captain realized that the ship must have been a cruiser.","start":107.5,"end":113.04,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-016-p01","sourceId":"b3-032-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"In another chest which contained the belongings of a ship's officer,","start":113.8,"end":117.52,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-016-p02","sourceId":"b3-032-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"english-ctc-fallback","text":"there was an unfinished letter which had been written on March 14th, 1943.","start":117.84,"end":123.12,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-017","sourceId":"b3-032-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The captain learnt from the letter that the name of the lost ship was the Karen.","start":123.77,"end":128.59,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-018","sourceId":"b3-032-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"The most valuable find of all was the ship's log book, parts of which it was still possible to read.","start":129.24,"end":136.24,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-019","sourceId":"b3-032-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"From this the captain was able to piece together all the information that had come to light.","start":136.9,"end":142.82,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-020","sourceId":"b3-032-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The Karen had been sailing in a convoy to Russia when she was torpedoed by an enemy submarine.","start":143.66,"end":150.39,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-021","sourceId":"b3-032-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"This was later confirmed by a naval official at the Ministry of Defence after the Elkor had returned home.","start":151.34,"end":158.06,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-032-022","sourceId":"b3-032-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"All the items that were found were sent to the War Museum.","start":158.79,"end":162.22,"score":0.81,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
