ourceId":"b2-049-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A gust of wind swept the bed off the roof and sent it crashing into the courtyard below.","start":54.66,"end":62.29,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-007","sourceId":"b2-049-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The young man did not wake up until the bed had struck the ground.","start":64.09,"end":68.57,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-008","sourceId":"b2-049-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Although the bed was smashed to pieces, the man was miraculously unhurt.","start":70.86,"end":76.44,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-009","sourceId":"b2-049-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"When he woke up, he was still on the mattress.","start":77.68,"end":81.03,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-010-p01","sourceId":"b2-049-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"Glancing at the bits of wood and metal that lay around him,","start":82.7,"end":86.35,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-010-p02","sourceId":"b2-049-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"mms-fa","text":"the man sadly picked up the mattress and carried it into his house.","start":87.34,"end":92.2,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-049-011","sourceId":"b2-049-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"After he had put it on the floor, he promptly went to sleep again.","start":93.72,"end":97.84,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
