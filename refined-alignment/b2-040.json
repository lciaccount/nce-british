:"mms-fa","text":"I tried to make conversation.","start":48.57,"end":50.46,"score":0.999,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-007","sourceId":"b2-040-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"'A new play is coming to \"The Globe\" soon,' I said.","start":53.56,"end":57.263,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-008","sourceId":"b2-040-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'Will you be seeing it?'","start":57.58,"end":58.93,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-009","sourceId":"b2-040-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"'No,' she answered.","start":60.223,"end":62.45,"score":0.992,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-040-010","sourceId":"b2-040-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"'Will you be spending your holidays abroad this year?'","start":64.16,"end":67.65,"score":0.984,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-040-011","sourceId":"b2-040-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"I asked.","start":68.34,"end":69.443,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-012","sourceId":"b2-040-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"'No,' she answered.","start":71.08,"end":73.75,"score":0.987,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-040-013","sourceId":"b2-040-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'Will you be staying in England?'","start":75.83,"end":77.7,"score":0.979,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-040-014","sourceId":"b2-040-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"I asked.","start":78.082,"end":79.323,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-015","sourceId":"b2-040-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"'No,' she answered.","start":80.443,"end":83.343,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-016","sourceId":"b2-040-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"In despair, I asked her whether she was enjoying her dinner.","start":84.68,"end":89.32,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-040-017","sourceId":"b2-040-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"'Young man,' she answered, 'if you ate more and talked less, we would both enjoy our dinner!'","start":90.262,"end":98.98,"score":0.989,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
