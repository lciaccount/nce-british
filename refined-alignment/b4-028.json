"score":0.991},{"text":"no","offset":214,"start":179.923,"end":180.022,"score":0.994},{"text":"inconvenience","offset":217,"start":180.222,"end":181.022,"score":0.995},{"text":"to","offset":231,"start":181.042,"end":181.102,"score":0.993},{"text":"themselves.","offset":234,"start":181.162,"end":181.842,"score":0.997}]],"cues":[{"id":"b4-028-001","sourceId":"b4-028-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"What are patients looking for when they visit the doctor?","start":12.18,"end":15.46,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-002-p01","sourceId":"b4-028-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"mms-fa","text":"This is a sceptical age, but although our faith in many of the things in which our forefathers fervently believed has weakened,","start":18.17,"end":26.58,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-002-p02","sourceId":"b4-028-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[22,38],"wordModel":"mms-fa","text":"our confidence in the curative properties of the bottle of medicine remains the same as theirs.","start":27.16,"end":33.0,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-003-p01","sourceId":"b4-028-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"This modern faith in medicines is proved by the fact","start":33.89,"end":37.24,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-003-p02","sourceId":"b4-028-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"that the annual drug bill of the Health Services is mounting to astronomical figures.","start":37.42,"end":43.0,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-004","sourceId":"b4-028-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"and shows no signs at present of ceasing to rise.","start":43.43,"end":46.82,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-005-p01","sourceId":"b4-028-005","sourceIndex":4,"part":1,"parts":4,"wordRange":[0,21],"wordModel":"mms-fa","text":"The majority of the patients attending the medical out-patients departments of our hospitals feel that they have not received adequate treatment","start":47.98,"end":56.42,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-005-p02","sourceId":"b4-028-005","sourceIndex":4,"part":2,"parts":4,"wordRange":[21,41],"wordModel":"mms-fa","text":"unless they are able to carry home with them some tangible remedy in the shape of a bottle of medicine,","start":56.8,"end":63.52,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-005-p03","sourceId":"b4-028-005","sourceIndex":4,"part":3,"parts":4,"wordRange":[41,51],"wordModel":"mms-fa","text":"a box of pills, or a small jar of ointment,","start":64.08,"end":67.24,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-005-p04","sourceId":"b4-028-005","sourceIndex":4,"part":4,"parts":4,"wordRange":[51,69],"wordModel":"mms-fa","text":"and the doctor in charge of the department is only too ready to provide them with these requirements.","start":67.92,"end":73.28,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-006-p01","sourceId":"b4-028-006","sourceIndex":5,"part":1,"parts":3,"wordRange":[0,18],"wordModel":"mms-fa","text":"There is no quicker method of disposing of patients than by giving them what they are asking for,","start":74.32,"end":79.79,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-006-p02","sourceId":"b4-028-006","sourceIndex":5,"part":2,"parts":3,"wordRange":[18,44],"wordModel":"mms-fa","text":"and since most medical men in the Health Services are overworked and have little time for offering time-consuming and little-appreciated advice on such subjects as diet,","start":80.76,"end":92.4,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-006-p03","sourceId":"b4-028-006","sourceIndex":5,"part":3,"parts":3,"wordRange":[44,66],"wordModel":"mms-fa","text":"right living, and the need for abandoning bad habits etc., the bottle, the box, and the jar are almost always granted them.","start":92.92,"end":102.68,"score":0.897,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-007","sourceId":"b4-028-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Nor is it only the ignorant and ill-educated person who has such faith in the bottle of medicine.","start":104.14,"end":110.25,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-008-p01","sourceId":"b4-028-008","sourceIndex":7,"part":1,"parts":3,"wordRange":[0,16],"wordModel":"mms-fa","text":"It is recounted of Thomas Carlyle that when he heard of the illness of his friend,","start":111.42,"end":116.06,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-008-p02","sourceId":"b4-028-008","sourceIndex":7,"part":2,"parts":3,"wordRange":[16,25],"wordModel":"mms-fa","text":"Henry Taylor, he went off immediately to visit him,","start":116.26,"end":119.8,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-008-p03","sourceId":"b4-028-008","sourceIndex":7,"part":3,"parts":3,"wordRange":[25,45],"wordModel":"mms-fa","text":"carrying with him in his pocket what remained a bottle of medicine formerly prescribed for an indisposition of Mrs. Carlyle's.","start":120.7,"end":129.19,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-009-p01","sourceId":"b4-028-009","sourceIndex":8,"part":1,"parts":4,"wordRange":[0,12],"wordModel":"mms-fa","text":"Carlyle was entirely ignorant of what the bottle in his pocket contained,","start":130.24,"end":134.8,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-009-p02","sourceId":"b4-028-009","sourceIndex":8,"part":2,"parts":4,"wordRange":[12,34],"wordModel":"mms-fa","text":"of the nature of the illness from which his friend was suffering, and of what had previously been wrong with his wife,","start":135.44,"end":141.66,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-009-p03","sourceId":"b4-028-009","sourceIndex":8,"part":3,"parts":4,"wordRange":[34,55],"wordModel":"mms-fa","text":"but a medicine that had worked so well in one form of illness would surely be of equal benefit in another,","start":142.202,"end":149.12,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-009-p04","sourceId":"b4-028-009","sourceIndex":8,"part":4,"parts":4,"wordRange":[55,75],"wordModel":"mms-fa","text":"and comforted by the thought of the help he was bringing to his friend, he hastened to Henry Taylor's house.","start":149.78,"end":155.86,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-010","sourceId":"b4-028-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"History does not relate whether his friend accepted his medical help, but in all probability he did.","start":156.9,"end":164.3,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-011-p01","sourceId":"b4-028-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,27],"wordModel":"mms-fa","text":"The great advantage of taking medicine is that it makes no demands on the taker beyond that of putting up for a moment with a disgusting taste,","start":165.042,"end":174.2,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-028-011-p02","sourceId":"b4-028-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[27,44],"wordModel":"mms-fa","text":"and that is what all patients demand of their doctors--to be cured at no inconvenience to themselves.","start":174.82,"end":181.92,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
