":148.843,"end":148.902,"score":0.998},{"text":"money","offset":27,"start":148.963,"end":149.182,"score":0.972},{"text":"and","offset":33,"start":149.743,"end":149.842,"score":0.999},{"text":"was","offset":37,"start":149.903,"end":150.022,"score":0.999},{"text":"paid","offset":41,"start":150.083,"end":150.342,"score":0.824},{"text":"as","offset":46,"start":150.382,"end":150.482,"score":0.998},{"text":"much","offset":49,"start":150.523,"end":150.742,"score":0.975},{"text":"as","offset":54,"start":150.782,"end":150.882,"score":0.998},{"text":"￡100","offset":57,"start":151.282,"end":152.242,"score":0.456},{"text":"for","offset":62,"start":152.542,"end":152.642,"score":0.994},{"text":"a","offset":66,"start":152.702,"end":152.722,"score":0.984},{"text":"single","offset":68,"start":152.803,"end":153.122,"score":0.943},{"text":"appearance.","offset":75,"start":153.142,"end":153.642,"score":0.934}],[{"text":"Despite","offset":0,"start":154.583,"end":155.042,"score":0.998},{"text":"this,","offset":8,"start":155.062,"end":155.282,"score":0.948},{"text":"he","offset":14,"start":155.743,"end":155.802,"score":0.995},{"text":"was","offset":17,"start":155.863,"end":155.982,"score":0.998},{"text":"so","offset":21,"start":156.023,"end":156.102,"score":0.992},{"text":"extravagant","offset":24,"start":156.222,"end":156.922,"score":0.998},{"text":"that","offset":36,"start":157.262,"end":157.402,"score":0.973},{"text":"he","offset":41,"start":157.423,"end":157.482,"score":0.977},{"text":"was","offset":44,"start":157.523,"end":157.642,"score":0.995},{"text":"always","offset":48,"start":157.822,"end":158.162,"score":0.998},{"text":"in","offset":55,"start":158.202,"end":158.302,"score":0.994},{"text":"debt.","offset":58,"start":158.382,"end":158.602,"score":0.678}],[{"text":"After","offset":0,"start":159.702,"end":159.902,"score":0.994},{"text":"he","offset":6,"start":159.963,"end":160.042,"score":0.901},{"text":"was","offset":9,"start":160.102,"end":160.202,"score":0.998},{"text":"defeated","offset":13,"start":160.282,"end":160.722,"score":0.975},{"text":"by","offset":22,"start":160.822,"end":160.942,"score":1.0},{"text":"a","offset":25,"start":161.042,"end":161.062,"score":1.0},{"text":"boxer","offset":27,"start":161.142,"end":161.482,"score":0.991},{"text":"called","offset":33,"start":161.542,"end":161.782,"score":1.0},{"text":"Gentleman","offset":40,"start":162.222,"end":162.682,"score":0.937},{"text":"Jackson,","offset":50,"start":162.822,"end":163.242,"score":0.996},{"text":"he","offset":59,"start":163.803,"end":163.902,"score":0.915},{"text":"was","offset":62,"start":163.982,"end":164.122,"score":0.995},{"text":"quickly","offset":66,"start":164.282,"end":164.602,"score":0.999},{"text":"forgotten.","offset":74,"start":164.683,"end":165.142,"score":0.984}],[{"text":"He","offset":0,"start":166.202,"end":166.282,"score":1.0},{"text":"was","offset":3,"start":166.343,"end":166.442,"score":1.0},{"text":"sent","offset":7,"start":166.502,"end":166.682,"score":0.989},{"text":"to","offset":12,"start":166.722,"end":166.782,"score":1.0},{"text":"prison","offset":15,"start":166.863,"end":167.122,"score":0.936},{"text":"for","offset":22,"start":167.442,"end":167.542,"score":1.0},{"text":"failing","offset":26,"start":167.642,"end":167.942,"score":1.0},{"text":"to","offset":34,"start":168.002,"end":168.062,"score":1.0},{"text":"pay","offset":37,"start":168.123,"end":168.262,"score":0.934},{"text":"his","offset":41,"start":168.322,"end":168.442,"score":0.987},{"text":"debts","offset":45,"start":168.482,"end":168.782,"score":0.989},{"text":"and","offset":51,"start":169.403,"end":169.482,"score":1.0},{"text":"died","offset":55,"start":169.602,"end":169.902,"score":0.95},{"text":"in","offset":60,"start":169.963,"end":170.002,"score":1.0},{"text":"poverty","offset":63,"start":170.142,"end":170.542,"score":0.998},{"text":"in","offset":71,"start":170.922,"end":170.962,"score":1.0},{"text":"1836.","offset":74,"start":171.162,"end":172.202,"score":0.975}]],"cues":[{"id":"b3-021-001","sourceId":"b3-021-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"How many unsuccessful attempts did Mendoza make before becoming Champion of all England?","start":12.15,"end":18.15,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-002","sourceId":"b3-021-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Boxing matches were very popular in England two hundred years ago.","start":20.78,"end":24.85,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-003","sourceId":"b3-021-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"In those days, boxers fought with bare fists for prize money.","start":26.02,"end":30.03,"score":0.901,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-004","sourceId":"b3-021-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Because of this, they were known as 'prizefighters'.","start":31.0,"end":34.25,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-005","sourceId":"b3-021-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"However, boxing was very crude, for there were no rules and a prizefighter could be seriously injured or even killed during a match.","start":35.26,"end":44.02,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-006","sourceId":"b3-021-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"One of the most colourful figures in boxing history was Daniel Mendoza, who was born in 1764.","start":45.8,"end":52.98,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-007","sourceId":"b3-021-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"The use of gloves was not introduced until 1860, when the Marquis of Queensberry drew up the first set of rules.","start":54.3,"end":62.48,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-008","sourceId":"b3-021-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Though he was technically a prizefighter, Mendoza did much to change crude prizefighting into a sport, for he brought science to the game.","start":63.69,"end":73.7,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-009","sourceId":"b3-021-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"In his day, Mendoza enjoyed tremendous popularity.","start":74.7,"end":78.53,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-010","sourceId":"b3-021-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He was adored by rich and poor alike.","start":79.32,"end":82.04,"score":0.864,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-011","sourceId":"b3-021-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Mendoza rose to fame swiftly after a boxing match when he was only fourteen years old.","start":83.19,"end":88.74,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-012","sourceId":"b3-021-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"This attracted the attention of Richard Humphries who was then the most eminent boxer in England.","start":89.77,"end":95.68,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-013","sourceId":"b3-021-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He offered to train Mendoza and his young pupil was quick to learn.","start":96.64,"end":100.6,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-014","sourceId":"b3-021-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"In fact, Mendoza soon became so successful that Humphries turned against him.","start":101.26,"end":106.41,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-015","sourceId":"b3-021-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The two men quarrelled bitterly and it was clear that the argument could only be settled by a fight.","start":107.1,"end":113.22,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-016","sourceId":"b3-021-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"A match was held at Stilton, where both men fought for an hour.","start":114.72,"end":118.68,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-017","sourceId":"b3-021-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"The public bet a great deal of money on Mendoza, but he was defeated.","start":119.69,"end":124.44,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-018","sourceId":"b3-021-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Mendoza met Humphries in the ring on a later occasion and he lost for a second time.","start":125.44,"end":130.46,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-019","sourceId":"b3-021-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"It was not until his third match in 1790 that he finally beat Humphries and became Champion of England.","start":131.39,"end":138.55,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-020","sourceId":"b3-021-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Meanwhile, he founded a highly successful Academy and even Lord Byron became one of his pupils.","start":139.87,"end":146.57,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-021","sourceId":"b3-021-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He earned enormous sums of money and was paid as much as ￡100 for a single appearance.","start":147.42,"end":153.76,"score":0.923,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-022","sourceId":"b3-021-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Despite this, he was so extravagant that he was always in debt.","start":154.52,"end":158.68,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-023","sourceId":"b3-021-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"After he was defeated by a boxer called Gentleman Jackson, he was quickly forgotten.","start":159.58,"end":165.36,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-021-024","sourceId":"b3-021-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"He was sent to prison for failing to pay his debts and died in poverty in 1836.","start":166.14,"end":172.43,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
