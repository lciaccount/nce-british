urceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The strike is due to begin on Tuesday.","start":22.43,"end":24.84,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-004","sourceId":"b2-084-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"No one knows how long it will last.","start":25.64,"end":27.81,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-005","sourceId":"b2-084-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The busmen have stated that the strike will continue until general agreement is reached about pay and working conditions.","start":28.82,"end":36.2,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-006","sourceId":"b2-084-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Most people believe that the strike will last for at least a week.","start":37.84,"end":41.65,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-007","sourceId":"b2-084-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Many owners of private cars are going to offer 'free rides' to people on their way to work.","start":43.22,"end":49.25,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-008","sourceId":"b2-084-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"This will relieve pressure on the trains to some extent.","start":50.36,"end":54.21,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-009","sourceId":"b2-084-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Meanwhile, a number of university students have volunteered to drive buses while the strike lasts.","start":54.84,"end":61.96,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-010","sourceId":"b2-084-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"All the students are expert drivers, but before they drive any of the buses, they will have to pass a special test.","start":62.98,"end":71.75,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-011","sourceId":"b2-084-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The students are going to take the test in two days' time.","start":72.44,"end":75.76,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-012","sourceId":"b2-084-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Even so, people are going to find it difficult to get to work.","start":76.982,"end":81.163,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-013","sourceId":"b2-084-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"But so far, the public has expressed its gratitude to the students in lettters to the Press.","start":81.75,"end":88.12,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-084-014","sourceId":"b2-084-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Only one or two people have objected that the students will drive too fast!","start":88.96,"end":93.39,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
