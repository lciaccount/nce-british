s","offset":57,"start":144.123,"end":144.262,"score":0.999},{"text":"impossible","offset":61,"start":144.322,"end":144.902,"score":0.999},{"text":"for","offset":72,"start":144.963,"end":145.062,"score":0.998},{"text":"the","offset":76,"start":145.083,"end":145.162,"score":0.995},{"text":"Cutty","offset":80,"start":145.243,"end":145.482,"score":0.744},{"text":"Sark","offset":86,"start":145.583,"end":145.822,"score":0.491},{"text":"to","offset":91,"start":145.882,"end":145.962,"score":0.999},{"text":"win.","offset":94,"start":146.042,"end":146.262,"score":0.999}],[{"text":"She","offset":0,"start":147.322,"end":147.402,"score":0.999},{"text":"arrived","offset":4,"start":147.463,"end":147.882,"score":0.98},{"text":"in","offset":12,"start":147.922,"end":147.982,"score":0.998},{"text":"England","offset":15,"start":148.083,"end":148.382,"score":1.0},{"text":"a","offset":23,"start":148.803,"end":148.822,"score":0.998},{"text":"week","offset":25,"start":148.963,"end":149.202,"score":0.836},{"text":"after","offset":30,"start":149.523,"end":149.762,"score":0.989},{"text":"the","offset":36,"start":149.782,"end":149.862,"score":0.995},{"text":"Thermopylae.","offset":40,"start":149.922,"end":150.462,"score":0.643}],[{"text":"Even","offset":0,"start":151.482,"end":151.702,"score":0.999},{"text":"this","offset":5,"start":151.782,"end":151.962,"score":0.992},{"text":"was","offset":10,"start":152.062,"end":152.182,"score":0.998},{"text":"remarkable,","offset":14,"start":152.243,"end":152.782,"score":0.959},{"text":"considering","offset":26,"start":153.343,"end":153.982,"score":0.986},{"text":"that","offset":38,"start":154.363,"end":154.502,"score":0.999},{"text":"she","offset":43,"start":154.542,"end":154.642,"score":0.991},{"text":"had","offset":47,"start":154.743,"end":154.862,"score":0.932},{"text":"had","offset":51,"start":154.903,"end":155.102,"score":0.993},{"text":"so","offset":55,"start":155.222,"end":155.322,"score":1.0},{"text":"many","offset":58,"start":155.442,"end":155.642,"score":1.0},{"text":"delays.","offset":63,"start":155.722,"end":156.222,"score":0.999}],[{"text":"There","offset":0,"start":156.903,"end":157.062,"score":0.98},{"text":"is","offset":6,"start":157.102,"end":157.182,"score":0.997},{"text":"no","offset":9,"start":157.243,"end":157.302,"score":0.999},{"text":"doubt","offset":12,"start":157.463,"end":157.742,"score":0.797},{"text":"that","offset":18,"start":158.162,"end":158.302,"score":0.973},{"text":"if","offset":23,"start":158.423,"end":158.502,"score":1.0},{"text":"she","offset":26,"start":158.542,"end":158.642,"score":1.0},{"text":"had","offset":30,"start":158.722,"end":158.862,"score":0.969},{"text":"not","offset":34,"start":158.942,"end":159.082,"score":0.999},{"text":"lost","offset":38,"start":159.183,"end":159.402,"score":0.999},{"text":"her","offset":43,"start":159.442,"end":159.542,"score":0.912},{"text":"rudder","offset":47,"start":159.642,"end":159.902,"score":0.883},{"text":"she","offset":54,"start":160.363,"end":160.462,"score":0.969},{"text":"would","offset":58,"start":160.523,"end":160.682,"score":0.983},{"text":"have","offset":64,"start":160.702,"end":160.862,"score":0.998},{"text":"won","offset":69,"start":160.922,"end":161.082,"score":0.945},{"text":"the","offset":73,"start":161.142,"end":161.222,"score":0.997},{"text":"race","offset":77,"start":161.322,"end":161.642,"score":0.984},{"text":"easily.","offset":82,"start":161.782,"end":162.142,"score":0.945}]],"cues":[{"id":"b3-025-001","sourceId":"b3-025-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"What piece of bad luck prevented the Cutty Sark from winning the race?","start":11.29,"end":16.2,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-002","sourceId":"b3-025-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"One of the most famous sailing ships of the nineteenth century, the Cutty Sark, can still be seen at Greenwich.","start":18.91,"end":26.12,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-003","sourceId":"b3-025-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"She stands on dry land and is visited by thousands of people each year.","start":26.86,"end":31.58,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-004","sourceId":"b3-025-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"She serves as an impressive reminder of the great ships of the past.","start":32.82,"end":37.14,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-005","sourceId":"b3-025-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"Before they were replaced by steamships, sailing vessels like the Cutty Sark were used to carry tea from China and wool from Australia.","start":39.07,"end":48.73,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-006","sourceId":"b3-025-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The Cutty Sark was one of the fastest sailing ships that has ever been built.","start":49.67,"end":54.3,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-007","sourceId":"b3-025-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The only other ship to match her was the Thermopylae.","start":55.05,"end":58.31,"score":0.858,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-025-008","sourceId":"b3-025-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"Both these ships set out from Shanghai on June 18th, 1872 on an exciting race to England.","start":59.07,"end":66.58,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-009","sourceId":"b3-025-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"This race, which went on for exactly four months, was the last of its kind.","start":67.53,"end":72.68,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-010","sourceId":"b3-025-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"It marked the end of the great tradition of ships with sails and the beginning of a new era.","start":73.41,"end":79.22,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-011-p01","sourceId":"b3-025-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"The first of the two ships to reach Java after the race had begun was the Thermopylae,","start":80.71,"end":86.02,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-011-p02","sourceId":"b3-025-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[17,28],"wordModel":"mms-fa","text":"but on the Indian Ocean, the Cutty Sark took the lead.","start":86.8,"end":89.97,"score":0.91,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-012","sourceId":"b3-025-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"It seemed certain that she would be the first ship home, but during the race she had a lot of bad luck.","start":90.7,"end":97.36,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-013","sourceId":"b3-025-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"In August, she was struck by a very heavy storm during which her rudder was torn away.","start":98.15,"end":103.5,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-014","sourceId":"b3-025-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The Cutty Sark rolled from side to side and it became impossible to steer her.","start":104.46,"end":109.62,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-015","sourceId":"b3-025-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"A temporary rudder was made on board from spare planks and it was fitted with great difficulty.","start":110.46,"end":116.05,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-016-p01","sourceId":"b3-025-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"This greatly reduced the speed of the ship,","start":116.82,"end":119.22,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-016-p02","sourceId":"b3-025-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[8,27],"wordModel":"english-ctc-fallback","text":"for there was a danger that if she travelled too quickly, this rudder would be torn away as well.","start":119.63,"end":125.39,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-017","sourceId":"b3-025-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Because of this, the Cutty Sark lost her lead.","start":126.41,"end":129.58,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-018-p01","sourceId":"b3-025-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"After crossing the Equator, the captain called in at a port to have a new rudder fitted,","start":130.51,"end":135.54,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-018-p02","sourceId":"b3-025-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[17,28],"wordModel":"english-ctc-fallback","text":"but by now the Thermopylae was over five hundred miles ahead.","start":136.04,"end":140.12,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-019","sourceId":"b3-025-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Though the new rudder was fitted at tremendous speed, it was impossible for the Cutty Sark to win.","start":140.99,"end":146.39,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-020","sourceId":"b3-025-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"She arrived in England a week after the Thermopylae.","start":147.23,"end":150.54,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-021","sourceId":"b3-025-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Even this was remarkable, considering that she had had so many delays.","start":151.38,"end":156.48,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-025-022","sourceId":"b3-025-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"There is no doubt that if she had not lost her rudder she would have won the race easily.","start":156.84,"end":162.45,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
