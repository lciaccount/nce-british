.0},{"text":"less","offset":51,"start":97.082,"end":97.263,"score":0.996},{"text":"exciting.","offset":56,"start":97.302,"end":97.983,"score":0.988}]],"cues":[{"id":"b2-056-001","sourceId":"b2-056-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"How fast did the winning car go?","start":13.04,"end":16.262,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-002","sourceId":"b2-056-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Once a year, a race is held for old cars.","start":18.99,"end":23.05,"score":0.835,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-003","sourceId":"b2-056-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"A lot of cars entered for this race last year and there was a great deal of excitement just before it began.","start":24.62,"end":32.17,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-004","sourceId":"b2-056-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"One of the most handsome cars was a Rolls-Royce Silver Ghost.","start":33.7,"end":39.14,"score":0.909,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-005","sourceId":"b2-056-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The most unusual car was a Benz which had only three wheels.","start":40.74,"end":45.56,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-006","sourceId":"b2-056-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"Built in 1885, it was the oldest car taking part.","start":46.463,"end":51.61,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-007","sourceId":"b2-056-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"After a great many loud explosions, the race began.","start":53.17,"end":57.5,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-008","sourceId":"b2-056-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Many of the cars broke down on the course and some drivers spent more time under their cars than in them!","start":58.78,"end":66.55,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-009","sourceId":"b2-056-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"A few cars, however, completed the race.","start":68.0,"end":70.84,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-010","sourceId":"b2-056-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The winning car reached a speed of forty miles an hour -- much faster than any of its rivals.","start":72.34,"end":79.97,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-011","sourceId":"b2-056-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"It sped downhill at the end of the race and its driver had a lot of trouble trying to stop it.","start":81.21,"end":88.03,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-012","sourceId":"b2-056-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The race gave everyone a great deal of pleasure.","start":89.18,"end":92.1,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-056-013","sourceId":"b2-056-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It was very different from modern car races but no less exciting.","start":92.94,"end":98.07,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
