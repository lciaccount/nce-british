?","start":13.03,"end":15.5,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-002","sourceId":"b2-006-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"I have just moved to a house in Bridge Street.","start":18.47,"end":22.37,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-003","sourceId":"b2-006-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Yesterday a beggar knocked at my door.","start":23.26,"end":26.16,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-004","sourceId":"b2-006-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He asked me for a meal and a glass of beer.","start":27.34,"end":30.76,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-005","sourceId":"b2-006-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"In return for this, the beggar stood on his head and sang songs.","start":32.06,"end":37.42,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-006","sourceId":"b2-006-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I gave him a meal.","start":38.35,"end":39.882,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-007","sourceId":"b2-006-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He ate the food and drank the beer.","start":40.86,"end":43.32,"score":0.873,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-008","sourceId":"b2-006-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Then he put a piece of cheese in his pocket and went away.","start":44.73,"end":48.68,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-009","sourceId":"b2-006-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Later a neighbour told me about him.","start":50.64,"end":54.062,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-010","sourceId":"b2-006-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"Everybody knows him.","start":55.03,"end":56.642,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-011","sourceId":"b2-006-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"His name is Percy Buttons.","start":57.36,"end":59.83,"score":0.883,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-006-012","sourceId":"b2-006-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"He calls at every house in the street once a month and always asks for a meal and a glass of beer.","start":60.28,"end":68.69,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
