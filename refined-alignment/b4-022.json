},{"text":"gunners","offset":73,"start":138.442,"end":138.842,"score":0.832},{"text":"using","offset":81,"start":138.923,"end":139.202,"score":0.958},{"text":"science","offset":87,"start":139.282,"end":139.722,"score":0.866},{"text":"to","offset":95,"start":139.743,"end":139.822,"score":0.997},{"text":"shatter","offset":98,"start":139.982,"end":140.282,"score":0.962},{"text":"men's","offset":106,"start":140.422,"end":140.722,"score":0.955},{"text":"bodies","offset":112,"start":140.803,"end":141.162,"score":0.999},{"text":"while,","offset":119,"start":141.523,"end":141.742,"score":0.968},{"text":"close","offset":126,"start":141.863,"end":142.122,"score":0.973},{"text":"at","offset":132,"start":142.162,"end":142.242,"score":0.999},{"text":"hand,","offset":135,"start":142.282,"end":142.602,"score":0.994},{"text":"surgeons","offset":141,"start":142.982,"end":143.442,"score":0.716},{"text":"use","offset":150,"start":143.523,"end":143.662,"score":0.997},{"text":"it","offset":154,"start":143.702,"end":143.762,"score":0.996},{"text":"to","offset":157,"start":143.803,"end":143.862,"score":0.998},{"text":"restore","offset":160,"start":143.922,"end":144.282,"score":0.955},{"text":"them?","offset":168,"start":144.303,"end":144.422,"score":0.998}],[{"text":"We","offset":0,"start":145.422,"end":145.502,"score":0.999},{"text":"have","offset":3,"start":145.583,"end":145.762,"score":0.998},{"text":"to","offset":8,"start":145.803,"end":145.862,"score":0.997},{"text":"ask","offset":11,"start":146.002,"end":146.202,"score":0.999},{"text":"ourselves","offset":15,"start":146.262,"end":146.702,"score":0.948},{"text":"very","offset":25,"start":146.743,"end":146.922,"score":1.0},{"text":"seriously","offset":30,"start":147.083,"end":147.522,"score":0.999},{"text":"what","offset":40,"start":148.002,"end":148.142,"score":0.92},{"text":"will","offset":45,"start":148.183,"end":148.322,"score":0.942},{"text":"happen","offset":50,"start":148.382,"end":148.662,"score":1.0},{"text":"if","offset":57,"start":148.982,"end":149.042,"score":0.999},{"text":"this","offset":60,"start":149.083,"end":149.222,"score":0.996},{"text":"twofold","offset":65,"start":149.322,"end":149.762,"score":0.926},{"text":"use","offset":73,"start":149.843,"end":150.002,"score":0.969},{"text":"of","offset":77,"start":150.023,"end":150.102,"score":0.999},{"text":"knowledge,","offset":80,"start":150.142,"end":150.582,"score":0.969},{"text":"with","offset":91,"start":150.903,"end":151.042,"score":0.989},{"text":"its","offset":96,"start":151.062,"end":151.162,"score":0.998},{"text":"ever-increasing","offset":100,"start":151.262,"end":151.942,"score":0.998},{"text":"power,","offset":116,"start":152.023,"end":152.302,"score":0.987},{"text":"continues.","offset":123,"start":152.702,"end":153.342,"score":0.978}]],"cues":[{"id":"b4-022-001","sourceId":"b4-022-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"In what two areas have people made no 'progress' at all?","start":11.32,"end":15.11,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-002","sourceId":"b4-022-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Why does the idea of progress loom so large in the modern world?","start":17.8,"end":22.5,"score":0.878,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-003","sourceId":"b4-022-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Surely because progress of a particular kind is actually taking place around us and is becoming more and more manifest.","start":23.6,"end":31.34,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-004","sourceId":"b4-022-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Although mankind has undergone no general improvement in intelligence or morality, it has made extraordinary progress in the accumulation of knowledge.","start":32.68,"end":42.33,"score":0.853,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-005","sourceId":"b4-022-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Knowledge began to increase as soon as the thoughts of one individual could be communicated to another by means of speech.","start":43.8,"end":51.23,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-006","sourceId":"b4-022-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"With the invention of writing, a great advance was made, for knowledge could then be not only communicated but also stored.","start":52.44,"end":61.12,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-007-p01","sourceId":"b4-022-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"Libraries made education possible, and education in its turn added to libraries:","start":62.23,"end":68.62,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-007-p02","sourceId":"b4-022-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[12,32],"wordModel":"mms-fa","text":"the growth of knowledge followed a kind of compound interest law, which was greatly enhanced by the invention of printing.","start":69.44,"end":76.9,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-008","sourceId":"b4-022-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"All this was comparatively slow until, with the coming of science, the tempo was suddenly raised.","start":78.32,"end":84.96,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-009","sourceId":"b4-022-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Then knowledge began to be accumulated according to a systematic plan.","start":86.07,"end":90.69,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-010","sourceId":"b4-022-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The trickle became a stream: the stream has now become a torrent.","start":91.723,"end":96.45,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-011","sourceId":"b4-022-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Moreover, as soon as new knowledge is acquired, it is now turned to practical account.","start":97.38,"end":103.0,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-012-p01","sourceId":"b4-022-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"What is called 'modern civilization' is not the result of a balanced development of all man's nature,","start":104.22,"end":110.81,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-012-p02","sourceId":"b4-022-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[17,25],"wordModel":"mms-fa","text":"but of accumulated knowledge applied to practical life.","start":111.062,"end":115.0,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-013","sourceId":"b4-022-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The problem now facing humanity is: What is going to be done with all this knowledge?","start":116.13,"end":121.34,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-014","sourceId":"b4-022-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"As is so often pointed out, knowledge is a two-edged weapon which can be used equally for good or evil.","start":122.04,"end":129.13,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-015","sourceId":"b4-022-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It is now being used indifferently for both.","start":130.2,"end":132.86,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-016-p01","sourceId":"b4-022-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"Could any spectacle, for instance, be more grimly whimsical than that of gunners using science to shatter men's bodies while, close at hand,","start":133.88,"end":142.68,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-016-p02","sourceId":"b4-022-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[23,29],"wordModel":"mms-fa","text":"surgeons use it to restore them?","start":142.89,"end":144.51,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-022-017","sourceId":"b4-022-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"We have to ask ourselves very seriously what will happen if this twofold use of knowledge, with its ever-increasing power, continues.","start":145.182,"end":153.43,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
