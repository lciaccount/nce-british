d":223.862,"score":0.952},{"text":"grave.","offset":143,"start":223.903,"end":224.382,"score":0.983}],[{"text":"If","offset":0,"start":225.303,"end":225.382,"score":0.998},{"text":"we","offset":3,"start":225.422,"end":225.502,"score":0.997},{"text":"could","offset":6,"start":225.542,"end":225.662,"score":0.866},{"text":"stay","offset":12,"start":225.702,"end":225.922,"score":0.999},{"text":"as","offset":17,"start":226.083,"end":226.182,"score":0.996},{"text":"vigorous","offset":20,"start":226.322,"end":226.802,"score":0.975},{"text":"as","offset":29,"start":227.062,"end":227.162,"score":0.977},{"text":"we","offset":32,"start":227.202,"end":227.282,"score":0.988},{"text":"are","offset":35,"start":227.403,"end":227.622,"score":0.868},{"text":"at","offset":39,"start":227.662,"end":227.742,"score":0.601},{"text":"twelve,","offset":42,"start":227.822,"end":228.222,"score":0.78},{"text":"it","offset":50,"start":228.903,"end":228.962,"score":0.994},{"text":"would","offset":53,"start":228.982,"end":229.122,"score":0.955},{"text":"take","offset":59,"start":229.162,"end":229.382,"score":0.992},{"text":"about","offset":64,"start":229.403,"end":229.662,"score":0.995},{"text":"700","offset":70,"start":229.822,"end":230.442,"score":0.852},{"text":"years","offset":74,"start":230.482,"end":230.802,"score":0.991},{"text":"for","offset":80,"start":230.903,"end":231.042,"score":0.759},{"text":"half","offset":84,"start":231.162,"end":231.402,"score":0.925},{"text":"of","offset":89,"start":231.442,"end":231.522,"score":0.995},{"text":"us","offset":92,"start":231.562,"end":231.682,"score":0.99},{"text":"to","offset":95,"start":231.722,"end":231.782,"score":0.993},{"text":"die,","offset":98,"start":231.843,"end":232.222,"score":0.967},{"text":"and","offset":103,"start":232.863,"end":233.022,"score":0.957},{"text":"another","offset":107,"start":233.142,"end":233.422,"score":0.95},{"text":"700","offset":115,"start":233.523,"end":234.082,"score":0.72},{"text":"for","offset":119,"start":234.382,"end":234.482,"score":0.941},{"text":"the","offset":123,"start":234.523,"end":234.602,"score":0.992},{"text":"survivors","offset":127,"start":234.722,"end":235.302,"score":0.877},{"text":"to","offset":137,"start":235.542,"end":235.622,"score":0.997},{"text":"be","offset":140,"start":235.662,"end":235.742,"score":0.998},{"text":"reduced","offset":143,"start":235.803,"end":236.302,"score":0.999},{"text":"by","offset":151,"start":236.442,"end":236.562,"score":0.997},{"text":"half","offset":154,"start":236.642,"end":236.842,"score":0.904},{"text":"again.","offset":159,"start":236.903,"end":237.202,"score":0.989}]],"cues":[{"id":"b4-037-001","sourceId":"b4-037-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"What is one of the most unpleasant discoveries we make about ourselves as we get older?","start":12.08,"end":17.95,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-002","sourceId":"b4-037-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"At the age of twelve years, the human body is at its most vigorous.","start":21.8,"end":26.53,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-003-p01","sourceId":"b4-037-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"It has yet to reach its full size and strength, and its owner his or her full intelligence:","start":27.46,"end":33.78,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-003-p02","sourceId":"b4-037-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[18,28],"wordModel":"mms-fa","text":"but at this age the likelihood of death is least.","start":34.523,"end":38.51,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-004-p01","sourceId":"b4-037-004","sourceIndex":3,"part":1,"parts":4,"wordRange":[0,11],"wordModel":"mms-fa","text":"Earlier, we were infants and young children, and consequently more vulnerable;","start":39.42,"end":44.94,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-004-p02","sourceId":"b4-037-004","sourceIndex":3,"part":2,"parts":4,"wordRange":[11,33],"wordModel":"mms-fa","text":"later, we shall undergo a progressive loss of our vigour and resistance which, though imperceptible at first will finally become so steep","start":46.02,"end":55.46,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-004-p03","sourceId":"b4-037-004","sourceIndex":3,"part":3,"parts":4,"wordRange":[33,39],"wordModel":"mms-fa","text":"that we can live no longer,","start":55.78,"end":57.42,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-004-p04","sourceId":"b4-037-004","sourceIndex":3,"part":4,"parts":4,"wordRange":[39,55],"wordModel":"mms-fa","text":"however well we look after ourselves, and however well society, and our doctors, look after us.","start":57.78,"end":63.61,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-005","sourceId":"b4-037-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This decline in vigour with the passing of time is called ageing.","start":64.74,"end":69.99,"score":0.904,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-006-p01","sourceId":"b4-037-006","sourceIndex":5,"part":1,"parts":4,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"It is one of the most unpleasant discoveries which we all make that we must decline in this way,","start":70.82,"end":77.29,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-006-p02","sourceId":"b4-037-006","sourceIndex":5,"part":2,"parts":4,"wordRange":[19,34],"wordModel":"english-ctc-fallback","text":"that if we escape wars, accidents and diseases we shall eventually 'die of old age',","start":77.622,"end":85.14,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-006-p03","sourceId":"b4-037-006","sourceIndex":5,"part":3,"parts":4,"wordRange":[34,48],"wordModel":"english-ctc-fallback","text":"and that this happens at a rate which differs little from person to person,","start":85.8,"end":90.23,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-006-p04","sourceId":"b4-037-006","sourceIndex":5,"part":4,"parts":4,"wordRange":[48,66],"wordModel":"english-ctc-fallback","text":"so that there are heavy odds in favour of our dying between the ages of 65 and 80.","start":90.82,"end":97.34,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-007","sourceId":"b4-037-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Some of us will die sooner, a few will live longer -- on into a ninth or tenth decade.","start":98.39,"end":104.88,"score":0.891,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-008-p01","sourceId":"b4-037-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"But the chances are against it,","start":105.45,"end":107.0,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-008-p02","sourceId":"b4-037-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[6,27],"wordModel":"mms-fa","text":"and there is a virtual limit on how long we can hope to remain alive, however lucky and robust we are.","start":107.48,"end":114.14,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-009","sourceId":"b4-037-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Normal people tend to forget this process unless and until they are reminded of it.","start":115.58,"end":121.06,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-010-p01","sourceId":"b4-037-010","sourceIndex":9,"part":1,"parts":4,"wordRange":[0,10],"wordModel":"mms-fa","text":"We are so familiar with the fact that man ages,","start":121.73,"end":124.57,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-010-p02","sourceId":"b4-037-010","sourceIndex":9,"part":2,"parts":4,"wordRange":[10,24],"wordModel":"mms-fa","text":"that people have for years assumed that the process of losing vigour with time,","start":124.7,"end":129.412,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-010-p03","sourceId":"b4-037-010","sourceIndex":9,"part":3,"parts":4,"wordRange":[24,34],"wordModel":"mms-fa","text":"of becoming more likely to die the older we get,","start":129.56,"end":132.28,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-010-p04","sourceId":"b4-037-010","sourceIndex":9,"part":4,"parts":4,"wordRange":[34,52],"wordModel":"mms-fa","text":"was something self-evident like the cooling of a hot kettle or the wearing-out of a pair of shoes.","start":132.7,"end":139.16,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-011-p01","sourceId":"b4-037-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"They have also assumed that all animals, and probably other organisms such as trees,","start":139.922,"end":145.86,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-011-p02","sourceId":"b4-037-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[14,27],"wordModel":"mms-fa","text":"or even the universe itself, must in the nature of things 'wear out'.","start":146.2,"end":151.26,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-012-p01","sourceId":"b4-037-012","sourceIndex":11,"part":1,"parts":3,"wordRange":[0,20],"wordModel":"mms-fa","text":"Most animals we commonly observe do in fact age as we do, if given the chance to live long enough;","start":152.44,"end":158.84,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-012-p02","sourceId":"b4-037-012","sourceIndex":11,"part":2,"parts":3,"wordRange":[20,30],"wordModel":"mms-fa","text":"and mechanical systems like a wound watch, or the sun,","start":159.38,"end":163.38,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-012-p03","sourceId":"b4-037-012","sourceIndex":11,"part":3,"parts":3,"wordRange":[30,57],"wordModel":"mms-fa","text":"do in fact run out of energy in accordance with the second law of thermodynamics (whether the whole universe does so is a moot point at present).","start":163.78,"end":173.59,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-013","sourceId":"b4-037-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"But these are not analogous to what happens when man ages.","start":174.47,"end":178.76,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-014","sourceId":"b4-037-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"A run-down watch is still a watch and can be rewound.","start":179.63,"end":183.42,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-015","sourceId":"b4-037-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"An old watch, by contrast, becomes so worn and unreliable that it eventually is not worth mending.","start":184.32,"end":190.68,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-016","sourceId":"b4-037-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"But a watch could never repair itself--it does not consist of living parts, only of metal, which wears away by friction.","start":191.31,"end":200.54,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-017","sourceId":"b4-037-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"We could, at one time, repair ourselves--well enough, at least, to overcome all but the most instantly fatal illnesses and accidents.","start":202.26,"end":211.54,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-018-p01","sourceId":"b4-037-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Between twelve and eighty years we gradually lose this power;","start":212.38,"end":216.25,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-018-p02","sourceId":"b4-037-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[10,29],"wordModel":"mms-fa","text":"an illness which at 12 would knock us over, at 80 can knock us out, and into our grave.","start":216.94,"end":224.46,"score":0.846,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-019-p01","sourceId":"b4-037-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"If we could stay as vigorous as we are at twelve, it would take about 700 years for half of us to die,","start":225.063,"end":232.3,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-037-019-p02","sourceId":"b4-037-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[23,35],"wordModel":"mms-fa","text":"and another 700 for the survivors to be reduced by half again.","start":232.8,"end":237.34,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
