"start":153.222,"end":153.302,"score":0.931},{"text":"the","offset":262,"start":153.322,"end":153.422,"score":0.855},{"text":"basis","offset":266,"start":153.482,"end":153.862,"score":0.97},{"text":"of","offset":272,"start":154.162,"end":154.202,"score":1.0},{"text":"a","offset":275,"start":154.303,"end":154.322,"score":0.999},{"text":"profitable","offset":277,"start":154.442,"end":154.962,"score":0.985},{"text":"fur","offset":288,"start":155.083,"end":155.282,"score":0.832},{"text":"industry.","offset":292,"start":155.363,"end":155.742,"score":0.996}],[{"text":"The","offset":0,"start":156.982,"end":157.062,"score":0.993},{"text":"question","offset":4,"start":157.142,"end":157.522,"score":0.992},{"text":"became","offset":13,"start":157.562,"end":157.942,"score":0.999},{"text":"one","offset":20,"start":158.363,"end":158.562,"score":0.998},{"text":"of","offset":24,"start":158.623,"end":158.702,"score":0.998},{"text":"whether","offset":27,"start":158.762,"end":159.002,"score":0.971},{"text":"Man","offset":35,"start":159.102,"end":159.422,"score":0.999},{"text":"could","offset":39,"start":159.542,"end":159.702,"score":0.986},{"text":"control","offset":45,"start":159.722,"end":160.102,"score":0.999},{"text":"the","offset":53,"start":160.142,"end":160.222,"score":0.988},{"text":"disease","offset":57,"start":160.262,"end":160.782,"score":0.94},{"text":"he","offset":65,"start":161.102,"end":161.182,"score":0.914},{"text":"had","offset":68,"start":161.262,"end":161.402,"score":0.997},{"text":"invented.","offset":72,"start":161.463,"end":161.962,"score":0.999}]],"cues":[{"id":"b4-017-001","sourceId":"b4-017-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"What factor helped to spread the disease of myxomatosis?","start":12.9,"end":17.16,"score":0.915,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-002","sourceId":"b4-017-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"In the early days of the settlement of Australia, enterprising settlers unwisely introduced the European rabbit.","start":19.86,"end":27.32,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-003","sourceId":"b4-017-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"This rabbit had no natural enemies in the Antipodes, so that it multiplied with that promiscuous abandon characteristic of rabbits.","start":28.32,"end":38.26,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-004","sourceId":"b4-017-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"It overran a whole continent.","start":39.4,"end":41.15,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-005","sourceId":"b4-017-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"It caused devastation by burrowing and by devouring the herbage which might have maintained millions of sheep and cattle.","start":41.79,"end":49.74,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-006","sourceId":"b4-017-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Scientists discovered that this particular variety of rabbit (and apparently no other animal) was susceptible to a fatal virus disease, myxomatosis.","start":50.88,"end":62.1,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-007","sourceId":"b4-017-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"By infecting animals and letting them loose in the burrows, local epidemics of this disease could be created.","start":63.21,"end":70.0,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-008","sourceId":"b4-017-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,26],"wordModel":"mms-fa","text":"Later it was found that there was a type of mosquito which acted as the carrier of this disease and passed it on to the rabbits.","start":71.18,"end":79.44,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-009","sourceId":"b4-017-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"So while the rest of the world was trying to get rid of mosquitoes, Australia was encouraging this one.","start":80.142,"end":86.72,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-010","sourceId":"b4-017-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It effectively spread the disease all over the continent and drastically reduced the rabit population.","start":87.86,"end":93.97,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-011-p01","sourceId":"b4-017-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"It later became apparent that rabbits were developing a degree of resistance to this disease,","start":95.06,"end":100.68,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-011-p02","sourceId":"b4-017-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[15,26],"wordModel":"mms-fa","text":"so that the rabbit population was unlikely to be completely exterminated.","start":101.122,"end":105.9,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-012","sourceId":"b4-017-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"There were hopes, however, that the problem of the rabbit would become manageable.","start":106.94,"end":111.66,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-013","sourceId":"b4-017-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Ironically, Europe, which had bequeathed the rabbit as a pest to Australia, acquired this man-made disease as a pestilence.","start":113.14,"end":121.8,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-014","sourceId":"b4-017-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A French physician decided to get rid of the wild rabbits on his own estate and introduced myxomatosis.","start":122.69,"end":129.43,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-015","sourceId":"b4-017-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"It did not, however, remain within the confines of this estate.","start":130.25,"end":133.94,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-016-p01","sourceId":"b4-017-016","sourceIndex":15,"part":1,"parts":3,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"It spread through France, where wild rabbits are not generally regarded as a pest but as a sport and a useful food supply,","start":134.75,"end":143.54,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-016-p02","sourceId":"b4-017-016","sourceIndex":15,"part":2,"parts":3,"wordRange":[23,40],"wordModel":"english-ctc-fallback","text":"and it spread to Britain where wild rabbits are regarded as a pest but where domesticated rabbits,","start":143.99,"end":150.48,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-016-p03","sourceId":"b4-017-016","sourceIndex":15,"part":3,"parts":3,"wordRange":[40,53],"wordModel":"english-ctc-fallback","text":"equally susceptible to the disease, are the basis of a profitable fur industry.","start":150.94,"end":155.92,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-017-017","sourceId":"b4-017-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The question became one of whether Man could control the disease he had invented.","start":156.92,"end":162.04,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
