d":200.102,"score":0.989},{"text":"taking","offset":167,"start":200.162,"end":200.482,"score":0.997},{"text":"time","offset":174,"start":200.542,"end":200.822,"score":0.954},{"text":"off","offset":179,"start":200.863,"end":201.002,"score":0.89},{"text":"from","offset":183,"start":201.062,"end":201.242,"score":0.964},{"text":"living","offset":188,"start":201.343,"end":201.642,"score":0.999},{"text":"with","offset":195,"start":201.762,"end":201.922,"score":0.99},{"text":"himself,","offset":200,"start":201.942,"end":202.402,"score":0.998},{"text":"from","offset":209,"start":203.102,"end":203.242,"score":0.996},{"text":"the","offset":214,"start":203.262,"end":203.342,"score":0.964},{"text":"search","offset":218,"start":203.422,"end":203.702,"score":0.926},{"text":"for","offset":225,"start":203.782,"end":203.922,"score":0.988},{"text":"what","offset":229,"start":204.282,"end":204.442,"score":0.952},{"text":"his","offset":234,"start":204.743,"end":204.962,"score":0.996},{"text":"world","offset":238,"start":205.042,"end":205.282,"score":0.999},{"text":"contains","offset":244,"start":205.343,"end":205.882,"score":0.998},{"text":"at","offset":253,"start":206.262,"end":206.362,"score":0.995},{"text":"its","offset":256,"start":206.422,"end":206.542,"score":0.98},{"text":"inmost","offset":260,"start":206.782,"end":207.182,"score":0.996},{"text":"point.","offset":267,"start":207.222,"end":207.522,"score":0.998}]],"cues":[{"id":"b4-039-001","sourceId":"b4-039-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"How do professional writers ignore what they were taught at school about writing?","start":11.78,"end":17.23,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-002-p01","sourceId":"b4-039-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"I have known very few writers, but those I have known and whom I respect,","start":19.9,"end":24.8,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-002-p02","sourceId":"b4-039-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[15,34],"wordModel":"mms-fa","text":"confess at once that they have little idea where they are going when they first set pen to paper.","start":25.102,"end":31.76,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-003-p01","sourceId":"b4-039-003","sourceIndex":2,"part":1,"parts":3,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"They have a character, perhaps two;","start":33.24,"end":35.34,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-003-p02","sourceId":"b4-039-003","sourceIndex":2,"part":2,"parts":3,"wordRange":[6,29],"wordModel":"english-ctc-fallback","text":"they are in that condition of eager discomfort which passes for inspiration all admit radical changes of destination once the journey has begun;","start":35.92,"end":46.41,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-003-p03","sourceId":"b4-039-003","sourceIndex":2,"part":3,"parts":3,"wordRange":[29,51],"wordModel":"english-ctc-fallback","text":"one, to my certain knowledge, spent nine months on a novel about Kashmir, then reset the whole thing in the Scottish Highlands.","start":47.663,"end":56.52,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-004","sourceId":"b4-039-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"I never heard of anyone making a 'skeleton', as we were taught at school.","start":57.81,"end":62.41,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-005-p01","sourceId":"b4-039-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"In the breaking and remaking, in the timing interweaving, beginning afresh,","start":63.36,"end":69.57,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-005-p02","sourceId":"b4-039-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[11,30],"wordModel":"mms-fa","text":"the writer comes to discern things in his material which were not consciously in his mind when he began.","start":69.902,"end":76.52,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-006","sourceId":"b4-039-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"This organic process, often leading to moments of extraordinary self-discovery, is of an indescribable fascination.","start":77.6,"end":86.68,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-007-p01","sourceId":"b4-039-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"A blurred image appears; he adds a brushstroke and another and it is gone but something was there,","start":88.34,"end":96.81,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-007-p02","sourceId":"b4-039-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[18,28],"wordModel":"mms-fa","text":"and he will not rest till he has captured it.","start":97.34,"end":100.09,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-008","sourceId":"b4-039-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Sometimes the yeast within a writer outlives a book he has written.","start":101.15,"end":106.07,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-009-p01","sourceId":"b4-039-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"I have heard of writers who read nothing but their own books;","start":107.33,"end":110.8,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-009-p02","sourceId":"b4-039-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[12,31],"wordModel":"mms-fa","text":"like adolescents they stand before the mirror, and still cannot fathom the exact outline of the vision before them.","start":111.383,"end":118.87,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-010-p01","sourceId":"b4-039-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"For the same reason, writers talk interminably about their own books,","start":120.0,"end":124.94,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-010-p02","sourceId":"b4-039-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"mms-fa","text":"winkling out hidden meanings, super-imposing new ones, begging response from those around them.","start":125.86,"end":132.83,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-011","sourceId":"b4-039-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Of course a writer doing this is misunderstood: he might as well try to explain a crime or a love affair.","start":133.503,"end":141.06,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-012","sourceId":"b4-039-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"He is also, incidentally, an unforgivable bore.","start":141.72,"end":145.23,"score":0.876,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-013-p01","sourceId":"b4-039-013","sourceIndex":12,"part":1,"parts":3,"wordRange":[0,11],"wordModel":"mms-fa","text":"This temptation to cover the distance between himself and the reader,","start":146.55,"end":150.74,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-013-p02","sourceId":"b4-039-013","sourceIndex":12,"part":2,"parts":3,"wordRange":[11,29],"wordModel":"mms-fa","text":"to study his image in the sight of those who do not know him, can be his undoing:","start":150.962,"end":156.77,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-013-p03","sourceId":"b4-039-013","sourceIndex":12,"part":3,"parts":3,"wordRange":[29,36],"wordModel":"mms-fa","text":"he has begun to write to please.","start":157.52,"end":159.78,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-014-p01","sourceId":"b4-039-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"A young English writer made the pertinent observation a year or two back that the talent goes into the first draft,","start":160.76,"end":168.72,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-014-p02","sourceId":"b4-039-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[21,29],"wordModel":"mms-fa","text":"and the art into the drafts that follow.","start":169.3,"end":171.65,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-015-p01","sourceId":"b4-039-015","sourceIndex":14,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"For this reason also the writer, like any other artist, has no resting place,","start":172.67,"end":177.9,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-015-p02","sourceId":"b4-039-015","sourceIndex":14,"part":2,"parts":2,"wordRange":[14,35],"wordModel":"mms-fa","text":"no crowd or movement in which he may take comfort, no judgment from outside which can replace the judgment from within.","start":178.42,"end":186.88,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-016-p01","sourceId":"b4-039-016","sourceIndex":15,"part":1,"parts":3,"wordRange":[0,11],"wordModel":"mms-fa","text":"A writer makes order out of the anarchy of his heart;","start":187.91,"end":191.36,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-016-p02","sourceId":"b4-039-016","sourceIndex":15,"part":2,"parts":3,"wordRange":[11,30],"wordModel":"mms-fa","text":"he submits himself to a more ruthless discipline than any critic dreamed of, and when he flirts with fame,","start":192.06,"end":199.52,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-039-016-p03","sourceId":"b4-039-016","sourceIndex":15,"part":3,"parts":3,"wordRange":[30,51],"wordModel":"mms-fa","text":"he is taking time off from living with himself, from the search for what his world contains at its inmost point.","start":199.72,"end":207.6,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
