gValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-047-006","sourceId":"b2-047-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Though Mr.Thompson had turned the lights off before he went to bed, they were on in the morning.","start":52.46,"end":59.08,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-047-007","sourceId":"b2-047-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"He also said that he had found five empty whisky bottles which the ghost must have drunk the night before.","start":60.5,"end":68.28,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-047-008","sourceId":"b2-047-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"When I suggested that some villagers must have come in for a free drink, Mr.Thompson shook his head.","start":69.93,"end":77.92,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-047-009","sourceId":"b2-047-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"The villagers have told him that they will not accept the pub even if he gives it away.","start":78.922,"end":84.1,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
