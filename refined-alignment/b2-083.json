xt":"retired","offset":7,"start":102.022,"end":102.663,"score":0.994},{"text":"from","offset":15,"start":102.722,"end":102.863,"score":0.999},{"text":"political","offset":20,"start":102.922,"end":103.403,"score":0.999},{"text":"life","offset":30,"start":103.502,"end":103.843,"score":0.992},{"text":"and","offset":35,"start":104.422,"end":104.583,"score":0.949},{"text":"gone","offset":39,"start":104.722,"end":105.023,"score":0.764},{"text":"to","offset":44,"start":105.102,"end":105.183,"score":0.997},{"text":"live","offset":47,"start":105.282,"end":105.543,"score":0.998},{"text":"abroad!'","offset":52,"start":105.662,"end":106.263,"score":0.957}],[{"text":"'I","offset":0,"start":108.263,"end":108.283,"score":1.0},{"text":"know,'","offset":3,"start":108.362,"end":108.583,"score":0.952},{"text":"answered","offset":10,"start":109.522,"end":109.783,"score":0.97},{"text":"Patrick,'","offset":19,"start":109.843,"end":110.263,"score":0.976},{"text":"but","offset":29,"start":110.983,"end":111.083,"score":1.0},{"text":"I","offset":33,"start":111.203,"end":111.223,"score":1.0},{"text":"love","offset":35,"start":111.522,"end":111.803,"score":0.997},{"text":"to","offset":40,"start":111.922,"end":112.003,"score":1.0},{"text":"hear","offset":43,"start":112.062,"end":112.243,"score":0.998},{"text":"you","offset":48,"start":112.302,"end":112.403,"score":0.96},{"text":"say","offset":52,"start":112.562,"end":112.783,"score":0.983},{"text":"it!'","offset":56,"start":112.882,"end":112.923,"score":0.996}]],"cues":[{"id":"b2-083-001","sourceId":"b2-083-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Why did Patrick keep on asking the same question?","start":13.04,"end":17.68,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-002","sourceId":"b2-083-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The former Prime Minister, Mr. Wentworth Lane, was defeated in the recent elections.","start":20.44,"end":27.8,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-003","sourceId":"b2-083-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He is now retiring from political life and has gone abroad.","start":28.88,"end":32.72,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-004","sourceId":"b2-083-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"My friend, Patrick, has always been a fanatical opponent of Mr. Lane's Radical Progressive Party.","start":34.34,"end":41.97,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-005","sourceId":"b2-083-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"After the elections, Patrick went to the former Prime Minister's house.","start":43.47,"end":48.48,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-006-p01","sourceId":"b2-083-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"When he asked if Mr. Lane lived there,","start":49.84,"end":52.56,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-006-p02","sourceId":"b2-083-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"mms-fa","text":"the policeman on duty told him that since his defeat, the ex-Prime Minister had gone abroad.","start":53.5,"end":59.09,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-007","sourceId":"b2-083-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"On the following day Patrick went to the house again.","start":61.16,"end":65.15,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-008","sourceId":"b2-083-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The same policeman was just walking slowly past the entrance, when Patrick asked the same question.","start":66.12,"end":72.45,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-009","sourceId":"b2-083-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Though a little suspicious this time the policeman gave him the same answer.","start":74.51,"end":79.54,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-010","sourceId":"b2-083-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The day after, Patrick went to the house once more and asked exactly the same question.","start":80.803,"end":87.38,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-011","sourceId":"b2-083-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This time, the policeman lost his temper.","start":88.44,"end":90.74,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-012","sourceId":"b2-083-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"'I told you yesterday and the day before yesterday,' he shouted, 'Mr.Lane was defeated in the elections.","start":91.95,"end":100.89,"score":0.976,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-083-013","sourceId":"b2-083-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He has retired from political life and gone to live abroad!'","start":101.22,"end":106.39,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-083-014","sourceId":"b2-083-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"'I know,' answered Patrick,' but I love to hear you say it!'","start":108.16,"end":113.14,"score":0.986,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
