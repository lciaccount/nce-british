part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"I rang the bell and was not surprised to see that Hugh was still as fat as ever.","start":55.64,"end":61.91,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-008","sourceId":"b2-051-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"He led me into his room and hurriedly hid a large parcel under his desk.","start":63.13,"end":69.09,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-009","sourceId":"b2-051-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It was obvious that he was very embarrassed.","start":70.52,"end":73.61,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-010","sourceId":"b2-051-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"When I asked him what he was doing, he smiled guiltily and then put the parcel on the desk.","start":74.76,"end":82.23,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-011","sourceId":"b2-051-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"He explained that his diet was so strict that he had to reward himself occasionally.","start":83.36,"end":89.65,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-012","sourceId":"b2-051-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Then he showed me the contents of the parcel.","start":91.04,"end":93.9,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-051-013","sourceId":"b2-051-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It contained five large bars of chocolate and three bags of sweets!","start":94.83,"end":101.25,"score":0.931,"timingValid":true,"needsReview"