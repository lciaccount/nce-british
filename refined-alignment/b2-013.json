ue,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-002","sourceId":"b2-013-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"The Greenwood Boys are a group of pop singers.","start":18.68,"end":21.91,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-003","sourceId":"b2-013-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"At present, they are visiting all parts of the country.","start":23.34,"end":27.36,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-004","sourceId":"b2-013-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"They will be arriving here tomorrow.","start":28.6,"end":31.03,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-005","sourceId":"b2-013-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"They will be coming by train and most of the young people in the town will be meeting them at the station.","start":32.46,"end":39.81,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-006","sourceId":"b2-013-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Tomorrow evening they will be singing at the Workers' Club.","start":41.28,"end":45.04,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-007","sourceId":"b2-013-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The Greenwood Boys will be staying for five days.","start":46.64,"end":50.13,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-008","sourceId":"b2-013-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"During this time, they will give five performances.","start":50.87,"end":54.79,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-009","sourceId":"b2-013-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"As usual, the police will have a difficult time.","start":55.84,"end":59.8,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-010","sourceId":"b2-013-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"They will be trying to keep order.","start":61.36,"end":63.61,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-013-011","sourceId":"b2-013-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It is always the same on these occasions.","start":64.44,"end":67.38,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
