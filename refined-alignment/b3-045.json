ndex":0,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Does the writer think the parents were lucky or unlucky to gain prosperity in this way?","start":12.33,"end":18.05,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-002","sourceId":"b3-045-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"Why?","start":18.49,"end":19.05,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-003","sourceId":"b3-045-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"In democratic countries any efforts to restrict the freedom of the press are rightly condemned.","start":21.68,"end":27.88,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-004","sourceId":"b3-045-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"However, this freedom can easily be abused.","start":28.84,"end":32.24,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-005","sourceId":"b3-045-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Stories about people often attract far more public attention than political events.","start":33.07,"end":38.31,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-006","sourceId":"b3-045-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Though we may enjoy reading about the lives of others, it is extremely doubtful whether we would equally enjoy reading about ourselves.","start":39.3,"end":47.56,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-007","sourceId":"b3-045-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Acting on the contention that facts are sacred, reporters can cause untold suffering to individuals by publishing details about their private lives.","start":48.46,"end":58.82,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-008-p01","sourceId":"b3-045-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Newspapers exert such tremendous influence that they can not only bring about major changes to the lives of ordinary people","start":59.51,"end":67.37,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-008-p02","sourceId":"b3-045-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[20,26],"wordModel":"mms-fa","text":"but can even overthrow a government.","start":67.74,"end":69.84,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-009","sourceId":"b3-045-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The story of a poor family that acquired fame and fortune overnight, dramatically illustrates the power of the press.","start":70.84,"end":78.06,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-010","text":"The family lived in Aberdeen, a small town of 23, 000 inhabitants in South Dakota.","start":78.793,"end":85.123,"score":0.932,"timingValid":true,"needsReview":true,"sourceId":"b3-045-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-045-011","sourceId":"b3-045-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"As the parents had five children, life was a perpetual struggle against poverty.","start":85.7,"end":90.55,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-012","sourceId":"b3-045-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"They were expecting their sixth child and were faced with even more pressing economic problems.","start":91.26,"end":96.66,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-013","sourceId":"b3-045-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"If they had only had one more child, the fact would have passed unnoticed.","start":97.46,"end":101.92,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-014","sourceId":"b3-045-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"They would have continued to struggle against economic odds and would have lived in obscurity.","start":102.46,"end":107.64,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-015","sourceId":"b3-045-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"But they suddenly became the parents of quintuplets, four girls and a boy, an event which radically changed their lives.","start":108.42,"end":116.85,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-016","sourceId":"b3-045-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The day after the birth of the five children, an aeroplane arrived in Aberdeen bringing sixty reporters and photographers.","start":117.62,"end":125.93,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-017","sourceId":"b3-045-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The rise to fame was swift.","start":127.18,"end":129.09,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-018","sourceId":"b3-045-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Television cameras and newspapers carried the news to everyone in the country.","start":129.74,"end":134.71,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-019","sourceId":"b3-045-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Newspapers and magazines offered the family huge sums for the exclusive rights to publish stories and photographs.","start":135.6,"end":143.09,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-020","sourceId":"b3-045-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Gifts poured in not only from unknown people, but from baby food and soap manufacturers who wished to advertise their products.","start":144.28,"end":152.75,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-021","sourceId":"b3-045-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The old farmhouse the family lived in was to be replaced by a new $500, 000 home.","start":153.42,"end":159.51,"score":0.865,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-045-022","sourceId":"b3-045-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Reporters kept pressing for interviews so lawyers had to be employed to act as spokesmen for the family at press conferences.","start":160.2,"end":167.38,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-023","sourceId":"b3-045-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"While the five babies were still quietly sleeping in oxygen tents in a hospital nursery, their parents were paying the price for fame.","start":168.08,"end":176.49,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-024","sourceId":"b3-045-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It would never again be possible for them to lead normal lives.","start":177.06,"end":180.96,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-025","sourceId":"b3-045-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"They had become the victims of commercialization, for their names had acquired a market value.","start":181.72,"end":187.97,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-045-026","sourceId":"b3-045-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Instead of being five new family members, these children had immediately become a commodity.","start":188.51,"end":195.26,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
