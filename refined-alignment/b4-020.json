":"an","offset":127,"start":149.803,"end":149.882,"score":0.996},{"text":"improved","offset":130,"start":149.922,"end":150.422,"score":0.871},{"text":"formula.","offset":139,"start":150.442,"end":150.822,"score":0.998}],[{"text":"Be","offset":0,"start":152.062,"end":152.162,"score":0.999},{"text":"that","offset":3,"start":152.282,"end":152.482,"score":0.993},{"text":"as","offset":8,"start":152.602,"end":152.702,"score":0.993},{"text":"it","offset":11,"start":152.762,"end":152.842,"score":0.997},{"text":"may,","offset":14,"start":152.922,"end":153.142,"score":1.0},{"text":"the","offset":19,"start":153.743,"end":153.842,"score":0.993},{"text":"nerve","offset":23,"start":153.942,"end":154.242,"score":0.944},{"text":"poison","offset":29,"start":154.282,"end":154.662,"score":0.965},{"text":"does","offset":36,"start":154.843,"end":155.022,"score":0.934},{"text":"its","offset":41,"start":155.083,"end":155.202,"score":0.996},{"text":"business","offset":45,"start":155.262,"end":155.622,"score":0.964},{"text":"with","offset":54,"start":155.942,"end":156.122,"score":0.999},{"text":"man","offset":59,"start":156.202,"end":156.482,"score":1.0},{"text":"far","offset":63,"start":156.843,"end":157.042,"score":0.999},{"text":"more","offset":67,"start":157.123,"end":157.282,"score":0.939},{"text":"quickly","offset":72,"start":157.343,"end":157.702,"score":0.995},{"text":"than","offset":80,"start":158.002,"end":158.142,"score":0.991},{"text":"the","offset":85,"start":158.183,"end":158.262,"score":0.993},{"text":"blood","offset":89,"start":158.363,"end":158.582,"score":0.998},{"text":"poison.","offset":95,"start":158.642,"end":159.022,"score":0.963}],[{"text":"This,","offset":0,"start":160.123,"end":160.302,"score":0.998},{"text":"however,","offset":6,"start":160.363,"end":160.702,"score":0.999},{"text":"means","offset":15,"start":160.782,"end":161.042,"score":0.977},{"text":"nothing.","offset":21,"start":161.123,"end":161.442,"score":0.972}],[{"text":"Snakes","offset":0,"start":162.303,"end":162.582,"score":0.976},{"text":"did","offset":7,"start":162.782,"end":162.922,"score":0.998},{"text":"not","offset":11,"start":162.982,"end":163.122,"score":0.985},{"text":"acquire","offset":15,"start":163.142,"end":163.502,"score":0.993},{"text":"their","offset":23,"start":163.502,"end":163.642,"score":0.972},{"text":"poison","offset":29,"start":163.722,"end":164.102,"score":0.955},{"text":"for","offset":36,"start":164.422,"end":164.542,"score":0.976},{"text":"use","offset":40,"start":164.662,"end":164.842,"score":0.925},{"text":"against","offset":44,"start":164.882,"end":165.202,"score":0.966},{"text":"man","offset":52,"start":165.262,"end":165.522,"score":0.996},{"text":"but","offset":56,"start":166.142,"end":166.262,"score":1.0},{"text":"for","offset":60,"start":166.303,"end":166.402,"score":0.947},{"text":"use","offset":64,"start":166.542,"end":166.702,"score":0.996},{"text":"against","offset":68,"start":166.762,"end":167.042,"score":0.986},{"text":"prey","offset":76,"start":167.083,"end":167.402,"score":0.75},{"text":"such","offset":81,"start":167.542,"end":167.722,"score":1.0},{"text":"as","offset":86,"start":167.782,"end":167.882,"score":0.999},{"text":"rats","offset":89,"start":168.002,"end":168.342,"score":0.938},{"text":"and","offset":94,"start":168.482,"end":168.602,"score":0.999},{"text":"mice,","offset":98,"start":168.662,"end":169.042,"score":0.93},{"text":"and","offset":104,"start":169.762,"end":169.862,"score":0.999},{"text":"the","offset":108,"start":169.882,"end":169.962,"score":0.98},{"text":"effects","offset":112,"start":170.002,"end":170.462,"score":0.998},{"text":"on","offset":120,"start":170.662,"end":170.742,"score":0.999},{"text":"these","offset":123,"start":170.803,"end":171.142,"score":0.972},{"text":"of","offset":129,"start":171.183,"end":171.242,"score":0.999},{"text":"viperine","offset":132,"start":171.403,"end":171.942,"score":0.687},{"text":"poison","offset":141,"start":172.002,"end":172.382,"score":0.956},{"text":"is","offset":148,"start":172.822,"end":172.922,"score":0.999},{"text":"almost","offset":151,"start":173.083,"end":173.482,"score":0.999},{"text":"immediate.","offset":158,"start":173.642,"end":174.222,"score":0.945}]],"cues":[{"id":"b4-020-001","sourceId":"b4-020-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What are the two different ways in which snake poison acts?","start":11.1,"end":14.56,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-002","sourceId":"b4-020-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"How in came about that snakes manufactured poison is a mystery.","start":17.09,"end":21.13,"score":0.802,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-003","sourceId":"b4-020-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Over the periods their saliva, a mild, digestive juice like our own, was converted into a poison that defies analysis even today.","start":22.11,"end":31.45,"score":0.918,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-004-p01","sourceId":"b4-020-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"It was not forced upon them by the survival competition;","start":32.94,"end":35.86,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-004-p02","sourceId":"b4-020-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[10,30],"wordModel":"mms-fa","text":"they could have caught and lived on prey without using poison, just as the thousands of non-poisonous snakes still do.","start":36.423,"end":43.64,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-005-p01","sourceId":"b4-020-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"Poison to a snake is merely a luxury;","start":44.92,"end":47.57,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-005-p02","sourceId":"b4-020-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[8,25],"wordModel":"mms-fa","text":"it enables it to get its food with very little effort, no more effort than one bite.","start":48.43,"end":54.16,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-006","sourceId":"b4-020-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"And why only snakes?","start":55.06,"end":56.74,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-007-p01","sourceId":"b4-020-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"Cats, for instance, would be greatly helped;","start":57.76,"end":60.21,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-007-p02","sourceId":"b4-020-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[7,26],"wordModel":"mms-fa","text":"no running fights with large, fierce rats or tussles with grown rabbits--just a bite and no more effort needed.","start":60.77,"end":68.52,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-008","sourceId":"b4-020-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"In fact, it would be an assistance to all carnivores though it would be a two-edged weapon when they fought each other.","start":69.68,"end":76.84,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-009","sourceId":"b4-020-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"But, of the vertebrates unpredictable Nature selected only snakes (and one lizard).","start":77.603,"end":83.76,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-010","sourceId":"b4-020-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"One wonders also why Nature, with some snakes concocted poison of such extreme potency.","start":84.82,"end":91.6,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-011","sourceId":"b4-020-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"In the conversion of saliva into poison, one might suppose that a fixed process took place.","start":92.98,"end":98.86,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-012-p01","sourceId":"b4-020-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"It did not; some snakes manufactured a poison different in every respect from that of others,","start":99.54,"end":105.54,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-012-p02","sourceId":"b4-020-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[16,27],"wordModel":"mms-fa","text":"as different as arsenic is from strychnine, and having different effects.","start":106.023,"end":111.17,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-013","sourceId":"b4-020-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"One poison acts on the nerves, the other on the blood.","start":112.23,"end":116.14,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-014","sourceId":"b4-020-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The makers of the nerve poison include the mambas and the cobras and their venom is called neurotoxic.","start":117.16,"end":124.89,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-015","sourceId":"b4-020-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Vipers (adders) and rattlesnakes manufacture the blood poison, which is known as haemolytic.","start":125.86,"end":133.47,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-016","sourceId":"b4-020-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Both poisons are unpleasant, but by far the more unpleasant is the blood poison.","start":134.383,"end":140.23,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-017-p01","sourceId":"b4-020-017","sourceIndex":16,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"It is said that the nerve poison is the more primitive of the two,","start":141.4,"end":145.21,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-017-p02","sourceId":"b4-020-017","sourceIndex":16,"part":2,"parts":2,"wordRange":[14,29],"wordModel":"mms-fa","text":"that the blood poison is, so to speak, a newer product from an improved formula.","start":145.642,"end":150.97,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-018","sourceId":"b4-020-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Be that as it may, the nerve poison does its business with man far more quickly than the blood poison.","start":151.92,"end":159.15,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-019","sourceId":"b4-020-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"This, however, means nothing.","start":159.99,"end":161.52,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-020-p01","sourceId":"b4-020-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Snakes did not acquire their poison for use against man but for use against prey such as rats and mice,","start":162.063,"end":169.12,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-020-020-p02","sourceId":"b4-020-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[20,31],"wordModel":"mms-fa","text":"and the effects on these of viperine poison is almost immediate.","start":169.7,"end":174.3,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
