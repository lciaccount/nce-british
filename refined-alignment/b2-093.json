18.77,"end":23.66,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-002-p02","sourceId":"b2-093-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[13,27],"wordModel":"mms-fa","text":"was presented to the USA in the nineteenth century by the people of France.","start":24.58,"end":31.53,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-003","sourceId":"b2-093-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"The great statue, which was designed by the sculptor Auguste Bartholdi, took ten years to complete.","start":32.76,"end":42.45,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-004","sourceId":"b2-093-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The actual figure was made of copper supported by a metal framework which had been especially constructed by Eiffel.","start":44.41,"end":55.04,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-005-p01","sourceId":"b2-093-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Before it could be transported to the United States,","start":56.23,"end":60.11,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-005-p02","sourceId":"b2-093-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[9,24],"wordModel":"mms-fa","text":"a site had to be found for it and a pedestal had to be built.","start":60.66,"end":65.48,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-006","sourceId":"b2-093-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The site chosen was an island at the entrance of New York Harbour.","start":67.36,"end":72.39,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-007","sourceId":"b2-093-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"By 1884, a statue which was 151 feet tall had been erected in Paris.","start":73.66,"end":82.69,"score":0.953,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-093-008","sourceId":"b2-093-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The following year, it was taken to pieces and sent to America.","start":83.67,"end":88.78,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-009-p01","sourceId":"b2-093-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"By the end of October 1886,","start":90.38,"end":93.28,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-009-p02","sourceId":"b2-093-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[6,24],"wordModel":"english-ctc-fallback","text":"the statue had been put together again and it was officially presented to the American people by Bartholdi.","start":93.82,"end":101.67,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-093-010","sourceId":"b2-093-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,30],"wordModel":"mms-fa","text":"Ever since then, the great monument has been a symbol of liberty for the millions of people who have passed through New York Harbour to make their homes in America.","start":102.64,"end":113.42,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
