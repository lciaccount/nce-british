Id":"b2-045-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Three months passed, and then one morning, Sam found his wallet outside his front door.","start":43.54,"end":50.77,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-045-006-p01","sourceId":"b2-045-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"mms-fa","text":"It had been wrapped up in newspaper and it contained half the money he had lost, together with a note which said:","start":52.24,"end":61.3,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-045-006-p02","sourceId":"b2-045-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[22,32],"wordModel":"mms-fa","text":"'A thief, yes, but only 50 per cent a thief!'","start":62.56,"end":67.263,"score":0.881,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-045-007","sourceId":"b2-045-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"Two months later, some more money was sent to Sam with another note: 'Only 25 per cent a thief now!'","start":69.94,"end":80.33,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-045-008","sourceId":"b2-045-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"In time, all Sam's money was paid back in this way.","start":82.09,"end":86.01,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-045-009","sourceId":"b2-045-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"The last note said: 'I am 100 per cent honest now!'","start":87.38,"end":93.12,"score":0.993,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
