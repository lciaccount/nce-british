.042,"score":0.72},{"text":"do","offset":11,"start":139.282,"end":139.362,"score":0.628},{"text":"us","offset":14,"start":139.442,"end":139.562,"score":0.784},{"text":"good,","offset":17,"start":139.642,"end":139.902,"score":0.779},{"text":"though","offset":23,"start":140.542,"end":140.722,"score":0.977},{"text":"we","offset":30,"start":140.762,"end":140.842,"score":0.997},{"text":"no","offset":33,"start":140.942,"end":141.022,"score":0.996},{"text":"longer","offset":36,"start":141.142,"end":141.382,"score":0.937},{"text":"take","offset":43,"start":141.463,"end":141.682,"score":0.999},{"text":"omens","offset":48,"start":141.822,"end":142.262,"score":0.833},{"text":"from","offset":54,"start":142.343,"end":142.482,"score":0.972},{"text":"their","offset":59,"start":142.523,"end":142.662,"score":0.973},{"text":"flight","offset":65,"start":142.722,"end":143.022,"score":0.978},{"text":"on","offset":72,"start":143.162,"end":143.262,"score":0.742},{"text":"this","offset":75,"start":143.343,"end":143.522,"score":0.998},{"text":"side","offset":80,"start":143.562,"end":143.922,"score":0.935},{"text":"and","offset":85,"start":143.942,"end":144.042,"score":0.989},{"text":"that;","offset":89,"start":144.083,"end":144.322,"score":0.993},{"text":"and","offset":95,"start":145.002,"end":145.122,"score":0.987},{"text":"even","offset":99,"start":145.243,"end":145.442,"score":0.999},{"text":"the","offset":104,"start":145.482,"end":145.562,"score":0.993},{"text":"most","offset":108,"start":145.583,"end":145.822,"score":0.998},{"text":"superstitious","offset":113,"start":145.903,"end":146.582,"score":0.931},{"text":"villagers","offset":127,"start":146.642,"end":147.042,"score":0.884},{"text":"no","offset":137,"start":147.463,"end":147.542,"score":0.999},{"text":"longer","offset":140,"start":147.662,"end":147.922,"score":0.97},{"text":"take","offset":147,"start":148.023,"end":148.262,"score":0.996},{"text":"off","offset":152,"start":148.282,"end":148.402,"score":0.996},{"text":"their","offset":156,"start":148.442,"end":148.582,"score":0.986},{"text":"hats","offset":162,"start":148.623,"end":148.922,"score":0.989},{"text":"to","offset":167,"start":148.982,"end":149.062,"score":0.995},{"text":"the","offset":170,"start":149.123,"end":149.182,"score":0.987},{"text":"magpie","offset":174,"start":149.243,"end":149.742,"score":0.749},{"text":"and","offset":181,"start":150.123,"end":150.262,"score":0.998},{"text":"wish","offset":185,"start":150.363,"end":150.562,"score":0.999},{"text":"it","offset":190,"start":150.602,"end":150.702,"score":0.988},{"text":"good-morning.","offset":193,"start":151.062,"end":151.642,"score":0.999}]],"cues":[{"id":"b4-023-001","sourceId":"b4-023-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"What are the two main types of bird flight described by the author?","start":11.36,"end":15.19,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-002","sourceId":"b4-023-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"No two sorts of birds practise quite the same sort of flight; the varieties are infinite; but two classes may be roughly seen.","start":17.9,"end":27.18,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-003-p01","sourceId":"b4-023-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Any ship that crosses the Pacific is accompanied for many days by the smaller albatross,","start":28.54,"end":34.43,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-003-p02","sourceId":"b4-023-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[15,34],"wordModel":"mms-fa","text":"which may keep company with the vessel for an hour without visible or more than occasional movement of wing.","start":34.703,"end":41.41,"score":0.911,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-023-004-p01","sourceId":"b4-023-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"The currents of air that the walls of the ship direct upwards, as well as in the line of its course,","start":42.6,"end":48.8,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-004-p02","sourceId":"b4-023-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[21,36],"wordModel":"mms-fa","text":"are enough to give the great bird with its immense wings sufficient sustenance and progress.","start":49.24,"end":54.84,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-005-p01","sourceId":"b4-023-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"The albatross is the king of the gliders,","start":55.79,"end":58.71,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-005-p02","sourceId":"b4-023-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[8,25],"wordModel":"mms-fa","text":"the class of fliers which harness the air to their purpose, but must yield to its opposition.","start":59.063,"end":65.37,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-006","sourceId":"b4-023-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"In the contrary school, the duck is supreme.","start":66.58,"end":70.01,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-007","sourceId":"b4-023-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"It comes nearer to the engines with which man has 'conquered' the air, as he boasts.","start":70.99,"end":76.04,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-008-p01","sourceId":"b4-023-008","sourceIndex":7,"part":1,"parts":3,"wordRange":[0,22],"wordModel":"mms-fa","text":"Duck, and like them the pigeons, are endowed with steel-like muscles, that are a good part of the weight of the bird,","start":76.71,"end":84.76,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-008-p02","sourceId":"b4-023-008","sourceIndex":7,"part":2,"parts":3,"wordRange":[22,33],"wordModel":"mms-fa","text":"and these will ply the short wings with such irresistible power","start":85.58,"end":89.7,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-008-p03","sourceId":"b4-023-008","sourceIndex":7,"part":3,"parts":3,"wordRange":[33,47],"wordModel":"mms-fa","text":"that they can bore for long distances through an opposing gale before exhaustion follows.","start":89.86,"end":96.04,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-009","sourceId":"b4-023-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Their humbler followers, such as partridges, have a like power of strong propulsion, but soon tire.","start":97.3,"end":104.36,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-010","sourceId":"b4-023-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"You may pick them up in utter exhaustion, if wind over the sea has driven them to a long journey.","start":105.3,"end":111.42,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-011","sourceId":"b4-023-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The swallow shares the virtues of both schools in highest measure.","start":112.48,"end":116.04,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-012-p01","sourceId":"b4-023-012","sourceIndex":11,"part":1,"parts":4,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"It tires not, nor does it boast of its power;","start":116.79,"end":120.07,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-012-p02","sourceId":"b4-023-012","sourceIndex":11,"part":2,"parts":4,"wordRange":[10,29],"wordModel":"english-ctc-fallback","text":"but belongs to the air travelling it may be six thousand miles to and from its northern nesting home,","start":120.66,"end":128.05,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-012-p03","sourceId":"b4-023-012","sourceIndex":11,"part":3,"parts":4,"wordRange":[29,36],"wordModel":"english-ctc-fallback","text":"feeding its flown young as it flies,","start":128.7,"end":131.03,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-012-p04","sourceId":"b4-023-012","sourceIndex":11,"part":4,"parts":4,"wordRange":[36,53],"wordModel":"english-ctc-fallback","text":"and slipping through a medium that seems to help its passage even when the wind is adverse.","start":131.5,"end":137.3,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-013-p01","sourceId":"b4-023-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,5],"wordModel":"mms-fa","text":"Such birds do us good,","start":138.223,"end":139.99,"score":0.765,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-023-013-p02","sourceId":"b4-023-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[5,38],"wordModel":"mms-fa","text":"though we no longer take omens from their flight on this side and that; and even the most superstitious villagers no longer take off their hats to the magpie and wish it good-morning.","start":140.302,"end":151.76,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
