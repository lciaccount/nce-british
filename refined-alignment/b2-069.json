ceId":"b2-069-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The examiner looked at me sadly.","start":101.56,"end":103.97,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-069-014","sourceId":"b2-069-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"english-ctc-fallback","text":"'Mr.","start":106.28,"end":106.84,"score":0.997,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-069-015","sourceId":"b2-069-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Eames,' he said, in a mournful voice, 'you have just killed that child!'","start":106.873,"end":114.47,"score":0.979,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
