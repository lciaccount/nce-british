982,"end":230.362,"score":0.998},{"text":"first","offset":35,"start":231.282,"end":231.622,"score":0.999},{"text":"from","offset":41,"start":231.863,"end":232.022,"score":0.999},{"text":"mastering","offset":46,"start":232.102,"end":232.542,"score":0.927},{"text":"a","offset":56,"start":232.562,"end":232.582,"score":0.994},{"text":"subject,","offset":58,"start":232.662,"end":233.062,"score":1.0},{"text":"then","offset":67,"start":233.662,"end":233.842,"score":0.991},{"text":"from","offset":72,"start":233.942,"end":234.102,"score":0.999},{"text":"being","offset":77,"start":234.142,"end":234.342,"score":0.995},{"text":"able","offset":83,"start":234.442,"end":234.702,"score":0.995},{"text":"to","offset":88,"start":234.743,"end":234.822,"score":0.997},{"text":"talk","offset":91,"start":234.963,"end":235.182,"score":0.805},{"text":"about","offset":96,"start":235.243,"end":235.502,"score":0.998},{"text":"it.","offset":102,"start":235.542,"end":235.622,"score":0.999}],[{"text":"Collecting,","offset":0,"start":236.583,"end":237.142,"score":0.988},{"text":"by","offset":12,"start":237.683,"end":237.822,"score":0.999},{"text":"occupying","offset":15,"start":237.963,"end":238.522,"score":0.979},{"text":"spare","offset":25,"start":238.602,"end":238.902,"score":0.79},{"text":"time","offset":31,"start":238.982,"end":239.322,"score":0.98},{"text":"so","offset":36,"start":239.363,"end":239.442,"score":0.998},{"text":"constructively,","offset":39,"start":239.562,"end":240.262,"score":0.996},{"text":"makes","offset":55,"start":240.922,"end":241.202,"score":0.99},{"text":"a","offset":61,"start":241.262,"end":241.282,"score":0.997},{"text":"person","offset":63,"start":241.343,"end":241.702,"score":0.999},{"text":"contented,","offset":70,"start":241.803,"end":242.382,"score":0.994},{"text":"with","offset":81,"start":242.942,"end":243.102,"score":0.98},{"text":"no","offset":86,"start":243.183,"end":243.282,"score":0.999},{"text":"time","offset":89,"start":243.482,"end":243.842,"score":0.999},{"text":"for","offset":94,"start":243.922,"end":244.022,"score":0.958},{"text":"boredom.","offset":98,"start":244.083,"end":244.402,"score":0.622}]],"cues":[{"id":"b3-059-001","sourceId":"b3-059-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"What in particular does a person gain when he or she becomes a serious collector?","start":11.55,"end":17.7,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-002","sourceId":"b3-059-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"People tend to amass possessions, sometimes without being aware of doing so.","start":20.28,"end":25.6,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-003","sourceId":"b3-059-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Indeed they can have a delightful surprise when they find something useful which they did not know they owned.","start":26.34,"end":32.98,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-004","sourceId":"b3-059-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Those who never have to move house become indiscriminate collectors of what can only be described as clutter.","start":33.79,"end":40.77,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-005-p01","sourceId":"b3-059-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"They leave unwanted objects in drawers, cupboards and attics for years,","start":41.44,"end":46.32,"score":0.904,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-005-p02","sourceId":"b3-059-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"mms-fa","text":"in the belief that they may one day need just those very things.","start":46.68,"end":50.49,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-006-p01","sourceId":"b3-059-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"As they grow old, people also accumulate belongings for two other reasons, lack of physical and mental energy,","start":51.2,"end":59.5,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-006-p02","sourceId":"b3-059-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[18,31],"wordModel":"mms-fa","text":"both of which are essential in turning out and throwing away, and sentiment.","start":59.98,"end":65.52,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-007-p01","sourceId":"b3-059-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Things owned for a long time are full of associations with the past,","start":66.18,"end":70.48,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-007-p02","sourceId":"b3-059-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[13,30],"wordModel":"mms-fa","text":"perhaps with relatives who are dead, and so they gradually acquire a value beyond their true worth.","start":71.0,"end":77.54,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-008","sourceId":"b3-059-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Some things are collected deliberately in the home in an attempt to avoid waste.","start":78.53,"end":82.94,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-009-p01","sourceId":"b3-059-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Among these I would list string and brown paper,","start":83.52,"end":86.77,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-009-p02","sourceId":"b3-059-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[9,25],"wordModel":"mms-fa","text":"kept by thrifty people when a parcel has been opened, to save buying these two requisites.","start":87.12,"end":93.0,"score":0.934,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-010","sourceId":"b3-059-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Collecting small items can easily become a mania.","start":93.79,"end":97.58,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-011-p01","sourceId":"b3-059-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"I know someone who always cuts sketches out from newspapers of model clothes","start":98.31,"end":103.76,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-011-p02","sourceId":"b3-059-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"that she would like to buy if she had the money.","start":103.9,"end":106.47,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-012-p01","sourceId":"b3-059-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"As she is not rich, the chances that she will ever be able to afford such purchases are remote;","start":107.01,"end":112.76,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-012-p02","sourceId":"b3-059-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[19,32],"wordModel":"mms-fa","text":"but she is never sufficiently strongminded to be able to stop the practice.","start":113.4,"end":118.18,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-013-p01","sourceId":"b3-059-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"It is a harmless habit, but it litters up her desk to such an extent that every time she opens it,","start":119.08,"end":125.61,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-013-p02","sourceId":"b3-059-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[21,30],"wordModel":"mms-fa","text":"loose bits of paper fall out in every direction.","start":125.78,"end":129.09,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-014","sourceId":"b3-059-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Collecting as a serious hobby is quite different and has many advantages.","start":130.24,"end":135.32,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-015","sourceId":"b3-059-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"It provides relaxation for leisure hours, as just looking at one's treasures is always a joy.","start":136.1,"end":142.53,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-016","sourceId":"b3-059-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"One does not have to go outside for amusement, since the collection is housed at home.","start":143.61,"end":148.82,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-017-p01","sourceId":"b3-059-017","sourceIndex":16,"part":1,"parts":4,"wordRange":[0,10],"wordModel":"mms-fa","text":"Whatever it consists of, stamps, records, first editions of books,","start":149.67,"end":155.57,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-017-p02","sourceId":"b3-059-017","sourceIndex":16,"part":2,"parts":4,"wordRange":[10,21],"wordModel":"mms-fa","text":"china, glass, antique furniture, pictures, model cars, stuffed birds, toy animals,","start":155.9,"end":164.98,"score":0.911,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-017-p03","sourceId":"b3-059-017","sourceIndex":16,"part":3,"parts":4,"wordRange":[21,31],"wordModel":"mms-fa","text":"there is always something to do in connection with it,","start":165.58,"end":168.41,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-017-p04","sourceId":"b3-059-017","sourceIndex":16,"part":4,"parts":4,"wordRange":[31,46],"wordModel":"mms-fa","text":"from finding the right place for the latest addition, to verifying facts in reference books.","start":168.843,"end":175.29,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-018","sourceId":"b3-059-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"This hobby educates one not only in the chosen subject, but also in general matters which have some bearing on it.","start":176.13,"end":183.9,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-019","sourceId":"b3-059-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"There are also other benefits.","start":184.67,"end":186.51,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-020","sourceId":"b3-059-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"One wants to meet like-minded collectors, to get advice, to compare notes, to exchange articles, to show off the latest find.","start":187.27,"end":196.62,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-021","sourceId":"b3-059-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"So one's circle of friends grows.","start":197.38,"end":199.71,"score":0.9,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-022-p01","sourceId":"b3-059-022","sourceIndex":21,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Soon the hobby leads to travel, perhaps to a meeting in another town,","start":200.36,"end":204.71,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-022-p02","sourceId":"b3-059-022","sourceIndex":21,"part":2,"parts":2,"wordRange":[13,32],"wordModel":"mms-fa","text":"possibly a trip abroad in search of a rare specimen, for collectors are not confined to any one country.","start":205.3,"end":212.82,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-023-p01","sourceId":"b3-059-023","sourceIndex":22,"part":1,"parts":2,"wordRange":[0,27],"wordModel":"mms-fa","text":"Over the years, one may well become an authority on one's hobby and will very probably be asked to give informal talks to little gatherings and then,","start":213.67,"end":224.15,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-023-p02","sourceId":"b3-059-023","sourceIndex":22,"part":2,"parts":2,"wordRange":[27,32],"wordModel":"mms-fa","text":"if successful, to larger audiences.","start":224.33,"end":226.96,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-024","sourceId":"b3-059-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"In this way self-confidence grows, first from mastering a subject, then from being able to talk about it.","start":227.85,"end":235.7,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-059-025","sourceId":"b3-059-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Collecting, by occupying spare time so constructively, makes a person contented, with no time for boredom.","start":236.52,"end":244.52,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
