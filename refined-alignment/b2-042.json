nge":[0,23],"wordModel":"mms-fa","text":"As soon as he saw us, he picked up a long pipe which was covered with coins and opened one of the baskets.","start":45.1,"end":54.61,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-042-005","sourceId":"b2-042-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When he began to play a tune, we had our first glimpse of the snake.","start":56.16,"end":62.02,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-042-006","sourceId":"b2-042-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It rose out of the basket and began to follow the movements of the pipe.","start":63.48,"end":69.12,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-042-007","sourceId":"b2-042-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"We were very much surprised when the snake charmer suddenly began to play jazz and modern pop songs.","start":70.44,"end":78.84,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-042-008","sourceId":"b2-042-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The snake, however, continued to 'dance' slowly.","start":80.68,"end":85.603,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-042-009","sourceId":"b2-042-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It obviously could not tell the difference between Indian music and jazz!","start":86.36,"end":91.95,"score":0.895,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]}]}
