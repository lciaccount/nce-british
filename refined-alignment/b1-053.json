":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"It's mild, but it's not always pleasant.","start":32.06,"end":35.34,"score":0.9,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-006","sourceId":"b1-053-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"The weather's often cold in the North and windy in the East.","start":36.71,"end":41.65,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-007","sourceId":"b1-053-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It's often wet in the West and sometimes warm in the South.","start":42.56,"end":47.42,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-008","sourceId":"b1-053-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Which seasons do you like best?","start":49.52,"end":52.05,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-009","sourceId":"b1-053-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I like spring and summer.","start":53.75,"end":55.81,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-010","sourceId":"b1-053-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The days are long and the nights are short.","start":56.57,"end":59.88,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-011","sourceId":"b1-053-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The sun rises early and sets late.","start":60.69,"end":64.18,"score":0.857,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-012","sourceId":"b1-053-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"I don't like autumn and winter.","start":65.72,"end":68.28,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-013","sourceId":"b1-053-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The days are short and the nights are long.","start":68.902,"end":72.67,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-014","sourceId":"b1-053-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The sun rises late and sets early.","start":73.74,"end":77.0,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-015","sourceId":"b1-053-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Our climate is not very good, but it's certainly interesting.","start":78.12,"end":83.33,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-053-016","sourceId":"b1-053-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"It's our favourite subject of conversation.","start":84.12,"end":86.97,"score":0.897,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
