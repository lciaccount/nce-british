":[{"id":"b4-014-001","sourceId":"b4-014-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Why do small errors make it impossible to predict the weather system with a high degree of accuracy?","start":12.96,"end":19.63,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-002","sourceId":"b4-014-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Beyond two or three days, the world's best weather forecasts are speculative, and beyond six or seven they are worthless.","start":23.11,"end":32.38,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-003","sourceId":"b4-014-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The Butterfly Effect is the reason.","start":33.3,"end":35.2,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-004","sourceId":"b4-014-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"For small pieces of weather-- and to a global forecaster, small can mean thunderstorms and blizzards-- any prediction deteriorates rapidly.","start":35.983,"end":46.72,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-005-p01","sourceId":"b4-014-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"Errors and uncertainties multiply, cascading upward through a chain of turbulent features,","start":47.71,"end":53.44,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-005-p02","sourceId":"b4-014-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[12,26],"wordModel":"english-ctc-fallback","text":"from dust devils and squalls up to continent-size eddies that only satellites can see.","start":54.21,"end":60.58,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-006-p01","sourceId":"b4-014-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"The modern weather models work with a grid of points of the order of sixty miles apart,","start":62.71,"end":68.2,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-006-p02","sourceId":"b4-014-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[17,35],"wordModel":"mms-fa","text":"and even so, some starting data has to be guessed, since ground stations and satellites cannot see everywhere.","start":68.82,"end":77.16,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-007-p01","sourceId":"b4-014-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"But suppose the earth could be covered with sensors spaced one foot apart,","start":78.163,"end":83.42,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-007-p02","sourceId":"b4-014-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"rising at one-foot intervals all the way to the top of the atmosphere.","start":83.803,"end":88.12,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-008","sourceId":"b4-014-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Suppose every sensor gives perfectly accurate readings of temperature, pressure, humidity, and any other quantity a meteorologist would want.","start":89.142,"end":99.86,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-009","sourceId":"b4-014-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,25],"wordModel":"english-ctc-fallback","text":"Precisely at noon an infinitely powerful computer takes all the data and calculates what will happen at each point at 12.01, then 12.02, then 12.03...","start":101.08,"end":114.74,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-010","sourceId":"b4-014-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The computer will still be unable to predict whether Princeton, New Jersey, will have sun or rain on a day one month away.","start":116.65,"end":125.12,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-011","sourceId":"b4-014-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"At noon the spaces between the sensors will hide fluctuations that the computer will not know about, tiny deviations from the average.","start":126.69,"end":135.71,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-014-012","text":"By 12.01, those fluctuations will already have created small errors one foot away.","start":136.812,"end":143.222,"score":0.854,"timingValid":true,"needsReview":true,"sourceId":"b4-014-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b4-014-013","sourceId":"b4-014-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Soon the errors will have multiplied to the ten-foot scale, and so on up to the size of the globe.","start":144.04,"end":150.98,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
