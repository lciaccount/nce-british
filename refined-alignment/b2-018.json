rceId":"b2-018-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What had happened to the writer's bag?","start":14.67,"end":17.87,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-002","sourceId":"b2-018-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"After I had had lunch at a village pub, I looked for my bag.","start":20.56,"end":25.81,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-003","sourceId":"b2-018-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"I had left it on a chair beside the door and now it wasn't there!","start":27.52,"end":32.84,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-004","sourceId":"b2-018-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"As I was looking for it, the landlord came in.","start":34.8,"end":38.61,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-005","sourceId":"b2-018-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'Did you have a good meal?'","start":40.19,"end":42.142,"score":0.994,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-018-006","sourceId":"b2-018-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"he asked.","start":42.4,"end":43.42,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-007","sourceId":"b2-018-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"'Yes, thank you,' I answered, 'but I can't pay the bill.","start":44.5,"end":50.03,"score":0.972,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-018-008","sourceId":"b2-018-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I haven't got my bag.'","start":50.4,"end":51.99,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-009","sourceId":"b2-018-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The landlord smiled and immediately went out.","start":53.66,"end":57.52,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-010","sourceId":"b2-018-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"In a few minutes he returned with my bag and gave it back to me.","start":59.36,"end":64.17,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-011","sourceId":"b2-018-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'I'm very sorry,' he said.","start":65.45,"end":67.9,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-018-012","sourceId":"b2-018-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"'My dog had taken it into the garden.","start":68.87,"end":71.73,"score":0.99,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-018-013","sourceId":"b2-018-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"He often does this!'","start":72.54,"end":73.87,"score":0.986,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
