rdModel":"mms-fa","text":"Why is Joe's garden the most beautiful one in the town?","start":14.73,"end":19.69,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-002","sourceId":"b2-008-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Joe Sanders has the most beautiful garden in our town.","start":22.34,"end":27.17,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-003","sourceId":"b2-008-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Nearly everybody enters for 'The Nicest Garden Competition' each year, but Joe wins every time.","start":28.2,"end":36.47,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-004","sourceId":"b2-008-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Bill Frith's garden is larger than Joe's.","start":38.51,"end":41.37,"score":0.836,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-005","sourceId":"b2-008-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Bill works harder than Joe and grows more flowers and vegetables, but Joe's garden is more interesting.","start":42.46,"end":51.023,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-006","sourceId":"b2-008-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"He has made neat paths and has built a wooden bridge over a pool.","start":51.86,"end":57.26,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-007","sourceId":"b2-008-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"I like gardens too, but I do not like hard work.","start":58.53,"end":62.92,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-008-008","sourceId":"b2-008-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Every year I enter for the garden competition too, and I always win a little prize for the worst garden in the town!","start":64.48,"end":74.48,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
