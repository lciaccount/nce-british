.442,"score":0.886}]],"cues":[{"id":"b4-003-001","sourceId":"b4-003-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"What was the main objective of early mountain climbers?","start":12.14,"end":15.88,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-002-p01","sourceId":"b4-003-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Modern alpinists try to climb mountains by a route which will give them good sport,","start":18.55,"end":24.73,"score":0.897,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-002-p02","sourceId":"b4-003-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[15,27],"wordModel":"mms-fa","text":"and the more difficult it is, the more highly it is regarded.","start":25.24,"end":28.69,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-003","sourceId":"b4-003-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"In the pioneering days however, this was not the case at all.","start":30.1,"end":33.69,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-004-p01","sourceId":"b4-003-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"The early climbers were looking for the easiest way to the top because the summit was the prize they sought,","start":34.31,"end":41.52,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-004-p02","sourceId":"b4-003-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[20,28],"wordModel":"mms-fa","text":"especially if it had never been attained before.","start":41.98,"end":44.84,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-005-p01","sourceId":"b4-003-005","sourceIndex":4,"part":1,"parts":3,"wordRange":[0,18],"wordModel":"mms-fa","text":"It is true that during their explorations they often faced difficulties and dangers of the most perilous nature,","start":46.1,"end":53.82,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-005-p02","sourceId":"b4-003-005","sourceIndex":4,"part":2,"parts":3,"wordRange":[18,32],"wordModel":"mms-fa","text":"equipped in a manner which would make a modern climber shudder at the thought,","start":55.02,"end":59.36,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-005-p03","sourceId":"b4-003-005","sourceIndex":4,"part":3,"parts":3,"wordRange":[32,45],"wordModel":"mms-fa","text":"but they did not go out of their way to court such excitement.","start":59.88,"end":63.7,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-006","sourceId":"b4-003-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"They had a single aim, a solitary goal -- the top!","start":64.48,"end":69.6,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-007","sourceId":"b4-003-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It is hard for us to realize nowadays how difficult it was for the pioneers.","start":71.1,"end":75.74,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-008","sourceId":"b4-003-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Except for one or two places such as Zermatt and Chamonix, which had rapidly become popular.","start":76.98,"end":84.1,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-009","sourceId":"b4-003-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Alpine villages tended to be impoverished settlements cut off from civilization by the high mountains.","start":84.76,"end":91.26,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-010-p01","sourceId":"b4-003-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Such inns as there were were generally dirty and flea-ridden;","start":92.38,"end":96.67,"score":0.918,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-010-p02","sourceId":"b4-003-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"the food simply local cheese accompanied by bread often twelve months old, all washed down with coarse wine.","start":97.26,"end":105.65,"score":0.894,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-011-p01","sourceId":"b4-003-011","sourceIndex":10,"part":1,"parts":3,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"Often a valley boasted no inn at all,","start":106.94,"end":109.43,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-011-p02","sourceId":"b4-003-011","sourceIndex":10,"part":2,"parts":3,"wordRange":[8,28],"wordModel":"english-ctc-fallback","text":"and climbers found shelter wherever they could -- sometimes with the local priest (who was usually as poor as his parishioners),","start":109.88,"end":118.51,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-011-p03","sourceId":"b4-003-011","sourceIndex":10,"part":3,"parts":3,"wordRange":[28,33],"wordModel":"english-ctc-fallback","text":"sometimes with shepherds or cheese-makers.","start":119.26,"end":121.98,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-012","sourceId":"b4-003-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Invariably the background was the same:dirt and poverty, and very uncomfortable.","start":123.22,"end":129.58,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-013-p01","sourceId":"b4-003-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"For men accustomed to eating seven-course dinners and sleeping between fine linen sheets at home,","start":130.74,"end":136.63,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-003-013-p02","sourceId":"b4-003-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[15,26],"wordModel":"mms-fa","text":"the change to the Alps must have been very hard indeed.","start":136.902,"end":140.52,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
