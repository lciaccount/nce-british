rt":158.183,"end":158.242,"score":0.991},{"text":"his","offset":17,"start":158.343,"end":158.482,"score":0.931},{"text":"family","offset":21,"start":158.542,"end":158.862,"score":0.999},{"text":"home,","offset":28,"start":158.942,"end":159.222,"score":0.975},{"text":"but","offset":34,"start":159.782,"end":159.902,"score":0.995},{"text":"the","offset":38,"start":159.942,"end":160.022,"score":0.954},{"text":"house","offset":42,"start":160.062,"end":160.342,"score":0.957},{"text":"had","offset":48,"start":160.363,"end":160.462,"score":0.998},{"text":"been","offset":52,"start":160.482,"end":160.642,"score":0.997},{"text":"bombed","offset":57,"start":160.722,"end":161.122,"score":0.734},{"text":"and","offset":64,"start":161.642,"end":161.782,"score":0.999},{"text":"no","offset":68,"start":161.903,"end":162.002,"score":0.881},{"text":"one","offset":71,"start":162.183,"end":162.322,"score":0.999},{"text":"in","offset":75,"start":162.422,"end":162.482,"score":0.998},{"text":"the","offset":78,"start":162.523,"end":162.602,"score":0.997},{"text":"neighbourhood","offset":82,"start":162.642,"end":163.082,"score":0.883},{"text":"knew","offset":96,"start":163.363,"end":163.582,"score":0.951},{"text":"what","offset":101,"start":163.843,"end":163.982,"score":0.989},{"text":"had","offset":106,"start":164.002,"end":164.122,"score":0.999},{"text":"become","offset":110,"start":164.142,"end":164.502,"score":0.999},{"text":"of","offset":117,"start":164.542,"end":164.622,"score":0.999},{"text":"the","offset":120,"start":164.642,"end":164.742,"score":0.982},{"text":"inhabitants.","offset":124,"start":164.803,"end":165.422,"score":0.986}],[{"text":"Assuming","offset":0,"start":166.562,"end":167.022,"score":0.999},{"text":"that","offset":9,"start":167.123,"end":167.242,"score":0.994},{"text":"his","offset":14,"start":167.303,"end":167.402,"score":0.948},{"text":"family","offset":18,"start":167.463,"end":167.782,"score":1.0},{"text":"had","offset":25,"start":167.863,"end":167.962,"score":0.988},{"text":"been","offset":29,"start":168.042,"end":168.202,"score":0.99},{"text":"killed","offset":34,"start":168.303,"end":168.622,"score":0.941},{"text":"during","offset":41,"start":168.963,"end":169.262,"score":0.975},{"text":"an","offset":48,"start":169.403,"end":169.462,"score":0.991},{"text":"air","offset":51,"start":169.662,"end":169.782,"score":0.872},{"text":"raid,","offset":55,"start":169.803,"end":170.022,"score":0.772},{"text":"Hans","offset":61,"start":170.722,"end":170.982,"score":0.963},{"text":"settled","offset":66,"start":171.343,"end":171.642,"score":0.976},{"text":"down","offset":74,"start":171.683,"end":171.922,"score":0.925},{"text":"in","offset":79,"start":172.062,"end":172.102,"score":1.0},{"text":"a","offset":82,"start":172.183,"end":172.202,"score":0.999},{"text":"village","offset":84,"start":172.282,"end":172.542,"score":1.0},{"text":"fifty","offset":92,"start":172.942,"end":173.242,"score":0.999},{"text":"miles","offset":98,"start":173.322,"end":173.622,"score":0.997},{"text":"away","offset":104,"start":173.683,"end":173.922,"score":0.955},{"text":"where","offset":109,"start":174.422,"end":174.582,"score":0.997},{"text":"he","offset":115,"start":174.623,"end":174.702,"score":0.954},{"text":"had","offset":118,"start":174.762,"end":174.862,"score":0.997},{"text":"remained","offset":122,"start":174.922,"end":175.342,"score":0.994},{"text":"ever","offset":131,"start":175.743,"end":175.902,"score":1.0},{"text":"since.","offset":136,"start":175.982,"end":176.222,"score":0.9}]],"cues":[{"id":"b3-036-001","sourceId":"b3-036-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"What was the chance in a million?","start":12.52,"end":14.81,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-002","sourceId":"b3-036-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"We are less credulous than we used to be.","start":17.44,"end":19.92,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-003","sourceId":"b3-036-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,26],"wordModel":"mms-fa","text":"In the nineteenth century, a novelist would bring his story to a conclusion by presenting his readers with a series of coincidences--most of them wildly improbable.","start":20.88,"end":32.54,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-004","sourceId":"b3-036-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Readers happily accepted the fact that an obscure maidservant was really the hero's mother.","start":33.49,"end":39.56,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-005","sourceId":"b3-036-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"A long-lost brother, who was presumed dead, was really alive all the time and wickedly plotting to bring about the hero's downfall.","start":40.07,"end":48.6,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-006","sourceId":"b3-036-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"And so on.","start":48.99,"end":49.86,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-007","sourceId":"b3-036-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Modern readers would find such naive solutions totally unacceptable.","start":50.33,"end":55.16,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-008","sourceId":"b3-036-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Yet, in real life, circumstances do sometimes conspire to bring about coincidences which anyone but a nineteenth century novelist would find incredible.","start":55.62,"end":66.71,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-009-p01","sourceId":"b3-036-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"When I was a boy, my grandfather told me how a German taxi driver,","start":67.67,"end":72.41,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-009-p02","sourceId":"b3-036-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[14,29],"wordModel":"mms-fa","text":"Franz Bussman, found a brother who was thought to have been killed twenty years before.","start":72.77,"end":78.52,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-010","sourceId":"b3-036-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"While on a walking tour with his wife, he stopped to talk to a workman.","start":79.12,"end":83.65,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-011-p01","sourceId":"b3-036-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"After they had gone on, Mrs. Bussman commented on the workman's close resemblance to her husband and even suggested","start":84.36,"end":92.52,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-011-p02","sourceId":"b3-036-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[19,25],"wordModel":"mms-fa","text":"that he might be his brother.","start":92.66,"end":94.22,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-012","sourceId":"b3-036-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Franz poured scorn on the idea, pointing out that his brother had been killed in action during the war.","start":95.52,"end":103.37,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-013-p01","sourceId":"b3-036-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"Though Mrs. Bussman was fully acquainted with this story,","start":104.32,"end":108.02,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-013-p02","sourceId":"b3-036-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[9,24],"wordModel":"english-ctc-fallback","text":"she thought that there was a chance in a million that she might be right.","start":108.53,"end":112.65,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-014","sourceId":"b3-036-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"A few days later, she sent a boy to the workman to ask him if his name was Hans Bussman.","start":113.48,"end":119.96,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-015","sourceId":"b3-036-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Needless to say, the man's name was Hans Bussman and he really was Franz's long-lost brother.","start":120.93,"end":128.34,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-016","sourceId":"b3-036-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When the brothers were reunited, Hans explained how it was that he was still alive.","start":129.16,"end":135.1,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-017","sourceId":"b3-036-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"After having been wounded towards the end of the war, he had been sent to hospital and was separated from his unit.","start":135.63,"end":142.86,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-018","sourceId":"b3-036-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The hospital had been bombed and Hans had made his way back into Western Germany on foot.","start":143.76,"end":149.97,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-019","sourceId":"b3-036-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Meanwhile, his unit was lost and all records of him had been destroyed.","start":151.01,"end":156.26,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-020-p01","sourceId":"b3-036-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"Hans returned to his family home,","start":157.12,"end":159.37,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-020-p02","sourceId":"b3-036-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[6,25],"wordModel":"mms-fa","text":"but the house had been bombed and no one in the neighbourhood knew what had become of the inhabitants.","start":159.72,"end":165.51,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-021-p01","sourceId":"b3-036-021","sourceIndex":20,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Assuming that his family had been killed during an air raid,","start":166.47,"end":170.22,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-036-021-p02","sourceId":"b3-036-021","sourceIndex":20,"part":2,"parts":2,"wordRange":[11,26],"wordModel":"english-ctc-fallback","text":"Hans settled down in a village fifty miles away where he had remained ever since.","start":170.482,"end":176.4,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
