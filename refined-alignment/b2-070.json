":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"How was the drunk removed from the ring?","start":13.53,"end":17.14,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-002","sourceId":"b2-070-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"During a bullfight, a drunk suddenly wandered into the middle of the ring.","start":19.91,"end":25.4,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-003","sourceId":"b2-070-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The crowd began to shout, but the drunk was unaware of the danger.","start":26.66,"end":32.22,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-004-p01","sourceId":"b2-070-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"The bull was busy with the matador at the time,","start":33.723,"end":36.84,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-004-p02","sourceId":"b2-070-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"but it suddenly caught sight of the drunk who was shouting rude remarks and waving a red cap.","start":37.63,"end":44.96,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-005","sourceId":"b2-070-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Apparently sensitive to criticism, the bull forgot all about the matador and charged at the drunk.","start":46.9,"end":55.403,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-006","sourceId":"b2-070-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"The crowd suddenly grew quiet.","start":56.85,"end":59.45,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-007","sourceId":"b2-070-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The drunk, however, seemed quite sure of himself.","start":60.76,"end":64.08,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-008","sourceId":"b2-070-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When the bull got close to him, he clumsily stepped aside to let it pass.","start":65.52,"end":71.47,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-009","sourceId":"b2-070-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The crowd broke into cheers and the drunk bowed.","start":72.8,"end":77.58,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-010","sourceId":"b2-070-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"By this time, however three men had come into the ring and they quickly dragged the drunk to safety.","start":79.03,"end":86.62,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-011-p01","sourceId":"b2-070-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Even the bull seemed to feel sorry for him,","start":88.01,"end":90.63,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-070-011-p02","sourceId":"b2-070-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[9,31],"wordModel":"mms-fa","text":"for it looked on sympathetically until the drunk was out of the way before once more turning its attention to the matador.","start":91.37,"end":100.58,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
