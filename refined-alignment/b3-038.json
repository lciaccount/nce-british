"offset":81,"start":156.542,"end":157.082,"score":0.999},{"text":"that","offset":90,"start":157.123,"end":157.242,"score":0.997},{"text":"sometimes","offset":95,"start":157.322,"end":157.842,"score":0.999},{"text":"accompany","offset":105,"start":157.963,"end":158.422,"score":0.988},{"text":"them.","offset":115,"start":158.482,"end":158.622,"score":0.978}],[{"text":"It","offset":0,"start":159.523,"end":159.622,"score":0.046},{"text":"seems","offset":3,"start":159.722,"end":160.062,"score":0.244},{"text":"that","offset":9,"start":160.102,"end":160.242,"score":0.99},{"text":"man","offset":14,"start":160.322,"end":160.562,"score":1.0},{"text":"was","offset":18,"start":160.642,"end":160.802,"score":0.999},{"text":"making","offset":22,"start":160.863,"end":161.202,"score":0.977},{"text":"a","offset":29,"start":161.282,"end":161.302,"score":0.999},{"text":"real","offset":31,"start":161.422,"end":161.662,"score":1.0},{"text":"effort","offset":36,"start":161.782,"end":162.042,"score":0.954},{"text":"to","offset":43,"start":162.403,"end":162.482,"score":0.999},{"text":"understand","offset":46,"start":162.662,"end":163.162,"score":0.982},{"text":"the","offset":57,"start":163.202,"end":163.282,"score":0.998},{"text":"seasons","offset":61,"start":163.363,"end":163.842,"score":0.99},{"text":"20,","offset":69,"start":164.303,"end":164.702,"score":0.228},{"text":"000","offset":73,"start":165.062,"end":165.282,"score":0.002},{"text":"years","offset":77,"start":165.282,"end":165.562,"score":0.994},{"text":"earlier","offset":83,"start":165.702,"end":166.062,"score":0.95},{"text":"than","offset":91,"start":166.363,"end":166.502,"score":0.971},{"text":"has","offset":96,"start":166.542,"end":166.682,"score":0.999},{"text":"been","offset":100,"start":166.782,"end":167.002,"score":0.998},{"text":"supposed.","offset":105,"start":167.102,"end":167.702,"score":0.998}]],"cues":[{"id":"b3-038-001","sourceId":"b3-038-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"What is the importance of the dots, lines, and symbols engraved on stone, bones and ivory?","start":12.29,"end":19.57,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-002","sourceId":"b3-038-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Future historians will be in a unique position when they come to record the history of our own times.","start":22.12,"end":28.48,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-003","sourceId":"b3-038-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"They will hardly know which facts to select from the great mass of evidence that steadily accumulates.","start":29.64,"end":35.92,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-004","sourceId":"b3-038-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"What is more, they will not have to rely solely on the written word.","start":37.29,"end":41.54,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-005","sourceId":"b3-038-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Films, videos, CDs and CD-ROMs are just some of the bewildering amount of information they will have.","start":42.25,"end":50.44,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-006","sourceId":"b3-038-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"They will be able, as it were, to see and hear us in action.","start":50.9,"end":54.98,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-007","sourceId":"b3-038-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"But the historian attempting to reconstruct the distant past is always faced with a difficult task.","start":55.53,"end":62.34,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-008","sourceId":"b3-038-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He has to deduce what he can from the few scanty clues available.","start":63.24,"end":67.46,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-009","sourceId":"b3-038-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Even seemingly insignificant remains can shed interesting light on the history of early man.","start":68.62,"end":74.46,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-010-p01","sourceId":"b3-038-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"Up to now, historians have assumed that calendars came into being with the advent of agriculture,","start":75.51,"end":81.94,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-010-p02","sourceId":"b3-038-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[16,31],"wordModel":"english-ctc-fallback","text":"for then man was faced with a real need to understand something about the seasons.","start":82.23,"end":87.34,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-011","sourceId":"b3-038-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Recent scientific evidence seems to indicate that this assumption is incorrect.","start":88.09,"end":93.37,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-012","sourceId":"b3-038-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Historians have long been puzzled by dots, lines and symbols which have been engraved on walls, bones, and the ivory tusks of mammoths.","start":94.48,"end":105.03,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-013","sourceId":"b3-038-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"The nomads who made these markings lived by hunting and fishing during the last Ice Age which began about 35, 000 B.C.","start":105.72,"end":114.943,"score":0.874,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-038-014","text":"and ended about 10, 000 B.C.","start":115.513,"end":118.083,"score":0.871,"timingValid":true,"needsReview":true,"sourceId":"b3-038-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-038-015","sourceId":"b3-038-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"By correlating markings made in various parts of the world, historians have been able to read this difficult code.","start":118.9,"end":126.55,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-016","sourceId":"b3-038-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"They have found that it is connected with the passage of days and the phases of the moon.","start":127.18,"end":132.67,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-017","sourceId":"b3-038-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"It is, in fact, a primitive type of calendar.","start":133.28,"end":136.29,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-018","sourceId":"b3-038-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"It has long been known that the hunting scenes depicted on walls were not simply a form of artistic expression.","start":137.52,"end":144.7,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-019","sourceId":"b3-038-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"They had a definite meaning, for they were as near as early man could get to writing.","start":145.22,"end":150.7,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-020","sourceId":"b3-038-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"It is possible that there is a definite relation between these paintings and the markings that sometimes accompany them.","start":151.46,"end":158.8,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-038-021","text":"It seems that man was making a real effort to understand the seasons 20, 000 years earlier than has been supposed.","start":159.512,"end":167.722,"score":0.953,"timingValid":true,"needsReview":true,"sourceId":"b3-038-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]}]}
