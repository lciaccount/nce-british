:true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-006","sourceId":"b1-111-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"It costs five hundred pounds.","start":32.17,"end":34.72,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-007","sourceId":"b1-111-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"That's too expensive for us.","start":36.39,"end":38.49,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-008","sourceId":"b1-111-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"We can't afford all that money.","start":38.6,"end":40.44,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-009","sourceId":"b1-111-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This model's less expensive than that one.","start":41.14,"end":44.403,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-010","sourceId":"b1-111-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"It's only three hundred pounds.","start":44.6,"end":46.68,"score":0.789,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-011","sourceId":"b1-111-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"But, of course, it's not as good as the expensive one.","start":46.94,"end":50.35,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-012","sourceId":"b1-111-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I don't like this model.","start":51.79,"end":53.302,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-013","sourceId":"b1-111-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"The other model's more expensive, but it's worth the money.","start":53.48,"end":57.07,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-014","sourceId":"b1-111-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Can we buy it on instalments?","start":58.64,"end":60.74,"score":0.841,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-015","sourceId":"b1-111-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"Of course.","start":62.12,"end":63.04,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-016","sourceId":"b1-111-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"You can pay a deposit of thirty pounds, and then fourteen pounds a month for three years.","start":63.38,"end":69.88,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-017","sourceId":"b1-111-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Do you like it, dear?","start":71.82,"end":72.9,"score":0.899,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-018","sourceId":"b1-111-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"I certainly do, but I don't like the price.","start":73.7,"end":77.59,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-019","sourceId":"b1-111-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"You always want the best, but we can't afford it.","start":78.54,"end":82.27,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-020","sourceId":"b1-111-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Sometimes you think you're a millionaire!","start":83.56,"end":86.42,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-111-021","sourceId":"b1-111-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Millionaires don't buy things on instalments!","start":87.08,"end":90.04,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
