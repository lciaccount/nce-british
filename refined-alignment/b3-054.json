ore":0.999},{"text":"and","offset":44,"start":214.743,"end":214.862,"score":0.998},{"text":"then","offset":48,"start":214.903,"end":215.062,"score":0.999},{"text":"on","offset":53,"start":215.222,"end":215.322,"score":0.503},{"text":"to","offset":56,"start":215.363,"end":215.422,"score":0.995},{"text":"the","offset":59,"start":215.463,"end":215.562,"score":0.947},{"text":"leaves","offset":63,"start":215.642,"end":216.002,"score":0.954},{"text":"of","offset":70,"start":216.023,"end":216.102,"score":0.999},{"text":"the","offset":73,"start":216.123,"end":216.222,"score":0.907},{"text":"tree.","offset":77,"start":216.262,"end":216.542,"score":0.947}],[{"text":"I","offset":0,"start":217.683,"end":217.702,"score":1.0},{"text":"realized","offset":2,"start":217.822,"end":218.382,"score":0.862},{"text":"sadly","offset":11,"start":218.442,"end":218.802,"score":1.0},{"text":"that","offset":17,"start":219.202,"end":219.322,"score":0.987},{"text":"I","offset":22,"start":219.482,"end":219.502,"score":0.999},{"text":"had","offset":24,"start":219.562,"end":219.722,"score":0.964},{"text":"been","offset":28,"start":219.782,"end":219.942,"score":0.911},{"text":"completely","offset":33,"start":220.002,"end":220.562,"score":0.998},{"text":"defeated","offset":44,"start":220.642,"end":221.102,"score":0.973},{"text":"by","offset":53,"start":221.183,"end":221.342,"score":1.0},{"text":"their","offset":56,"start":221.403,"end":221.562,"score":0.993},{"text":"ingenuity.","offset":62,"start":221.662,"end":222.302,"score":0.897}],[{"text":"The","offset":0,"start":222.922,"end":223.022,"score":0.999},{"text":"ants","offset":4,"start":223.183,"end":223.422,"score":0.509},{"text":"had","offset":9,"start":223.482,"end":223.622,"score":0.994},{"text":"been","offset":13,"start":223.662,"end":223.822,"score":0.998},{"text":"quick","offset":18,"start":223.903,"end":224.102,"score":0.927},{"text":"to","offset":24,"start":224.183,"end":224.262,"score":0.999},{"text":"find","offset":27,"start":224.322,"end":224.582,"score":0.997},{"text":"an","offset":32,"start":224.602,"end":224.682,"score":0.998},{"text":"answer","offset":35,"start":224.803,"end":225.102,"score":0.932},{"text":"to","offset":42,"start":225.422,"end":225.502,"score":0.999},{"text":"my","offset":45,"start":225.583,"end":225.722,"score":0.999},{"text":"thoroughly","offset":48,"start":225.882,"end":226.262,"score":0.599},{"text":"unscientific","offset":59,"start":226.602,"end":227.542,"score":0.978},{"text":"methods!","offset":72,"start":227.623,"end":228.082,"score":1.0}]],"cues":[{"id":"b3-054-001","sourceId":"b3-054-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Was the writer successful in protecting his peach tree?","start":13.26,"end":17.2,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-002","sourceId":"b3-054-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"Why not?","start":17.7,"end":18.39,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-003","sourceId":"b3-054-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"We have been brought up to fear insects.","start":21.03,"end":23.71,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-004","sourceId":"b3-054-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"We regard them as unnecessary creatures that do more harm than good.","start":24.2,"end":28.59,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-005","sourceId":"b3-054-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"We continually wage war on them, for they contaminate our food, carry diseases, or devour our crops.","start":29.14,"end":36.46,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-006","sourceId":"b3-054-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"They sting or bite without provocation; they fly uninvited into our rooms on summer nights, or beat against our lighted windows.","start":36.91,"end":46.1,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-007","sourceId":"b3-054-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"We live in dread not only of unpleasant insects like spiders or wasps, but of quite harmless ones like moths.","start":47.03,"end":55.45,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-008","sourceId":"b3-054-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Reading about them increases our understanding without dispelling our fears.","start":56.03,"end":60.54,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-009-p01","sourceId":"b3-054-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"Knowing that the industrious ant lives in a highly organized society does nothing to prevent us from being filled with revulsion","start":61.31,"end":69.79,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-009-p02","sourceId":"b3-054-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[21,34],"wordModel":"mms-fa","text":"when we find hordes of them crawling over a carefully prepared picnic lunch.","start":69.88,"end":74.64,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-010-p01","sourceId":"b3-054-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"No matter how much we like honey,","start":75.4,"end":77.26,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-010-p02","sourceId":"b3-054-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[7,29],"wordModel":"mms-fa","text":"or how much we have read about the uncanny sense of direction which bees possess, we have a horror of being stung.","start":77.68,"end":85.46,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-011","sourceId":"b3-054-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Most of our fears are unreasonable, but they are impossible to erase.","start":86.18,"end":91.1,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-012","sourceId":"b3-054-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"At the same time, however, insects are strangely fascinating.","start":91.91,"end":95.93,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-013","sourceId":"b3-054-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"We enjoy reading about them, especially when we find that, like the praying mantis, they lead perfectly horrible lives.","start":96.68,"end":105.0,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-014","sourceId":"b3-054-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"We enjoy staring at them, entranced as they go about their business, unaware (we hope) of our presence.","start":105.57,"end":113.07,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-015-p01","sourceId":"b3-054-015","sourceIndex":14,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"Who has not stood in awe at the sight of a spider pouncing on a fly,","start":113.49,"end":118.06,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-015-p02","sourceId":"b3-054-015","sourceIndex":14,"part":2,"parts":2,"wordRange":[16,28],"wordModel":"english-ctc-fallback","text":"or a column of ants triumphantly bearing home an enormous dead beetle?","start":118.29,"end":123.46,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-016","sourceId":"b3-054-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Last summer I spent days in the garden watching thousands of ants crawling up the trunk of my prize peach tree.","start":124.34,"end":131.83,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-017","sourceId":"b3-054-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The tree has grown against a warm wall on a sheltered side of the house.","start":132.42,"end":136.58,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-018","sourceId":"b3-054-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"I am especially proud of it, not only because it has survived several severe winters, but because it occasionally produces luscious peaches.","start":137.05,"end":146.71,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-019","sourceId":"b3-054-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"During the summer, I noticed that the leaves of the tree were beginning to wither.","start":147.36,"end":151.98,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-020","sourceId":"b3-054-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Clusters of tiny insects called aphides were to be found on the underside of the leaves.","start":152.27,"end":158.54,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-021","sourceId":"b3-054-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"They were visited by a large colony of ants which obtained a sort of honey from them.","start":159.33,"end":164.43,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-022","sourceId":"b3-054-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"I immediately embarked on an experiment which even though it failed to get rid of the ants kept me fascinated for twenty-four hours.","start":164.89,"end":172.77,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-023","sourceId":"b3-054-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"I bound the base of the tree with sticky tape, making it impossible for the ants to reach the aphides.","start":173.74,"end":179.74,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-024","sourceId":"b3-054-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The tape was so sticky that they did not dare to cross it.","start":180.33,"end":183.52,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-025","sourceId":"b3-054-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"For a long time, I watched them scurrying around the base of the tree in bewilderment.","start":184.16,"end":189.17,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-026-p01","sourceId":"b3-054-026","sourceIndex":25,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"I even went out at midnight with a torch and noted with satisfaction (and surprise)","start":189.82,"end":195.4,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-026-p02","sourceId":"b3-054-026","sourceIndex":25,"part":2,"parts":2,"wordRange":[15,33],"wordModel":"mms-fa","text":"that the ants were still swarming around the sticky tape without being able to do anything about it.","start":195.58,"end":201.18,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-027","sourceId":"b3-054-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"I got up early next morning hoping to find that the ants had given up in despair.","start":201.86,"end":206.99,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-028","sourceId":"b3-054-028","sourceIndex":27,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Instead, I saw that they had discovered a new route.","start":207.59,"end":211.47,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-029","sourceId":"b3-054-029","sourceIndex":28,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"They were climbing up the wall of the house and then on to the leaves of the tree.","start":212.0,"end":216.73,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-030","sourceId":"b3-054-030","sourceIndex":29,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"I realized sadly that I had been completely defeated by their ingenuity.","start":217.48,"end":222.52,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-054-031","sourceId":"b3-054-031","sourceIndex":30,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The ants had been quick to find an answer to my thoroughly unscientific methods!","start":222.82,"end":228.2,"score":0.923,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
