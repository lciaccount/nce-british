eviewReasons":[]},{"id":"b2-073-002","sourceId":"b2-073-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Children who play truant from school are unimaginative.","start":20.04,"end":24.67,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-003-p01","sourceId":"b2-073-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"A quiet days' fishing, or eight hours in a cinema seeing the same film over and over again,","start":26.28,"end":32.19,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-003-p02","sourceId":"b2-073-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[18,25],"wordModel":"mms-fa","text":"is usually as far as they get.","start":32.58,"end":34.49,"score":0.999,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-004","text":"They have all been put to shame by a boy who, while playing truant travelled 1, 600 miles.","start":36.073,"end":44.563,"score":0.922,"timingValid":true,"needsReview":true,"sourceId":"b2-073-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b2-073-005","sourceId":"b2-073-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"He hitchhiked to Dover and towards evening went into a boat to find somewhere to sleep.","start":46.04,"end":52.87,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-006","sourceId":"b2-073-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"When he woke up next morning, he discovered that the boat had, in the meantime, travelled to Calais.","start":54.24,"end":62.723,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-007","sourceId":"b2-073-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"No one noticed the boy as he crept off.","start":63.77,"end":66.8,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-008","sourceId":"b2-073-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"From there, he hitchhiked to Paris in a lorry.","start":67.69,"end":71.78,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-009","sourceId":"b2-073-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The driver gave him a few biscuits and a cup of coffee and left him just outside the city.","start":72.98,"end":79.29,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-010-p01","sourceId":"b2-073-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"The next car the boy stopped did not take him into the centre of Paris as he hoped it would,","start":80.62,"end":86.84,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-010-p02","sourceId":"b2-073-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[20,27],"wordModel":"mms-fa","text":"but to Perpignan on the French-Spanish border.","start":87.54,"end":91.08,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-011","sourceId":"b2-073-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"There he was picked up by a policeman and sent back to England by the local authorities.","start":92.08,"end":98.76,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-073-012","sourceId":"b2-073-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He has surely set up a record for the thousands of children who dream of evading school.","start":99.94,"end":105.83,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
