,"score":1.0},{"text":"in","offset":313,"start":130.843,"end":130.882,"score":1.0},{"text":"a","offset":316,"start":130.963,"end":130.982,"score":0.999},{"text":"word","offset":318,"start":131.042,"end":131.322,"score":0.958},{"text":"beauty","offset":323,"start":131.903,"end":132.202,"score":0.966},{"text":"means","offset":330,"start":132.262,"end":132.522,"score":0.986},{"text":"something","offset":336,"start":132.782,"end":133.142,"score":1.0},{"text":"yet","offset":346,"start":133.982,"end":134.122,"score":0.991},{"text":"we","offset":350,"start":134.343,"end":134.422,"score":1.0},{"text":"must","offset":353,"start":134.542,"end":134.742,"score":0.951},{"text":"not","offset":358,"start":134.803,"end":134.942,"score":0.993},{"text":"seek","offset":362,"start":135.062,"end":135.282,"score":0.932},{"text":"to","offset":367,"start":135.382,"end":135.482,"score":1.0},{"text":"interpret","offset":370,"start":135.623,"end":136.082,"score":0.998},{"text":"the","offset":380,"start":136.142,"end":136.202,"score":1.0},{"text":"meaning.","offset":384,"start":136.243,"end":136.502,"score":0.994}],[{"text":"If","offset":0,"start":137.982,"end":138.082,"score":0.976},{"text":"we","offset":3,"start":138.142,"end":138.202,"score":0.991},{"text":"glimpse","offset":6,"start":138.322,"end":138.682,"score":0.977},{"text":"the","offset":14,"start":138.722,"end":138.822,"score":0.869},{"text":"unutterable,","offset":18,"start":138.982,"end":139.562,"score":0.752},{"text":"it","offset":31,"start":140.183,"end":140.242,"score":0.998},{"text":"is","offset":34,"start":140.282,"end":140.362,"score":0.998},{"text":"unwise","offset":37,"start":140.482,"end":141.082,"score":0.999},{"text":"to","offset":44,"start":141.102,"end":141.162,"score":0.999},{"text":"try","offset":47,"start":141.222,"end":141.402,"score":0.986},{"text":"to","offset":51,"start":141.442,"end":141.522,"score":0.999},{"text":"utter","offset":54,"start":141.642,"end":141.882,"score":0.947},{"text":"it,","offset":60,"start":141.922,"end":142.022,"score":0.998},{"text":"nor","offset":64,"start":143.222,"end":143.422,"score":0.967},{"text":"should","offset":68,"start":143.523,"end":143.702,"score":0.998},{"text":"we","offset":75,"start":143.743,"end":143.802,"score":0.999},{"text":"seek","offset":78,"start":143.922,"end":144.122,"score":0.999},{"text":"to","offset":83,"start":144.202,"end":144.262,"score":0.999},{"text":"invest","offset":86,"start":144.343,"end":144.842,"score":1.0},{"text":"with","offset":93,"start":144.922,"end":145.082,"score":0.957},{"text":"significance","offset":98,"start":145.123,"end":145.802,"score":1.0},{"text":"that","offset":111,"start":146.262,"end":146.442,"score":0.999},{"text":"which","offset":116,"start":146.722,"end":146.902,"score":0.999},{"text":"we","offset":122,"start":146.982,"end":147.062,"score":1.0},{"text":"cannot","offset":125,"start":147.183,"end":147.482,"score":0.998},{"text":"grasp.","offset":132,"start":147.562,"end":148.002,"score":0.999}],[{"text":"Beauty","offset":0,"start":149.002,"end":149.342,"score":0.915},{"text":"in","offset":7,"start":149.863,"end":149.942,"score":0.999},{"text":"terms","offset":10,"start":150.023,"end":150.402,"score":0.986},{"text":"of","offset":16,"start":150.442,"end":150.522,"score":0.999},{"text":"our","offset":19,"start":150.562,"end":150.662,"score":0.995},{"text":"human","offset":23,"start":150.743,"end":151.022,"score":0.998},{"text":"meanings","offset":29,"start":151.083,"end":151.522,"score":0.998},{"text":"is","offset":38,"start":152.062,"end":152.202,"score":0.997},{"text":"meaningless.","offset":41,"start":152.322,"end":152.922,"score":0.996}]],"cues":[{"id":"b4-024-001","sourceId":"b4-024-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"What do glimpses of beauty, either in nature or art, often suggest to the human mind?","start":11.52,"end":17.49,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-002-p01","sourceId":"b4-024-002","sourceIndex":1,"part":1,"parts":5,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"A young man sees a sunset and, unable to understand or to express the emotion that it rouses in him,","start":20.18,"end":26.72,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-002-p02","sourceId":"b4-024-002","sourceIndex":1,"part":2,"parts":5,"wordRange":[20,33],"wordModel":"english-ctc-fallback","text":"concludes that it must be the gateway to a world that lies beyond","start":27.143,"end":31.25,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-002-p03","sourceId":"b4-024-002","sourceIndex":1,"part":3,"parts":5,"wordRange":[33,50],"wordModel":"english-ctc-fallback","text":"It is difficult for any of us in moments of intense aesthetic experience to resist the suggestion","start":32.5,"end":39.14,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-002-p04","sourceId":"b4-024-002","sourceIndex":1,"part":4,"parts":5,"wordRange":[50,70],"wordModel":"english-ctc-fallback","text":"that we are catching a glimpse of a light that shines down to us from a different realm of existence,","start":39.4,"end":45.65,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-002-p05","sourceId":"b4-024-002","sourceIndex":1,"part":5,"parts":5,"wordRange":[70,82],"wordModel":"english-ctc-fallback","text":"different and, because the experience is intensely moving, in some way higher.","start":46.21,"end":51.78,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-003-p01","sourceId":"b4-024-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"And, though the gleams blind and dazzle,","start":52.723,"end":55.54,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-003-p02","sourceId":"b4-024-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[7,24],"wordModel":"mms-fa","text":"yet do they convey a hint of beauty and serenity greater than we have known or imagined.","start":55.88,"end":61.84,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-004-p01","sourceId":"b4-024-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"Greater too than we can describe;","start":62.703,"end":64.94,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-004-p02","sourceId":"b4-024-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[6,27],"wordModel":"mms-fa","text":"for language, which was invented to convey the meanings of this world cannot readily be fitted to the uses of another.","start":65.49,"end":72.92,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-005","sourceId":"b4-024-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"That all great art has this power of suggesting a world beyond is undeniable.","start":74.443,"end":80.54,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-006","sourceId":"b4-024-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"In some moods, nature shares it.","start":81.71,"end":83.86,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-007-p01","sourceId":"b4-024-007","sourceIndex":6,"part":1,"parts":3,"wordRange":[0,17],"wordModel":"mms-fa","text":"There is no sky in June so blue that it does not point forward to a bluer,","start":84.93,"end":89.64,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-007-p02","sourceId":"b4-024-007","sourceIndex":6,"part":2,"parts":3,"wordRange":[17,32],"wordModel":"mms-fa","text":"no sunset so beautiful that it does not waken the vision of a greater beauty,","start":90.43,"end":95.43,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-007-p03","sourceId":"b4-024-007","sourceIndex":6,"part":3,"parts":3,"wordRange":[32,50],"wordModel":"mms-fa","text":"a vision which passes before it is fully glimpsed, and in passing leaves an indefinable longing and regret.","start":96.38,"end":105.04,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-008-p01","sourceId":"b4-024-008","sourceIndex":7,"part":1,"parts":5,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"But, if this world is not merely a bad joke,","start":105.84,"end":108.6,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-008-p02","sourceId":"b4-024-008","sourceIndex":7,"part":2,"parts":5,"wordRange":[10,30],"wordModel":"english-ctc-fallback","text":"life a vulgar flare amid the cool radiance of the stars, and existence an empty laugh braying across the mysteries;","start":108.99,"end":117.01,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-008-p03","sourceId":"b4-024-008","sourceIndex":7,"part":3,"parts":5,"wordRange":[30,46],"wordModel":"english-ctc-fallback","text":"if these intimations of a something behind and beyond are not evil humour born of indigestion,","start":117.87,"end":124.67,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-008-p04","sourceId":"b4-024-008","sourceIndex":7,"part":4,"parts":5,"wordRange":[46,57],"wordModel":"english-ctc-fallback","text":"or whimsies sent by the devil to mock and madden us,","start":125.3,"end":129.22,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-008-p05","sourceId":"b4-024-008","sourceIndex":7,"part":5,"parts":5,"wordRange":[57,73],"wordModel":"english-ctc-fallback","text":"if, in a word beauty means something yet we must not seek to interpret the meaning.","start":130.12,"end":136.6,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-009-p01","sourceId":"b4-024-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"If we glimpse the unutterable, it is unwise to try to utter it,","start":137.92,"end":142.1,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-009-p02","sourceId":"b4-024-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"nor should we seek to invest with significance that which we cannot grasp.","start":143.12,"end":148.11,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-024-010","sourceId":"b4-024-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Beauty in terms of our human meanings is meaningless.","start":148.9,"end":153.04,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
