score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-005","sourceId":"b3-016-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"She kept it tied to a tree in a field during the day and went to fetch it every evening.","start":35.77,"end":41.32,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-006","sourceId":"b3-016-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"One evening, however the lamb was missing.","start":42.88,"end":45.56,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-007","sourceId":"b3-016-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The rope had been cut, so it was obvious that the lamb had been stolen.","start":46.31,"end":51.58,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-008","sourceId":"b3-016-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"When Dimitri came in from the fields, his wife told him what had happened.","start":53.15,"end":57.24,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-009","sourceId":"b3-016-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Dimitri at once set out to find the thief.","start":58.34,"end":61.1,"score":0.923,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-010","sourceId":"b3-016-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"He knew it would not prove difficult in such a small village.","start":61.95,"end":65.61,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-011","sourceId":"b3-016-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"After telling several of his friends about the theft, Dimitri found out that his neighbour, Aleko, had suddenly acquired a new lamb.","start":66.7,"end":75.73,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-012","sourceId":"b3-016-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Dimitri immediately went to Aleko's house and angrily accused him of stealing the lamb.","start":76.94,"end":82.3,"score":0.909,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-013","sourceId":"b3-016-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"He told him he had better return it or he would call the police.","start":83.36,"end":86.94,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-014","sourceId":"b3-016-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Aleko denied taking it and led Dimitri into his backyard.","start":88.35,"end":93.08,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-015","sourceId":"b3-016-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"It was true that he had just bought a lamb he explained, but his lamb was black.","start":94.38,"end":100.3,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-016","sourceId":"b3-016-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Ashamed of having acted so rashly, Dimitri apologized to Aleko for having accused him.","start":101.31,"end":107.55,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-017","sourceId":"b3-016-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"While they were talking it began to rain and Dimitri stayed in Aleko's house until the rain stopped.","start":108.59,"end":115.65,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-018","sourceId":"b3-016-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"When he went outside half an hour later, he was astonished to find that the little black lamb was almost white.","start":116.62,"end":124.49,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-016-019","sourceId":"b3-016-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Its wool, which had been dyed black, had been washed clean by the rain!","start":125.49,"end":130.23,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
