"start":167.903,"end":168.122,"score":1.0},{"text":"to","offset":124,"start":168.162,"end":168.222,"score":0.997},{"text":"drink.","offset":127,"start":168.282,"end":168.542,"score":1.0}],[{"text":"Those","offset":0,"start":169.863,"end":170.122,"score":0.999},{"text":"planning","offset":6,"start":170.162,"end":170.482,"score":0.989},{"text":"a","offset":15,"start":170.523,"end":170.542,"score":0.998},{"text":"trip","offset":17,"start":170.602,"end":170.802,"score":1.0},{"text":"to","offset":22,"start":170.882,"end":170.962,"score":0.998},{"text":"remote","offset":25,"start":171.062,"end":171.422,"score":0.996},{"text":"areas,","offset":32,"start":171.523,"end":171.862,"score":0.976},{"text":"or","offset":39,"start":172.262,"end":172.342,"score":0.999},{"text":"intending","offset":42,"start":172.403,"end":172.882,"score":0.988},{"text":"to","offset":52,"start":172.903,"end":172.962,"score":0.999},{"text":"live","offset":55,"start":173.062,"end":173.302,"score":1.0},{"text":"in","offset":60,"start":173.343,"end":173.422,"score":1.0},{"text":"countries","offset":63,"start":173.523,"end":173.942,"score":0.957},{"text":"where","offset":73,"start":173.982,"end":174.162,"score":0.934},{"text":"drinking","offset":79,"start":174.243,"end":174.622,"score":0.989},{"text":"water","offset":88,"start":174.662,"end":174.942,"score":0.952},{"text":"is","offset":94,"start":175.262,"end":175.362,"score":1.0},{"text":"not","offset":97,"start":175.403,"end":175.562,"score":0.989},{"text":"readily","offset":101,"start":175.722,"end":176.022,"score":0.996},{"text":"available,","offset":109,"start":176.083,"end":176.582,"score":0.999},{"text":"should","offset":120,"start":177.142,"end":177.322,"score":0.994},{"text":"know","offset":127,"start":177.343,"end":177.522,"score":0.981},{"text":"about","offset":132,"start":177.562,"end":177.822,"score":0.976},{"text":"the","offset":138,"start":177.863,"end":177.942,"score":0.998},{"text":"various","offset":142,"start":178.062,"end":178.442,"score":0.999},{"text":"possible","offset":150,"start":178.542,"end":178.922,"score":0.991},{"text":"methods","offset":159,"start":178.963,"end":179.342,"score":1.0},{"text":"for","offset":167,"start":179.602,"end":179.742,"score":0.976},{"text":"making","offset":171,"start":179.843,"end":180.202,"score":0.996},{"text":"water","offset":178,"start":180.282,"end":180.562,"score":0.982},{"text":"safe.","offset":184,"start":180.722,"end":181.042,"score":0.905}]],"cues":[{"id":"b4-038-001","sourceId":"b4-038-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"What does this text describe?","start":12.02,"end":14.28,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-002-p01","sourceId":"b4-038-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Contamination of water supplies is usually due to poor sanitation close to water sources, sewage disposal into the sources themselves,","start":16.86,"end":26.53,"score":0.819,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-002-p02","sourceId":"b4-038-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[20,33],"wordModel":"mms-fa","text":"leakage of sewage into distribution systems or contamination with industrial or farm waste.","start":27.24,"end":33.58,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-003","sourceId":"b4-038-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Even if a piped water supply is safe at its source, it is not always safe by the time it reaches the tap.","start":34.95,"end":41.92,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-004","sourceId":"b4-038-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Intermittent tap-water supplies should be regarded as particularly suspect.","start":43.28,"end":48.5,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-005","sourceId":"b4-038-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Travellers on short trips to areas with water supplies of uncertain quality should avoid drinking tap-water, or untreated water from any other source.","start":49.72,"end":60.5,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-006-p01","sourceId":"b4-038-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"It is best to keep to hot drinks,","start":61.58,"end":63.62,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-006-p02","sourceId":"b4-038-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[8,26],"wordModel":"mms-fa","text":"bottled or canned drinks of well-known brand names-international standard of water treatment are usually followed at bottling plants.","start":63.98,"end":72.62,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-007","sourceId":"b4-038-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Carbonated drinks are acidic, and slightly safer.","start":73.7,"end":76.89,"score":0.88,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-008","sourceId":"b4-038-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Make sure that all bottles are opened in your presence, and that their rims are clean and dry.","start":77.86,"end":83.98,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-009","sourceId":"b4-038-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Boiling is always a good way of treating water.","start":85.12,"end":87.9,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-010","sourceId":"b4-038-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Some hotels supply boiled water on request and this can be used for drinking, or for brushing teeth.","start":88.92,"end":95.24,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-011","sourceId":"b4-038-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Portable boiling elements that can boil small quantities of water are useful when the right voltage of electricity is available.","start":96.46,"end":104.48,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-012","sourceId":"b4-038-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Refuse politely any cold drink from an unknown source.","start":105.36,"end":109.5,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-013-p01","sourceId":"b4-038-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Ice is only as safe as the water from which it is made,","start":110.83,"end":114.18,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-013-p02","sourceId":"b4-038-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[13,27],"wordModel":"mms-fa","text":"and should not be put in drinks unless it is known to be safe.","start":114.56,"end":118.3,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-014","sourceId":"b4-038-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"Drinks can be cooled by placing them on ice rather than adding ice to them.","start":119.26,"end":124.26,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-015","sourceId":"b4-038-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Alcohol may be a medical disinfectant, but should not be relied upon to sterilize water.","start":125.39,"end":131.41,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-016","sourceId":"b4-038-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Ethanol is more effective at a concentration of 50-70 percent; below 20 per cent, its bactericidal action is negligible.","start":132.53,"end":143.25,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-017","sourceId":"b4-038-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Spirits labelled 95 proof contain only about 47 per cent alcohol.","start":144.31,"end":150.29,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-018","sourceId":"b4-038-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Beware of methylated alcohol, which is very poisonous and should never be added to drinking water.","start":151.082,"end":158.23,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-019-p01","sourceId":"b4-038-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"If no other safe water supply can be obtained,","start":159.43,"end":162.32,"score":0.884,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-019-p02","sourceId":"b4-038-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[9,28],"wordModel":"mms-fa","text":"tap water that is too hot to touch can be left to cool and is generally safe to drink.","start":162.74,"end":168.63,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-020-p01","sourceId":"b4-038-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Those planning a trip to remote areas, or intending to live in countries where drinking water is not readily available,","start":169.623,"end":176.76,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-038-020-p02","sourceId":"b4-038-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[20,31],"wordModel":"mms-fa","text":"should know about the various possible methods for making water safe.","start":176.902,"end":181.13,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
