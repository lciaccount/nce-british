-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"NASA is now going to put the telescope right, so it will soon be sending up four astronauts to repair it.","start":46.82,"end":55.0,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-006","sourceId":"b2-061-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The shuttle Endeavour will be taking the astronauts to the Hubble.","start":56.2,"end":60.92,"score":0.831,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-007","sourceId":"b2-061-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"A robot-arm from the Endeavour will grab the telescope and hold it while the astronauts make the necessary repairs.","start":62.12,"end":71.33,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-008-p01","sourceId":"b2-061-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Of course, the Hubble is above the earth's atmosphere,","start":72.4,"end":77.27,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-008-p02","sourceId":"b2-061-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[9,30],"wordModel":"mms-fa","text":"so it will soon be sending us the clearest pictures of the stars and distant galaxies that we have ever seen.","start":78.01,"end":86.06,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-009","sourceId":"b2-061-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The Hubble will tell us a great deal about the age and size of the universe.","start":87.1,"end":92.943,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-061-010","sourceId":"b2-061-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"By the time you read this, the Hubble's eagle eye will have sent us thousands and thousands of wonderful pictures.","start":94.08,"end":102.03,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
