,4],"wordModel":"mms-fa","text":"I can't have been.","start":36.41,"end":37.68,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-009","sourceId":"b1-129-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"I was doing eighty when I overtook you.","start":39.34,"end":41.9,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-010","sourceId":"b1-129-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Didn't you see the speed limit?","start":43.52,"end":45.59,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-011","sourceId":"b1-129-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I'm afraid I didn't, officer.","start":47.26,"end":48.98,"score":0.901,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-012","sourceId":"b1-129-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I must have been dreaming.","start":49.72,"end":51.34,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-013","sourceId":"b1-129-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"He wasn't dreaming, officer.","start":52.34,"end":54.17,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-014","sourceId":"b1-129-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I was telling him to drive slowly.","start":54.723,"end":57.25,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-015","sourceId":"b1-129-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"That's why I didn't see the sign.","start":57.68,"end":60.48,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-016","sourceId":"b1-129-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Let me see your driving licence.","start":62.08,"end":64.36,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-017","sourceId":"b1-129-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"I won't charge you this time.","start":66.13,"end":68.13,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-018","sourceId":"b1-129-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"But you'd better not do it again!","start":68.54,"end":70.72,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-019","sourceId":"b1-129-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"english-ctc-fallback","text":"Thank you.","start":71.55,"end":72.14,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-020","sourceId":"b1-129-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"I'll certainly be more careful.","start":72.94,"end":74.67,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-021","sourceId":"b1-129-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I told you to drive slowly, Gary.","start":75.72,"end":78.41,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-022","sourceId":"b1-129-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"You always tell me to drive slowly, darling.","start":79.2,"end":82.39,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-129-023","sourceId":"b1-129-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Well, next time you'd better take my advice!","start":82.88,"e