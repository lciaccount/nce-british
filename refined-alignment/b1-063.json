.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-020","sourceId":"b1-063-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Where's Mr. Williams this evening?","start":71.22,"end":73.4,"score":0.677,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-021","sourceId":"b1-063-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"He's in bed, doctor.","start":74.3,"end":75.85,"score":0.856,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-022","sourceId":"b1-063-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Can you see him please?","start":76.78,"end":78.4,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-023","sourceId":"b1-063-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"He has a bad cold, too!","start":79.1,"end":80.93,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
