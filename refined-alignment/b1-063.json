":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"Better.","start":21.26,"end":21.712,"score":0.65,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-005","sourceId":"b1-063-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"Thank you, doctor.","start":21.712,"end":22.75,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-006","sourceId":"b1-063-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Can I see him please, Mrs. Williams?","start":23.7,"end":26.4,"score":0.821,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-007","sourceId":"b1-063-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"english-ctc-fallback","text":"Certainly, doctor.","start":26.63,"end":27.83,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-008","sourceId":"b1-063-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"Come upstairs.","start":28.22,"end":29.25,"score":0.847,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-009","sourceId":"b1-063-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"You look very well, Jimmy.","start":31.14,"end":33.27,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-010","sourceId":"b1-063-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"You are better now, but you mustn't get up yet.","start":33.88,"end":38.06,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-011","sourceId":"b1-063-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"You must stay in bed for another two days.","start":38.94,"end":42.39,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-063-012","s