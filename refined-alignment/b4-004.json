":134.082,"score":0.925},{"text":"fingers","offset":67,"start":134.162,"end":134.622,"score":0.999},{"text":"this","offset":75,"start":135.303,"end":135.522,"score":0.998},{"text":"ability","offset":80,"start":135.722,"end":136.122,"score":1.0},{"text":"ceased","offset":88,"start":136.262,"end":136.622,"score":0.827},{"text":"the","offset":95,"start":136.942,"end":137.042,"score":0.974},{"text":"moment","offset":99,"start":137.142,"end":137.462,"score":0.999},{"text":"her","offset":106,"start":137.683,"end":137.802,"score":0.996},{"text":"hands","offset":110,"start":137.863,"end":138.202,"score":0.988},{"text":"were","offset":116,"start":138.442,"end":138.622,"score":0.999},{"text":"wet.","offset":121,"start":138.722,"end":138.982,"score":0.998}]],"cues":[{"id":"b4-004-001","sourceId":"b4-004-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"How did Vera disover she had this gift of second sight?","start":11.78,"end":15.64,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-002-p01","sourceId":"b4-004-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"Several cases have been reported in Russia recently of people who can read and detect colours with their fingers,","start":18.39,"end":25.68,"score":0.878,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-002-p02","sourceId":"b4-004-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[19,27],"wordModel":"mms-fa","text":"and even see through solid doors and walls.","start":26.022,"end":28.92,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-003-p01","sourceId":"b4-004-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"One case concerns an 11-year-old schoolgirl Vera Petrova,","start":30.23,"end":35.57,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-003-p02","sourceId":"b4-004-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[8,28],"wordModel":"mms-fa","text":"who has normal vision but who can also perceive things with different parts of her skin, and through solid walls.","start":35.92,"end":43.76,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-004","sourceId":"b4-004-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"This ability was first noticed by her father.","start":44.99,"end":47.69,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-005","sourceId":"b4-004-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"One day she came into his office and happened to put her hands on the door of a locked safe.","start":49.14,"end":54.96,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-006-p01","sourceId":"b4-004-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Suddenly she asked her father why he kept so many old newspapers locked away there,","start":55.82,"end":61.4,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-006-p02","sourceId":"b4-004-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[15,26],"wordModel":"mms-fa","text":"and even described the way they were done up in bundles.","start":61.9,"end":65.43,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-007-p01","sourceId":"b4-004-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"mms-fa","text":"Vera's curious talent was brought to the notice of a scientific research institute in the town of Ulyanovsk, near where she lives,","start":66.72,"end":75.6,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-007-p02","sourceId":"b4-004-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[22,46],"wordModel":"mms-fa","text":"and in April she was given a series of tests by a special commission of the Ministry of Health of the Russian Federal Republic.","start":76.4,"end":84.16,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-008-p01","sourceId":"b4-004-008","sourceIndex":7,"part":1,"parts":3,"wordRange":[0,17],"wordModel":"mms-fa","text":"During these tests she was able to read a newspaper through an opaque screen and, stranger still,","start":85.38,"end":92.31,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-008-p02","sourceId":"b4-004-008","sourceIndex":7,"part":2,"parts":3,"wordRange":[17,43],"wordModel":"mms-fa","text":"by moving her elbow over a child's game of Lotto she was able to describe the figures and colours printed on it; and, in another instance,","start":92.72,"end":103.42,"score":0.892,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-008-p03","sourceId":"b4-004-008","sourceIndex":7,"part":3,"parts":3,"wordRange":[43,64],"wordModel":"mms-fa","text":"wearing stockings and slippers, to make out with her foot the outlines and colours of a picture hidden under a carpet.","start":103.74,"end":111.94,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-009","sourceId":"b4-004-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Other experiments showed that her knees and shoulders had a similar sensitivity.","start":113.1,"end":118.21,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-010","sourceId":"b4-004-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"During all these tests Vera was blindfold; and indeed, except when blindfold she lacked the ability to perceive things with her skin.","start":119.25,"end":129.26,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-004-011","sourceId":"b4-004-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"It was also found that although she could perceive things with her fingers this ability ceased the moment her hands were wet.","start":130.21,"end":139.1,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
