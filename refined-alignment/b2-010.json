xt":"It is called a clavichord.","start":24.52,"end":27.04,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-004","sourceId":"b2-010-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"It was made in Germany in 1681.","start":28.56,"end":31.85,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-005","sourceId":"b2-010-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Our clavichord is kept in the living room.","start":33.16,"end":35.95,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-006","sourceId":"b2-010-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"It has belonged to our family for a long time.","start":36.78,"end":40.34,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-007","sourceId":"b2-010-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The instrument was bought by my grandfather many years ago.","start":41.44,"end":46.12,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-008","sourceId":"b2-010-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Recently it was damaged by a visitor.","start":47.62,"end":50.57,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-009","sourceId":"b2-010-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"She tried to play jazz on it!","start":51.403,"end":54.46,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-010","sourceId":"b2-010-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"She struck the keys too hard and two of the strings were broken.","start":55.07,"end":60.84,"score":0.903,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-011","sourceId":"b2-010-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"My father was shocked.","start":62.31,"end":64.67,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-012","sourceId":"b2-010-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Now we are not allowed to touch it.","start":65.49,"end":67.88,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-010-013","sourceId":"b2-010-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"It is being repaired by a friend of my father's.","start":68.32,"end":71.42,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
