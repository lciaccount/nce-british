dsReview":false,"reviewReasons":[]},{"id":"b3-003-004","sourceId":"b3-003-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The city at one time must have been prosperous, for it enjoyed a high level of civilization.","start":35.3,"end":41.43,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-005","sourceId":"b3-003-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Houses -- often three storeys high -- were built of stone.","start":42.34,"end":46.58,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-006","sourceId":"b3-003-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"They had large rooms with beautifully decorated walls.","start":47.74,"end":51.22,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-007","sourceId":"b3-003-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"The city was even equipped with a drainage system, for a great many clay pipes were found beneath the narrow streets.","start":52.28,"end":59.18,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-008","sourceId":"b3-003-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The temple which the archaeologists explored was used as a place of worship from the fifteenth century B.C.","start":61.05,"end":68.5,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-009","sourceId":"b3-003-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"until Roman times.","start":68.88,"end":70.16,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-010","sourceId":"b3-003-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"In the most sacred room of the temple, clay fragments of fifteen statues were found.","start":71.12,"end":76.71,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-011","sourceId":"b3-003-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Each of these represented a goddess and had, at one time, been painted.","start":77.98,"end":83.42,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-012","sourceId":"b3-003-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The body of one statue was found among remains dating from the 15th century B.C.","start":84.88,"end":90.57,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-013","sourceId":"b3-003-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Its missing head happened to be among remains of the fifth century B.C.","start":91.99,"end":96.46,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-014","sourceId":"b3-003-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"This head must have been found in Classical times and carefully preserved.","start":98.14,"end":103.13,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-015","sourceId":"b3-003-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It was very old and precious even then.","start":104.35,"end":107.17,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-016","sourceId":"b3-003-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"When the archaeologists reconstructed the fragments, they were amazed to find that the goddess turned out to be a very modern-looking woman.","start":108.42,"end":117.31,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-017","sourceId":"b3-003-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"She stood three feet high and her hands rested on her hips.","start":118.62,"end":122.63,"score":0.918,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-018","sourceId":"b3-003-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"She was wearing a full-length skirt which swept the ground.","start":123.41,"end":127.07,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-003-019","sourceId":"b3-003-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Despite her great age, she was very graceful indeed, but, so far, the archaeologists have been unable to discover her identity.","start":128.18,"end":137.39,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
