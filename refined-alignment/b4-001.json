fset":85,"start":124.322,"end":124.383,"score":1.0},{"text":"the","offset":88,"start":124.422,"end":124.503,"score":0.983},{"text":"men","offset":92,"start":124.543,"end":124.763,"score":0.999},{"text":"who","offset":96,"start":124.862,"end":124.963,"score":0.935},{"text":"made","offset":100,"start":125.082,"end":125.303,"score":0.996},{"text":"them","offset":105,"start":125.322,"end":125.483,"score":0.99},{"text":"have","offset":110,"start":126.162,"end":126.323,"score":0.999},{"text":"disappeared","offset":115,"start":126.382,"end":127.043,"score":0.994},{"text":"without","offset":127,"start":127.582,"end":127.943,"score":0.994},{"text":"trace.","offset":135,"start":128.023,"end":128.442,"score":0.999}]],"cues":[{"id":"b4-001-001","sourceId":"b4-001-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Why are legends handed down by storytellers useful?","start":12.0,"end":15.85,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-002","sourceId":"b4-001-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"We can read of things that happened 5, 000 years ago in the Near East, where people first learned to write.","start":18.55,"end":26.0,"score":0.871,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-001-003","sourceId":"b4-001-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"But there are some parts of the world where even now people cannot write.","start":27.24,"end":32.02,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-004","sourceId":"b4-001-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,25],"wordModel":"mms-fa","text":"The only way that they can preserve their history is to recount it as sagas legends handed down from one generation of storytellers to another.","start":33.22,"end":45.17,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-005-p01","sourceId":"b4-001-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"These legends are useful because they can tell us something about migrations of people who lived long ago,","start":46.703,"end":54.91,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-005-p02","sourceId":"b4-001-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[18,26],"wordModel":"mms-fa","text":"but none could write down what they did.","start":55.84,"end":58.82,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-006","sourceId":"b4-001-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Anthropologists wondered where the remote ancestors of the Polynesian peoples now living in the Pacific Islandscame from.","start":60.4,"end":68.82,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-007","sourceId":"b4-001-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The sagas of these people explain that some of them came from Indonesia about 2, 000 years ago.","start":70.08,"end":77.47,"score":0.89,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-001-008","sourceId":"b4-001-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"english-ctc-fallback","text":"But the first people who were like ourselves lived so long ago that even their sagas, if they had any, are forgotten.","start":79.1,"end":87.87,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-009","sourceId":"b4-001-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"So archaeologists have neither history nor legends to help them to find out where the first 'modern men' came from.","start":88.862,"end":97.38,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-010","sourceId":"b4-001-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Fortunately, however, ancient men made tools of stone, especially flint, because this is easier to shape than other kinds.","start":98.96,"end":108.92,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-011","sourceId":"b4-001-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"They may also have used wood and skins, but these have rotted away.","start":109.982,"end":115.41,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-012-p01","sourceId":"b4-001-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Stone does not decay, and so the tools of long ago have remained","start":116.5,"end":121.86,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-001-012-p02","sourceId":"b4-001-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[13,27],"wordModel":"mms-fa","text":"when even the bones of the men who made them have disappeared without trace.","start":122.64,"end":128.52,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
