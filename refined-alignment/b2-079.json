0,14],"wordModel":"mms-fa","text":"I used to travel by air a great deal when I was a boy.","start":17.46,"end":20.99,"score":0.873,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-003","sourceId":"b2-079-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"My parents used to live in South America and I used to fly there from Europe in the holidays.","start":22.042,"end":28.65,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-004","sourceId":"b2-079-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"A flight attendant would take charge of me and I never had an unpleasant experience.","start":30.1,"end":35.56,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-005","sourceId":"b2-079-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"I am used to travelling by air and only on one occasion have I ever felt frightened.","start":36.69,"end":43.02,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-006-p01","sourceId":"b2-079-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"After taking off, we were flying low over the city and slowly gaining height,","start":44.11,"end":50.21,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-006-p02","sourceId":"b2-079-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[14,26],"wordModel":"mms-fa","text":"when the plane suddenly turned round and flew back to the airport.","start":50.99,"end":55.24,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-007-p01","sourceId":"b2-079-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"While we were waiting to land,","start":56.52,"end":58.28,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-007-p02","sourceId":"b2-079-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[6,28],"wordModel":"mms-fa","text":"a flight attendant told us to keep calm and to get off the plane quietly as soon as it had touched down.","start":58.82,"end":65.82,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-008","sourceId":"b2-079-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Everybody on board was worried and we were curious to find out what had happened.","start":67.32,"end":72.86,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-009","sourceId":"b2-079-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Later we learnt that there was a very important person on board.","start":74.14,"end":78.7,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-010","sourceId":"b2-079-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The police had been told that a bomb had been planted on the plane.","start":79.8,"end":84.07,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-011","sourceId":"b2-079-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"After we had landed, the plane was searched thoroughly.","start":84.93,"end":88.83,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-079-012","sourceId":"b2-079-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Fortunately, nothing was found and five hours later we were able to take off again.","start":89.88,"end":95.33,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
