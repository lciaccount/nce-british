":1,"parts":3,"wordRange":[0,13],"wordModel":"mms-fa","text":"Many people in industry and the Services, who have practical experience of noise,","start":18.22,"end":23.58,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-002-p02","sourceId":"b4-025-002","sourceIndex":1,"part":2,"parts":3,"wordRange":[13,24],"wordModel":"mms-fa","text":"regard any investigation of this question as a waste of time;","start":23.862,"end":27.92,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-002-p03","sourceId":"b4-025-002","sourceIndex":1,"part":3,"parts":3,"wordRange":[24,37],"wordModel":"mms-fa","text":"they are not prepared even to admit the possibility that noise affects people.","start":28.542,"end":33.58,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-003","sourceId":"b4-025-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"On the other hand, those who dislike noise will sometimes use most inadequate evidence to support their pleas for a quieter society.","start":34.47,"end":43.39,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-004-p01","sourceId":"b4-025-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"This is a pity, because noise abatement really is a good cause,","start":44.46,"end":49.62,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-004-p02","sourceId":"b4-025-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[12,28],"wordModel":"mms-fa","text":"and it is likely to be discredited if it gets to be associated with bad science.","start":50.003,"end":54.96,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-005","text":"One allegation often made is that noise produces mental illness.","start":56.972,"end":61.663,"score":0.934,"timingValid":true,"needsReview":true,"sourceId":"b4-025-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b4-025-006-p01","sourceId":"b4-025-006","sourceIndex":5,"part":1,"parts":3,"wordRange":[0,9],"wordModel":"mms-fa","text":"A recent article in a weekly newspaper, for instance,","start":62.89,"end":66.05,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-006-p02","sourceId":"b4-025-006","sourceIndex":5,"part":2,"parts":3,"wordRange":[9,24],"wordModel":"mms-fa","text":"was headed with a striking illustration of a lady in a state of considerable distress,","start":66.44,"end":71.81,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-006-p03","sourceId":"b4-025-006","sourceIndex":5,"part":3,"parts":3,"wordRange":[24,37],"wordModel":"mms-fa","text":"with the caption 'She was yet another victim, reduced to a screaming wreck'.","start":72.26,"end":78.16,"score":0.906,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-025-007-p01","sourceId":"b4-025-007","sourceIndex":6,"part":1,"parts":3,"wordRange":[0,6],"wordModel":"mms-fa","text":"On turning eagerly to the text,","start":79.142,"end":81.12,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-007-p02","sourceId":"b4-025-007","sourceIndex":6,"part":2,"parts":3,"wordRange":[6,26],"wordModel":"mms-fa","text":"one learns that the lady was a typist who found the sound of office typewriters worried her more and more","start":81.56,"end":88.56,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-007-p03","sourceId":"b4-025-007","sourceIndex":6,"part":3,"parts":3,"wordRange":[26,36],"wordModel":"mms-fa","text":"until eventually she had to go into a mental hospital.","start":88.72,"end":92.68,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-008","sourceId":"b4-025-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Now the snag in this sort of anecdote is of course that one cannot distinguish cause and effect.","start":93.72,"end":100.34,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-009","sourceId":"b4-025-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Was the noise a cause of the illness, or were the complaints about noise merely a symptom?","start":101.52,"end":107.38,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-010-p01","sourceId":"b4-025-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Another patient might equally well complain that her neighbours were combining to slander her and persecute her,","start":108.31,"end":114.72,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-010-p02","sourceId":"b4-025-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[17,27],"wordModel":"mms-fa","text":"and yet one might be cautious about believing this statement.","start":115.023,"end":118.38,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-011-p01","sourceId":"b4-025-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"What is needed in the case of noise is a study of large numbers of people living under noisy conditions,","start":119.94,"end":126.56,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-011-p02","sourceId":"b4-025-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[20,33],"wordModel":"mms-fa","text":"to discover whether they are mentally ill more often than other people are.","start":127.06,"end":131.22,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-012-p01","sourceId":"b4-025-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Some time ago the United States Navy, for instance, examined a very large number of men working on aircraft carriers:","start":132.45,"end":140.04,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-012-p02","sourceId":"b4-025-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[20,27],"wordModel":"mms-fa","text":"the study was known as Project Anehin.","start":140.742,"end":143.66,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-013-p01","sourceId":"b4-025-013","sourceIndex":12,"part":1,"parts":3,"wordRange":[0,12],"wordModel":"mms-fa","text":"It can be unpleasant to live even several miles from an aerodrome;","start":144.503,"end":148.58,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-013-p02","sourceId":"b4-025-013","sourceIndex":12,"part":2,"parts":3,"wordRange":[12,33],"wordModel":"mms-fa","text":"if you think what it must be like to share the deck of a ship with several squadrons of jet aircraft,","start":149.68,"end":155.52,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-013-p03","sourceId":"b4-025-013","sourceIndex":12,"part":3,"parts":3,"wordRange":[33,47],"wordModel":"mms-fa","text":"you will realize that a modern navy is a good place to study noise.","start":156.02,"end":160.3,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-014","sourceId":"b4-025-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"But neither psychiatric interviews nor objective tests were able to show any effects upon these American sailors.","start":161.44,"end":169.44,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-015-p01","sourceId":"b4-025-015","sourceIndex":14,"part":1,"parts":3,"wordRange":[0,9],"wordModel":"mms-fa","text":"This result merely confirms earlier American and British studies:","start":170.71,"end":175.21,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-015-p02","sourceId":"b4-025-015","sourceIndex":14,"part":2,"parts":3,"wordRange":[9,19],"wordModel":"mms-fa","text":"if there is any effect of noise upon mental health,","start":176.02,"end":178.82,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-015-p03","sourceId":"b4-025-015","sourceIndex":14,"part":3,"parts":3,"wordRange":[19,33],"wordModel":"mms-fa","text":"it must be so small that present methods of psychiatric diagnosis cannot find it.","start":179.32,"end":184.76,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-016-p01","sourceId":"b4-025-016","sourceIndex":15,"part":1,"parts":3,"wordRange":[0,9],"wordModel":"mms-fa","text":"That does not prove that it does not exist;","start":185.88,"end":188.67,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-016-p02","sourceId":"b4-025-016","sourceIndex":15,"part":2,"parts":3,"wordRange":[9,19],"wordModel":"mms-fa","text":"but it does mean that noise is less dangerous than,","start":189.33,"end":192.553,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-025-016-p03","sourceId":"b4-025-016","sourceIndex":15,"part":3,"parts":3,"wordRange":[19,33],"wordModel":"mms-fa","text":"say being brought up in an orphanage --which really is a mental health hazard.","start":192.553,"end":197.96,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
