t":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"As long ago as the fourteenth century, an Englishman, Sir John Hawkwood,","start":41.92,"end":47.57,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-005-p02","sourceId":"b3-014-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[12,33],"wordModel":"mms-fa","text":"made the remarkable discovery that people would rather pay large sums of money than have their life work destroyed by gangsters.","start":47.89,"end":55.09,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-006","sourceId":"b3-014-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Six hundred years ago, Sir John Hawkwood arrived in Italy with a band of soldiers and settled near Florence.","start":56.46,"end":63.84,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-007","sourceId":"b3-014-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"He soon made a name for himself and came to be known to the Italians as Giovanni Acuto.","start":64.62,"end":70.92,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-008-p01","sourceId":"b3-014-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Whenever the Italian city-states were at war with each other,","start":72.31,"end":75.28,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-008-p02","sourceId":"b3-014-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"Hawkwood used to hire his soldiers to princes who were willing to pay the high price he demanded.","start":75.7,"end":81.46,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-009-p01","sourceId":"b3-014-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"In times of peace, when business was bad, Hawkwood and his men would march into a city-state,","start":82.58,"end":89.26,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-009-p02","sourceId":"b3-014-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[17,36],"wordModel":"mms-fa","text":"and after burning down a few farms, would offer to go away if protection money was paid to them.","start":89.56,"end":95.75,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-010","sourceId":"b3-014-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Hawkwood made large sums of money in this way.","start":96.74,"end":99.57,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-011","sourceId":"b3-014-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"In spite of this, the Italians regarded him as a sort of hero.","start":100.84,"end":104.83,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-012-p01","sourceId":"b3-014-012","sourceIndex":11,"part":1,"parts":3,"wordRange":[0,8],"wordModel":"mms-fa","text":"When he died at the age of eighty,","start":105.96,"end":108.14,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-012-p02","sourceId":"b3-014-012","sourceIndex":11,"part":2,"parts":3,"wordRange":[8,20],"wordModel":"mms-fa","text":"the Florentines gave him a state funeral and had a picture painted","start":108.74,"end":113.282,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-014-012-p03","sourceId":"b3-014-012","sourceIndex":11,"part":3,"parts":3,"wordRange":[20,38],"wordModel":"mms-fa","text":"which was dedicated to the memory of 'the most valiant soldier and most notable leader, Signor Giovanni Haukodue'.","start":113.38,"end":122.01,"score":0.882,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]}]}
