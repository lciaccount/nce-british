069-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"The winner was Billy Stewart.","start":65.84,"end":67.92,"score":0.87,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-069-013","sourceId":"b1-069-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"He was in car number fifteen.","start":69.24,"end":71.43,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-069-014","sourceId":"b1-069-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Five other cars were just behind him.","start":72.39,"end":75.46,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-069-015","sourceId":"b1-069-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"On the way home, my wife said to me, 'Don't drive so quickly!","start":77.3,"end":83.16,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-069-016","sourceId":"b1-069-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"You're not Billy Stewart!'","start":83.74,"end":85.39,"score":0.91,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
