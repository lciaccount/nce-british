t":"espionage!","offset":61,"start":141.982,"end":142.682,"score":0.837}]],"cues":[{"id":"b4-009-001","sourceId":"b4-009-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"What important thing did King Alfred learn when he penetrated the Danish camp of Guthrum?","start":12.8,"end":19.46,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-002","sourceId":"b4-009-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Alfred the Great acted as his own spy, visiting Danish camps disguised as a minstrel.","start":22.18,"end":28.96,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-003","sourceId":"b4-009-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"In those days wandering minstrels were welcome everywhere.","start":29.802,"end":33.46,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-004","sourceId":"b4-009-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"They were not fighting men, and their harp was their passport.","start":34.09,"end":38.12,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-005","sourceId":"b4-009-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Alfred had learned many of their ballads in his youth and could vary his programme with acrobatic tricks and simple conjuring.","start":39.13,"end":47.25,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-006-p01","sourceId":"b4-009-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"While Alfred's little army slowly began to gather at Athelney,","start":48.68,"end":53.1,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-006-p02","sourceId":"b4-009-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[10,27],"wordModel":"mms-fa","text":"the king himself set out to penetrate the camp of Guthrum, the commander of the Danish invaders.","start":53.68,"end":60.17,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-007","sourceId":"b4-009-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"These had settled down for the winter at Chippenham: thither Alfred went.","start":61.46,"end":66.74,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-008","sourceId":"b4-009-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"He noticed at once that discipline was slack: the Danes had the self-confidence of conquerors, and their security precautions were casual.","start":67.24,"end":76.69,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-009","sourceId":"b4-009-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"They lived well, on the proceeds of raids on neighbouring regions.","start":77.74,"end":81.38,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-010","sourceId":"b4-009-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"There they collected women as well as food and drink, and a life of ease had made them soft.","start":82.17,"end":88.32,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-011","sourceId":"b4-009-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Alfred stayed in the camp a week before he returned to Athelney.","start":89.85,"end":93.71,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-012","sourceId":"b4-009-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The force there assembled was trivial compared with the Danish horde.","start":94.62,"end":98.6,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-013-p01","sourceId":"b4-009-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"But Alfred had deduced that the Danes were no longer fit for prolonged battle:","start":99.223,"end":104.06,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-013-p02","sourceId":"b4-009-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[14,26],"wordModel":"mms-fa","text":"and that their commissariat had no organization, but depended on irregular raids.","start":105.04,"end":110.75,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-014","sourceId":"b4-009-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"So, faced with the Danish advance, Alfred did not risk open battle but harried the enemy.","start":111.85,"end":118.7,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-015","sourceId":"b4-009-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He was constantly on the move, drawing the Danes after him.","start":119.26,"end":123.03,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-016","sourceId":"b4-009-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"His patrols halted the raiding parties: hunger assailed the Danish army.","start":123.78,"end":128.91,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-017","sourceId":"b4-009-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Now Alfred began a long series of skirmishes -- and within a month the Danes had surrendered.","start":130.07,"end":136.62,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-009-018","sourceId":"b4-009-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The episode could reasonably serve as a unique epic of royal espionage!","start":137.202,"end":142.76,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
