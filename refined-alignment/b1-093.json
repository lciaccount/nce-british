93-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The month after next he'll fly to Tokyo.","start":28.82,"end":31.45,"score":0.889,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-007","sourceId":"b1-093-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"At the moment, he's in Madrid.","start":32.78,"end":34.65,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-008","sourceId":"b1-093-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"He flew to Spain a week ago.","start":35.5,"end":37.64,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-009","sourceId":"b1-093-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He'll return to London the week after next.","start":38.64,"end":41.25,"score":0.851,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-010","sourceId":"b1-093-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He's only forty-one years old, and he has already been to nearly every country in the world.","start":42.31,"end":48.94,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-011","sourceId":"b1-093-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Nigel is a very lucky man.","start":50.11,"end":52.67,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-012","sourceId":"b1-093-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"But his wife isn't very lucky.","start":53.36,"end":55.27,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-093-013","sourceId":"b1-093-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"She usually stays at home!","start":5