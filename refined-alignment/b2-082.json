"text":"an","offset":100,"start":99.302,"end":99.383,"score":0.996},{"text":"oarfish.","offset":103,"start":99.642,"end":100.343,"score":0.678}],[{"text":"Such","offset":0,"start":101.903,"end":102.143,"score":0.937},{"text":"creatures","offset":5,"start":102.282,"end":102.683,"score":1.0},{"text":"have","offset":15,"start":102.722,"end":102.843,"score":0.975},{"text":"rarely","offset":20,"start":102.922,"end":103.263,"score":0.94},{"text":"been","offset":27,"start":103.322,"end":103.483,"score":1.0},{"text":"seen","offset":32,"start":103.602,"end":103.803,"score":0.997},{"text":"alive","offset":37,"start":103.903,"end":104.263,"score":1.0},{"text":"by","offset":43,"start":104.343,"end":104.483,"score":1.0},{"text":"man","offset":46,"start":104.602,"end":104.843,"score":1.0},{"text":"as","offset":50,"start":105.462,"end":105.523,"score":0.888},{"text":"they","offset":53,"start":105.602,"end":105.723,"score":0.952},{"text":"live","offset":58,"start":105.802,"end":105.983,"score":0.995},{"text":"at","offset":63,"start":106.022,"end":106.063,"score":0.991},{"text":"a","offset":66,"start":106.162,"end":106.183,"score":0.998},{"text":"depth","offset":68,"start":106.302,"end":106.643,"score":0.971},{"text":"of","offset":74,"start":106.903,"end":106.943,"score":1.0},{"text":"six","offset":77,"start":107.102,"end":107.283,"score":0.919},{"text":"hundred","offset":81,"start":107.522,"end":107.843,"score":0.978},{"text":"feet.","offset":89,"start":107.942,"end":108.183,"score":0.952}]],"cues":[{"id":"b2-082-001","sourceId":"b2-082-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"What was the monster called?","start":13.21,"end":15.88,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-002","sourceId":"b2-082-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Fishermen and sailors sometimes claim to have seen monsters in the sea.","start":18.462,"end":23.46,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-003-p01","sourceId":"b2-082-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Though people have often laughed at stories told by seamen,","start":25.25,"end":29.03,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-003-p02","sourceId":"b2-082-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[10,29],"wordModel":"mms-fa","text":"it is now known that many of these 'monsters' which have at times been sighted are simply strange fish.","start":29.78,"end":38.9,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-004","sourceId":"b2-082-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Occasionally, unusual creatures are washed to the shore, but they are rarely caught out at sea.","start":40.47,"end":48.22,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-005","sourceId":"b2-082-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Some time ago, however, a peculiar fish was caught near Madagascar.","start":49.24,"end":54.93,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-006","sourceId":"b2-082-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"A small fishing boat was carried miles out to sea by the powerful fish as it pulled on the line.","start":56.15,"end":63.64,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-007","sourceId":"b2-082-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Realizing that this was no ordinary fish, the fisherman made every effort not to damage it in any way.","start":64.76,"end":72.46,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-008","sourceId":"b2-082-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"When it was eventually brought to shore, it was found to be over thirteen feet long.","start":73.86,"end":80.5,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-009","sourceId":"b2-082-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"It had a head like a horse big blue eyes, shining silver skin, and a bright red tail.","start":81.54,"end":90.29,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-010","sourceId":"b2-082-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"The fish, which has since been set to a museum where it is being examined by a scientist, is called an oarfish.","start":91.78,"end":100.52,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-082-011","sourceId":"b2-082-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Such creatures have rarely been seen alive by man as they live at a depth of six hundred feet.","start":101.8,"end":108.44,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
