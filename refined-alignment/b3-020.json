urceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Over a year passed before the first attempt was made.","start":28.29,"end":31.3,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-004","text":"On July 19th, 1909, in the early morning, Hubert Latham took off from the French coast in his plane the 'Antoinette IV.'","start":32.612,"end":42.783,"score":0.835,"timingValid":true,"needsReview":true,"sourceId":"b3-020-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-020-005","sourceId":"b3-020-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"He had travelled only seven miles across the Channel when his engine failed and he was forced to land on the sea.","start":43.61,"end":49.79,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-006","sourceId":"b3-020-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The 'Antoinette' floated on the water until Latham was picked up by a ship.","start":50.97,"end":55.47,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-007","text":"Two days later, Louis Bleriot arrived near Calais with a plane called 'No.XI'.","start":56.713,"end":62.723,"score":0.858,"timingValid":true,"needsReview":true,"sourceId":"b3-020-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-020-008","sourceId":"b3-020-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Bleriot had been making planes since 1905 and this was his latest model.","start":63.86,"end":69.78,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-009","sourceId":"b3-020-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"A week before, he had completed a successful overland flight during which he covered twenty-six miles.","start":70.72,"end":77.26,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-010","sourceId":"b3-020-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Latham, however, did not give up easily.","start":78.36,"end":80.78,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-011","sourceId":"b3-020-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He, too, arrived near Calais on the same day with a new 'Antoinette'.","start":81.48,"end":86.06,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-012","sourceId":"b3-020-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"It looked as if there would be an exciting race across the Channel.","start":87.3,"end":90.68,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-013","sourceId":"b3-020-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"Both planes were going to take off on July 25th, but Latham failed to get up early enough.","start":91.87,"end":98.34,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-014","sourceId":"b3-020-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"After making a short test flight at 4.15 a.m., Bleriot set off half an hour later.","start":99.29,"end":105.54,"score":0.852,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-020-015","sourceId":"b3-020-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"His great flight lasted thirty-seven minutes.","start":106.52,"end":109.5,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-016","sourceId":"b3-020-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"When he landed near Dover, the first person to greet him was a local policeman.","start":110.5,"end":115.25,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-017","sourceId":"b3-020-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Latham made another attempt a week later and got within half a mile of Dover, but he was unlucky again.","start":116.15,"end":123.423,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-020-018","sourceId":"b3-020-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"His engine failed and he landed on the sea for the second time.","start":123.84,"end":128.16,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
