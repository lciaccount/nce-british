"offset":99,"start":164.083,"end":164.162,"score":0.919},{"text":"cake.","offset":103,"start":164.202,"end":164.502,"score":0.993}],[{"text":"It","offset":0,"start":165.162,"end":165.262,"score":1.0},{"text":"was","offset":3,"start":165.303,"end":165.462,"score":0.999},{"text":"just","offset":7,"start":165.562,"end":165.842,"score":0.962},{"text":"one","offset":12,"start":166.102,"end":166.222,"score":0.999},{"text":"of","offset":16,"start":166.262,"end":166.362,"score":0.891},{"text":"those","offset":19,"start":166.422,"end":166.722,"score":0.967},{"text":"days!","offset":25,"start":166.743,"end":167.162,"score":1.0}]],"cues":[{"id":"b3-033-001","sourceId":"b3-033-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"What incident began the series of traffic accidents?","start":11.82,"end":14.99,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-002","sourceId":"b3-033-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"We have all experienced days when everything goes wrong.","start":17.62,"end":21.06,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-003","sourceId":"b3-033-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"A day may begin well enough, but suddenly everything seems to get out of control.","start":21.85,"end":27.05,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-004","sourceId":"b3-033-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"What invariably happens is that a great number of things choose to go wrong at precisely the same moment.","start":27.92,"end":34.69,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-005","sourceId":"b3-033-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"It is as if a single unimportant event set up a chain of reactions.","start":35.47,"end":40.73,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-006","sourceId":"b3-033-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Let us suppose that you are preparing a meal and keeping an eye on the baby at the same time.","start":41.57,"end":47.71,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-007","sourceId":"b3-033-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The telephone rings and this marks the prelude to an unforeseen series of catastrophes.","start":48.54,"end":54.85,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-008-p01","sourceId":"b3-033-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"While you are on the phone, the baby pulls the tablecloth off the table,","start":55.78,"end":60.56,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-008-p02","sourceId":"b3-033-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[14,25],"wordModel":"mms-fa","text":"smashing half your best crockery and cutting himself in the process.","start":60.8,"end":65.58,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-009","sourceId":"b3-033-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"You hang up hurriedly and attend to baby, crockery, etc.","start":66.35,"end":70.443,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-010","sourceId":"b3-033-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Meanwhile, the meal gets burnt.","start":71.0,"end":73.03,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-011","sourceId":"b3-033-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"As if this were not enough to reduce you to tears, your husband arrives, unexpectedly bringing three guests to dinner.","start":73.8,"end":81.76,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-012","sourceId":"b3-033-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Things can go wrong on a big scale as a number of people recently discovered in Parramatta, a suburb of Sydney.","start":83.0,"end":90.96,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-013","sourceId":"b3-033-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"During the rush hour one evening two cars collided and both drivers began to argue.","start":91.94,"end":97.31,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-014","sourceId":"b3-033-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The woman immediately behind the two cars happened to be a learner.","start":97.86,"end":102.43,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-015","sourceId":"b3-033-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"She suddenly got into a panic and stopped her car.","start":103.13,"end":106.1,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-016","sourceId":"b3-033-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"This made the driver following her brake hard.","start":107.16,"end":110.41,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-017","sourceId":"b3-033-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"His wife was sitting beside him holding a large cake.","start":110.83,"end":114.28,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-018","sourceId":"b3-033-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"As she was thrown forward, the cake went right through the windscreen and landed on the road.","start":114.97,"end":120.79,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-019","sourceId":"b3-033-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Seeing a cake flying through the air, a lorry driver who was drawing up alongside the car, pulled up all of a sudden.","start":121.59,"end":129.45,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-020","sourceId":"b3-033-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"The lorry was loaded with empty beer bottles and hundreds of them slid off the back of the vehicle and on to the road.","start":130.1,"end":137.67,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-021","sourceId":"b3-033-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This led to yet another angry argument.","start":138.47,"end":141.44,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-022","sourceId":"b3-033-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Meanwhile, the traffic piled up behind.","start":142.16,"end":145.0,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-023","sourceId":"b3-033-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It took the police nearly an hour to get the traffic on the move again.","start":145.61,"end":149.89,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-024","sourceId":"b3-033-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"In the meantime, the lorry driver had to sweep up hundreds of broken bottles.","start":150.58,"end":155.89,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-025","sourceId":"b3-033-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Only two stray dogs benefited from all this confusion, for they greedily devoured what was left of the cake.","start":156.64,"end":164.58,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-033-026","sourceId":"b3-033-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"It was just one of those days!","start":165.09,"end":167.27,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
