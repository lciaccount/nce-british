0.962},{"text":"more.","offset":130,"start":100.203,"end":100.483,"score":0.908}]],"cues":[{"id":"b2-096-001","sourceId":"b2-096-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What happens to the lanterns at the end of the festival?","start":13.06,"end":17.15,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-002","sourceId":"b2-096-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"A Festival for the Dead is held once a year in Japan.","start":19.81,"end":24.03,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-003-p01","sourceId":"b2-096-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"This festival is a cheerful occasion, for on this day,","start":25.16,"end":29.15,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-003-p02","sourceId":"b2-096-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[10,26],"wordModel":"english-ctc-fallback","text":"the dead are said to return to their homes and they are welcomed by the living.","start":29.64,"end":34.63,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-004","sourceId":"b2-096-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"As they are expected to be hungry after their long journey, food is laid out for them.","start":36.1,"end":42.22,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-005","sourceId":"b2-096-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Specially-made lanterns are hung outside each house to help the dead to find their way.","start":43.28,"end":49.16,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-006","sourceId":"b2-096-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"All night long, people dance and sing.","start":50.58,"end":53.98,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-007","sourceId":"b2-096-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,34],"wordModel":"mms-fa","text":"In the early morning the food that had been laid out for the dead is thrown into a river or into the sea as it is considered unlucky for anyone living to eat it.","start":55.21,"end":66.89,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-008-p01","sourceId":"b2-096-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"In towns that are near the sea, the tiny lanterns which had been hung in the streets the night before,","start":68.36,"end":75.58,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-008-p02","sourceId":"b2-096-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[20,30],"wordModel":"mms-fa","text":"are placed into the water when the festival is over.","start":76.4,"end":79.71,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-009","sourceId":"b2-096-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Thousands of lanterns slowly drift out to sea guiding the dead on their return journey to the other world.","start":80.87,"end":89.2,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-010-p01","sourceId":"b2-096-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,5],"wordModel":"mms-fa","text":"This is a moving spectacle,","start":90.54,"end":92.22,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-096-010-p02","sourceId":"b2-096-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[5,25],"wordModel":"mms-fa","text":"for crowds of people stand on the shore watching the lanterns drifting away until they can be seen no more.","start":92.62,"end":100.72,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
