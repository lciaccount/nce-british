":0.999},{"text":"baggage.","offset":78,"start":130.482,"end":130.942,"score":0.997}]],"cues":[{"id":"b3-011-001","sourceId":"b3-011-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What was the Customs Officer looking for?","start":12.18,"end":14.76,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-002-p01","sourceId":"b3-011-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"Customs Officers are quite tolerant these days,","start":17.36,"end":20.24,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-002-p02","sourceId":"b3-011-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[7,26],"wordModel":"mms-fa","text":"but they can still stop you when you are going through the Green Channel and have nothing to declare.","start":20.5,"end":25.8,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-003","sourceId":"b3-011-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Even really honest people are often made to feel guilty.","start":27.19,"end":30.68,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-004-p01","sourceId":"b3-011-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"The hardened professional smuggler, on the other hand, is never troubled by such feelings,","start":32.08,"end":36.81,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-004-p02","sourceId":"b3-011-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[14,26],"wordModel":"english-ctc-fallback","text":"even if he has five hundred gold watches hidden in his suitcase.","start":37.21,"end":41.1,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-005","sourceId":"b3-011-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"When I returned from abroad recently, a particularly officious young Customs Officer clearly regarded me as a smuggler.","start":42.2,"end":50.32,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-006","sourceId":"b3-011-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'Have you anything to declare?'","start":51.96,"end":53.533,"score":0.969,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-011-007","sourceId":"b3-011-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"he asked, looking me in the eye.","start":53.533,"end":55.73,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-008","sourceId":"b3-011-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"'No,' I answered confidently.","start":56.71,"end":58.65,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-009","sourceId":"b3-011-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'Would you mind unlocking this suitcase please? '","start":59.7,"end":62.41,"score":0.986,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-011-010","sourceId":"b3-011-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'Not at all,' I answered.","start":63.58,"end":64.83,"score":0.981,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-011-011","sourceId":"b3-011-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The Officer went through the case with great care.","start":66.07,"end":68.94,"score":0.918,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-012","sourceId":"b3-011-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"All the things I had packed so carefully were soon in a dreadful mess.","start":69.95,"end":73.94,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-013","sourceId":"b3-011-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"I felt sure I would never be able to close the case again.","start":74.83,"end":78.18,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-014","sourceId":"b3-011-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Suddenly, I saw the Officer's face light up.","start":78.92,"end":81.82,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-015","sourceId":"b3-011-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"He had spotted a tiny bottle at the bottom of my case and he pounced on it with delight.","start":82.8,"end":88.85,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-016","sourceId":"b3-011-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"english-ctc-fallback","text":"'Perfume, eh?'","start":90.3,"end":91.4,"score":0.861,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-011-017","sourceId":"b3-011-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"he asked sarcastically.","start":91.6,"end":92.94,"score":0.909,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-018","sourceId":"b3-011-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'You should have declared that.","start":93.25,"end":94.45,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-019","sourceId":"b3-011-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Perfume is not exempt from import duty.  '","start":95.0,"end":97.44,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-020","sourceId":"b3-011-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"'But it isn't perfume, I said.","start":98.75,"end":100.45,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-021","text":"'It's hair gel.  '","start":101.013,"end":101.823,"score":0.569,"timingValid":true,"needsReview":true,"sourceId":"b3-011-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-011-022","sourceId":"b3-011-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Then I added with a smile, 'It's a strange mixture I make myself.","start":102.66,"end":107.39,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-023","sourceId":"b3-011-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"As I expected, he did not believe me.","start":108.68,"end":111.07,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-024","sourceId":"b3-011-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"english-ctc-fallback","text":"'Try it!'","start":112.1,"end":112.58,"score":1.0,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-011-025","sourceId":"b3-011-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"I said encouragingly.","start":112.76,"end":114.07,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-026","sourceId":"b3-011-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The Officer unscrewed the cap and put the bottle to his nostrils.","start":114.69,"end":118.82,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-027","sourceId":"b3-011-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"He was greeted by an unpleasant smell which convinced him that I was telling the truth.","start":119.72,"end":124.74,"score":0.915,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-011-028","sourceId":"b3-011-028","sourceIndex":27,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"A few minutes later, I was able to hurry away with precious chalk marks on my baggage.","start":125.68,"end":131.02,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
