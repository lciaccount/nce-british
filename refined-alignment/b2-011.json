?","start":14.08,"end":16.62,"score":0.821,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-002","sourceId":"b2-011-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"I was having dinner at a restaurant when Tony Steele came in.","start":19.34,"end":24.0,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-003","sourceId":"b2-011-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Tony worked in a lawyer's office years ago, but he is now working at a bank.","start":25.42,"end":31.55,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-004","sourceId":"b2-011-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"He gets a good salary, but he always borrows money from his friends and never pays it back.","start":32.98,"end":40.46,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-005","sourceId":"b2-011-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Tony saw me and came and sat at the same table.","start":42.36,"end":46.03,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-006","sourceId":"b2-011-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"He has never borrowed money from me.","start":47.48,"end":49.45,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-007","sourceId":"b2-011-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"While he was eating, I asked him to lend me twenty pounds.","start":50.98,"end":55.97,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-008","sourceId":"b2-011-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"To my surprise, he gave me the money immediately.","start":57.9,"end":61.96,"score":0.828,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-011-009","sourceId":"b2-011-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"'I have never borrowed any money from you,' Tony said, 'so now you can pay for my dinner!'","start":64.47,"end":71.12,"score":0.988,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
