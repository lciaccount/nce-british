[]},{"id":"b1-075-015","sourceId":"b1-075-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"But they're not in fashion this year.","start":57.54,"end":60.25,"score":0.844,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-075-016","sourceId":"b1-075-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"These shoes are in fashion now.","start":61.88,"end":64.26,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-075-017","sourceId":"b1-075-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"They look very uncomfortable.","start":65.21,"end":67.58,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-075-018","sourceId":"b1-075-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"They are very uncomfortable.","start":68.43,"end":70.98,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-075-019","sourceId":"b1-075-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"But women always wear uncomfortable shoes!","start":71.26,"end":74.58,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
