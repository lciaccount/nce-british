ext":"continent.","offset":86,"start":101.382,"end":101.903,"score":0.976}]],"cues":[{"id":"b2-064-001","sourceId":"b2-064-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Why was the first tunnel not completed?","start":13.12,"end":16.3,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-002-p01","sourceId":"b2-064-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"In 1858, a French engineer, Aime Thome de Gamond,","start":18.842,"end":26.33,"score":0.863,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-064-002-p02","sourceId":"b2-064-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[9,23],"wordModel":"english-ctc-fallback","text":"arrived in England with a plan for a 21-mile tunnel under the English Channel.","start":27.0,"end":33.74,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-003","sourceId":"b2-064-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He said that it would be possible to build a platform in the centre of the Channel.","start":35.52,"end":40.53,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-004","sourceId":"b2-064-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"This platform would serve as a port and a railway station.","start":41.26,"end":45.763,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-005","sourceId":"b2-064-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The tunnel would be well-ventilated if tall chimneys were built above sea level.","start":46.49,"end":52.74,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-006","sourceId":"b2-064-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"In 1860, a better plan was put forward by an Englishman, William Low.","start":53.92,"end":60.19,"score":0.978,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-064-007","sourceId":"b2-064-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"He suggested that a double railway-tunnel should be built.","start":61.41,"end":65.24,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-008","sourceId":"b2-064-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"This would solve the problem of ventilation for if a train entered this tunnel, it would draw in fresh air behind it.","start":66.09,"end":73.98,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-009","sourceId":"b2-064-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Forty-two years later a tunnel was actually begun.","start":75.85,"end":79.84,"score":0.883,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-010","sourceId":"b2-064-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"If, at the time, the British had not feared invasion, it would have been completed.","start":80.88,"end":86.34,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-011","sourceId":"b2-064-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The world had to wait almost another 100 years for the Channel Tunnel.","start":87.56,"end":93.18,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-064-012","sourceId":"b2-064-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"It was officially opened on March 7, 1994, finally connecting Britain to the European continent.","start":93.88,"end":102.18,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
