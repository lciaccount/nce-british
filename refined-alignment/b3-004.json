,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-005-p01","sourceId":"b3-004-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"This can give rise to curious situations,","start":47.41,"end":50.21,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-005-p02","sourceId":"b3-004-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[7,25],"wordModel":"mms-fa","text":"as it did in the case of Alfred Bloggs who worked as a dustman for the Ellesmere Corporation.","start":50.79,"end":57.15,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-006","sourceId":"b3-004-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"When he got married, Alf was too embarrassed to say anything to his wife about his job.","start":58.73,"end":64.17,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-007","sourceId":"b3-004-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"He simply told her that he worked for the Corporation.","start":65.34,"end":68.34,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-008","sourceId":"b3-004-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Every morning, he left home dressed in a smart black suit.","start":69.3,"end":73.49,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-009","sourceId":"b3-004-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"He then changed into overalls and spent the next eight hours as a dustman.","start":74.72,"end":79.85,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-010","sourceId":"b3-004-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Before returning home at night, he took a shower and changed back into his suit.","start":80.68,"end":85.84,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-011","sourceId":"b3-004-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Alf did this for over two years and his fellow dustmen kept his secret.","start":86.81,"end":92.14,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-012","sourceId":"b3-004-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Alf's wife has never discovered that she married a dustman and she never will, for Alf has just found another job.","start":93.52,"end":102.49,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-013","sourceId":"b3-004-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He will soon be working in an office.","start":103.58,"end":105.86,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-014-p01","sourceId":"b3-004-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"He will be earning only half as much as he used to,","start":106.82,"end":109.66,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-014-p02","sourceId":"b3-004-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[12,27],"wordModel":"mms-fa","text":"but he feels that his rise in status is well worth the loss of money.","start":110.24,"end":114.56,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-004-015","sourceId":"b3-004-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"From now on, he will wear a suit all day and others will call him 'Mr.Bloggs', not 'Alf'.","start":115.72,"end":123.79,"score":0.882,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
