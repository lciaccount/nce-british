159.082,"score":0.842},{"text":"is","offset":3,"start":159.123,"end":159.182,"score":0.852},{"text":"a","offset":6,"start":159.243,"end":159.262,"score":0.814},{"text":"world","offset":8,"start":159.322,"end":159.622,"score":0.897},{"text":"of","offset":14,"start":159.662,"end":159.742,"score":0.936},{"text":"red","offset":17,"start":159.863,"end":160.102,"score":0.98},{"text":"sandy","offset":21,"start":160.442,"end":160.742,"score":0.996},{"text":"deserts","offset":27,"start":160.863,"end":161.322,"score":0.997},{"text":"(hence","offset":35,"start":162.023,"end":162.282,"score":0.997},{"text":"its","offset":42,"start":162.322,"end":162.442,"score":0.999},{"text":"name--the","offset":46,"start":162.502,"end":163.322,"score":0.988},{"text":"Red","offset":56,"start":163.482,"end":163.682,"score":0.999},{"text":"Planet),","offset":60,"start":163.762,"end":164.122,"score":0.996},{"text":"cloudless","offset":69,"start":165.083,"end":165.562,"score":0.946},{"text":"skies,","offset":79,"start":165.623,"end":166.142,"score":0.601},{"text":"savage","offset":86,"start":167.222,"end":167.662,"score":0.911},{"text":"sandstorms,","offset":93,"start":167.743,"end":168.542,"score":0.996},{"text":"chasms","offset":105,"start":169.303,"end":169.782,"score":0.761},{"text":"wider","offset":112,"start":169.882,"end":170.262,"score":0.991},{"text":"than","offset":118,"start":170.322,"end":170.422,"score":0.999},{"text":"the","offset":123,"start":170.463,"end":170.542,"score":0.993},{"text":"Grand","offset":127,"start":170.602,"end":170.922,"score":0.995},{"text":"Canyon","offset":133,"start":170.982,"end":171.402,"score":0.852},{"text":"and","offset":140,"start":172.062,"end":172.162,"score":0.999},{"text":"at","offset":144,"start":172.202,"end":172.282,"score":1.0},{"text":"least","offset":147,"start":172.322,"end":172.502,"score":0.998},{"text":"one","offset":153,"start":172.662,"end":172.802,"score":0.999},{"text":"mountain","offset":157,"start":172.863,"end":173.222,"score":0.99},{"text":"more","offset":166,"start":173.523,"end":173.662,"score":0.784},{"text":"than","offset":171,"start":173.662,"end":173.802,"score":0.999},{"text":"twice","offset":176,"start":173.882,"end":174.262,"score":0.992},{"text":"as","offset":182,"start":174.303,"end":174.402,"score":0.997},{"text":"tall","offset":185,"start":174.482,"end":174.722,"score":0.831},{"text":"as","offset":190,"start":174.782,"end":174.862,"score":0.998},{"text":"Everest.","offset":193,"start":175.023,"end":175.502,"score":0.893}],[{"text":"It","offset":0,"start":176.482,"end":176.602,"score":0.999},{"text":"seems","offset":3,"start":176.702,"end":177.022,"score":0.91},{"text":"ideal","offset":9,"start":177.222,"end":177.602,"score":0.999},{"text":"for","offset":15,"start":177.702,"end":177.802,"score":0.979},{"text":"settlement.","offset":19,"start":177.863,"end":178.322,"score":0.997}]],"cues":[{"id":"b4-035-001","sourceId":"b4-035-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"When will it be possible for us to think seriously about colonising Mars?","start":12.34,"end":17.05,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-002-p01","sourceId":"b4-035-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"The Moon is likely to become the industrial hub of the Solar System supplying the rocket fuels for its ships,","start":19.74,"end":27.32,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-002-p02","sourceId":"b4-035-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[20,32],"wordModel":"english-ctc-fallback","text":"easily obtainable from the lunar rocks in the form of liquid oxygen.","start":27.97,"end":32.56,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-003","sourceId":"b4-035-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The reason lies in its gravity.","start":33.41,"end":35.61,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-004-p01","sourceId":"b4-035-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Because the Moon has only an eightieth of the Earth's mass,","start":36.44,"end":40.11,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-004-p02","sourceId":"b4-035-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[11,38],"wordModel":"english-ctc-fallback","text":"it requires 97% less energy to travel the quarter of a million miles from the Moon to Earth-orbit than the 200 mile-journey from Earth's surface into orbit!","start":40.9,"end":52.24,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-005","sourceId":"b4-035-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"This may sound fantastic, but it is easily calculated.","start":53.29,"end":57.18,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-006","sourceId":"b4-035-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"To escape from the Earth in a rocket, one must travel at seven miles per second.","start":58.003,"end":63.38,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-007","sourceId":"b4-035-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"The comparable speed from the Moon is only 1.5 miles per second.","start":64.42,"end":69.22,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-008-p01","sourceId":"b4-035-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"Because the gravity on the Moon's surface is only a sixth of Earth's (remember how easily the Apollo astronauts bounded along),","start":70.6,"end":78.88,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-008-p02","sourceId":"b4-035-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[21,36],"wordModel":"english-ctc-fallback","text":"it takes much less energy to accelerate to that 1.5mps than it does on Earth.","start":79.322,"end":86.2,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-009","sourceId":"b4-035-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Moon dwellers will be able to fly in space at only three percent of the cost of similar journeys by their terrestrial cousins.","start":87.4,"end":95.42,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-010","sourceId":"b4-035-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Arthur C.Clark once suggested a revolutionary idea passes through three phases: 1.","start":96.73,"end":103.72,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-011","sourceId":"b4-035-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'It's impossible--don't waste my time.'","start":104.18,"end":106.75,"score":0.91,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-012","sourceId":"b4-035-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"2.","start":107.7,"end":108.2,"score":0.795,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-013","sourceId":"b4-035-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'It's possible, but not worth doing.'","start":109.07,"end":111.71,"score":0.988,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b4-035-014","sourceId":"b4-035-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"3.","start":112.862,"end":113.58,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-015","sourceId":"b4-035-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"'I said it was a good idea all along.'","start":114.29,"end":116.81,"score":0.995,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b4-035-016-p01","sourceId":"b4-035-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"english-ctc-fallback","text":"The idea of colonising Mars--a world 160 times more distant than the Moon--will move decisively from the second phase to the third,","start":118.77,"end":128.98,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-016-p02","sourceId":"b4-035-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[22,33],"wordModel":"english-ctc-fallback","text":"when a significant number of people are living permanently in space.","start":129.26,"end":133.17,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-017","sourceId":"b4-035-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Mars has an extraordinary fascination for would-be voyagers.","start":134.45,"end":138.1,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-018","sourceId":"b4-035-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"America, Russia and Europe are filled with enthusiasts--many of them serious and senior scientists who dream of sending people to it.","start":139.04,"end":149.72,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-019","sourceId":"b4-035-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"Their aim is understandable.","start":150.62,"end":152.74,"score":0.903,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-020","sourceId":"b4-035-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It is the one world in the Solar System that is most like the Earth.","start":153.96,"end":157.99,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-021-p01","sourceId":"b4-035-021","sourceIndex":20,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"It is a world of red sandy deserts (hence its name--the Red Planet), cloudless skies, savage sandstorms,","start":158.96,"end":168.63,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-021-p02","sourceId":"b4-035-021","sourceIndex":20,"part":2,"parts":2,"wordRange":[17,35],"wordModel":"mms-fa","text":"chasms wider than the Grand Canyon and at least one mountain more than twice as tall as Everest.","start":169.24,"end":175.59,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-035-022","sourceId":"b4-035-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"It seems ideal for settlement.","start":176.41,"end":178.4,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
