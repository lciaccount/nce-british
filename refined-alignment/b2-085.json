d":"b2-085-005-p01","sourceId":"b2-085-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"All those who have contributed towards the gift will sign their names in a large album","start":39.63,"end":45.36,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-005-p02","sourceId":"b2-085-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[16,24],"wordModel":"mms-fa","text":"which will be sent to the headmaster's home.","start":45.48,"end":47.89,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-006","sourceId":"b2-085-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"We shall all remember Mr.","start":49.18,"end":50.783,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-007","sourceId":"b2-085-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Page for his patience and understanding and for the kindly encouragement he gave us when we went so unwillingly to school.","start":50.783,"end":60.03,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-008","sourceId":"b2-085-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"A great many former pupils will be attending a farewell dinner in his honour next Thursday.","start":61.3,"end":67.423,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-009","sourceId":"b2-085-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It is a curious coincidence that the day before his retirement, Mr.","start":68.93,"end":74.523,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-010","sourceId":"b2-085-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Page will have been teaching for a total of forty years.","start":74.523,"end":78.34,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-011","sourceId":"b2-085-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"After he has retired he will devote himself to gardening.","start":79.65,"end":83.7,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-012","sourceId":"b2-085-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"For him, this will be an entirely new hobby.","start":84.51,"end":87.97,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-085-013","sourceId":"b2-085-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"But this does not matter, for, as he has often remarked, one is never too old to learn.","start":89.582,"end":96.62,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
