":91,"start":210.762,"end":211.022,"score":0.999},{"text":"plunging","offset":96,"start":211.303,"end":211.782,"score":0.965},{"text":"into","offset":105,"start":211.863,"end":212.042,"score":0.999},{"text":"the","offset":110,"start":212.083,"end":212.182,"score":0.989},{"text":"water","offset":114,"start":212.243,"end":212.542,"score":0.994},{"text":"again.","offset":120,"start":212.583,"end":212.882,"score":1.0}],[{"text":"By","offset":0,"start":213.722,"end":213.882,"score":1.0},{"text":"working","offset":3,"start":213.982,"end":214.342,"score":0.868},{"text":"at","offset":11,"start":214.382,"end":214.482,"score":0.999},{"text":"tremendous","offset":14,"start":214.542,"end":215.062,"score":0.991},{"text":"speed,","offset":25,"start":215.102,"end":215.402,"score":0.999},{"text":"the","offset":32,"start":215.762,"end":215.842,"score":0.999},{"text":"men","offset":36,"start":215.882,"end":216.062,"score":0.983},{"text":"managed","offset":40,"start":216.162,"end":216.522,"score":0.973},{"text":"to","offset":48,"start":216.562,"end":216.622,"score":0.998},{"text":"get","offset":51,"start":216.662,"end":216.802,"score":1.0},{"text":"the","offset":55,"start":216.863,"end":216.942,"score":0.998},{"text":"dish","offset":59,"start":217.002,"end":217.262,"score":0.939},{"text":"on","offset":64,"start":217.403,"end":217.482,"score":0.992},{"text":"to","offset":67,"start":217.502,"end":217.582,"score":0.995},{"text":"dry","offset":70,"start":217.642,"end":217.882,"score":0.997},{"text":"land","offset":74,"start":217.942,"end":218.302,"score":0.997},{"text":"before","offset":79,"start":218.583,"end":219.042,"score":0.995},{"text":"the","offset":86,"start":219.102,"end":219.182,"score":0.989},{"text":"wave","offset":90,"start":219.303,"end":219.622,"score":1.0},{"text":"returned.","offset":95,"start":219.683,"end":220.302,"score":0.984}]],"cues":[{"id":"b3-043-001","sourceId":"b3-043-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Who owned the pie dish and why?","start":11.94,"end":14.99,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-002","sourceId":"b3-043-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Insurance companies are normally willing to insure anything.","start":17.62,"end":21.11,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-003","sourceId":"b3-043-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Insuring public or private property is a standard practice in most countries in the world.","start":22.1,"end":27.38,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-004-p01","sourceId":"b3-043-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"If, however, you were holding an open air garden party","start":28.31,"end":31.873,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-004-p02","sourceId":"b3-043-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[10,27],"wordModel":"mms-fa","text":"or a fete it would be equally possible to insure yourself in the event of bad weather.","start":31.94,"end":37.45,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-005","sourceId":"b3-043-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"Needless to say, the bigger the risk an insurance company takes, the higher the premium you will have to pay.","start":38.5,"end":45.28,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-006","sourceId":"b3-043-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"It is not uncommon to hear that a shipping company has made a claim for the cost of salvaging a sunken ship.","start":45.88,"end":52.29,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-007","sourceId":"b3-043-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"But the claim made by a local authority to recover the cost of salvaging a sunken pie dish must surely be unique.","start":53.08,"end":61.12,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-008","sourceId":"b3-043-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Admittedly it was an unusual pie dish, for it was eighteen feet long and six feet wide.","start":62.06,"end":69.7,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-009","sourceId":"b3-043-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"It had been purchased by a local authority so that an enormous pie could be baked for an annual fair.","start":70.44,"end":76.54,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-010","sourceId":"b3-043-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The pie committee decided that the best way to transport the dish would be by canal so they insured it for the trip.","start":77.47,"end":85.37,"score":0.869,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-011","sourceId":"b3-043-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Shortly after it was launched, the pie committee went to a local inn to celebrate.","start":86.03,"end":91.42,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-012","sourceId":"b3-043-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"At the same time, a number of teenagers climbed on to the dish and held a little party of their own.","start":92.32,"end":98.75,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-013","sourceId":"b3-043-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Dancing proved to be more than the dish could bear, for during the party it capsized and sank in seven feet of water.","start":99.64,"end":108.03,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-014","sourceId":"b3-043-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The pie committee telephoned a local garage owner who arrived in a recovery truck to salvage the pie dish.","start":109.18,"end":115.99,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-015","sourceId":"b3-043-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Shivering in their wet clothes, the teenagers looked on while three men dived repeatedly into the water to locate the dish.","start":116.6,"end":125.31,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-016","sourceId":"b3-043-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"They had little difficulty in finding it, but hauling it out of the water proved to be a serious problem.","start":126.19,"end":133.11,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-017-p01","sourceId":"b3-043-017","sourceIndex":16,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"The sides of the dish were so smooth","start":133.91,"end":136.39,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-017-p02","sourceId":"b3-043-017","sourceIndex":16,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"english-ctc-fallback","text":"that it was almost impossible to attach hawsers and chains to the rim without damaging it.","start":136.7,"end":142.3,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-018","sourceId":"b3-043-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Eventually chains were fixed to one end of the dish and a powerful winch was put into operation.","start":143.15,"end":149.24,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-019","sourceId":"b3-043-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The dish rose to the surface and was gently drawn towards the canal bank.","start":150.04,"end":154.68,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-020-p01","sourceId":"b3-043-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"For one agonizing moment, the dish was perched precariously on the bank of the canal,","start":155.6,"end":161.87,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-020-p02","sourceId":"b3-043-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[15,25],"wordModel":"mms-fa","text":"but it suddenly overbalanced and slid back into the water.","start":162.24,"end":166.54,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-021","sourceId":"b3-043-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The men were now obliged to try once more.","start":167.4,"end":169.9,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-022","sourceId":"b3-043-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"This time they fixed heavy metal clamps to both sides of the dish so that they could fasten the chains.","start":170.8,"end":177.25,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-023","sourceId":"b3-043-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The dish now had to be lifted vertically because one edge was resting against the side of the canal.","start":178.29,"end":184.76,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-024","sourceId":"b3-043-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The winch was again put into operation and one of the men started up the truck.","start":185.62,"end":190.71,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-025","sourceId":"b3-043-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Several minutes later, the dish was successfully hauled above the surface of the water.","start":191.41,"end":196.85,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-026","sourceId":"b3-043-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Water streamed in torrents over its sides with such force that it set up a huge wave in the canal.","start":197.68,"end":204.49,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-027","sourceId":"b3-043-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,25],"wordModel":"mms-fa","text":"There was a danger that the wave would rebound off the other side of the bank and send the dish plunging into the water again.","start":205.19,"end":213.11,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-043-028","sourceId":"b3-043-028","sourceIndex":27,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"By working at tremendous speed, the men managed to get the dish on to dry land before the wave returned.","start":213.66,"end":220.39,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
