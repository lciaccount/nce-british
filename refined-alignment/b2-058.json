d":85.103,"score":0.962},{"text":"of","offset":16,"start":85.142,"end":85.203,"score":0.999},{"text":"them","offset":19,"start":85.302,"end":85.523,"score":0.999},{"text":"has","offset":24,"start":85.582,"end":85.703,"score":0.999},{"text":"been","offset":28,"start":85.742,"end":85.903,"score":0.999},{"text":"struck","offset":33,"start":86.022,"end":86.343,"score":0.962},{"text":"down","offset":40,"start":86.462,"end":86.683,"score":0.999},{"text":"by","offset":45,"start":86.722,"end":86.863,"score":0.999},{"text":"sudden","offset":48,"start":86.962,"end":87.283,"score":0.932},{"text":"death!","offset":55,"start":87.403,"end":87.723,"score":0.907}]],"cues":[{"id":"b2-058-001","sourceId":"b2-058-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Why does the vicar refuse to cut down the tree?","start":13.26,"end":17.03,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-002","sourceId":"b2-058-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"The tiny village of Frinley is said to possess a 'cursed tree'.","start":19.68,"end":25.863,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-003","sourceId":"b2-058-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Because the tree was mentioned in a newspaper, the number of visitors to Frinley has now increased.","start":27.16,"end":33.72,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-004-p01","sourceId":"b2-058-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"The tree was planted near the church fifty years ago,","start":34.64,"end":38.14,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-004-p02","sourceId":"b2-058-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"but it is only in recent years that it has gained an evil reputation.","start":39.21,"end":43.86,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-005","sourceId":"b2-058-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"It is said that if anyone touches the tree, he will have bad luck; if he picks a leaf, he will die.","start":45.02,"end":52.2,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-006","sourceId":"b2-058-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Many villagers believe that the tree has already claimed a number of victims.","start":53.33,"end":57.95,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-007","sourceId":"b2-058-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"The vicar has been asked to have the tree cut down, but so far he has refused.","start":59.52,"end":64.603,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-008-p01","sourceId":"b2-058-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"He has pointed out that the tree is a useful source of income,","start":65.062,"end":68.82,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-008-p02","sourceId":"b2-058-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[13,27],"wordModel":"mms-fa","text":"as tourists have been coming from all parts of the country to see it.","start":69.27,"end":73.38,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-009","sourceId":"b2-058-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"In spite of all that has been said, the tourists have been picking leaves and cutting their names on the tree-trunk.","start":75.36,"end":82.48,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-058-010","sourceId":"b2-058-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"So far, not one of them has been struck down by sudden death!","start":83.49,"end":87.8,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
