rts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"'It couldn't be better, Gloria,' Brinksley Meers agreed.","start":51.88,"end":56.29,"score":0.945,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-074-007","sourceId":"b2-074-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"'No newspaper men, no film fans!","start":56.86,"end":59.623,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-008","sourceId":"b2-074-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Why don't we come more often?'","start":59.84,"end":61.71,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-009-p01","sourceId":"b2-074-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Meanwhile, two other actors Rockwall Slinger and Merlin Greeves,","start":63.28,"end":70.42,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-009-p02","sourceId":"b2-074-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[9,22],"wordModel":"mms-fa","text":"had carried two large food baskets to a shady spot under some trees.","start":71.12,"end":76.51,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-010","sourceId":"b2-074-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"When they had all made themselves comfortable, a stranger appeared.","start":78.23,"end":82.36,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-011","sourceId":"b2-074-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"He looked very angry.","start":82.8,"end":84.65,"score":0.999,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-074-012","sourceId":"b2-074-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordMo