":96,"start":229.463,"end":229.782,"score":0.996},{"text":"fifty","offset":101,"start":229.982,"end":230.262,"score":0.907},{"text":"years.","offset":107,"start":230.363,"end":230.702,"score":0.974}]],"cues":[{"id":"b3-051-001","sourceId":"b3-051-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"What was the 'future' electronic development that Leon Bagrit wasn't able to foresee?","start":12.35,"end":18.08,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-002","sourceId":"b3-051-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Predicting the future is notoriously difficult.","start":20.75,"end":23.9,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-003-p01","sourceId":"b3-051-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"Who could have imagined, in the mid 1970s, for example, that by the end of the 20th century,","start":24.52,"end":30.512,"score":0.906,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-051-003-p02","sourceId":"b3-051-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[18,29],"wordModel":"mms-fa","text":"computers would be as common in people's homes as TV sets?","start":30.68,"end":34.55,"score":0.991,"timingValid":true,"needsReview":true,"reviewReasons":["waveform-corrected-needs-listening"]},{"id":"b3-051-004","text":"In the 1970s, computers were common enough, but only in big business, government departments and large organizations.","start":35.48,"end":44.703,"score":0.797,"timingValid":true,"needsReview":true,"sourceId":"b3-051-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment","waveform-corrected-needs-listening"]},{"id":"b3-051-005","sourceId":"b3-051-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"These were the so-called mainframe machines.","start":45.51,"end":48.28,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-006","sourceId":"b3-051-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Mainframe computers were very large indeed often occupying whole air-conditioned rooms, employing full-time technicians and run on specially-written software.","start":49.43,"end":60.98,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-007","sourceId":"b3-051-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Though these large machines still exist, many of their functions have been taken over by small powerful personal computers, commonly known as PCs.","start":61.85,"end":72.7,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-008","sourceId":"b3-051-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"In 1975, a primitive machine called the Altair, was launched in the USA.","start":73.69,"end":80.04,"score":0.982,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-051-009","sourceId":"b3-051-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"It can properly be described as the first 'home computer' and it pointed the way to the future.","start":80.45,"end":87.04,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-010","sourceId":"b3-051-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"This was followed, at the end of the 1970s, by a machine called an Apple.","start":87.84,"end":93.1,"score":0.919,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-051-011","text":"In the early 1980s, the computer giant, IBM produced the world's first Personal Computer.","start":93.913,"end":101.283,"score":0.736,"timingValid":true,"needsReview":true,"sourceId":"b3-051-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-051-012","sourceId":"b3-051-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"This ran on an 'operating system' called DOS, produced by a then small company named Microsoft.","start":102.25,"end":109.84,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-013","sourceId":"b3-051-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The IBM Personal Computer was widely copied.","start":110.62,"end":114.2,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-014","sourceId":"b3-051-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"From those humble beginnings, we have seen the development of the user-friendly home computers and multimedia machines which are in common use today.","start":114.68,"end":124.78,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-015-p01","sourceId":"b3-051-015","sourceIndex":14,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Considering how recent these developments are, it is even more remarkable that as long ago as the 1960s, an Englishman,","start":126.02,"end":134.96,"score":0.936,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-051-015-p02","sourceId":"b3-051-015","sourceIndex":14,"part":2,"parts":2,"wordRange":[20,36],"wordModel":"mms-fa","text":"Leon Bagrit, was able to predict some of the uses of computers which we know today.","start":135.19,"end":140.92,"score":0.848,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-051-016-p01","sourceId":"b3-051-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Bagrit dismissed the idea that computers would learn to 'think' for themselves and would 'rule the world',","start":141.89,"end":149.12,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-016-p02","sourceId":"b3-051-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[17,25],"wordModel":"mms-fa","text":"which people liked to believe in those days.","start":149.38,"end":151.61,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-017-p01","sourceId":"b3-051-017","sourceIndex":16,"part":1,"parts":4,"wordRange":[0,15],"wordModel":"mms-fa","text":"Bagrit foresaw a time when computers would be small enough to hold in the hand,","start":152.69,"end":157.64,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-017-p02","sourceId":"b3-051-017","sourceIndex":16,"part":2,"parts":4,"wordRange":[15,30],"wordModel":"mms-fa","text":"when they would be capable of providing information about traffic jams and suggesting alterative routes,","start":158.123,"end":164.74,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-017-p03","sourceId":"b3-051-017","sourceIndex":16,"part":3,"parts":4,"wordRange":[30,43],"wordModel":"mms-fa","text":"when they would be used in hospitals to help doctors to diagnose illnesses,","start":165.36,"end":169.92,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-017-p04","sourceId":"b3-051-017","sourceIndex":16,"part":4,"parts":4,"wordRange":[43,56],"wordModel":"mms-fa","text":"when they would relieve office workers and accountants of dull, repetitive clerical work.","start":170.54,"end":176.06,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-018","sourceId":"b3-051-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"All these computer uses have become commonplace.","start":176.75,"end":180.04,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-019-p01","sourceId":"b3-051-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Of course, Leon Bagrit couldn't possibly have foreseen the development of the Internet,","start":180.75,"end":186.14,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-019-p02","sourceId":"b3-051-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[13,37],"wordModel":"mms-fa","text":"the worldwide system that enables us to communicate instantly with anyone in any part of the world by using computers linked to telephone networks.","start":186.75,"end":196.34,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-020-p01","sourceId":"b3-051-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"Nor could he have foreseen how we could use the Internet to obtain information on every known subject,","start":197.05,"end":203.52,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-020-p02","sourceId":"b3-051-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[18,39],"wordModel":"mms-fa","text":"so we can read it on a screen in our homes and even print it as well if we want to.","start":203.86,"end":209.6,"score":0.949,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-051-021","sourceId":"b3-051-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Computers have become smaller and smaller, more and more powerful and cheaper and cheaper.","start":210.1,"end":216.86,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-022","sourceId":"b3-051-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"This is what makes Leon Bagrit's predictions particularly remarkable.","start":217.32,"end":221.93,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-023-p01","sourceId":"b3-051-023","sourceIndex":22,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"If he, or someone like him, were alive today,","start":222.44,"end":225.66,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-051-023-p02","sourceId":"b3-051-023","sourceIndex":22,"part":2,"parts":2,"wordRange":[9,24],"wordModel":"mms-fa","text":"he might be able to tell us what to expect in the next fifty years.","start":226.05,"end":230.8,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
