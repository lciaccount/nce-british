"id":"b2-060-006","sourceId":"b2-060-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The moment you leave this tent, you will get a big surprise.","start":46.92,"end":51.32,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-007","sourceId":"b2-060-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"A woman you know well will rush towards you.","start":52.56,"end":55.86,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-008","sourceId":"b2-060-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"She will speak to you and then she will lead you away from this place.","start":56.65,"end":61.87,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-009","sourceId":"b2-060-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"That is all.'","start":62.92,"end":63.75,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-010","sourceId":"b2-060-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"As soon as I went outside, I forgot all about Madam Bellinsky because my wife hurried towards me.","start":66.26,"end":73.36,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-011","sourceId":"b2-060-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'Where have you been hiding?'","start":74.3,"end":75.99,"score":0.974,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-060-012","sourceId":"b2-060-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"she asked impatiently.","start":76.35,"end":78.13,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-013","sourceId":"b2-060-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"'Your sister will be here in less than an hour and we must be at the station to meet her.","start":78.75,"end":84.1,"score":0.977,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-060-014","sourceId":"b2-060-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"We are late already.'","start":84.41,"end":85.77,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-060-015","sourceId":"b2-060-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"As she walked away, I followed her out of the fair.","start":87.19,"end":91.523,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
