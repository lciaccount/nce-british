164.362,"score":0.998},{"text":"first","offset":209,"start":164.442,"end":164.722,"score":0.988},{"text":"group","offset":215,"start":164.762,"end":164.962,"score":0.957},{"text":"began","offset":221,"start":165.202,"end":165.482,"score":1.0},{"text":"to","offset":227,"start":165.523,"end":165.582,"score":0.999},{"text":"show","offset":230,"start":165.642,"end":165.822,"score":1.0},{"text":"some","offset":235,"start":165.922,"end":166.122,"score":0.999},{"text":"personality","offset":240,"start":166.262,"end":166.922,"score":0.999},{"text":"disorders","offset":252,"start":166.982,"end":167.522,"score":0.999},{"text":"while","offset":262,"start":168.062,"end":168.242,"score":0.962},{"text":"the","offset":268,"start":168.243,"end":168.322,"score":0.995},{"text":"others","offset":272,"start":168.403,"end":168.662,"score":0.999},{"text":"seemed","offset":279,"start":168.963,"end":169.182,"score":0.963},{"text":"more","offset":286,"start":169.322,"end":169.502,"score":0.884},{"text":"or","offset":291,"start":169.502,"end":169.542,"score":0.585},{"text":"less","offset":294,"start":169.583,"end":169.742,"score":0.972},{"text":"unaffected.","offset":299,"start":169.882,"end":170.462,"score":0.999}],[{"text":"The","offset":0,"start":171.702,"end":171.802,"score":0.973},{"text":"implications","offset":4,"start":171.903,"end":172.542,"score":0.984},{"text":"of","offset":17,"start":172.602,"end":172.662,"score":0.999},{"text":"all","offset":20,"start":172.743,"end":172.862,"score":0.967},{"text":"this","offset":24,"start":172.903,"end":173.142,"score":0.994},{"text":"were","offset":29,"start":173.502,"end":173.622,"score":0.989},{"text":"that","offset":34,"start":173.642,"end":173.802,"score":0.996},{"text":"it","offset":39,"start":173.982,"end":174.082,"score":0.998},{"text":"was","offset":42,"start":174.123,"end":174.302,"score":0.998},{"text":"not","offset":46,"start":174.382,"end":174.522,"score":0.999},{"text":"the","offset":50,"start":174.642,"end":174.742,"score":0.984},{"text":"disturbance","offset":54,"start":174.762,"end":175.282,"score":0.956},{"text":"of","offset":66,"start":175.303,"end":175.362,"score":0.999},{"text":"sleep","offset":69,"start":175.442,"end":175.662,"score":0.999},{"text":"that","offset":75,"start":175.722,"end":175.862,"score":0.983},{"text":"mattered,","offset":80,"start":175.923,"end":176.202,"score":0.975},{"text":"but","offset":90,"start":176.602,"end":176.742,"score":1.0},{"text":"the","offset":94,"start":176.782,"end":176.862,"score":0.962},{"text":"disturbance","offset":98,"start":176.882,"end":177.462,"score":0.937},{"text":"of","offset":110,"start":177.502,"end":177.582,"score":0.999},{"text":"dreaming.","offset":113,"start":177.662,"end":178.082,"score":1.0}]],"cues":[{"id":"b4-019-001","sourceId":"b4-019-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"What is going on when a person experiences rapid eye-movements during sleep?","start":12.94,"end":18.8,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-002-p01","sourceId":"b4-019-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"It is fairly clear that the sleeping period must have some function,","start":21.52,"end":26.15,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-002-p02","sourceId":"b4-019-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[12,27],"wordModel":"mms-fa","text":"and because there is so much of it the function would seem to be important.","start":27.2,"end":31.26,"score":0.998,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-003-p01","sourceId":"b4-019-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Speculations about its nature have been going on for literally thousands of years,","start":32.54,"end":37.92,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-003-p02","sourceId":"b4-019-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[13,42],"wordModel":"mms-fa","text":"and one odd finding that makes the problem puzzling is that it looks very much as if sleeping is not simply a matter of giving the body a rest.","start":38.84,"end":47.6,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-004","sourceId":"b4-019-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"'Rest', in terms of muscle relaxation and so on, can be achieved by a brief period lying, or even sitting down.","start":48.83,"end":57.76,"score":0.97,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b4-019-005","sourceId":"b4-019-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"The body's tissues are self-repairing and self-restoring to a degree, and function best when more or less continuously active.","start":58.98,"end":68.09,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-006","sourceId":"b4-019-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"In fact a basic amount of movement occurs during sleep which is specifically concerned with preventing muscle inactivity.","start":69.22,"end":77.35,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-007","sourceId":"b4-019-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"If it is not a question of resting the body, then perhaps it is the brain that needs resting?","start":79.65,"end":85.46,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-008","sourceId":"b4-019-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"This might be a plausible hypothesis were it not for two factors.","start":86.66,"end":90.85,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-009-p01","sourceId":"b4-019-009","sourceIndex":8,"part":1,"parts":3,"wordRange":[0,23],"wordModel":"mms-fa","text":"First the electroencephalograph (which is simply a device for recording the electrical activity of the brain by attaching electrodes to the scalp) shows","start":91.77,"end":102.65,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-009-p02","sourceId":"b4-019-009","sourceIndex":8,"part":2,"parts":3,"wordRange":[23,36],"wordModel":"mms-fa","text":"that while there is a change in the pattern of activity during sleep,","start":102.86,"end":106.28,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-009-p03","sourceId":"b4-019-009","sourceIndex":8,"part":3,"parts":3,"wordRange":[36,49],"wordModel":"mms-fa","text":"there is no evidence that the total amount of activity is any less.","start":106.74,"end":111.17,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-010","sourceId":"b4-019-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The second factor is more interesting and more fundamental.","start":112.8,"end":116.18,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-011","sourceId":"b4-019-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Some years ago an American psychiatrist named William Dement published experiments dealing with the recording of eye-movements during sleep.","start":117.28,"end":127.06,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-012","sourceId":"b4-019-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"He showed that the average individual's sleep cycle is punctuated with peculiar bursts of eye-movements, some drifting and slow, others jerky and rapid.","start":128.34,"end":139.32,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-013","sourceId":"b4-019-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"People woken during these periods of eye-movements generally reported that they had been dreaming.","start":140.5,"end":146.42,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-014","sourceId":"b4-019-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"When woken at other times they reported no dreams.","start":147.47,"end":150.83,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-015-p01","sourceId":"b4-019-015","sourceIndex":14,"part":1,"parts":3,"wordRange":[0,16],"wordModel":"mms-fa","text":"If one group of people were disturbed from their eye-movement sleep for several nights on end,","start":151.723,"end":156.82,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-015-p02","sourceId":"b4-019-015","sourceIndex":14,"part":2,"parts":3,"wordRange":[16,34],"wordModel":"mms-fa","text":"and another group were disturbed for an equal period of time but when they were not exhibiting eye-movements,","start":157.69,"end":163.64,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-015-p03","sourceId":"b4-019-015","sourceIndex":14,"part":3,"parts":3,"wordRange":[34,51],"wordModel":"mms-fa","text":"the first group began to show some personality disorders while the others seemed more or less unaffected.","start":164.06,"end":170.54,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-019-016","sourceId":"b4-019-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"The implications of all this were that it was not the disturbance of sleep that mattered, but the disturbance of dreaming.","start":171.64,"end":178.22,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
