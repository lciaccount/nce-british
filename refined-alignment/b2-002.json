":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"'It's raining again.'","start":45.72,"end":47.53,"score":0.766,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-011","sourceId":"b2-002-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Just then, the telephone rang.","start":48.84,"end":51.3,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-012","sourceId":"b2-002-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"It was my aunt Lucy.","start":52.48,"end":54.13,"score":0.91,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-013","sourceId":"b2-002-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'I've just arrived by train,' she said.","start":55.69,"end":59.22,"score":0.982,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-002-014","sourceId":"b2-002-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'I'm coming to see you.'","start":59.75,"end":61.203,"score":0.993,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-002-015","sourceId":"b2-002-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'But I'm still having breakfast,' I said.","start":63.03,"end":66.36,"score":0.993,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-002-016","sourceId":"b2-002-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"'What are you doing?'","start":67.79,"end":69.08,"score":0.988,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-002-017","sourceId":"b2-002-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"she asked.","start":70.04,"end":71.11,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-018","sourceId":"b2-002-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"'I'm having breakfast,' I repeated.","start":72.16,"end":75.43,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-019","sourceId":"b2-002-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"'Dear me,' she said.","start":76.7,"end":79.03,"score":0.995,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-002-020","sourceId":"b2-002-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"'Do you always get up so late?","start":79.96,"end":82.26,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-002-021","sourceId":"b2-002-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"It's one o'clock!'","start":82.89,"end":84.06,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
