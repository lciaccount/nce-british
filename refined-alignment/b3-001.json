rt":136.502,"end":136.582,"score":0.995},{"text":"quiet","offset":80,"start":136.683,"end":137.042,"score":0.931},{"text":"countryside.","offset":86,"start":137.123,"end":137.842,"score":0.981}]],"cues":[{"id":"b3-001-001","sourceId":"b3-001-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Where must the puma have come from?","start":11.5,"end":13.59,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-002","sourceId":"b3-001-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Pumas are large, cat-like animals which are found in America.","start":16.22,"end":21.1,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-003","sourceId":"b3-001-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"When reports came into London Zoo that a wild puma had been spotted forty-five miles south of London, they were not taken seriously.","start":22.62,"end":31.74,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-004-p01","sourceId":"b3-001-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"However, as the evidence began to accumulate, experts from the Zoo felt obliged to investigate,","start":32.84,"end":40.4,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-004-p02","sourceId":"b3-001-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[15,31],"wordModel":"mms-fa","text":"for the descriptions given by people who claimed to have seen the puma were extraordinarily similar.","start":40.92,"end":46.96,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-005","sourceId":"b3-001-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"The hunt for the puma began in a small village where a woman picking blackberries saw 'a large cat'only five yards away from her.","start":48.54,"end":58.36,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-006-p01","sourceId":"b3-001-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"It immediately ran away when she saw it,","start":59.38,"end":62.13,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-006-p02","sourceId":"b3-001-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"mms-fa","text":"and experts confirmed that a puma will not attack a human being unless it is cornered.","start":62.66,"end":68.95,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-007","sourceId":"b3-001-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,26],"wordModel":"mms-fa","text":"The search proved difficult, for the puma was often observed at one place in the morning and at another place twenty miles away in the evening.","start":70.02,"end":80.12,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-008","sourceId":"b3-001-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Wherever it went, it left behind it a trail of dead deer and small animals like rabbits.","start":81.2,"end":87.76,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-009","sourceId":"b3-001-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Paw prints were seen in a number of places and puma fur was found clinging to bushes.","start":89.0,"end":94.66,"score":0.876,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-010","sourceId":"b3-001-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Several people complained of 'cat-like noises' at night and a businessman on a fishing trip saw the puma up a tree.","start":95.87,"end":103.88,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-011","sourceId":"b3-001-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The experts were now fully convinced that the animal was a puma, but where had it come from?","start":105.0,"end":111.74,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-012-p01","sourceId":"b3-001-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"As no pumas had been reported missing from any zoo in the country,","start":112.52,"end":116.47,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-012-p02","sourceId":"b3-001-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[13,30],"wordModel":"mms-fa","text":"this one must have been in the possession of a private collector and somehow managed to escape.","start":117.22,"end":123.84,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-013","sourceId":"b3-001-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The hunt went on for several weeks, but the puma was not caught.","start":124.98,"end":129.42,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-001-014","sourceId":"b3-001-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"It is disturbing to think that a dangerous wild animal is still at large in the quiet countryside.","start":130.84,"end":137.92,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
