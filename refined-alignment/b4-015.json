s":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"the other the lack of freedom of the individual research worker.","start":31.96,"end":35.66,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-004-p01","sourceId":"b4-015-004","sourceIndex":3,"part":1,"parts":3,"wordRange":[0,10],"wordModel":"mms-fa","text":"In so far as any inquiry is a secret one,","start":37.07,"end":40.2,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-004-p02","sourceId":"b4-015-004","sourceIndex":3,"part":2,"parts":3,"wordRange":[10,34],"wordModel":"mms-fa","text":"it naturally limits all those engaged in carrying it out from effective contact with their fellow scientists either in other countries or in universities,","start":40.82,"end":50.58,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-004-p03","sourceId":"b4-015-004","sourceIndex":3,"part":3,"parts":3,"wordRange":[34,45],"wordModel":"mms-fa","text":"or even, often enough, in other departments of the same firm.","start":51.15,"end":55.29,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-005","sourceId":"b4-015-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The degree of secrecy naturally varies considerably.","start":56.78,"end":60.23,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-006-p01","sourceId":"b4-015-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Some of the bigger firms are engaged in researches which are of such general and fundamental nature","start":61.16,"end":67.54,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-006-p02","sourceId":"b4-015-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[17,30],"wordModel":"mms-fa","text":"that it is a positive advantage to them not to keep them secret.","start":67.762,"end":72.46,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-007-p01","sourceId":"b4-015-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Yet a great many processes depending on such research are sought for with complete secrecy","start":73.67,"end":80.13,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-007-p02","sourceId":"b4-015-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[15,25],"wordModel":"mms-fa","text":"until the stage at which patents can be taken out.","start":80.4,"end":83.44,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-008","sourceId":"b4-015-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Even more processes are never patented at all but kept as secret processes.","start":84.65,"end":90.22,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-009","sourceId":"b4-015-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"english-ctc-fallback","text":"This applies particularly to chemical industries, where chance discoveries play a much larger part than they do in physical and mechanical industries.","start":91.18,"end":101.53,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-010","sourceId":"b4-015-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Sometimes the secrecy goes to such an extent that the whole nature of the research cannot be mentioned.","start":102.19,"end":108.78,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-011-p01","sourceId":"b4-015-011","sourceIndex":10,"part":1,"parts":3,"wordRange":[0,15],"wordModel":"mms-fa","text":"Many firms, for instance have great difficulty in obtaining technical or scientific books from libraries","start":109.67,"end":116.5,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-011-p02","sourceId":"b4-015-011","sourceIndex":10,"part":2,"parts":3,"wordRange":[15,33],"wordModel":"mms-fa","text":"because they are unwilling to have their names entered as having taken out such and such a book,","start":116.68,"end":121.84,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-015-011-p03","sourceId":"b4-015-011","sourceIndex":10,"part":3,"parts":3,"wordRange":[33,55],"wordModel":"mms-fa","text":"for fear the agents of other firms should be able to trace the kind of research they are likely to be undertaking.","start":122.22,"end":129.31,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
