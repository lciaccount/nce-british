e":0.999},{"text":"the","offset":130,"start":155.423,"end":155.482,"score":0.999},{"text":"hall!","offset":134,"start":155.542,"end":155.822,"score":0.381}],[{"text":"I","offset":0,"start":157.023,"end":157.042,"score":1.0},{"text":"have","offset":2,"start":157.083,"end":157.242,"score":0.997},{"text":"never","offset":7,"start":157.363,"end":157.622,"score":0.994},{"text":"be","offset":13,"start":157.662,"end":157.782,"score":1.0},{"text":"able","offset":16,"start":157.942,"end":158.182,"score":0.999},{"text":"to","offset":21,"start":158.222,"end":158.302,"score":0.998},{"text":"look","offset":24,"start":158.442,"end":158.622,"score":0.997},{"text":"at","offset":29,"start":158.662,"end":158.742,"score":0.994},{"text":"a","offset":32,"start":158.782,"end":158.802,"score":0.862},{"text":"snail","offset":34,"start":158.882,"end":159.162,"score":0.932},{"text":"since","offset":40,"start":159.262,"end":159.522,"score":0.998},{"text":"then.","offset":46,"start":159.562,"end":159.762,"score":0.927}]],"cues":[{"id":"b3-023-001","sourceId":"b3-023-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"What was it about snails that made the writer collect them for his friend on that day in particular?","start":13.89,"end":19.56,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-002","sourceId":"b3-023-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"People become quite illogical when they try to decide what can be eaten and what cannot be eaten.","start":22.16,"end":28.87,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-003","sourceId":"b3-023-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"If you lived in the Mediterranean, for instance, you would consider octopus a great delicacy.","start":29.87,"end":35.75,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-004","sourceId":"b3-023-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"You would not be able to understand why some people find it repulsive.","start":36.78,"end":40.74,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-005","sourceId":"b3-023-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"On the other hand, your stomach would turn at the idea of frying potatoes in animal fat-the normally accepted practice in many northern countries.","start":41.82,"end":50.98,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-006-p01","sourceId":"b3-023-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"The sad truth is that most of us have been brought up to eat certain foods","start":51.82,"end":56.36,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-006-p02","sourceId":"b3-023-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[16,24],"wordModel":"mms-fa","text":"and we stick to them all our lives.","start":56.6,"end":58.6,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-007","sourceId":"b3-023-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"No creature has received more praise and abuse than the common garden snail.","start":60.15,"end":64.95,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-008","sourceId":"b3-023-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Cooked in wine, snails are a great luxury in various parts of the world.","start":66.24,"end":71.6,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-009","sourceId":"b3-023-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"There are countless people who, ever since their early years, have learned to associate snails with food.","start":72.46,"end":78.26,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-010","sourceId":"b3-023-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"My friend, Robert, lives in a country where snails are despised.","start":79.56,"end":84.77,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-011","sourceId":"b3-023-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"As his flat is in a large town, he has no garden of his own.","start":85.74,"end":90.08,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-012","sourceId":"b3-023-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"For years he has been asking me to collect snails from my garden and take them to him.","start":90.94,"end":96.39,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-013-p01","sourceId":"b3-023-013","sourceIndex":12,"part":1,"parts":3,"wordRange":[0,15],"wordModel":"mms-fa","text":"The idea never appealed to me very much, but one day, after a heavy shower,","start":97.44,"end":102.41,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-013-p02","sourceId":"b3-023-013","sourceIndex":12,"part":2,"parts":3,"wordRange":[15,23],"wordModel":"mms-fa","text":"I happened to be walking in my garden","start":102.69,"end":104.69,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-013-p03","sourceId":"b3-023-013","sourceIndex":12,"part":3,"parts":3,"wordRange":[23,40],"wordModel":"mms-fa","text":"when I noticed a huge number of snails taking a stroll on some of my prize plants.","start":104.9,"end":110.29,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-014","sourceId":"b3-023-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Acting on a sudden impulse, I collected several dozen, put them in a paper bag, and took them to Robert.","start":111.29,"end":118.52,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-015","sourceId":"b3-023-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Robert was delighted to see me and equally pleased with my little gift.","start":119.48,"end":123.83,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-016","sourceId":"b3-023-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"I left the bag in the hall and Robert and I went into the living room where we talked for a couple of hours.","start":124.41,"end":130.55,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-017","sourceId":"b3-023-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"I had forgotten all about the snails when Robert suddenly said that I must stay to dinner.","start":131.53,"end":136.87,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-018","sourceId":"b3-023-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"Snails would, of course, be the main dish.","start":137.73,"end":140.38,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-019","sourceId":"b3-023-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"I did not fancy the idea and I reluctantly followed Robert out of the room.","start":141.46,"end":146.04,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-020-p01","sourceId":"b3-023-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"To our dismay, we saw that there were snails everywhere:","start":147.04,"end":150.73,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-020-p02","sourceId":"b3-023-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[10,25],"wordModel":"mms-fa","text":"they had escaped from the paper bag and had taken complete possession of the hall!","start":151.18,"end":155.93,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-023-021","sourceId":"b3-023-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"I have never be able to look at a snail since then.","start":156.91,"end":159.99,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
