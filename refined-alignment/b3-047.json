":64,"start":236.162,"end":236.502,"score":0.924},{"text":"has","offset":71,"start":237.002,"end":237.142,"score":0.999},{"text":"become","offset":75,"start":237.202,"end":237.622,"score":1.0},{"text":"a","offset":82,"start":237.982,"end":238.002,"score":0.998},{"text":"golden","offset":84,"start":238.222,"end":238.622,"score":0.977},{"text":"memory.","offset":91,"start":238.743,"end":239.122,"score":1.0}]],"cues":[{"id":"b3-047-001","sourceId":"b3-047-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"What does the writer describe as an 'amusing old-fashioned source of noise' ?","start":11.97,"end":16.98,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-002","sourceId":"b3-047-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Pollution is the price we pay for an overpopulated, overindustrialized planet.","start":19.63,"end":24.94,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-003-p01","sourceId":"b3-047-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"When you come to think about it, there are only four ways you can deal with rubbish:","start":25.68,"end":29.93,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-003-p02","sourceId":"b3-047-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[17,35],"wordModel":"mms-fa","text":"dump it, burn it, turn it into something you can use again, attempt to produce less of it.","start":30.53,"end":37.06,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-004","sourceId":"b3-047-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"We keep trying all four methods, but sheer volume of rubbish we produce worldwide threatens to overwhelm us.","start":37.7,"end":44.89,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-005","sourceId":"b3-047-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Rubbish, however, is only part of the problem of polluting our planet.","start":46.13,"end":49.9,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-006","sourceId":"b3-047-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The need to produce ever increasing quantities of cheap food leads to a different kind of pollution.","start":50.48,"end":56.54,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-007","sourceId":"b3-047-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Industriallized farming metheods produce cheap meat products: beef, pork and chicken.","start":57.44,"end":63.78,"score":0.914,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-008","sourceId":"b3-047-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The use of pesticides and fertilizers produces cheap grain and vegetables.","start":64.44,"end":69.73,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-009-p01","sourceId":"b3-047-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"The price we pay for cheap food may be already too high:","start":70.64,"end":74.26,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-009-p02","sourceId":"b3-047-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[12,28],"wordModel":"mms-fa","text":"Mad Cow Disease (BSE) in cattle, salmonella in chicken and eggs, and listeria in dairy products.","start":75.02,"end":83.95,"score":0.884,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-010-p01","sourceId":"b3-047-010","sourceIndex":9,"part":1,"parts":4,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"And if you think you'll abandon meat and become a vegetarian,","start":84.69,"end":87.86,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-010-p02","sourceId":"b3-047-010","sourceIndex":9,"part":2,"parts":4,"wordRange":[11,20],"wordModel":"english-ctc-fallback","text":"you have the choice of very expensive organically-grown vegetables","start":88.4,"end":92.65,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-010-p03","sourceId":"b3-047-010","sourceIndex":9,"part":3,"parts":4,"wordRange":[20,36],"wordModel":"english-ctc-fallback","text":"or a steady diet of pesticides every time you think you're eating fresh salads and vegetables,","start":93.09,"end":98.92,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-010-p04","sourceId":"b3-047-010","sourceIndex":9,"part":4,"parts":4,"wordRange":[36,44],"wordModel":"english-ctc-fallback","text":"or just having an innocent glass of water!","start":99.52,"end":102.14,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-011-p01","sourceId":"b3-047-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"However, there is an even more insidious kind of pollution","start":103.06,"end":106.92,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-011-p02","sourceId":"b3-047-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"that particularly affects urban area and invades our daily lives, and that is noise.","start":107.06,"end":113.66,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-012","sourceId":"b3-047-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"Burglar alarms going off at any time of the day or night serve only to annoy passers-by and actually assist burglars to burgle.","start":114.37,"end":123.22,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-013","sourceId":"b3-047-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Car alarms constantly scream at us in the street and are a source of profound irritation.","start":124.0,"end":129.34,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-014","sourceId":"b3-047-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"A recent survey of the effects of noise revealed (surprisingly?)","start":130.25,"end":134.84,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-015","sourceId":"b3-047-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"that dogs barking incessantly in the night rated the highest form of noise pollution on a scale ranging from 1 to 7.","start":135.24,"end":143.25,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-016","sourceId":"b3-047-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The survey revealed a large number of sources of noise that we really dislike.","start":144.23,"end":149.42,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-017-p01","sourceId":"b3-047-017","sourceIndex":16,"part":1,"parts":3,"wordRange":[0,18],"wordModel":"mms-fa","text":"Lawn mowers whining on a summer's day, late-night parties in apartment blocks, noisy neighbours, vehicles of all kinds,","start":150.56,"end":160.37,"score":0.879,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-017-p02","sourceId":"b3-047-017","sourceIndex":16,"part":2,"parts":3,"wordRange":[18,31],"wordModel":"mms-fa","text":"especially large container trucks thundering through quiet villages, planes and helicopters flying overhead,","start":160.56,"end":167.53,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-017-p03","sourceId":"b3-047-017","sourceIndex":16,"part":3,"parts":3,"wordRange":[31,43],"wordModel":"mms-fa","text":"large radios carried round in public places and played at maximum volume.","start":168.24,"end":173.66,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-018","sourceId":"b3-047-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"New technology has also made its own contribution to noise.","start":174.14,"end":178.02,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-019","sourceId":"b3-047-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"A lot of people object to mobile phones, especially when they are used in public places like restaurant or on public transport.","start":178.66,"end":186.95,"score":0.903,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-020","sourceId":"b3-047-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Loud conversations on mobile phones invade our thoughts or interrupt the pleasure of meeting friends for a quiet chat.","start":187.48,"end":194.9,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-021","sourceId":"b3-047-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The noise pollution survey revealed a rather surprising and possibly amusing old-fashioned source of noise.","start":195.56,"end":202.66,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-022","sourceId":"b3-047-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"It turned out to be snoring!","start":203.44,"end":206.02,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-023","sourceId":"b3-047-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Men were found to be the worst offenders.","start":206.5,"end":208.93,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-024","sourceId":"b3-047-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"It was revealed that 20% of men in their mid-thirties snore.","start":209.68,"end":214.06,"score":0.884,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-025","sourceId":"b3-047-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This figure rises to a staggering 60% of men in their sixties.","start":214.67,"end":219.48,"score":0.898,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-026-p01","sourceId":"b3-047-026","sourceIndex":25,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Against these figures, it was found that only 5% of women snore regularly,","start":220.25,"end":225.83,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-026-p02","sourceId":"b3-047-026","sourceIndex":25,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"while the rest are constantly woken or kept awake by their trumpeting partners.","start":226.28,"end":231.24,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-047-027","sourceId":"b3-047-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Whatever the source of noise, one thing is certain: silence, it seems, has become a golden memory.","start":231.84,"end":239.24,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
