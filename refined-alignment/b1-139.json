,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-007","sourceId":"b1-139-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"She invited Charlotte and me to dinner this evening.","start":34.57,"end":38.04,"score":0.878,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-008","sourceId":"b1-139-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"I said I would be at your house at six o'clock, but the boss wants me to do some extra work.","start":38.73,"end":45.05,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-009","sourceId":"b1-139-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I'll have to stay at the office.","start":45.97,"end":47.74,"score":0.87,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-010","sourceId":"b1-139-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"I don't know when I'll finish.","start":48.45,"end":50.27,"score":0.852,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-011","sourceId":"b1-139-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Oh, and by the way, my wife wants to know if Mary needs any help.","start":50.78,"end":55.66,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-012","sourceId":"b1-139-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I don't know what you're talking about.","start":56.963,"end":60.13,"score":0.914,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-139-013","sourceId":"b1-139-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"That is John Smith, isn't it?","start":61.25,"end":62.97,"score":0.967,"timingValid":true,"needsReview":false,"revie