re":0.986},{"text":"who?","offset":9,"start":103.802,"end":103.903,"score":0.875}]],"cues":[{"id":"b2-090-001","sourceId":"b2-090-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"What kind of fish are they?","start":12.25,"end":14.56,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-002-p01","sourceId":"b2-090-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"Fish and chips has always been a favourite dish in Britain,","start":17.3,"end":21.27,"score":0.887,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-002-p02","sourceId":"b2-090-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[11,25],"wordModel":"mms-fa","text":"but as the oceans have been overfished, fish has become more and more expensive.","start":22.24,"end":27.5,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-003","sourceId":"b2-090-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"So it comes as a surprise to learn that giant fish are terrifying the divers on North Sea oil rigs.","start":28.62,"end":36.04,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-004-p01","sourceId":"b2-090-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"Oil rigs have to be repaired frequently and divers, who often have to work in darkness a hundred feet under water,","start":37.49,"end":46.83,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-004-p02","sourceId":"b2-090-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[21,37],"wordModel":"mms-fa","text":"have been frightened out of their wits by giant fish bumping into them as they work.","start":47.17,"end":53.31,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-005","sourceId":"b2-090-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Now they have had special cages made to protect them from these monsters.","start":55.26,"end":59.65,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-006-p01","sourceId":"b2-090-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"The fish are not sharks or killer whales,","start":61.06,"end":63.96,"score":0.907,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-006-p02","sourceId":"b2-090-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[8,29],"wordModel":"mms-fa","text":"but favourite eating varieties like cod and skate which grow to unnatural sizes, sometimes as much as twelve feet in length.","start":64.88,"end":75.483,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-007-p01","sourceId":"b2-090-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"Three factors have caused these fish to grow so large: the warm water round the hot oil pipes under the sea;","start":76.7,"end":85.18,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-007-p02","sourceId":"b2-090-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[21,44],"wordModel":"mms-fa","text":"the plentiful supply of food thrown overboard by the crews on the rigs; the total absence of fishing boats around the oil rigs.","start":86.15,"end":95.27,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-008","sourceId":"b2-090-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"As a result, the fish just eat and eat and grow and grow in the lovely warm water.","start":96.43,"end":102.36,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-090-009","sourceId":"b2-090-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"Who eats who?","start":103.2,"end":104.21,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
