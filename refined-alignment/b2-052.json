1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What is the writer's carpet made of?","start":14.27,"end":17.05,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-002","sourceId":"b2-052-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"We have just moved into a new house and I have been working hard all morning.","start":19.76,"end":26.16,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-003","sourceId":"b2-052-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"I have been trying to get my new room in order.","start":28.1,"end":30.98,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-004","sourceId":"b2-052-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This has not been easy because I own over a thousand books.","start":32.4,"end":37.59,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-005","sourceId":"b2-052-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"To make matters worse, the room is rather small, so I have temporarily put my books on the floor.","start":38.62,"end":46.3,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-006-p01","sourceId":"b2-052-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"At the moment, they cover every inch of floor space","start":47.68,"end":52.2,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-006-p02","sourceId":"b2-052-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[10,26],"wordModel":"mms-fa","text":"and I actually have to walk on them to get in or out of the room.","start":52.76,"end":57.23,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-007","sourceId":"b2-052-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A short while ago, my sister helped me to carry one of my old bookcases up the stairs.","start":58.8,"end":65.84,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-008","sourceId":"b2-052-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"She went into my room and got a big surprise when she saw all those books on the floor.","start":67.39,"end":73.93,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-009","sourceId":"b2-052-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"'This is the prettiest carpet I have ever seen,' she said.","start":75.36,"end":79.06,"score":0.973,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-052-010","sourceId":"b2-052-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"She gazed at it for some time then added, 'You don't need bookcases at all.","start":80.58,"end":86.28,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-052-011","sourceId":"b2-052-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"You can sit here in your spare time and read the carpet!'","start":86.74,"end":90.16,"score":0.979,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
