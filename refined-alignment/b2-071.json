dRange":[0,6],"wordModel":"mms-fa","text":"Has Big Ben ever gone wrong?","start":13.64,"end":16.52,"score":0.891,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-002-p01","sourceId":"b2-071-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"When you visit London, one of the first things you will see is Big Ben,","start":19.22,"end":24.98,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-002-p02","sourceId":"b2-071-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[15,29],"wordModel":"mms-fa","text":"the famous clock which can be heard all over the world on the B.B.C.","start":25.78,"end":30.742,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-003","sourceId":"b2-071-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"If the Houses of Parliament had not been burned down in 1834, the great clock would never have been erected.","start":32.24,"end":40.96,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-004-p01","sourceId":"b2-071-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Big Ben takes its name from Sir Benjamin Hall","start":42.15,"end":46.7,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-004-p02","sourceId":"b2-071-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[9,27],"wordModel":"mms-fa","text":"who was responsible for the making of the clock when the new Houses of Parliament were being built.","start":47.88,"end":54.11,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-005","sourceId":"b2-071-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"It is not only of immense size, but is extremely accurate as well.","start":55.49,"end":61.9,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-006","sourceId":"b2-071-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Officials from Greenwich Observatory have the clock checked twice a day.","start":63.2,"end":68.74,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-007","sourceId":"b2-071-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"On the B.B.C.","start":69.79,"end":70.943,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-008","sourceId":"b2-071-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"you can hear the clock when it is actually striking because microphones are connected to the clock tower.","start":71.51,"end":79.09,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-009","sourceId":"b2-071-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Big Ben has rarely gone wrong.","start":80.5,"end":82.69,"score":0.88,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-010","sourceId":"b2-071-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Once, however, it failed to give the correct time.","start":83.92,"end":87.41,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-071-011","sourceId":"b2-071-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"A painter who had been working on the tower hung a pot of paint on one of the hands and slowed it down!","start":88.45,"end":96.23,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
