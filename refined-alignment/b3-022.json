65},{"text":"off","offset":22,"start":144.702,"end":144.782,"score":0.965},{"text":"the","offset":26,"start":144.822,"end":144.902,"score":0.998},{"text":"stage.","offset":30,"start":144.942,"end":145.362,"score":0.987}],[{"text":"Much","offset":0,"start":146.142,"end":146.362,"score":0.941},{"text":"to","offset":5,"start":146.422,"end":146.502,"score":0.999},{"text":"the","offset":8,"start":146.562,"end":146.662,"score":0.926},{"text":"aristocrat's","offset":12,"start":146.822,"end":147.542,"score":0.95},{"text":"amusement,","offset":25,"start":147.602,"end":148.142,"score":0.98},{"text":"the","offset":36,"start":148.662,"end":148.742,"score":0.998},{"text":"gaoler","offset":40,"start":148.822,"end":149.182,"score":0.626},{"text":"returned","offset":47,"start":149.222,"end":149.702,"score":0.986},{"text":"a","offset":56,"start":149.743,"end":149.762,"score":0.998},{"text":"few","offset":58,"start":149.863,"end":150.022,"score":0.935},{"text":"moments","offset":62,"start":150.123,"end":150.542,"score":0.98},{"text":"later","offset":70,"start":150.623,"end":150.882,"score":0.986},{"text":"with","offset":76,"start":151.183,"end":151.322,"score":0.966},{"text":"a","offset":81,"start":151.363,"end":151.382,"score":0.972},{"text":"pair","offset":83,"start":151.463,"end":151.702,"score":0.731},{"text":"of","offset":88,"start":151.762,"end":151.842,"score":0.986},{"text":"glasses","offset":91,"start":151.903,"end":152.342,"score":0.861},{"text":"and","offset":99,"start":152.702,"end":152.802,"score":0.948},{"text":"the","offset":103,"start":152.843,"end":152.922,"score":0.998},{"text":"usual","offset":107,"start":153.123,"end":153.462,"score":1.0},{"text":"copy","offset":113,"start":153.523,"end":153.782,"score":0.999},{"text":"of","offset":118,"start":153.843,"end":153.902,"score":0.999},{"text":"the","offset":121,"start":153.942,"end":154.022,"score":0.986},{"text":"letter","offset":125,"start":154.062,"end":154.342,"score":0.977},{"text":"which","offset":132,"start":154.822,"end":155.022,"score":0.943},{"text":"he","offset":138,"start":155.062,"end":155.122,"score":0.999},{"text":"proceeded","offset":141,"start":155.243,"end":155.842,"score":0.996},{"text":"to","offset":151,"start":155.942,"end":156.022,"score":0.998},{"text":"read","offset":154,"start":156.142,"end":156.362,"score":0.996},{"text":"to","offset":159,"start":156.442,"end":156.522,"score":0.997},{"text":"the","offset":162,"start":156.583,"end":156.662,"score":0.979},{"text":"prisoner.","offset":166,"start":156.722,"end":157.162,"score":0.98}]],"cues":[{"id":"b3-022-001","sourceId":"b3-022-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Which actor read the letter in the end, the aristocrat or the gaoler?","start":12.07,"end":17.44,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-002","sourceId":"b3-022-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Some plays are so successful that they run for years on end.","start":20.09,"end":24.14,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-003","sourceId":"b3-022-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"In many ways, this is unfortunate for the poor actors who are required to go on repeating the same lines night after night.","start":25.16,"end":33.1,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-004","sourceId":"b3-022-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"One would expect them to know their parts by heart and never have cause to falter.","start":33.67,"end":38.58,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-005","sourceId":"b3-022-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Yet this is not always the case.","start":39.38,"end":41.68,"score":0.815,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-006-p01","sourceId":"b3-022-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"A famous actor in a highly successful play was once cast in the role of an aristocrat","start":42.86,"end":49.25,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-006-p02","sourceId":"b3-022-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[17,27],"wordModel":"mms-fa","text":"who had been imprisoned in the Bastille for twenty years.","start":49.7,"end":52.94,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-007","sourceId":"b3-022-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"In the last act, a gaoler would always come on to the stage with a letter which he would hand to the prisoner.","start":54.12,"end":60.2,"score":0.897,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-022-008-p01","sourceId":"b3-022-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Even though the noble was expected to read the letter at each performance,","start":60.75,"end":64.67,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-008-p02","sourceId":"b3-022-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"he always insisted that it should be written out in full.","start":64.99,"end":68.15,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-009-p01","sourceId":"b3-022-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"One night, the gaoler decided to play a joke on his colleague to find out if, after so many performances,","start":69.85,"end":77.33,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-009-p02","sourceId":"b3-022-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[20,32],"wordModel":"english-ctc-fallback","text":"he had managed to learn the contents of the letter by heart.","start":77.6,"end":80.51,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-010","sourceId":"b3-022-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The curtain went up on the final act of the play and revealed the aristocrat sitting alone behind bars in his dark cell.","start":81.75,"end":90.06,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-011","sourceId":"b3-022-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Just then, the gaoler appeared with the precious letter in his hands.","start":91.3,"end":95.76,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-012","sourceId":"b3-022-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He entered the cell and presented the letter to the aristocrat.","start":96.84,"end":100.44,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-013","sourceId":"b3-022-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"But the copy he gave him had not been written out in full as usual.","start":101.04,"end":105.81,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-014","sourceId":"b3-022-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It was simply a blank sheet of paper.","start":106.61,"end":109.45,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-015","sourceId":"b3-022-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The gaoler looked on eagerly, anxious to see if his fellow actor had at last learnt his lines.","start":110.4,"end":116.66,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-016","sourceId":"b3-022-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The noble stared at the blank sheet of paper for a few seconds.","start":117.52,"end":120.98,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-017","sourceId":"b3-022-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Then, squinting his eyes, he said: 'The light is dim.","start":121.57,"end":125.8,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-018","sourceId":"b3-022-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"Read the letter to me.'","start":126.44,"end":127.86,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-019","sourceId":"b3-022-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"And he promptly handed the sheet of paper to the gaoler.","start":128.52,"end":131.61,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-020","sourceId":"b3-022-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Finding that he could not remember a word of the letter either, the gaoler replied: 'The light is indeed dim, sire.","start":132.38,"end":140.24,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-021","sourceId":"b3-022-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I must get my glasses.  '","start":140.87,"end":142.58,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-022","sourceId":"b3-022-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"With this, he hurried off the stage.","start":143.24,"end":145.44,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-023-p01","sourceId":"b3-022-023","sourceIndex":22,"part":1,"parts":3,"wordRange":[0,5],"wordModel":"mms-fa","text":"Much to the aristocrat's amusement,","start":146.01,"end":148.37,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-023-p02","sourceId":"b3-022-023","sourceIndex":22,"part":2,"parts":3,"wordRange":[5,17],"wordModel":"mms-fa","text":"the gaoler returned a few moments later with a pair of glasses","start":148.59,"end":152.43,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-022-023-p03","sourceId":"b3-022-023","sourceIndex":22,"part":3,"parts":3,"wordRange":[17,32],"wordModel":"mms-fa","text":"and the usual copy of the letter which he proceeded to read to the prisoner.","start":152.64,"end":157.24,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
