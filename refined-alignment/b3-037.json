":0.985},{"text":"not","offset":66,"start":131.583,"end":131.742,"score":0.975},{"text":"even","offset":70,"start":131.882,"end":132.082,"score":0.998},{"text":"heard","offset":75,"start":132.202,"end":132.422,"score":0.978},{"text":"of","offset":81,"start":132.442,"end":132.522,"score":0.998},{"text":"it.","offset":84,"start":132.562,"end":132.662,"score":0.996}],[{"text":"I","offset":0,"start":133.722,"end":133.742,"score":1.0},{"text":"determined","offset":2,"start":133.882,"end":134.422,"score":0.961},{"text":"to","offset":13,"start":134.463,"end":134.522,"score":0.996},{"text":"lodge","offset":16,"start":134.602,"end":134.842,"score":0.913},{"text":"a","offset":22,"start":134.882,"end":134.902,"score":0.998},{"text":"complaint","offset":24,"start":134.963,"end":135.362,"score":0.981},{"text":"as","offset":34,"start":135.463,"end":135.502,"score":1.0},{"text":"soon","offset":37,"start":135.583,"end":135.762,"score":0.992},{"text":"as","offset":42,"start":135.803,"end":135.862,"score":1.0},{"text":"we","offset":45,"start":135.923,"end":135.982,"score":1.0},{"text":"arrived.","offset":48,"start":136.062,"end":136.502,"score":0.974}],[{"text":"Two","offset":0,"start":137.683,"end":137.822,"score":0.982},{"text":"hours","offset":4,"start":137.843,"end":138.102,"score":0.871},{"text":"later,","offset":10,"start":138.183,"end":138.462,"score":0.991},{"text":"I","offset":17,"start":139.083,"end":139.102,"score":0.997},{"text":"was","offset":19,"start":139.142,"end":139.262,"score":0.991},{"text":"talking","offset":23,"start":139.322,"end":139.642,"score":0.994},{"text":"angrily","offset":31,"start":139.863,"end":140.282,"score":0.891},{"text":"to","offset":39,"start":140.363,"end":140.422,"score":0.998},{"text":"the","offset":42,"start":140.463,"end":140.542,"score":0.98},{"text":"station","offset":46,"start":140.583,"end":140.922,"score":0.995},{"text":"master","offset":54,"start":140.963,"end":141.342,"score":0.952},{"text":"at","offset":61,"start":141.623,"end":141.722,"score":0.997},{"text":"Westhaven.","offset":64,"start":141.822,"end":142.362,"score":0.996}],[{"text":"When","offset":0,"start":143.243,"end":143.382,"score":0.992},{"text":"he","offset":5,"start":143.403,"end":143.462,"score":0.896},{"text":"denied","offset":8,"start":143.562,"end":143.962,"score":0.998},{"text":"the","offset":15,"start":144.002,"end":144.082,"score":0.997},{"text":"train's","offset":19,"start":144.142,"end":144.482,"score":0.954},{"text":"existence,","offset":27,"start":144.542,"end":145.122,"score":0.925},{"text":"I","offset":38,"start":145.602,"end":145.622,"score":0.999},{"text":"borrowed","offset":40,"start":145.743,"end":146.022,"score":0.83},{"text":"his","offset":49,"start":146.062,"end":146.182,"score":0.999},{"text":"copy","offset":53,"start":146.222,"end":146.482,"score":1.0},{"text":"of","offset":58,"start":146.683,"end":146.742,"score":0.999},{"text":"the","offset":61,"start":146.762,"end":146.862,"score":0.956},{"text":"timetable.","offset":65,"start":146.903,"end":147.442,"score":0.995}],[{"text":"There","offset":0,"start":148.523,"end":148.682,"score":0.995},{"text":"was","offset":6,"start":148.722,"end":148.862,"score":0.992},{"text":"a","offset":10,"start":149.262,"end":149.282,"score":1.0},{"text":"note","offset":12,"start":149.403,"end":149.602,"score":0.944},{"text":"of","offset":17,"start":149.662,"end":149.702,"score":1.0},{"text":"triumph","offset":20,"start":149.843,"end":150.202,"score":0.935},{"text":"in","offset":28,"start":150.282,"end":150.322,"score":1.0},{"text":"my","offset":31,"start":150.403,"end":150.482,"score":1.0},{"text":"voice","offset":34,"start":150.583,"end":150.842,"score":1.0},{"text":"when","offset":40,"start":151.243,"end":151.362,"score":0.945},{"text":"I","offset":45,"start":151.422,"end":151.442,"score":1.0},{"text":"told","offset":47,"start":151.562,"end":151.762,"score":1.0},{"text":"him","offset":52,"start":151.822,"end":151.922,"score":0.942},{"text":"that","offset":56,"start":152.183,"end":152.322,"score":0.904},{"text":"it","offset":61,"start":152.382,"end":152.422,"score":0.999},{"text":"was","offset":64,"start":152.482,"end":152.622,"score":0.993},{"text":"there","offset":68,"start":152.702,"end":152.942,"score":0.995},{"text":"in","offset":74,"start":153.102,"end":153.142,"score":1.0},{"text":"black","offset":77,"start":153.262,"end":153.502,"score":0.905},{"text":"and","offset":83,"start":153.583,"end":153.662,"score":0.983},{"text":"white.","offset":87,"start":153.743,"end":153.962,"score":0.999}],[{"text":"Glancing","offset":0,"start":154.982,"end":155.502,"score":0.97},{"text":"at","offset":9,"start":155.642,"end":155.742,"score":0.998},{"text":"it","offset":12,"start":155.762,"end":155.842,"score":0.997},{"text":"briefly,","offset":15,"start":155.903,"end":156.242,"score":0.923},{"text":"he","offset":24,"start":156.903,"end":156.982,"score":0.983},{"text":"told","offset":27,"start":157.062,"end":157.262,"score":0.851},{"text":"me","offset":32,"start":157.282,"end":157.342,"score":0.998},{"text":"to","offset":35,"start":157.442,"end":157.502,"score":0.996},{"text":"look","offset":38,"start":157.642,"end":157.802,"score":0.999},{"text":"again.","offset":43,"start":157.863,"end":158.182,"score":0.999}],[{"text":"A","offset":0,"start":159.222,"end":159.242,"score":0.559},{"text":"tiny","offset":2,"start":159.343,"end":159.622,"score":0.61},{"text":"asterisk","offset":7,"start":159.843,"end":160.402,"score":0.752},{"text":"conducted","offset":16,"start":160.702,"end":161.222,"score":0.999},{"text":"me","offset":26,"start":161.262,"end":161.342,"score":0.999},{"text":"to","offset":29,"start":161.482,"end":161.562,"score":0.998},{"text":"a","offset":32,"start":161.702,"end":161.722,"score":0.998},{"text":"footnote","offset":34,"start":161.863,"end":162.382,"score":0.97},{"text":"at","offset":43,"start":162.662,"end":162.742,"score":0.999},{"text":"the","offset":46,"start":162.782,"end":162.882,"score":0.943},{"text":"bottom","offset":50,"start":162.942,"end":163.242,"score":0.992},{"text":"of","offset":57,"start":163.303,"end":163.362,"score":0.999},{"text":"the","offset":60,"start":163.403,"end":163.482,"score":0.997},{"text":"page.","offset":64,"start":163.502,"end":163.922,"score":0.999}],[{"text":"It","offset":0,"start":164.382,"end":164.422,"score":1.0},{"text":"said:","offset":3,"start":164.502,"end":164.722,"score":0.993},{"text":"'This","offset":9,"start":165.702,"end":165.862,"score":0.999},{"text":"service","offset":15,"start":165.982,"end":166.422,"score":0.971},{"text":"has","offset":23,"start":166.782,"end":166.922,"score":0.999},{"text":"been","offset":27,"start":167.062,"end":167.282,"score":0.997},{"text":"suspended.'","offset":32,"start":167.442,"end":167.982,"score":0.981}]],"cues":[{"id":"b3-037-001","sourceId":"b3-037-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What was the mistake the author made?","start":12.82,"end":15.38,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-002","sourceId":"b3-037-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"We have learnt to expect that trains will be punctual.","start":18.0,"end":21.56,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-003","sourceId":"b3-037-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"After years of conditioning, most of us have developed an unshakable faith in railway timetables.","start":22.24,"end":29.22,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-004","sourceId":"b3-037-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Ships may be delayed by storms; flights may be cancelled because of bad weather; but trains must be on time.","start":30.15,"end":38.53,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-005","sourceId":"b3-037-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Only an exceptionally heavy snow fall might temporarily dislocate railway services.","start":39.02,"end":44.57,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-006","sourceId":"b3-037-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It is all too easy to blame the railway authorities when something does go wrong.","start":45.39,"end":50.11,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-007","sourceId":"b3-037-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The truth is that when mistakes occur, they are more likely to be ours than theirs.","start":50.82,"end":56.48,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-008","sourceId":"b3-037-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"After consulting my railway timetable, I noted with satisfaction that there was an express train to Westhaven.","start":57.75,"end":65.54,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-009","sourceId":"b3-037-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"It went direct from my local station and the journey lasted a mere hour and seventeen minutes.","start":66.32,"end":72.3,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-010","sourceId":"b3-037-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"When I boarded the train, I could not help noticing that a great many local people got on as well.","start":73.21,"end":79.64,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-011","sourceId":"b3-037-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"At the time, this did not strike me as odd.","start":80.41,"end":83.05,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-012","sourceId":"b3-037-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"I reflected that there must be a great many people besides myself who wished to take advantage of this excellent service.","start":83.6,"end":91.1,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-013","sourceId":"b3-037-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Neither was I surprised when the train stopped at Widley, a tiny station a few miles along the line.","start":92.04,"end":98.71,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-014","sourceId":"b3-037-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Even a mighty express train can be held up by signals.","start":99.71,"end":103.33,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-015","sourceId":"b3-037-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"But when the train dawdled at station after station, I began to wonder.","start":104.23,"end":108.96,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-016-p01","sourceId":"b3-037-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"It suddenly dawned on me that this express was not roaring down the line at ninety miles an hour,","start":109.78,"end":116.34,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-016-p02","sourceId":"b3-037-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[19,25],"wordModel":"english-ctc-fallback","text":"but barely chugging along at thirty.","start":116.542,"end":119.4,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-017","sourceId":"b3-037-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"One hour and seventeen minutes passed and we had not even covered half the distance.","start":120.25,"end":125.42,"score":0.909,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-018","sourceId":"b3-037-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"I asked a passenger if this was the Westhaven Express, but he had not even heard of it.","start":126.33,"end":132.81,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-019","sourceId":"b3-037-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"I determined to lodge a complaint as soon as we arrived.","start":133.56,"end":136.6,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-020","sourceId":"b3-037-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Two hours later, I was talking angrily to the station master at Westhaven.","start":137.62,"end":142.52,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-021","sourceId":"b3-037-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"When he denied the train's existence, I borrowed his copy of the timetable.","start":143.17,"end":147.55,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-022","sourceId":"b3-037-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"There was a note of triumph in my voice when I told him that it was there in black and white.","start":148.46,"end":154.05,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-023","sourceId":"b3-037-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Glancing at it briefly, he told me to look again.","start":154.92,"end":158.4,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-024","sourceId":"b3-037-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"A tiny asterisk conducted me to a footnote at the bottom of the page.","start":159.16,"end":164.0,"score":0.915,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-037-025","sourceId":"b3-037-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"It said: 'This service has been suspended.'","start":164.26,"end":168.11,"score":0.991,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
