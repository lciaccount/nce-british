ext":"is","offset":49,"start":218.843,"end":218.922,"score":0.999},{"text":"certain:","offset":52,"start":218.982,"end":219.322,"score":0.994},{"text":"you","offset":61,"start":220.162,"end":220.262,"score":0.997},{"text":"will","offset":65,"start":220.282,"end":220.422,"score":0.936},{"text":"arrive","offset":70,"start":220.442,"end":220.902,"score":0.996},{"text":"at","offset":77,"start":220.922,"end":221.022,"score":0.995},{"text":"your","offset":80,"start":221.062,"end":221.202,"score":0.999},{"text":"destination","offset":85,"start":221.262,"end":221.922,"score":0.998},{"text":"fresh","offset":97,"start":222.343,"end":222.642,"score":0.95},{"text":"and","offset":103,"start":223.162,"end":223.282,"score":0.999},{"text":"uncrumpled.","offset":107,"start":223.343,"end":223.922,"score":0.988}],[{"text":"You","offset":0,"start":225.202,"end":225.302,"score":0.999},{"text":"will","offset":4,"start":225.322,"end":225.482,"score":0.998},{"text":"not","offset":9,"start":225.583,"end":225.802,"score":1.0},{"text":"have","offset":13,"start":225.882,"end":226.022,"score":0.999},{"text":"to","offset":18,"start":226.042,"end":226.102,"score":0.991},{"text":"spend","offset":21,"start":226.162,"end":226.462,"score":0.945},{"text":"the","offset":27,"start":226.482,"end":226.562,"score":0.991},{"text":"next","offset":31,"start":226.642,"end":226.882,"score":0.998},{"text":"few","offset":36,"start":226.903,"end":227.062,"score":0.938},{"text":"days","offset":40,"start":227.142,"end":227.442,"score":0.993},{"text":"recovering","offset":45,"start":227.822,"end":228.382,"score":0.985},{"text":"from","offset":56,"start":228.442,"end":228.602,"score":1.0},{"text":"a","offset":61,"start":228.662,"end":228.682,"score":0.997},{"text":"long","offset":63,"start":228.803,"end":229.122,"score":0.998},{"text":"and","offset":68,"start":229.442,"end":229.562,"score":0.974},{"text":"arduous","offset":72,"start":229.782,"end":230.202,"score":0.845},{"text":"journey.","offset":80,"start":230.262,"end":230.582,"score":0.974}]],"cues":[{"id":"b3-044-001","sourceId":"b3-044-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Which type of transport does the writer prefer, do you think?","start":12.02,"end":15.85,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-002","sourceId":"b3-044-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"People travelling long distances frequently have to decide whether they would prefer to go by land, sea, or air.","start":18.44,"end":26.7,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-003","sourceId":"b3-044-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Hardly anyone can positively enjoy sitting in a train for more than a few hours.","start":27.23,"end":31.99,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-004","sourceId":"b3-044-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Train compartments soon get cramped and stuffy.","start":32.88,"end":35.59,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-005","sourceId":"b3-044-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"It is almost impossible to take your mind off the journey.","start":36.21,"end":39.19,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-006","sourceId":"b3-044-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Reading is only a partial solution, for the monotonous rhythm of the wheels clicking on the rails soon lull you to sleep.","start":40.07,"end":48.25,"score":0.927,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-007","sourceId":"b3-044-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"During the day, sleep comes in snatches.","start":49.05,"end":51.8,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-008","sourceId":"b3-044-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"At night, when you really wish to go to sleep, you rarely manage to do so.","start":52.46,"end":57.21,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-009-p01","sourceId":"b3-044-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"If you are lucky enough to get a sleeper,","start":57.98,"end":59.99,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-009-p02","sourceId":"b3-044-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[9,31],"wordModel":"mms-fa","text":"you spend half the night staring at the small blue light in the ceiling, or fumbling to find your ticket for inspection.","start":60.4,"end":67.08,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-010","sourceId":"b3-044-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Inevitably you arrive at your destination almost exhausted.","start":67.97,"end":72.25,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-011","sourceId":"b3-044-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Long car journeys are even less pleasant, for it is quite impossible even to read.","start":73.05,"end":78.66,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-012-p01","sourceId":"b3-044-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"On motorways you can, at least, travel fairly safely at high speeds, but more often than not,","start":79.34,"end":85.31,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-012-p02","sourceId":"b3-044-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[17,35],"wordModel":"mms-fa","text":"the greater part of the journey is spent on roads with few service stations and too much traffic.","start":85.54,"end":91.52,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-013","sourceId":"b3-044-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"By comparison, ferry trips or cruises offer a great variety of civilized comforts.","start":92.51,"end":98.46,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-014-p01","sourceId":"b3-044-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"You can stretch your legs on the spacious decks, play games,","start":99.4,"end":103.33,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-014-p02","sourceId":"b3-044-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[11,26],"wordModel":"english-ctc-fallback","text":"meet interesting people and enjoy good food--always assuming, of course, that the sea is calm.","start":103.78,"end":110.35,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-015","sourceId":"b3-044-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"If it is not, and you are likely to get seasick, no form of transport could be worse.","start":111.34,"end":117.42,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-016","sourceId":"b3-044-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Even if you travel in ideal weather, sea journeys take a long time.","start":118.35,"end":123.08,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-017","sourceId":"b3-044-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Relatively few people are prepared to sacrifice holiday time for the pleasure of travelling by sea.","start":124.12,"end":130.01,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-018","sourceId":"b3-044-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Aeroplanes have the reputation of being dangerous and even hardened travellers are intimidated by them.","start":131.93,"end":138.54,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-019","sourceId":"b3-044-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"They also have the disadvantage of being an expensive form of transport.","start":139.44,"end":143.64,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-020","sourceId":"b3-044-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"But nothing can match them for speed and comfort.","start":144.8,"end":147.92,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-021","text":"Travelling at a height of 30, 000 feet, far above the clouds, and at over 500 miles an hour is an exhilarating experience.","start":148.692,"end":157.642,"score":0.949,"timingValid":true,"needsReview":true,"sourceId":"b3-044-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-044-022","sourceId":"b3-044-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"You do not have to devise ways of taking your mind off the journey, for an aeroplane gets you to your destination rapidly.","start":158.71,"end":165.83,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-023","sourceId":"b3-044-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"For a few hours, you settle back in a deep armchair to enjoy the flight.","start":167.02,"end":171.88,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-024","sourceId":"b3-044-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"The real escapist can watch a film and sip champagne on some services.","start":172.63,"end":177.41,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-025","sourceId":"b3-044-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"But even when such refinements are not available, there is plenty to keep you occupied.","start":177.99,"end":183.15,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-026","sourceId":"b3-044-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"An aeroplane offers you an unusual and breathtaking view of the world.","start":184.0,"end":188.46,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-027","sourceId":"b3-044-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"You soar effortlessly over high mountains and deep valleys.","start":189.17,"end":193.29,"score":0.872,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-044-028","sourceId":"b3-044-028","sourceIndex":27,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"You really see the shape of the land.","start":194.09,"end":196.03,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-029-p01","sourceId":"b3-044-029","sourceIndex":28,"part":1,"parts":3,"wordRange":[0,7],"wordModel":"mms-fa","text":"If the landscape is hidden from view,","start":196.74,"end":198.68,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-029-p02","sourceId":"b3-044-029","sourceIndex":28,"part":2,"parts":3,"wordRange":[7,24],"wordModel":"mms-fa","text":"you can enjoy the extraordinary sight of unbroken cloud plains that stretch out for miles before you,","start":198.883,"end":205.37,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-029-p03","sourceId":"b3-044-029","sourceIndex":28,"part":3,"parts":3,"wordRange":[24,33],"wordModel":"mms-fa","text":"while the sun shines brilliantly in a clear sky.","start":205.74,"end":208.9,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-030","sourceId":"b3-044-030","sourceIndex":29,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The journey is so smooth that there is nothing to prevent you from reading or sleeping.","start":209.9,"end":215.24,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-031","sourceId":"b3-044-031","sourceIndex":30,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"However you decide to spend your time, one thing is certain: you will arrive at your destination fresh and uncrumpled.","start":215.89,"end":224.01,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-044-032","sourceId":"b3-044-032","sourceIndex":31,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"You will not have to spend the next few days recovering from a long and arduous journey.","start":225.13,"end":230.71,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
