.922,"end":154.502,"score":0.993},{"text":"the","offset":55,"start":154.523,"end":154.602,"score":0.998},{"text":"police","offset":59,"start":154.642,"end":155.022,"score":0.998},{"text":"did","offset":66,"start":155.423,"end":155.562,"score":1.0},{"text":"he","offset":70,"start":155.602,"end":155.662,"score":1.0},{"text":"realize","offset":73,"start":155.822,"end":156.402,"score":0.995},{"text":"that","offset":81,"start":156.642,"end":156.762,"score":0.999},{"text":"they","offset":86,"start":156.803,"end":156.902,"score":0.999},{"text":"had","offset":91,"start":156.942,"end":157.062,"score":0.999},{"text":"all","offset":95,"start":157.183,"end":157.342,"score":0.967},{"text":"been","offset":99,"start":157.463,"end":157.662,"score":0.999},{"text":"the","offset":104,"start":157.702,"end":157.782,"score":0.998},{"text":"victims","offset":108,"start":157.882,"end":158.342,"score":1.0},{"text":"of","offset":116,"start":158.583,"end":158.662,"score":0.999},{"text":"a","offset":119,"start":158.702,"end":158.722,"score":0.994},{"text":"hoax.","offset":121,"start":158.843,"end":159.142,"score":0.568}]],"cues":[{"id":"b3-040-001","sourceId":"b3-040-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"How did the policeman discover that the whole thing was a joke?","start":11.88,"end":15.96,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-002","sourceId":"b3-040-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"It has never been explained why university students seem to enjoy practical jokes more than anyone else.","start":18.62,"end":25.55,"score":0.907,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-003","sourceId":"b3-040-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Students specialize in a particular type of practical joke: the hoax.","start":26.38,"end":31.44,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-004-p01","sourceId":"b3-040-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"Inviting the fire brigade to put out a nonexistent fire is a crude form of deception","start":31.99,"end":37.612,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-004-p02","sourceId":"b3-040-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[16,24],"wordModel":"english-ctc-fallback","text":"which no self-respecting student would ever indulde in.","start":37.7,"end":41.05,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-005","sourceId":"b3-040-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Students often create amusing situations which are funny to everyone except the victims.","start":41.87,"end":48.44,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-006-p01","sourceId":"b3-040-006","sourceIndex":5,"part":1,"parts":3,"wordRange":[0,14],"wordModel":"mms-fa","text":"When a student recently saw two workmen using a pneumatic drill outside his university,","start":49.61,"end":55.8,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-006-p02","sourceId":"b3-040-006","sourceIndex":5,"part":2,"parts":3,"wordRange":[14,22],"wordModel":"mms-fa","text":"he immediately telephoned the police and informed them","start":56.5,"end":59.56,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-006-p03","sourceId":"b3-040-006","sourceIndex":5,"part":3,"parts":3,"wordRange":[22,38],"wordModel":"mms-fa","text":"that two students dressed up as workmen were tearing up the road with a pneumatic drill.","start":59.72,"end":65.13,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-007-p01","sourceId":"b3-040-007","sourceIndex":6,"part":1,"parts":3,"wordRange":[0,7],"wordModel":"mms-fa","text":"As soon as he had hung up,","start":65.62,"end":67.03,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-007-p02","sourceId":"b3-040-007","sourceIndex":6,"part":2,"parts":3,"wordRange":[7,25],"wordModel":"mms-fa","text":"he went over to the workmen and told them that if a policeman ordered them to go away,","start":67.3,"end":72.49,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-007-p03","sourceId":"b3-040-007","sourceIndex":6,"part":3,"parts":3,"wordRange":[25,32],"wordModel":"mms-fa","text":"they were not to take him seriously.","start":72.75,"end":74.62,"score":0.998,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-008","sourceId":"b3-040-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"He added that a student had dressed up as a policeman and was playing all sorts of silly jokes on people.","start":75.41,"end":81.41,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-009","sourceId":"b3-040-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Both the police and the workmen were grateful to the student for this piece of advance information.","start":82.17,"end":87.59,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-010","sourceId":"b3-040-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The student hid in an archway nearby where he could watch and hear everything that went on.","start":88.5,"end":93.44,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-011","sourceId":"b3-040-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Sure enough, a policeman arrived on the scene and politely asked the workmen to go away.","start":94.04,"end":99.44,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-012","sourceId":"b3-040-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"When he received a very rude reply from one of the workmen, he threatened to remove them by force.","start":100.08,"end":105.6,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-013","sourceId":"b3-040-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The workmen told him to do as he pleased and the policeman telephoned for help.","start":106.27,"end":110.74,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-014","sourceId":"b3-040-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Shortly afterwards, 4 more policemen arrived and remonstrated with the workmen.","start":111.85,"end":116.93,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-015","sourceId":"b3-040-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"As the men refused to stop working, the police attempted to seize the pneumatic drill.","start":117.79,"end":122.42,"score":0.917,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-016","sourceId":"b3-040-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The workmen struggled fiercely and one of them lost his temper.","start":123.42,"end":126.96,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-017","sourceId":"b3-040-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"He threatened to call the police.","start":127.72,"end":129.5,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-018","sourceId":"b3-040-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"At this, the police pointed out ironically that this would hardly be necessary as the men were already under arrest.","start":130.31,"end":137.96,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-019","sourceId":"b3-040-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Pretending to speak seriously, one of the workmen asked if he might make a telephone call before being taken to the station.","start":138.68,"end":145.94,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-020","sourceId":"b3-040-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Permission was granted and a policeman accompanied him to a pay phone.","start":146.64,"end":150.88,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-021-p01","sourceId":"b3-040-021","sourceIndex":20,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Only when he saw that the man was actually telephoning the police did he realize","start":151.63,"end":156.522,"score":0.998,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-040-021-p02","sourceId":"b3-040-021","sourceIndex":20,"part":2,"parts":2,"wordRange":[15,25],"wordModel":"mms-fa","text":"that they had all been the victims of a hoax.","start":156.58,"end":159.462,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
