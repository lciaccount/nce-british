89.002,"score":0.993},{"text":"popular","offset":171,"start":189.183,"end":189.562,"score":0.997},{"text":"contrivance","offset":179,"start":189.602,"end":190.262,"score":0.946},{"text":"for","offset":191,"start":190.523,"end":190.662,"score":0.998},{"text":"producing","offset":195,"start":190.722,"end":191.222,"score":0.995},{"text":"not","offset":205,"start":191.523,"end":191.682,"score":0.998},{"text":"truth","offset":209,"start":191.803,"end":192.122,"score":0.95},{"text":"but","offset":215,"start":192.602,"end":192.762,"score":0.999},{"text":"illusion,","offset":219,"start":192.982,"end":193.482,"score":0.977},{"text":"untruth;","offset":229,"start":194.262,"end":194.742,"score":0.963},{"text":"and","offset":238,"start":195.423,"end":195.562,"score":0.983},{"text":"if","offset":242,"start":195.662,"end":195.742,"score":0.999},{"text":"a","offset":245,"start":195.803,"end":195.822,"score":0.997},{"text":"single","offset":247,"start":195.942,"end":196.282,"score":0.999},{"text":"curved","offset":254,"start":196.382,"end":196.702,"score":0.904},{"text":"glass","offset":261,"start":196.722,"end":197.122,"score":0.713},{"text":"would","offset":267,"start":197.523,"end":197.682,"score":0.994},{"text":"distort","offset":273,"start":197.722,"end":198.082,"score":0.842},{"text":"nature,","offset":281,"start":198.183,"end":198.542,"score":0.982},{"text":"how","offset":289,"start":199.202,"end":199.362,"score":0.999},{"text":"much","offset":293,"start":199.403,"end":199.582,"score":0.938},{"text":"more","offset":298,"start":199.662,"end":199.902,"score":0.995},{"text":"would","offset":303,"start":200.222,"end":200.382,"score":0.966},{"text":"a","offset":309,"start":200.403,"end":200.422,"score":0.861},{"text":"pair","offset":311,"start":200.523,"end":200.762,"score":0.722},{"text":"of","offset":316,"start":200.822,"end":200.882,"score":0.988},{"text":"them?","offset":319,"start":200.922,"end":201.062,"score":0.99}]],"cues":[{"id":"b4-032-001","sourceId":"b4-032-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What has modified our traditional view of Galileo in recent times?","start":12.1,"end":16.78,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-002-p01","sourceId":"b4-032-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"In his own lifetime Galileo was the centre of violent controversy, but the scientific dust has long since settled,","start":19.5,"end":27.83,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-002-p02","sourceId":"b4-032-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[19,37],"wordModel":"english-ctc-fallback","text":"and today we can see even his famous clash with the Inquisition in something like its proper perspective.","start":28.32,"end":35.25,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-003","sourceId":"b4-032-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"But, in contrast, it is only in modern times that Galileo has become a problem child for historians of science.","start":36.123,"end":44.52,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-004","sourceId":"b4-032-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The old view of Galileo was delightfully uncomplicated.","start":46.0,"end":50.14,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-005-p01","sourceId":"b4-032-005","sourceIndex":4,"part":1,"parts":3,"wordRange":[0,8],"wordModel":"mms-fa","text":"He was, above all, a man who experimented:","start":50.88,"end":54.04,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-005-p02","sourceId":"b4-032-005","sourceIndex":4,"part":2,"parts":3,"wordRange":[8,18],"wordModel":"mms-fa","text":"who despised the prejudice and book learning of the Aristotelians,","start":54.64,"end":59.45,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-005-p03","sourceId":"b4-032-005","sourceIndex":4,"part":3,"parts":3,"wordRange":[18,35],"wordModel":"mms-fa","text":"who put his questions to nature instead of to the ancients, and who drew his conclusions fearlessly.","start":59.97,"end":66.98,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-006-p01","sourceId":"b4-032-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"He had been the first to turn a telescope to the sky,","start":67.94,"end":70.75,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-006-p02","sourceId":"b4-032-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"mms-fa","text":"and he had seen there evidence enough to overthrow Aristotle and Ptolemy together.","start":71.023,"end":76.1,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-007-p01","sourceId":"b4-032-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"He was the man who climbed the Leaning Tower of Pisa and dropped various weights from the top,","start":76.94,"end":82.57,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-007-p02","sourceId":"b4-032-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[18,40],"wordModel":"mms-fa","text":"who rolled balls down inclined planes, and then generalized the results of his many experiments into the famous law of free fall.","start":83.3,"end":92.13,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-008-p01","sourceId":"b4-032-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"But a closer study of the evidence, supported by a deeper sense of the period,","start":93.52,"end":98.28,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-008-p02","sourceId":"b4-032-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[15,36],"wordModel":"mms-fa","text":"and particularly by a new consciousness of the philosophical undercurrents in the scientific revolution, has profoundly modified this view of Galileo.","start":98.74,"end":108.65,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-009","sourceId":"b4-032-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Today, although the old Galileo lives on in many popular writings, among historians of science a new and more sophisticated picture has emerged.","start":109.64,"end":119.08,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-010","sourceId":"b4-032-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"At the same time our sympathy for Galileo's opponents has grown somewhat.","start":120.36,"end":125.22,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-011-p01","sourceId":"b4-032-011","sourceIndex":10,"part":1,"parts":3,"wordRange":[0,6],"wordModel":"mms-fa","text":"His telescopic observations are justly immortal;","start":125.95,"end":129.45,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-011-p02","sourceId":"b4-032-011","sourceIndex":10,"part":2,"parts":3,"wordRange":[6,18],"wordModel":"mms-fa","text":"they aroused great interest at the time, they had important theoretical consequences,","start":130.08,"end":135.9,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-011-p03","sourceId":"b4-032-011","sourceIndex":10,"part":3,"parts":3,"wordRange":[18,32],"wordModel":"mms-fa","text":"and they provided a striking demonstration of the potentialities hidden in instruments and apparatus.","start":136.46,"end":143.28,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-012-p01","sourceId":"b4-032-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"But can we blame those who looked and failed to see what Galileo saw,","start":144.64,"end":149.06,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-012-p02","sourceId":"b4-032-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[14,38],"wordModel":"mms-fa","text":"if we remember that to use a telescope at the limit of its powers calls for long experience and intimate familiarity with one's instrument?","start":149.92,"end":158.94,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-013","sourceId":"b4-032-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,35],"wordModel":"mms-fa","text":"Was the philosopher who refused to look through Galileo's telescope more culpable than those who alleged that the spiral nebulae observed with Lord Rosse's great telescope in the 1840s were scratches left by the grinder?","start":159.79,"end":174.64,"score":0.929,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-032-014-p01","sourceId":"b4-032-014","sourceIndex":13,"part":1,"parts":3,"wordRange":[0,23],"wordModel":"mms-fa","text":"We can perhaps forgive those who said the moons of Jupiter were produced by Galileo's spyglass if we recall that in his day,","start":175.642,"end":184.92,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-014-p02","sourceId":"b4-032-014","sourceIndex":13,"part":2,"parts":3,"wordRange":[23,40],"wordModel":"mms-fa","text":"as for centuries before, curved glass was the popular contrivance for producing not truth but illusion, untruth;","start":185.28,"end":194.82,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-032-014-p03","sourceId":"b4-032-014","sourceIndex":13,"part":3,"parts":3,"wordRange":[40,57],"wordModel":"mms-fa","text":"and if a single curved glass would distort nature, how much more would a pair of them?","start":195.36,"end":201.22,"score":0.934,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
