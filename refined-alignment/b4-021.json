":"found","offset":56,"start":149.002,"end":149.222,"score":0.957},{"text":"it","offset":62,"start":149.262,"end":149.322,"score":0.993},{"text":"pleasant","offset":65,"start":149.403,"end":149.822,"score":0.754},{"text":"to","offset":74,"start":149.863,"end":149.942,"score":0.996},{"text":"escape","offset":77,"start":150.023,"end":150.382,"score":0.998},{"text":"to","offset":84,"start":150.422,"end":150.482,"score":0.996},{"text":"a","offset":87,"start":150.562,"end":150.582,"score":0.992},{"text":"time","offset":89,"start":150.683,"end":151.002,"score":0.998},{"text":"when","offset":94,"start":151.042,"end":151.182,"score":0.998},{"text":"life,","offset":99,"start":151.282,"end":151.582,"score":0.999},{"text":"though","offset":105,"start":152.102,"end":152.302,"score":0.956},{"text":"hard,","offset":112,"start":152.363,"end":152.682,"score":0.994},{"text":"was","offset":118,"start":153.023,"end":153.182,"score":0.998},{"text":"relatively","offset":122,"start":153.422,"end":153.902,"score":0.975},{"text":"simple.","offset":133,"start":153.963,"end":154.302,"score":0.989}],[{"text":"We","offset":0,"start":155.162,"end":155.242,"score":0.996},{"text":"still","offset":3,"start":155.322,"end":155.522,"score":0.971},{"text":"do;","offset":9,"start":155.583,"end":155.682,"score":0.901},{"text":"living","offset":13,"start":156.523,"end":156.842,"score":0.999},{"text":"in","offset":20,"start":156.923,"end":156.982,"score":0.996},{"text":"a","offset":23,"start":157.023,"end":157.042,"score":0.993},{"text":"world","offset":25,"start":157.123,"end":157.422,"score":0.967},{"text":"in","offset":31,"start":157.463,"end":157.542,"score":0.995},{"text":"which","offset":34,"start":157.602,"end":157.802,"score":0.985},{"text":"undeclared","offset":40,"start":158.183,"end":158.722,"score":0.968},{"text":"aggression,","offset":51,"start":158.743,"end":159.202,"score":0.955},{"text":"war,","offset":63,"start":159.882,"end":160.162,"score":0.787},{"text":"hypocrisy,","offset":68,"start":160.762,"end":161.382,"score":0.922},{"text":"chicanery,","offset":79,"start":161.922,"end":162.462,"score":0.861},{"text":"anarchy","offset":90,"start":163.343,"end":163.662,"score":0.758},{"text":"and","offset":98,"start":164.243,"end":164.402,"score":0.997},{"text":"impending","offset":102,"start":164.523,"end":165.102,"score":0.995},{"text":"immolation","offset":112,"start":165.222,"end":165.782,"score":0.817},{"text":"are","offset":123,"start":166.243,"end":166.362,"score":0.908},{"text":"part","offset":127,"start":166.422,"end":166.702,"score":0.999},{"text":"of","offset":132,"start":166.743,"end":166.802,"score":0.999},{"text":"our","offset":135,"start":166.863,"end":166.962,"score":0.997},{"text":"daily","offset":139,"start":167.042,"end":167.302,"score":0.898},{"text":"lives,","offset":145,"start":167.382,"end":167.842,"score":0.999},{"text":"we","offset":152,"start":168.482,"end":168.562,"score":0.998},{"text":"all","offset":155,"start":168.743,"end":168.882,"score":0.994},{"text":"want","offset":159,"start":168.963,"end":169.162,"score":0.991},{"text":"a","offset":164,"start":169.202,"end":169.222,"score":0.966},{"text":"code","offset":166,"start":169.363,"end":169.722,"score":0.784},{"text":"to","offset":171,"start":169.782,"end":169.842,"score":0.995},{"text":"live","offset":174,"start":169.963,"end":170.162,"score":0.997},{"text":"by.","offset":179,"start":170.222,"end":170.462,"score":0.999}]],"cues":[{"id":"b4-021-001","sourceId":"b4-021-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"How did William Hart's childhood prepare him for his acting role in Western films?","start":13.72,"end":19.4,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-002","sourceId":"b4-021-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"William S.Hart was, perhaps, the greatest of all Western stars, for unlike Gary Cooper and John Wayne he appeared in nothing but Westerns.","start":22.13,"end":32.88,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-003","sourceId":"b4-021-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"From 1914 to 1924 he was supreme and unchallenged.","start":33.86,"end":39.86,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-004-p01","sourceId":"b4-021-004","sourceIndex":3,"part":1,"parts":3,"wordRange":[0,23],"wordModel":"mms-fa","text":"It was Hart who created the basic formula of the Western film, and devised the protagonist he played in every film he made,","start":40.76,"end":49.76,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-004-p02","sourceId":"b4-021-004","sourceIndex":3,"part":2,"parts":3,"wordRange":[23,44],"wordModel":"mms-fa","text":"the good-bad man, the accidental, noble outlaw, or the honest, but framed cowboy, or the sheriff made suspect by vicious gossip;","start":50.38,"end":60.92,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-004-p03","sourceId":"b4-021-004","sourceIndex":3,"part":3,"parts":3,"wordRange":[44,56],"wordModel":"mms-fa","text":"in short, the individual in conflict with himself and his frontier environment.","start":61.66,"end":66.7,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-005","sourceId":"b4-021-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Unlike most of his contemporaries in Hollywood, Hart actually knew something of the old West.","start":68.16,"end":73.5,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-006-p01","sourceId":"b4-021-006","sourceIndex":5,"part":1,"parts":4,"wordRange":[0,13],"wordModel":"mms-fa","text":"He had lived in it as a child when it was already disappearing,","start":74.16,"end":78.26,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-006-p02","sourceId":"b4-021-006","sourceIndex":5,"part":2,"parts":4,"wordRange":[13,36],"wordModel":"mms-fa","text":"and his hero was firmly rooted in his memories and experiences, and in both the history and the mythology of the vanished frontier,","start":78.84,"end":88.13,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-006-p03","sourceId":"b4-021-006","sourceIndex":5,"part":3,"parts":4,"wordRange":[36,50],"wordModel":"mms-fa","text":"And although no period or place in American history has been more absurdly romanticized,","start":88.943,"end":94.74,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-006-p04","sourceId":"b4-021-006","sourceIndex":5,"part":4,"parts":4,"wordRange":[50,69],"wordModel":"mms-fa","text":"myth and reality did join hands in at least one arena, the conflict between the individual and encroaching civilization.","start":95.13,"end":104.98,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-007-p01","sourceId":"b4-021-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Men accustomed to struggling for survival against the elements and Indians were bewildered by politicians,","start":106.722,"end":113.9,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-007-p02","sourceId":"b4-021-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[15,26],"wordModel":"mms-fa","text":"bankers and businessmen, and unhorsed by fences, laws and alien taboos.","start":114.14,"end":120.55,"score":0.897,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-008-p01","sourceId":"b4-021-008","sourceIndex":7,"part":1,"parts":3,"wordRange":[0,12],"wordModel":"mms-fa","text":"Hart's good-bad man was always an outsider, always one of the disinherited,","start":121.76,"end":127.6,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-008-p02","sourceId":"b4-021-008","sourceIndex":7,"part":2,"parts":3,"wordRange":[12,29],"wordModel":"mms-fa","text":"and if he found it necessary to shoot a sheriff or rob a bank along the way,","start":128.55,"end":133.2,"score":0.895,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-008-p03","sourceId":"b4-021-008","sourceIndex":7,"part":3,"parts":3,"wordRange":[29,52],"wordModel":"mms-fa","text":"his early audiences found it easy to understand and forgive, especially when it was Hart who, in the end, overcame the attacking Indians.","start":133.462,"end":143.6,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-009-p01","sourceId":"b4-021-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"Audiences in the second decade of the twentieth century found it pleasant to escape to a time when life,","start":145.43,"end":151.67,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-009-p02","sourceId":"b4-021-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[19,24],"wordModel":"mms-fa","text":"though hard, was relatively simple.","start":152.0,"end":154.38,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-010-p01","sourceId":"b4-021-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"We still do; living in a world in which undeclared aggression, war, hypocrisy, chicanery,","start":155.09,"end":162.57,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-021-010-p02","sourceId":"b4-021-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[14,32],"wordModel":"mms-fa","text":"anarchy and impending immolation are part of our daily lives, we all want a code to live by.","start":163.28,"end":170.57,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
