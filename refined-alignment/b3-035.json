22,"score":0.999},{"text":"emerged,","offset":41,"start":152.363,"end":152.862,"score":0.989},{"text":"admitted","offset":50,"start":153.363,"end":153.742,"score":0.921},{"text":"at","offset":59,"start":153.782,"end":153.862,"score":0.999},{"text":"once","offset":62,"start":154.023,"end":154.322,"score":0.965},{"text":"that","offset":67,"start":154.762,"end":154.882,"score":0.984},{"text":"he","offset":72,"start":154.903,"end":154.962,"score":0.997},{"text":"had","offset":75,"start":155.042,"end":155.202,"score":1.0},{"text":"tried","offset":79,"start":155.262,"end":155.522,"score":0.995},{"text":"to","offset":85,"start":155.542,"end":155.602,"score":0.999},{"text":"break","offset":88,"start":155.702,"end":155.942,"score":0.956},{"text":"into","offset":94,"start":156.002,"end":156.142,"score":0.999},{"text":"the","offset":99,"start":156.183,"end":156.242,"score":0.997},{"text":"shop","offset":103,"start":156.322,"end":156.522,"score":0.975},{"text":"during","offset":108,"start":156.623,"end":156.862,"score":1.0},{"text":"the","offset":115,"start":156.882,"end":156.942,"score":0.997},{"text":"night","offset":119,"start":156.982,"end":157.242,"score":0.993},{"text":"but","offset":125,"start":158.042,"end":158.202,"score":1.0},{"text":"had","offset":129,"start":158.583,"end":158.722,"score":0.999},{"text":"got","offset":133,"start":158.782,"end":158.962,"score":0.995},{"text":"stuck","offset":137,"start":159.083,"end":159.442,"score":0.973},{"text":"in","offset":143,"start":159.722,"end":159.822,"score":0.976},{"text":"the","offset":146,"start":159.843,"end":159.942,"score":0.946},{"text":"chimney.","offset":150,"start":160.023,"end":160.342,"score":0.952}],[{"text":"He","offset":0,"start":161.083,"end":161.142,"score":0.996},{"text":"had","offset":3,"start":161.202,"end":161.342,"score":0.998},{"text":"been","offset":7,"start":161.403,"end":161.582,"score":0.998},{"text":"there","offset":12,"start":161.623,"end":161.802,"score":0.976},{"text":"for","offset":18,"start":161.822,"end":161.942,"score":0.998},{"text":"nearly","offset":22,"start":162.002,"end":162.222,"score":0.985},{"text":"ten","offset":29,"start":162.382,"end":162.662,"score":0.897},{"text":"hours.","offset":33,"start":162.822,"end":163.262,"score":0.986}],[{"text":"Justice","offset":0,"start":164.322,"end":164.822,"score":0.993},{"text":"had","offset":8,"start":164.882,"end":165.022,"score":0.997},{"text":"been","offset":12,"start":165.083,"end":165.242,"score":0.998},{"text":"done","offset":17,"start":165.343,"end":165.602,"score":0.927},{"text":"even","offset":22,"start":166.023,"end":166.242,"score":0.999},{"text":"before","offset":27,"start":166.303,"end":166.662,"score":0.999},{"text":"the","offset":34,"start":166.683,"end":166.762,"score":0.98},{"text":"man","offset":38,"start":166.822,"end":167.042,"score":0.999},{"text":"was","offset":42,"start":167.102,"end":167.242,"score":0.98},{"text":"handed","offset":46,"start":167.282,"end":167.582,"score":0.998},{"text":"over","offset":53,"start":167.683,"end":167.902,"score":0.998},{"text":"to","offset":58,"start":167.963,"end":168.042,"score":0.997},{"text":"the","offset":61,"start":168.083,"end":168.182,"score":0.919},{"text":"police.","offset":65,"start":168.202,"end":168.642,"score":0.985}]],"cues":[{"id":"b3-035-001","sourceId":"b3-035-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The word 'justice' is given two different meanings in the text.","start":11.95,"end":15.76,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-002","sourceId":"b3-035-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"What is the distinction between them?","start":16.89,"end":18.65,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-003","sourceId":"b3-035-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The word justice is usually associated with courts of law.","start":21.25,"end":25.34,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-004","sourceId":"b3-035-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"We might say that justice has been done when a man's innocence or guilt has been proved beyond doubt.","start":26.4,"end":32.92,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-005","sourceId":"b3-035-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Justice is part of the complex machinery of the law.","start":34.04,"end":37.81,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-006","sourceId":"b3-035-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Those who seek it, undertake an arduous journey and can never be sure that they will find it.","start":38.76,"end":44.8,"score":0.899,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-007","sourceId":"b3-035-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Judges, however wise or eminent, are human and can make mistakes.","start":45.77,"end":50.76,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-008","sourceId":"b3-035-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"There are rare instances when justice almost ceases to be an abstract concept.","start":52.08,"end":57.42,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-009","sourceId":"b3-035-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Reward or punishment are meted out quite independent of human interference.","start":58.23,"end":63.4,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-010","sourceId":"b3-035-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"At such times, justice acts like a living force.","start":64.62,"end":68.24,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-011-p01","sourceId":"b3-035-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"When we use a phrase like 'it serves him right', we are, in part,","start":69.12,"end":73.6,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-011-p02","sourceId":"b3-035-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[14,30],"wordModel":"mms-fa","text":"admitting that a certain set of circumstances has enabled justice to act of its own accord.","start":73.96,"end":80.1,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-012-p01","sourceId":"b3-035-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"When a thief was caught on the premises of a large jewellery store one morning,","start":81.2,"end":85.49,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-012-p02","sourceId":"b3-035-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[15,33],"wordModel":"mms-fa","text":"the shop assistants must have found it impossible to resist the temptation to say 'it serves him right'.","start":85.99,"end":92.13,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-013","sourceId":"b3-035-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"The shop was an old converted house with many large, disused fireplaces and tall, narrow chimneys.","start":93.06,"end":100.49,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-014","sourceId":"b3-035-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Towards midday, a girl heard a muffled cry coming from behind one of the walls.","start":101.68,"end":107.23,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-015","sourceId":"b3-035-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"As the cry was repeated several times, she ran to tell the manager who promptly rang up the fire brigade.","start":108.1,"end":114.66,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-016-p01","sourceId":"b3-035-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"The cry had certainly come from one of the chimneys,","start":115.7,"end":118.62,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-016-p02","sourceId":"b3-035-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"but as there were so many of them, the firemen could not be certain which one it was.","start":119.18,"end":124.27,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-017","sourceId":"b3-035-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"They located the right chimney by tapping at the walls and listening for the man's cries.","start":125.38,"end":131.13,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-018","sourceId":"b3-035-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"After chipping through a wall which was eighteen inches thick, they found that a man had been trapped in the chimney.","start":131.75,"end":139.07,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-019-p01","sourceId":"b3-035-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"As it was extremely narrow, the man was unable to move,","start":139.73,"end":143.34,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-019-p02","sourceId":"b3-035-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[11,29],"wordModel":"english-ctc-fallback","text":"but the fire fighters were eventually able to free him by cutting a huge hole in the wall.","start":143.77,"end":149.5,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-020-p01","sourceId":"b3-035-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"The sorry-looking, blackened figure that emerged,","start":150.42,"end":153.03,"score":0.897,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-020-p02","sourceId":"b3-035-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[6,28],"wordModel":"mms-fa","text":"admitted at once that he had tried to break into the shop during the night but had got stuck in the chimney.","start":153.22,"end":160.48,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-021","sourceId":"b3-035-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He had been there for nearly ten hours.","start":161.02,"end":163.34,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-035-022","sourceId":"b3-035-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Justice had been done even before the man was handed over to the police.","start":164.2,"end":168.74,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
