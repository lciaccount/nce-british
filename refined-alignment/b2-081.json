d":99.123,"score":1.0},{"text":"came","offset":11,"start":99.263,"end":99.483,"score":1.0},{"text":"near","offset":16,"start":99.562,"end":99.783,"score":0.989},{"text":"the","offset":21,"start":100.562,"end":100.663,"score":0.998},{"text":"prisoner","offset":25,"start":100.782,"end":101.203,"score":0.92},{"text":"knocked","offset":34,"start":101.403,"end":101.743,"score":0.949},{"text":"him","offset":42,"start":101.782,"end":101.883,"score":1.0},{"text":"to","offset":46,"start":101.983,"end":102.043,"score":1.0},{"text":"the","offset":49,"start":102.102,"end":102.183,"score":0.999},{"text":"ground","offset":53,"start":102.222,"end":102.563,"score":0.996},{"text":"with","offset":60,"start":102.623,"end":102.723,"score":1.0},{"text":"a","offset":65,"start":102.782,"end":102.823,"score":0.845},{"text":"sharp","offset":67,"start":102.922,"end":103.203,"score":0.991},{"text":"blow.","offset":73,"start":103.403,"end":103.683,"score":0.901}],[{"text":"Then,","offset":0,"start":104.683,"end":104.923,"score":0.985},{"text":"jumping","offset":6,"start":105.162,"end":105.583,"score":1.0},{"text":"into","offset":14,"start":105.623,"end":105.823,"score":0.999},{"text":"the","offset":19,"start":105.862,"end":105.943,"score":0.99},{"text":"car,","offset":23,"start":105.983,"end":106.303,"score":0.975},{"text":"he","offset":28,"start":106.582,"end":106.663,"score":0.952},{"text":"drove","offset":31,"start":106.843,"end":107.183,"score":0.998},{"text":"off","offset":37,"start":107.222,"end":107.423,"score":0.999},{"text":"as","offset":41,"start":107.522,"end":107.603,"score":0.999},{"text":"quickly","offset":44,"start":107.782,"end":108.183,"score":0.979},{"text":"as","offset":52,"start":108.242,"end":108.343,"score":0.999},{"text":"he","offset":55,"start":108.382,"end":108.443,"score":0.999},{"text":"could.","offset":58,"start":108.522,"end":108.843,"score":0.903}]],"cues":[{"id":"b2-081-001","sourceId":"b2-081-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Why did the prisoner attack the driver?","start":12.65,"end":15.69,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-002","sourceId":"b2-081-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"When he had killed the guard, the prisoner of war quickly dragged him into the bushes.","start":18.44,"end":24.92,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-003","sourceId":"b2-081-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Working rapidly in the darkness, he soon changed into the dead man's clothes.","start":26.44,"end":32.49,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-004-p01","sourceId":"b2-081-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Now, dressed in a blue uniform and with a rifle over his shoulder,","start":33.82,"end":38.44,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-004-p02","sourceId":"b2-081-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[13,25],"wordModel":"mms-fa","text":"the prisoner marched boldly up and down in front of the camp.","start":39.16,"end":43.64,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-005","sourceId":"b2-081-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He could hear shouting in the camp itself.","start":45.26,"end":47.82,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-006","sourceId":"b2-081-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Lights were blazing and men were running here and there: they had just discovered that a prisoner had escaped.","start":48.6,"end":56.17,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-007","sourceId":"b2-081-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"At that moment, a large black car with four officers inside it, stopped at the camp gates.","start":58.07,"end":66.23,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-008","sourceId":"b2-081-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The officers got out and the prisoner stood to attention and saluted as they passed.","start":68.22,"end":74.54,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-009","sourceId":"b2-081-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"When they had gone the driver of the car came towards him.","start":76.06,"end":80.4,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-010","sourceId":"b2-081-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The man obviously wanted to talk.","start":82.08,"end":84.8,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-011","sourceId":"b2-081-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He was rather elderly with grey hair and clear blue eyes.","start":85.94,"end":90.42,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-012","sourceId":"b2-081-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The prisoner felt sorry for him, but there was nothing else he could do.","start":92.12,"end":96.94,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-013","sourceId":"b2-081-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"As the man came near the prisoner knocked him to the ground with a sharp blow.","start":98.443,"end":103.87,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-081-014","sourceId":"b2-081-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Then, jumping into the car, he drove off as quickly as he could.","start":104.443,"end":108.99,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
