et":58,"start":123.203,"end":123.263,"score":0.993},{"text":"a","offset":61,"start":123.322,"end":123.343,"score":0.988},{"text":"controlled","offset":63,"start":123.422,"end":123.923,"score":0.742},{"text":"manner.","offset":74,"start":123.983,"end":124.243,"score":1.0}]],"cues":[{"id":"b4-013-001","sourceId":"b4-013-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"What do oilmen want to achieve as soon as they strike oil?","start":11.85,"end":15.87,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-002","text":"The deepest holes of all are made for oil, and they go down to as much as 25, 000 feet.","start":18.553,"end":25.302,"score":0.932,"timingValid":true,"needsReview":true,"sourceId":"b4-013-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b4-013-003","sourceId":"b4-013-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"But we do not need to send man down to get the oil out, as we must with other mineral deposits.","start":26.6,"end":32.94,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-004","sourceId":"b4-013-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The holes are only borings, less than a foot in diameter.","start":34.28,"end":38.36,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-005-p01","sourceId":"b4-013-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"My particular experience is largely in oil,","start":39.34,"end":42.51,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-005-p02","sourceId":"b4-013-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[7,24],"wordModel":"mms-fa","text":"and the search for oil has done more to improve deep drilling than any other mining activity.","start":42.95,"end":48.48,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-006","sourceId":"b4-013-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"When it has been decided where we are going to drill, we put up at the surface an oil derrick.","start":49.91,"end":56.48,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-007-p01","sourceId":"b4-013-007","sourceIndex":6,"part":1,"parts":3,"wordRange":[0,14],"wordModel":"mms-fa","text":"It has to be tall because it is like a giant block and tackle","start":57.7,"end":61.64,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-007-p02","sourceId":"b4-013-007","sourceIndex":6,"part":2,"parts":3,"wordRange":[14,33],"wordModel":"mms-fa","text":"and we have to lower into the ground and haul out of the ground great lengths of drill pipe","start":62.083,"end":67.72,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-007-p03","sourceId":"b4-013-007","sourceIndex":6,"part":3,"parts":3,"wordRange":[33,52],"wordModel":"mms-fa","text":"which are rotated by an engine at the top and are fitted with a cutting bit at the bottom.","start":67.843,"end":73.39,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-008","sourceId":"b4-013-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"The geologist needs to know what rocks the drill has reached, so every so often a sample is obtained with a coring bit.","start":74.91,"end":83.73,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-009","sourceId":"b4-013-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"It cuts a clean cylinder of rock, from which can be seen the strata the drill has been cutting through.","start":84.9,"end":91.27,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-010-p01","sourceId":"b4-013-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"Once we get down to the oil,","start":92.482,"end":94.34,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-010-p02","sourceId":"b4-013-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[7,24],"wordModel":"english-ctc-fallback","text":"it usually flows to the surface because great pressure either from gas or water, is pushing it.","start":94.65,"end":101.39,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-011","sourceId":"b4-013-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"This pressure must be under control, and we control it by means of the mud which we circulate down the drill pipe.","start":102.55,"end":110.18,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-012","sourceId":"b4-013-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"We endeavour to avoid the old, romantic idea of a gusher, which wastes oil and gas.","start":111.422,"end":118.44,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-013-013","sourceId":"b4-013-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"We want it to stay down the hole until we can lead it off in a controlled manner.","start":119.16,"end":124.38,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
