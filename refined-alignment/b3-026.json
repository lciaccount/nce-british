nd":180.182,"score":0.037},{"text":"000.","offset":121,"start":180.243,"end":200.022,"score":0.054}]],"cues":[{"id":"b3-026-001","sourceId":"b3-026-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"Who won the prize for the biggest biscuit?","start":13.5,"end":16.23,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-002","sourceId":"b3-026-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"No one can avoid being influenced by advertisements.","start":18.84,"end":22.14,"score":0.773,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-003-p01","sourceId":"b3-026-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Much as we may pride ourselves on our good taste,","start":23.11,"end":26.08,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-003-p02","sourceId":"b3-026-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[10,29],"wordModel":"mms-fa","text":"we are no longer free to choose the things we want, for advertising exerts a subtle influence on us.","start":26.56,"end":33.34,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-004-p01","sourceId":"b3-026-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"In their efforts to persuade us to buy this","start":34.68,"end":37.233,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-004-p02","sourceId":"b3-026-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[9,28],"wordModel":"mms-fa","text":"or that product, advertisers have made a close study of human nature and have classified all our little weaknesses.","start":37.233,"end":45.49,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-005","sourceId":"b3-026-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Advertisers discovered years ago that all of us love to get something for nothing.","start":47.1,"end":51.9,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-006","sourceId":"b3-026-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"An advertisement which begins with the magic word FREE can rarely go wrong.","start":53.06,"end":58.46,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-007","sourceId":"b3-026-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"These days, advertisers not only offer free samples, but free cars, free houses, and free trips round the world as well.","start":59.59,"end":70.49,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-008","sourceId":"b3-026-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"They devise hundreds of competitions which will enable us to win huge sums of money.","start":71.37,"end":76.64,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-009","sourceId":"b3-026-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Radio and television have made it possible for advertisers to capture the attention of millions of people in this way.","start":77.93,"end":85.16,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-010","sourceId":"b3-026-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"During a radio programme, a company of biscuit manufacturers once asked listeners to bake biscuits and send them to their factory.","start":86.77,"end":95.85,"score":0.892,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-011","sourceId":"b3-026-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"They offered to pay $10 a pound for the biggest biscuit baked by a listener.","start":97.06,"end":102.66,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-012","sourceId":"b3-026-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The response to this competition was tremendous.","start":103.6,"end":106.21,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-013","sourceId":"b3-026-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Before long, biscuits of all shapes and sizes began arriving at the factory.","start":107.06,"end":112.42,"score":0.887,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-014","sourceId":"b3-026-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"One lady brought biscuit on a wheelbarrow.","start":113.51,"end":117.02,"score":0.875,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-015","sourceId":"b3-026-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"It weighed nearly 500 pounds.","start":117.65,"end":119.71,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-016","sourceId":"b3-026-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A little later, a man came along with a biscuit which occupied the whole boot of his car.","start":120.86,"end":126.62,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-017","sourceId":"b3-026-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"All the biscuits that were sent were carefully weighed.","start":127.8,"end":131.1,"score":0.832,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-018","sourceId":"b3-026-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"The largest was 713 pounds.","start":131.9,"end":135.24,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-019","sourceId":"b3-026-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"It seemed certain that this would win the prize.","start":136.36,"end":139.22,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-020","text":"But just before the competition closed, a lorry arrived at the factory with a truly colossal biscuit which weighed 2, 400 pounds.","start":140.032,"end":150.302,"score":0.956,"timingValid":true,"needsReview":true,"sourceId":"b3-026-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-026-021","text":"It had been baked by a college student who had used over 1, 000 pounds of flour, 800 pounds of sugar, 200 pounds of fat, and 400 pounds of various other ingredients.","start":151.552,"end":164.662,"score":0.96,"timingValid":true,"needsReview":true,"sourceId":"b3-026-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,32],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-026-022","sourceId":"b3-026-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"It was so heavy that a crane had to be used to remove it from the lorry.","start":165.68,"end":170.33,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-026-023","text":"The manufacturers had to pay more money than they had anticipated, for they bought the biscuit from the student for $24, 000.","start":171.172,"end":180.97,"score":0.954,"timingValid":true,"needsReview":true,"sourceId":"b3-026-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment","waveform-corrected-needs-listening"]}]}
