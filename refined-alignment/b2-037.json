t":88.502,"end":88.923,"score":0.999},{"text":"to","offset":48,"start":89.002,"end":89.083,"score":0.999},{"text":"the","offset":51,"start":89.123,"end":89.203,"score":0.999},{"text":"Olympic","offset":55,"start":89.242,"end":89.643,"score":0.995},{"text":"Games","offset":63,"start":89.703,"end":90.123,"score":1.0},{"text":"because","offset":69,"start":91.162,"end":91.463,"score":0.985},{"text":"they","offset":77,"start":91.463,"end":91.583,"score":0.997},{"text":"have","offset":82,"start":91.602,"end":91.763,"score":0.996},{"text":"never","offset":87,"start":91.862,"end":92.143,"score":0.996},{"text":"been","offset":93,"start":92.183,"end":92.383,"score":1.0},{"text":"held","offset":98,"start":92.483,"end":92.803,"score":1.0},{"text":"before","offset":103,"start":92.882,"end":93.343,"score":0.997},{"text":"in","offset":110,"start":93.642,"end":93.723,"score":1.0},{"text":"this","offset":113,"start":93.782,"end":93.983,"score":0.973},{"text":"country.","offset":118,"start":94.062,"end":94.503,"score":0.986}]],"cues":[{"id":"b2-037-001","sourceId":"b2-037-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"When was the last time this country hosted the Olympic Games?","start":13.84,"end":18.56,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-002","sourceId":"b2-037-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The Olympic Games will be held in our country in four years' time.","start":21.28,"end":25.8,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-003-p01","sourceId":"b2-037-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"As a great many people will be visiting the country,","start":27.3,"end":30.32,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-003-p02","sourceId":"b2-037-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[10,26],"wordModel":"mms-fa","text":"the government will be building new hotels, an immense stadium, and a new Olympic-standard swimming pool.","start":30.89,"end":39.47,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-004","sourceId":"b2-037-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"They will also be building new roads and a special railway line.","start":40.66,"end":45.41,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-005","sourceId":"b2-037-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The Games will be held just outside the capital and the whole area will be called 'Olympic City'.","start":47.16,"end":56.0,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-006","sourceId":"b2-037-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Workers will have completed the new roads by the end of this year.","start":57.97,"end":62.81,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-007","sourceId":"b2-037-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"By the end of next year, they will have finished work on the new stadium.","start":64.64,"end":70.13,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-008","sourceId":"b2-037-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The fantastic modern buildings have been designed by Kurt Gunter.","start":72.16,"end":78.15,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-009","sourceId":"b2-037-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Everybody will be watching anxiously as the new buildings go up.","start":79.52,"end":83.95,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-037-010","sourceId":"b2-037-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"We are all very excited and are looking forward to the Olympic Games because they have never been held before in this country.","start":85.2,"end":94.65,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
