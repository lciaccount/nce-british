e","offset":22,"start":76.522,"end":76.583,"score":0.999},{"text":"mad","offset":25,"start":76.683,"end":77.103,"score":1.0},{"text":"and","offset":29,"start":77.942,"end":78.023,"score":0.992},{"text":"they","offset":33,"start":78.022,"end":78.123,"score":0.912},{"text":"are","offset":38,"start":78.142,"end":78.223,"score":0.67},{"text":"probably","offset":42,"start":78.243,"end":78.643,"score":0.999},{"text":"right.","offset":51,"start":78.722,"end":79.043,"score":0.965}]],"cues":[{"id":"b2-021-001","sourceId":"b2-021-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Why do people think the writer is mad?","start":14.34,"end":17.73,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-002","sourceId":"b2-021-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Aeroplanes are slowly driving me mad.","start":20.37,"end":24.31,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-003","sourceId":"b2-021-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"I live near an airport and passing planes can be heard night and day.","start":25.82,"end":32.26,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-004","sourceId":"b2-021-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The airport was built years ago, but for some reason it could not be used then.","start":34.0,"end":42.23,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-005","sourceId":"b2-021-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Last year, however, it came into use.","start":43.78,"end":47.47,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-006","sourceId":"b2-021-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Over a hundred people must have been driven away from their homes by the noise.","start":48.72,"end":53.96,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-007","sourceId":"b2-021-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"I am one of the few people left.","start":55.363,"end":57.81,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-008","sourceId":"b2-021-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Sometimes I think this house will be knocked down by a passing plane.","start":59.25,"end":64.61,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-009","sourceId":"b2-021-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"I have been offered a large sum of money to go away, but I am determined to stay here.","start":66.27,"end":73.88,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-021-010","sourceId":"b2-021-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Everybody says I must be mad and they are probably right.","start":75.18,"end":79.18,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
