t":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Had the writer's money been stolen?","start":15.0,"end":17.88,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-002","sourceId":"b2-024-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"I entered the hotel manager's office and sat down.","start":20.65,"end":25.28,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-003","sourceId":"b2-024-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"I had just lost ￡50 and I felt very upset.","start":27.39,"end":33.59,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-004","sourceId":"b2-024-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"'I left the money in my room,' I said, 'and it's not there now.  '","start":35.75,"end":42.13,"score":0.974,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-024-005","sourceId":"b2-024-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"The manager was sympathetic, but he could do nothing.","start":43.82,"end":48.49,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-006","sourceId":"b2-024-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'Everyone's losing money these days,' he said.","start":50.33,"end":53.66,"score":0.99,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-024-007","sourceId":"b2-024-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"He started to complain about this wicked world but was interrupted by a knock at the door.","start":54.92,"end":62.63,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-008","sourceId":"b2-024-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"A girl came in and put an envelope on his desk.","start":64.1,"end":67.99,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-009","sourceId":"b2-024-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"It contained ￡50.","start":69.39,"end":71.22,"score":0.868,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-024-010","sourceId":"b2-024-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"'I found this outside this gentleman's room,' she said.","start":74.07,"end":78.5,"score":0.98,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-024-011","sourceId":"b2-024-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"'Well,' I said to the manager,'there is still some honesty in this world!'","start":80.09,"end":86.26,"score":0.985,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
