Reasons":[]},{"id":"b2-091-002","sourceId":"b2-091-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"A pilot noticed a balloon which seemed to be making for a Royal Air Force station nearby.","start":18.88,"end":24.91,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-003","sourceId":"b2-091-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"He informed the station at once, but no one there was able to explain the mystery.","start":26.66,"end":32.54,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-004","sourceId":"b2-091-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"The officer in the control tower was very angry when he heard the news, because balloons can be a great danger to aircraft.","start":33.9,"end":42.7,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-005","sourceId":"b2-091-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"He said that someone might be spying on the station and the pilot was ordered to keep track of the strange object.","start":44.02,"end":51.5,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-006","sourceId":"b2-091-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The pilot managed to circle the balloon for some time.","start":53.34,"end":57.142,"score":0.919,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-007","sourceId":"b2-091-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"He could make out three men in a basket under it and one of them was holding a pair of binoculars.","start":58.19,"end":66.3,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-008","sourceId":"b2-091-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"When the balloon was over the station, the pilot saw one of the men taking photographs.","start":68.02,"end":74.78,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-009","sourceId":"b2-091-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Soon afterwards, the balloon began to descend and it landed near an airfield.","start":76.37,"end":82.82,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-010-p01","sourceId":"b2-091-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"The police were called in, but they could not arrest anyone,","start":84.69,"end":89.31,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-010-p02","sourceId":"b2-091-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[11,26],"wordModel":"mms-fa","text":"for the basket contained two Members of Parliament and the Commanding Officer of the station!","start":90.1,"end":96.31,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-091-011","sourceId":"b2-091-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"As the Commanding Officer explained later, one half of the station did not know what the other half was doing!","start":98.14,"end":105.93,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
