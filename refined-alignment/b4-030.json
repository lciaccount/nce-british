rt":203.583,"end":203.762,"score":0.942},{"text":"water","offset":247,"start":203.882,"end":204.182,"score":0.944},{"text":"after","offset":253,"start":204.762,"end":204.962,"score":1.0},{"text":"being","offset":259,"start":205.002,"end":205.202,"score":0.984},{"text":"eroded","offset":265,"start":205.322,"end":205.762,"score":0.921},{"text":"from","offset":272,"start":206.083,"end":206.222,"score":0.941},{"text":"the","offset":277,"start":206.282,"end":206.362,"score":0.993},{"text":"continental","offset":281,"start":206.502,"end":207.122,"score":0.984},{"text":"masses.","offset":293,"start":207.202,"end":207.542,"score":0.975}]],"cues":[{"id":"b4-030-001","sourceId":"b4-030-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"How did people probably imagine the sea-floor before it was investigated?","start":11.803,"end":17.44,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-002-p01","sourceId":"b4-030-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"Our knowledge of the oceans a hundred years ago was confined to the two-dimensional shape of the sea surface","start":20.14,"end":27.38,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-002-p02","sourceId":"b4-030-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[19,38],"wordModel":"mms-fa","text":"and the hazards of navigation presented by the irregularities in depth of the shallow water close to the land.","start":27.9,"end":35.18,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-003-p01","sourceId":"b4-030-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"The open sea was deep and mysterious,","start":36.51,"end":39.52,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-003-p02","sourceId":"b4-030-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[7,30],"wordModel":"mms-fa","text":"and anyone who gave more than a passing thought to the bottom confines of the oceans probably assumed that the sea-bed was flat.","start":40.14,"end":48.7,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-004","sourceId":"b4-030-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"Sir James Clark Ross had obtained a sounding of over 2, 400 fathoms in 1839, but it was not until 1869, when H.M.S.","start":49.7,"end":61.513,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-005-p01","sourceId":"b4-030-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Porcupine was put at the disposal of the Royal Society for several cruises","start":61.52,"end":66.9,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-005-p02","sourceId":"b4-030-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[13,34],"wordModel":"mms-fa","text":"that a series of deep soundings was obtained in the Atlantic and the first samples were collected by dredging the bottom.","start":67.77,"end":76.01,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-006","sourceId":"b4-030-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Shortly after this the famous H.M.S.","start":77.08,"end":80.083,"score":0.908,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-007","sourceId":"b4-030-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Challenger expedition established the study of the sea-floor as a subject worthy of the most qualified physicists and geologists.","start":80.083,"end":88.7,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-008-p01","sourceId":"b4-030-008","sourceIndex":7,"part":1,"parts":3,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"A burst of activity associated with the laying of submarine cables soon confirmed the Challenger's observation","start":89.73,"end":96.9,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-008-p02","sourceId":"b4-030-008","sourceIndex":7,"part":2,"parts":3,"wordRange":[16,28],"wordModel":"english-ctc-fallback","text":"that many parts of the ocean were two to three miles deep,","start":97.32,"end":101.23,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-008-p03","sourceId":"b4-030-008","sourceIndex":7,"part":3,"parts":3,"wordRange":[28,37],"wordModel":"english-ctc-fallback","text":"and the existence of underwater features of considerable magnitude.","start":101.84,"end":106.11,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-009-p01","sourceId":"b4-030-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Today, enough soundings are available to enable a relief map of the Atlantic to be drawn","start":107.11,"end":113.18,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-009-p02","sourceId":"b4-030-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[16,29],"wordModel":"mms-fa","text":"and we know something of the great variety of the sea bed's topography.","start":113.523,"end":118.0,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-010-p01","sourceId":"b4-030-010","sourceIndex":9,"part":1,"parts":3,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Since the sea covers the greater part of the earth's surface,","start":119.31,"end":122.28,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-010-p02","sourceId":"b4-030-010","sourceIndex":9,"part":2,"parts":3,"wordRange":[11,30],"wordModel":"english-ctc-fallback","text":"it is quite reasonable to regard the sea floor as the basic form of the crust of the earth,","start":123.02,"end":128.57,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-010-p03","sourceId":"b4-030-010","sourceIndex":9,"part":3,"parts":3,"wordRange":[30,46],"wordModel":"english-ctc-fallback","text":"with superimposed upon it the continents, together with the islands and other features of the oceans.","start":129.14,"end":135.81,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-011","sourceId":"b4-030-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The continents form rugged tablelands which stand nearly three miles above the floor of the open ocean.","start":136.84,"end":144.32,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-012-p01","sourceId":"b4-030-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"From the shore line, out to a distance which may be anywhere from a few miles to a few hundred miles,","start":145.61,"end":152.09,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-012-p02","sourceId":"b4-030-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[21,34],"wordModel":"mms-fa","text":"runs the gentle slope of the continental shelf, geologically part of the continents.","start":152.402,"end":158.97,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-013","sourceId":"b4-030-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The real dividing line between continents and oceans occurs at the foot of a steeper slope.","start":159.86,"end":166.16,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-014","sourceId":"b4-030-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,32],"wordModel":"english-ctc-fallback","text":"This continental slope usually starts at a place somewhere near the 100-fathom mark and in the course of a few hundred miles reaches the true ocean floor at 2, 500-3, 500 fathoms.","start":167.302,"end":183.15,"score":0.976,"timingValid":true,"needsReview":true,"reviewReasons":["stretched-word"]},{"id":"b4-030-015-p01","sourceId":"b4-030-015","sourceIndex":14,"part":1,"parts":3,"wordRange":[0,17],"wordModel":"english-ctc-fallback","text":"The slope averages about 1 in 30, but contains steep, probably vertical, cliffs, and gentle sediment-covered terraces,","start":184.3,"end":194.46,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-015-p02","sourceId":"b4-030-015","sourceIndex":14,"part":2,"parts":3,"wordRange":[17,27],"wordModel":"english-ctc-fallback","text":"and near its lower reaches there is a long tailing-off","start":195.42,"end":198.78,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-030-015-p03","sourceId":"b4-030-015","sourceIndex":14,"part":3,"parts":3,"wordRange":[27,47],"wordModel":"english-ctc-fallback","text":"which is almost certainly the result of material transported out to deep water after being eroded from the continental masses.","start":198.94,"end":207.67,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
