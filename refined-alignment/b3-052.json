42,"score":0.999},{"text":"little","offset":38,"start":223.222,"end":223.442,"score":0.994},{"text":"game","offset":45,"start":223.523,"end":223.802,"score":1.0},{"text":"he","offset":50,"start":223.822,"end":223.902,"score":0.99},{"text":"had","offset":53,"start":223.982,"end":224.102,"score":0.998},{"text":"invented","offset":57,"start":224.123,"end":224.562,"score":0.999},{"text":"might","offset":66,"start":224.922,"end":225.122,"score":0.977},{"text":"prove","offset":72,"start":225.183,"end":225.462,"score":0.997},{"text":"to","offset":78,"start":225.502,"end":225.562,"score":0.998},{"text":"be","offset":81,"start":225.602,"end":225.662,"score":0.998},{"text":"expensive.","offset":84,"start":225.743,"end":226.342,"score":0.998}],[{"text":"The","offset":0,"start":227.142,"end":227.222,"score":0.917},{"text":"curious","offset":4,"start":227.282,"end":227.742,"score":0.999},{"text":"bottle","offset":12,"start":227.803,"end":228.102,"score":0.997},{"text":"which","offset":19,"start":228.442,"end":228.602,"score":0.981},{"text":"now","offset":25,"start":228.642,"end":228.802,"score":0.977},{"text":"adorns","offset":29,"start":228.942,"end":229.442,"score":0.991},{"text":"the","offset":36,"start":229.502,"end":229.582,"score":0.993},{"text":"bookcase","offset":40,"start":229.662,"end":230.162,"score":0.994},{"text":"in","offset":49,"start":230.183,"end":230.262,"score":0.998},{"text":"his","offset":52,"start":230.303,"end":230.422,"score":0.999},{"text":"study","offset":56,"start":230.463,"end":230.722,"score":0.958},{"text":"was","offset":62,"start":231.222,"end":231.362,"score":0.999},{"text":"his","offset":66,"start":231.403,"end":231.542,"score":0.991},{"text":"first","offset":70,"start":231.642,"end":232.062,"score":0.989},{"text":"and","offset":76,"start":232.442,"end":232.602,"score":0.941},{"text":"last","offset":80,"start":232.702,"end":233.062,"score":0.997},{"text":"purchase","offset":85,"start":233.202,"end":233.682,"score":0.8},{"text":"of","offset":94,"start":234.123,"end":234.242,"score":0.993},{"text":"rare","offset":97,"start":234.602,"end":234.882,"score":0.458},{"text":"cosmetics.","offset":102,"start":234.982,"end":235.642,"score":0.988}]],"cues":[{"id":"b3-052-001","sourceId":"b3-052-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Why did Harry decide to give up his little game?","start":11.89,"end":15.53,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-002","sourceId":"b3-052-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"My cousin, Harry, keeps a large curiously-shaped bottle on permanent display in his study.","start":18.11,"end":24.38,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-003-p01","sourceId":"b3-052-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Despite the fact that the bottle is tinted a delicate shade of green,","start":25.3,"end":29.81,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-003-p02","sourceId":"b3-052-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[13,31],"wordModel":"mms-fa","text":"an observant visitor would soon notice that it is filled with what looks like a thick, greyish substance.","start":30.15,"end":38.0,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-004","sourceId":"b3-052-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"If you were to ask Harry what was in the bottle, he would tell you that it contained perfumed mud.","start":38.98,"end":45.85,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-005","sourceId":"b3-052-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"If you expressed doubt or surprise, he would immediately invite you to smell it and then to rub some into your skin.","start":46.94,"end":54.81,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-006","text":"The brief experiment would dispel any further doubts she might have.","start":55.653,"end":59.603,"score":0.921,"timingValid":true,"needsReview":true,"sourceId":"b3-052-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b3-052-007","sourceId":"b3-052-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The bottle really does contain perfumed mud.","start":60.3,"end":63.88,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-008","sourceId":"b3-052-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"How Harry came into the possession of this outlandish stuff makes an interesting story which he is fond of relating.","start":64.49,"end":72.1,"score":0.937,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-052-009","sourceId":"b3-052-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Furthermore, the acquisition of this bottle cured him of a bad habit he had been developing for years.","start":72.94,"end":79.52,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-010","sourceId":"b3-052-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"Harry used to consider it a great joke to go into expensive cosmetic shops and make outrageous requests for goods that do not exist.","start":80.82,"end":90.18,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-011","sourceId":"b3-052-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"He would invent fanciful names on the spot.","start":91.0,"end":93.59,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-012","sourceId":"b3-052-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"On entering a shop, he would ask for a new perfume called 'Scented Shadow' or for 'insoluble bath cubes'.","start":94.28,"end":102.18,"score":0.892,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-013","sourceId":"b3-052-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"If a shop assistant told him she had not heard of it, he would pretend to be considerably put out.","start":103.03,"end":109.06,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-014-p01","sourceId":"b3-052-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"He loved to be told that one of his imaginary products was temporarily out of stock","start":110.04,"end":115.6,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-014-p02","sourceId":"b3-052-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[16,34],"wordModel":"mms-fa","text":"and he would faithfully promise to call again at some future date, but of course he never did.","start":116.13,"end":122.16,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-015","sourceId":"b3-052-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"How Harry managed to keep a straight face during these performances is quite beyond me.","start":123.04,"end":128.32,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-016","sourceId":"b3-052-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Harry does not need to be prompted to explain how he bought his precious bottle of mud.","start":129.54,"end":134.8,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-017","sourceId":"b3-052-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"One day, he went to an exclusive shop in London and asked for 'Myrolite'.","start":135.5,"end":141.07,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-018","sourceId":"b3-052-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The shop assistant looked puzzled and Harry repeated the word, slowly stressing each syllable.","start":141.73,"end":147.86,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-019-p01","sourceId":"b3-052-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"When the woman shook her head in bewilderment, Harry went on to explain that 'myrolite' was a hard,","start":148.34,"end":155.3,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-019-p02","sourceId":"b3-052-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[18,27],"wordModel":"mms-fa","text":"amber-like substance which could be used to remove freckles.","start":155.6,"end":159.74,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-020","sourceId":"b3-052-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"This explanation evidently conveyed something to the woman who searched shelf after shelf.","start":160.73,"end":166.71,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-021","sourceId":"b3-052-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"She produced all sorts of weird concoctions, but none of them met with Harry's requirements.","start":167.64,"end":173.23,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-022","sourceId":"b3-052-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"When Harry put on his act of being mildly annoyed, the assistant promised to order some for him.","start":174.02,"end":180.32,"score":0.893,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-023","sourceId":"b3-052-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Intoxicated by his success, Harry then asked for perfumed mud.","start":181.11,"end":185.9,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-024","sourceId":"b3-052-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He expected the assistant to look at him in blank astonishment.","start":186.54,"end":190.16,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-025-p01","sourceId":"b3-052-025","sourceIndex":24,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"However, it was his turn to be surprised,","start":190.88,"end":193.78,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-025-p02","sourceId":"b3-052-025","sourceIndex":24,"part":2,"parts":2,"wordRange":[8,30],"wordModel":"mms-fa","text":"for the woman's eyes immediately lit up and she fetched several bottles which she placed on the counter for Harry to inspect.","start":194.12,"end":202.24,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-026","sourceId":"b3-052-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"For once, Harry had to admit defeat.","start":202.76,"end":205.56,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-027","sourceId":"b3-052-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"He picked up what seemed to be the smallest bottle and discreetly asked the price.","start":205.96,"end":210.83,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-028-p01","sourceId":"b3-052-028","sourceIndex":27,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"He was glad to get away with a mere twenty pounds and he beat a hasty retreat,","start":211.39,"end":216.58,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-028-p02","sourceId":"b3-052-028","sourceIndex":27,"part":2,"parts":2,"wordRange":[17,24],"wordModel":"mms-fa","text":"clutching the precious bottle under his arm.","start":217.1,"end":219.77,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-029","sourceId":"b3-052-029","sourceIndex":28,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"From then on, Harry decided that this little game he had invented might prove to be expensive.","start":220.54,"end":226.42,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-052-030","sourceId":"b3-052-030","sourceIndex":29,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"The curious bottle which now adorns the bookcase in his study was his first and last purchase of rare cosmetics.","start":227.08,"end":235.78,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
