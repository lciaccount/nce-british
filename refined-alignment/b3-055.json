fset":90,"start":215.722,"end":216.262,"score":0.99},{"text":"change","offset":101,"start":216.382,"end":216.802,"score":0.949},{"text":"our","offset":108,"start":216.863,"end":216.962,"score":0.931},{"text":"view","offset":112,"start":217.023,"end":217.242,"score":0.942},{"text":"of","offset":117,"start":217.423,"end":217.502,"score":0.994},{"text":"ourselves.","offset":120,"start":217.562,"end":218.162,"score":0.945}],[{"text":"As","offset":0,"start":219.083,"end":219.142,"score":0.978},{"text":"Daniel","offset":3,"start":219.262,"end":219.582,"score":0.995},{"text":"Goldin","offset":10,"start":219.722,"end":220.102,"score":0.825},{"text":"of","offset":17,"start":220.562,"end":220.602,"score":0.999},{"text":"NASA","offset":20,"start":220.743,"end":221.082,"score":0.924},{"text":"observed,","offset":25,"start":221.222,"end":221.702,"score":0.972},{"text":"'Finding","offset":35,"start":222.662,"end":223.022,"score":0.996},{"text":"life","offset":44,"start":223.123,"end":223.322,"score":0.999},{"text":"elsewhere","offset":49,"start":223.482,"end":223.882,"score":0.96},{"text":"would","offset":59,"start":224.222,"end":224.402,"score":0.997},{"text":"change","offset":65,"start":224.502,"end":224.822,"score":0.997},{"text":"everything.","offset":72,"start":225.042,"end":225.422,"score":1.0}],[{"text":"No","offset":0,"start":226.442,"end":226.582,"score":0.85},{"text":"human","offset":3,"start":226.722,"end":227.002,"score":0.998},{"text":"endeavour","offset":9,"start":227.062,"end":227.422,"score":0.911},{"text":"or","offset":19,"start":227.583,"end":227.622,"score":0.999},{"text":"thought","offset":22,"start":227.743,"end":228.002,"score":0.948},{"text":"would","offset":30,"start":228.442,"end":228.602,"score":0.978},{"text":"be","offset":36,"start":228.642,"end":228.722,"score":1.0},{"text":"unchanged","offset":39,"start":228.903,"end":229.462,"score":0.956},{"text":"by","offset":49,"start":229.583,"end":229.722,"score":1.0},{"text":"it.'","offset":52,"start":229.843,"end":229.882,"score":1.0}]],"cues":[{"id":"b3-055-001","sourceId":"b3-055-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Which life forms are most likely to develop on a distant planet?","start":13.69,"end":18.0,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-002","sourceId":"b3-055-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Recent developments in astronomy have made it possible to detect planets in our own Milky Way and in other galaxies.","start":20.58,"end":28.32,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-003","sourceId":"b3-055-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"This is a major achievement because, in relative terms, planets are very small and do not emit light.","start":29.3,"end":36.84,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-004","sourceId":"b3-055-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Finding planets is proving hard enough, but finding life on them will prove infinitely more difficult.","start":37.69,"end":44.58,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-005","sourceId":"b3-055-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The first question to answer is whether a planet can actually support life.","start":45.42,"end":50.3,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-006","sourceId":"b3-055-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"In our own solar system, for example, Venus is far to hot and Mars is far too cold to support life.","start":51.0,"end":59.7,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-007-p01","sourceId":"b3-055-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"Only the Earth provides ideal conditions,","start":60.56,"end":63.3,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-007-p02","sourceId":"b3-055-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[6,24],"wordModel":"mms-fa","text":"and even here it has taken more than four billion years for plant and animal life to evolve.","start":63.77,"end":69.98,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-008","sourceId":"b3-055-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Whether a planet can support life depends on the size and brightness of its star, that is its 'sun'.","start":71.42,"end":79.07,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-009","sourceId":"b3-055-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"Imagine a star up to twenty times larger, brighter and hotter than our own sun.","start":79.7,"end":86.15,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-010","sourceId":"b3-055-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"A planet would have to be a very long way from it to be capable of supporting life.","start":86.84,"end":92.08,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-011-p01","sourceId":"b3-055-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"Alternatively, if the star were small,","start":92.84,"end":95.34,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-011-p02","sourceId":"b3-055-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[6,29],"wordModel":"mms-fa","text":"the life-supporting planet would have to have a close orbit round it and also provide the perfect conditions for life forms to develop.","start":95.6,"end":103.67,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-012","sourceId":"b3-055-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"But how would we find such a planet?","start":104.38,"end":106.72,"score":0.998,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-013","sourceId":"b3-055-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"At present, there is no telescope in existence that is capable of detecting the presence of life.","start":107.54,"end":113.34,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-014","sourceId":"b3-055-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"The development of such a telescope will be one of the great astronomical projects of the 21st century.","start":114.05,"end":120.49,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-015","sourceId":"b3-055-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"It is impossible to look for life on another planet using earth-based telescopes.","start":121.78,"end":126.39,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-016","sourceId":"b3-055-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Our own warm atmosphere and the heat generated by the telescope would make it impossible to detect objects as small as planets.","start":127.1,"end":135.4,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-017-p01","sourceId":"b3-055-017","sourceIndex":16,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"Even a telescope in orbit round the earth, like the very successful Hubble telescope,","start":136.47,"end":142.12,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-017-p02","sourceId":"b3-055-017","sourceIndex":16,"part":2,"parts":2,"wordRange":[14,27],"wordModel":"mms-fa","text":"would not be suitable because of the dust particles in our solar system.","start":142.302,"end":146.78,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-018-p01","sourceId":"b3-055-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"A telescope would have to be as far away as the planet Jupiter to look for life in outer space,","start":147.68,"end":154.1,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-018-p02","sourceId":"b3-055-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[20,38],"wordModel":"mms-fa","text":"because the dust becomes thinner the further we travel towards the outer edges of our own solar system.","start":154.6,"end":160.69,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-019-p01","sourceId":"b3-055-019","sourceIndex":18,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Once we detected a planet, we would have to find a way of blotting out the light from its star,","start":161.49,"end":167.12,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-019-p02","sourceId":"b3-055-019","sourceIndex":18,"part":2,"parts":2,"wordRange":[20,35],"wordModel":"mms-fa","text":"so that we would be able to 'see' the planet properly and analyse its atmosphere.","start":167.41,"end":172.32,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-020","sourceId":"b3-055-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"In the first instance, we would be looking for plant life, rather than 'little green men'.","start":173.08,"end":179.1,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-021","sourceId":"b3-055-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"The life forms most likely to develop on a planet would be bacteria.","start":179.81,"end":184.63,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-022","sourceId":"b3-055-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It is bacteria that have generated the oxygen we breathe on earth.","start":185.23,"end":189.37,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-023","sourceId":"b3-055-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"For most of the earth's history they have been the only form of life on our planet.","start":190.19,"end":194.84,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-024-p01","sourceId":"b3-055-024","sourceIndex":23,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"As Earth-dwellers, we always cherish the hope that we will be visited by little green men","start":195.75,"end":201.75,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-024-p02","sourceId":"b3-055-024","sourceIndex":23,"part":2,"parts":2,"wordRange":[16,26],"wordModel":"mms-fa","text":"and that we will be able to communicate with them.","start":202.14,"end":204.64,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-025","sourceId":"b3-055-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"But this hope is always in the realms of science fiction.","start":205.38,"end":208.72,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-026","sourceId":"b3-055-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"If we were able to discover lowly forms of life like bacteria on another planet, it would completely change our view of ourselves.","start":209.6,"end":218.24,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-027","sourceId":"b3-055-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"As Daniel Goldin of NASA observed, 'Finding life elsewhere would change everything.","start":218.94,"end":225.55,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-055-028","sourceId":"b3-055-028","sourceIndex":27,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"No human endeavour or thought would be unchanged by it.'","start":226.202,"end":229.98,"score":0.964,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
