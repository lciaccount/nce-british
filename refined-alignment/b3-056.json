o","offset":48,"start":208.662,"end":208.742,"score":0.999},{"text":"do","offset":51,"start":208.822,"end":208.902,"score":1.0},{"text":"so.","offset":54,"start":209.042,"end":209.142,"score":1.0}]],"cues":[{"id":"b3-056-001","sourceId":"b3-056-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Why had the neighbours left their farm?","start":13.09,"end":15.83,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-002","sourceId":"b3-056-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The river which forms the eastern boundary of our farm has always played an important part in our lives.","start":18.5,"end":25.35,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-003","sourceId":"b3-056-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Without it we could not make a living.","start":26.21,"end":28.46,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-004-p01","sourceId":"b3-056-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"There is only enough spring water to supply the needs of the house","start":29.12,"end":32.48,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-004-p02","sourceId":"b3-056-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"so we have to pump from the river for farm use.","start":32.85,"end":35.64,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-005","sourceId":"b3-056-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"We tell the river all our secrets.","start":36.32,"end":38.32,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-006-p01","sourceId":"b3-056-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"We know instinctively, just as beekeepers with their bees,","start":38.64,"end":42.3,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-006-p02","sourceId":"b3-056-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[9,26],"wordModel":"mms-fa","text":"that misfortune might overtake us if the important events of our lives were not related to it.","start":42.56,"end":48.76,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-007","sourceId":"b3-056-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"We have special river birthday parties in the summer.","start":49.57,"end":52.48,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-008-p01","sourceId":"b3-056-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Sometimes we go upstream to a favourite backwater, sometimes we have our party at the boathouse,","start":53.21,"end":59.94,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-008-p02","sourceId":"b3-056-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[16,37],"wordModel":"mms-fa","text":"which a predecessor of ours at the farm built in the meadow hard by the deepest pool for swimming and diving.","start":60.36,"end":67.69,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-009","sourceId":"b3-056-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"In a heat wave we choose a midnight birthday party and that is the most exciting of all.","start":68.59,"end":74.98,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-010-p01","sourceId":"b3-056-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"We welcome the seasons by the riverside, crowning the youngest girl with flowers in the spring, holding a summer festival on Midsummer Eve,","start":75.66,"end":84.84,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-010-p02","sourceId":"b3-056-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[23,42],"wordModel":"mms-fa","text":"giving thanks for the harvest in the autumn, and throwing a holly wreath into the current in the winter.","start":85.55,"end":91.7,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-011","sourceId":"b3-056-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"After a long period of rain the river may overflow its banks.","start":93.08,"end":97.31,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-012","sourceId":"b3-056-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This is a rare occurrence as our climate seldom goes to extremes.","start":98.12,"end":102.46,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-013-p01","sourceId":"b3-056-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"We are lucky in that only the lower fields, which make up a very small proportion of our farm,","start":103.21,"end":109.21,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-013-p02","sourceId":"b3-056-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[19,39],"wordModel":"mms-fa","text":"are affected by flooding, but other farms are less favourably sited, and flooding can sometimes spell disaster for their owners.","start":109.44,"end":118.54,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-014","sourceId":"b3-056-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"One bad winter we watched the river creep up the lower meadows.","start":119.523,"end":123.56,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-015","sourceId":"b3-056-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"All the cattle had been moved into stalls and we stood to lose little.","start":124.4,"end":128.49,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-016","sourceId":"b3-056-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"We were, however, worried about our nearest neighbours, whose farm was low lying and who were newcomers to the district.","start":129.36,"end":136.86,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-017","sourceId":"b3-056-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"As the floods had put the telephone out of order, we could not find out how they were managing.","start":137.61,"end":143.19,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-018-p01","sourceId":"b3-056-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"From an attic window we could get a sweeping view of the river where their land joined ours,","start":143.96,"end":149.56,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-018-p02","sourceId":"b3-056-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[18,31],"wordModel":"mms-fa","text":"and at the most critical juncture we took turns in watching that point.","start":149.95,"end":153.97,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-019","sourceId":"b3-056-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The first sign of disaster was a dead sheep floating down.","start":154.64,"end":158.62,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-020-p01","sourceId":"b3-056-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"Next came a horse, swimming bravely,","start":159.34,"end":161.87,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-020-p02","sourceId":"b3-056-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[6,25],"wordModel":"mms-fa","text":"but we were afraid that the strength of the current would prevent its landing anywhere before it became exhausted.","start":162.042,"end":168.44,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-021-p01","sourceId":"b3-056-021","sourceIndex":20,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Suddenly a raft appeared, looking rather like Noah's ark, carrying the whole family,","start":169.27,"end":175.29,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-021-p02","sourceId":"b3-056-021","sourceIndex":20,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"a few hens, the dogs, a cat, and a bird in a cage.","start":175.78,"end":180.36,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-022-p01","sourceId":"b3-056-022","sourceIndex":21,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"We realized that they must have become unduly frightened by the rising flood, for their house,","start":181.16,"end":187.35,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-022-p02","sourceId":"b3-056-022","sourceIndex":21,"part":2,"parts":2,"wordRange":[16,31],"wordModel":"mms-fa","text":"which had sound foundations, would have stood stoutly even if it had been almost submerged.","start":187.84,"end":193.8,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-023-p01","sourceId":"b3-056-023","sourceIndex":22,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"The men of our family waded down through our flooded meadows with boat hooks,","start":194.63,"end":199.18,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-023-p02","sourceId":"b3-056-023","sourceIndex":22,"part":2,"parts":2,"wordRange":[14,37],"wordModel":"mms-fa","text":"in the hope of being able to grapple a corner of the raft and pull it out of the current towrds our bank.","start":199.32,"end":205.0,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-056-024","sourceId":"b3-056-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"We still think it a miracle that they were able to do so.","start":205.65,"end":209.34,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
