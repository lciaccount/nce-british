rnt","offset":71,"start":108.683,"end":108.983,"score":0.984},{"text":"down","offset":77,"start":109.082,"end":109.383,"score":0.968},{"text":"in","offset":82,"start":109.822,"end":109.863,"score":1.0},{"text":"1936.","offset":85,"start":109.963,"end":111.003,"score":0.979}]],"cues":[{"id":"b2-080-001","sourceId":"b2-080-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"How many people visited the Great Exhibition of 1851?","start":12.42,"end":18.07,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-002-p01","sourceId":"b2-080-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Perhaps the most extraordinary building of the 19th century was the Crystal Palace","start":20.76,"end":27.03,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-002-p02","sourceId":"b2-080-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[13,25],"wordModel":"english-ctc-fallback","text":"which was built in Hyde Park for the Great Exhibition of 1851.","start":27.682,"end":33.1,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-003","sourceId":"b2-080-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"The Crystal Palace was different from all other buildings in the world, for it was made of iron and glass.","start":35.0,"end":42.56,"score":0.934,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-004","sourceId":"b2-080-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"It was one of the biggest buildings of all time and a lot of people from many countries came to see it.","start":43.78,"end":50.83,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-005","sourceId":"b2-080-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"A great many goods were sent to the exhibition from various parts of the world.","start":52.86,"end":58.38,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-006","sourceId":"b2-080-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"There was also a great deal of machinery on display.","start":59.58,"end":62.75,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-007","sourceId":"b2-080-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The most wonderful piece of machinery on show was Nasmyth's steam hammer.","start":64.16,"end":70.24,"score":0.899,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-008-p01","sourceId":"b2-080-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"Though in those days travelling was not as easy as it is today,","start":71.52,"end":75.63,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-008-p02","sourceId":"b2-080-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"steam boats carried thousands of visitors across the Channel from Europe.","start":76.17,"end":81.39,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-009","sourceId":"b2-080-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"On arriving in England, they were, taken to the Crystal Palace by train.","start":82.9,"end":87.63,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-010","sourceId":"b2-080-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"There were six million visitors in all, and the profits from the exhibition were used to build museums and colleges.","start":89.54,"end":98.17,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-011","sourceId":"b2-080-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Later, the Crystal Palace was moved to South London.","start":99.2,"end":103.13,"score":0.901,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-080-012","sourceId":"b2-080-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"It remained one of the most famous buildings in the world until it was burnt down in 1936.","start":103.8,"end":111.323,"score":0.987,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
