eIndex":1,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"As the man tried to swing the speedboat round, the steering wheel came away in his hands.","start":16.8,"end":23.1,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-003","sourceId":"b2-086-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"He waved desperately to his companion, who had been water skiing for the last fifteen minutes.","start":24.48,"end":30.68,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-004","sourceId":"b2-086-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Both men had hardly had time to realize what was happening when they were thrown violently into the sea.","start":31.71,"end":38.8,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-005","sourceId":"b2-086-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The speedboat had struck a buoy, but it continued to move very quickly across the water.","start":40.14,"end":46.92,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-006","sourceId":"b2-086-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Both men had just begun to swim towards the shore, when they noticed with dismay that the speedboat was moving in a circle.","start":48.1,"end":56.76,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-007","sourceId":"b2-086-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"It now came straight towards them at tremendous speed.","start":57.6,"end":61.26,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-008","sourceId":"b2-086-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"In less than a minute, it roared past them only a few feet away.","start":62.58,"end":67.77,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-009","sourceId":"b2-086-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"After it had passed, they swam on as quickly as they could because they knew that the boat would soon return.","start":69.14,"end":76.54,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-010","sourceId":"b2-086-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"They had just had enough time to swim out of danger when the boat again completed a circle.","start":77.58,"end":84.96,"score":0.908,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-011","sourceId":"b2-086-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"On this occasion, however, it had slowed down considerably.","start":86.26,"end":90.64,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-012","sourceId":"b2-086-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The petrol had nearly all been used up.","start":91.682,"end":94.47,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-086-013","sourceId":"b2-086-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Before long, the noise dropped completely and the boat began to drift gently across the water.","start":95.62,"end":102.76,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
