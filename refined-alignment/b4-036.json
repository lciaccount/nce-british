78.822,"score":0.999},{"text":"in","offset":99,"start":178.942,"end":179.042,"score":0.998},{"text":"the","offset":102,"start":179.062,"end":179.162,"score":0.996},{"text":"interests","offset":106,"start":179.262,"end":179.662,"score":0.921},{"text":"of","offset":116,"start":179.683,"end":179.762,"score":0.999},{"text":"the","offset":119,"start":179.782,"end":179.882,"score":0.978},{"text":"nation;","offset":123,"start":179.942,"end":180.302,"score":0.881},{"text":"and","offset":131,"start":181.102,"end":181.302,"score":0.955},{"text":"it","offset":135,"start":181.583,"end":181.662,"score":0.998},{"text":"will","offset":138,"start":181.683,"end":181.822,"score":0.883},{"text":"have","offset":143,"start":181.882,"end":182.042,"score":0.941},{"text":"to","offset":148,"start":182.083,"end":182.142,"score":0.993},{"text":"watch,","offset":151,"start":182.262,"end":182.562,"score":0.947},{"text":"check,","offset":158,"start":183.162,"end":183.402,"score":0.978},{"text":"and","offset":165,"start":183.863,"end":184.002,"score":0.98},{"text":"control","offset":169,"start":184.062,"end":184.462,"score":0.999},{"text":"the","offset":177,"start":184.502,"end":184.582,"score":0.997},{"text":"people","offset":181,"start":184.623,"end":184.942,"score":0.957},{"text":"accordingly.","offset":188,"start":185.002,"end":185.502,"score":0.994}],[{"text":"A","offset":0,"start":186.523,"end":186.542,"score":0.959},{"text":"disunited","offset":2,"start":186.722,"end":187.362,"score":0.97},{"text":"nation","offset":12,"start":187.403,"end":187.682,"score":0.958},{"text":"therefore","offset":19,"start":187.762,"end":188.202,"score":0.979},{"text":"has","offset":29,"start":188.583,"end":188.762,"score":0.998},{"text":"to","offset":33,"start":188.803,"end":188.862,"score":0.998},{"text":"incur","offset":36,"start":188.963,"end":189.262,"score":0.812},{"text":"unduly","offset":42,"start":189.662,"end":190.062,"score":0.844},{"text":"high","offset":49,"start":190.142,"end":190.362,"score":0.978},{"text":"costs","offset":54,"start":190.422,"end":190.882,"score":0.996},{"text":"of","offset":60,"start":190.982,"end":191.082,"score":0.998},{"text":"government.","offset":63,"start":191.162,"end":191.582,"score":0.972}]],"cues":[{"id":"b4-036-001","sourceId":"b4-036-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"What's the most important factor, both in government or business, for keeping running costs low?","start":11.42,"end":18.49,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-002","sourceId":"b4-036-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"If a nation is essentialy disunited, it is left to the government to hold it together.","start":21.16,"end":26.53,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-003","sourceId":"b4-036-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"This increases the expense of government, and reduces correspondingly the amount of economic resources that could be used for developing the country.","start":27.58,"end":37.07,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-004","sourceId":"b4-036-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"And it should not be forgotten how small those resources are in a poor and backward country.","start":38.15,"end":43.81,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-005","sourceId":"b4-036-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Where the cost of government is high, resources for development are correspondingly low.","start":44.78,"end":50.3,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-006","sourceId":"b4-036-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"This may be illustrated by comparing the position of a nation with that of a private business enterprise.","start":51.84,"end":58.04,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-007","sourceId":"b4-036-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"An enterprise has to incur certain costs and expenses in order to stay in business.","start":59.36,"end":64.93,"score":0.854,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-008","sourceId":"b4-036-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"For our purposes, we are concerned only with one kind of cost--the cost of managing and administering the business.","start":65.803,"end":74.58,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-009","sourceId":"b4-036-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Such administrative overheads in a business are analogous to the cost of government in a nation.","start":75.82,"end":82.15,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-010-p01","sourceId":"b4-036-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,25],"wordModel":"mms-fa","text":"The administrative overheads of a business are low to the extent that everyone working in the business can be trusted to behave in a way","start":83.16,"end":91.67,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-010-p02","sourceId":"b4-036-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[25,33],"wordModel":"mms-fa","text":"that best promotes the interests of the firm.","start":91.86,"end":94.45,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-011-p01","sourceId":"b4-036-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"If they can each be trusted to take such responsibilities,","start":95.74,"end":99.04,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-011-p02","sourceId":"b4-036-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[10,26],"wordModel":"mms-fa","text":"and to exercise such initiative as falls within their sphere, then administrative overheads will be low.","start":99.42,"end":106.96,"score":0.896,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-012-p01","sourceId":"b4-036-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,29],"wordModel":"mms-fa","text":"It will be low because it will be necessary to have only one man looking after each job without having another man to check upon what he is doing,","start":108.28,"end":117.32,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-012-p02","sourceId":"b4-036-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[29,40],"wordModel":"mms-fa","text":"keep him in line, and report on him to someone else.","start":117.86,"end":121.66,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-013-p01","sourceId":"b4-036-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"But if no one can be trusted to act in a loyal and responsible manner towards his job,","start":122.41,"end":128.57,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-013-p02","sourceId":"b4-036-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[18,35],"wordModel":"mms-fa","text":"then the business will require armies of administrators, checkers and foremen and administrative overheads will rise correspondingly.","start":128.982,"end":138.56,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-014-p01","sourceId":"b4-036-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"As administrative overheads rise, so the earnings of the business after meeting the expense of administration, will fall;","start":140.08,"end":148.15,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-014-p02","sourceId":"b4-036-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[18,38],"wordModel":"mms-fa","text":"and the business will have less money to distribute as dividends or invest directly in its future progress and development.","start":148.74,"end":156.12,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-015","sourceId":"b4-036-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It is precisely the same with a nation.","start":157.58,"end":159.79,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-016-p01","sourceId":"b4-036-016","sourceIndex":15,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"To the extent that the people can be relied on to behave in a loyal and responsible manner,","start":160.27,"end":166.13,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-016-p02","sourceId":"b4-036-016","sourceIndex":15,"part":2,"parts":2,"wordRange":[18,34],"wordModel":"mms-fa","text":"the government does not require armies of police and civil servants to keep them in order.","start":166.462,"end":171.7,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-017-p01","sourceId":"b4-036-017","sourceIndex":16,"part":1,"parts":3,"wordRange":[0,6],"wordModel":"mms-fa","text":"But if a nation is disunited,","start":172.42,"end":174.86,"score":0.997,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-017-p02","sourceId":"b4-036-017","sourceIndex":16,"part":2,"parts":3,"wordRange":[6,25],"wordModel":"mms-fa","text":"the government cannot be sure that the actions of the people will be in the interests of the nation;","start":175.08,"end":180.4,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-017-p03","sourceId":"b4-036-017","sourceIndex":16,"part":3,"parts":3,"wordRange":[25,37],"wordModel":"mms-fa","text":"and it will have to watch, check, and control the people accordingly.","start":181.03,"end":185.63,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-036-018","sourceId":"b4-036-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"A disunited nation therefore has to incur unduly high costs of government.","start":186.29,"end":191.66,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
