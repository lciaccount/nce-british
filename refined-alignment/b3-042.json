.842,"score":0.98},{"text":"the","offset":49,"start":226.903,"end":226.982,"score":0.999},{"text":"colours","offset":53,"start":227.083,"end":227.422,"score":0.809},{"text":"of","offset":61,"start":227.463,"end":227.522,"score":1.0},{"text":"the","offset":64,"start":227.562,"end":227.642,"score":0.998},{"text":"rainbow.","offset":68,"start":227.702,"end":228.082,"score":0.989}],[{"text":"In","offset":0,"start":229.162,"end":229.242,"score":1.0},{"text":"the","offset":3,"start":229.282,"end":229.382,"score":0.992},{"text":"eerie","offset":7,"start":229.602,"end":229.922,"score":0.405},{"text":"silence","offset":13,"start":230.023,"end":230.482,"score":0.909},{"text":"of","offset":21,"start":230.502,"end":230.562,"score":1.0},{"text":"the","offset":24,"start":230.602,"end":230.682,"score":0.999},{"text":"cavern,","offset":28,"start":230.722,"end":231.062,"score":0.952},{"text":"the","offset":36,"start":231.502,"end":231.582,"score":0.999},{"text":"only","offset":40,"start":231.743,"end":231.962,"score":0.999},{"text":"sound","offset":45,"start":232.083,"end":232.382,"score":0.992},{"text":"that","offset":51,"start":232.403,"end":232.502,"score":0.999},{"text":"could","offset":56,"start":232.562,"end":232.722,"score":0.994},{"text":"be","offset":62,"start":232.743,"end":232.822,"score":0.999},{"text":"heard","offset":65,"start":232.882,"end":233.102,"score":0.966},{"text":"was","offset":71,"start":233.403,"end":233.522,"score":0.999},{"text":"made","offset":75,"start":233.583,"end":233.782,"score":0.999},{"text":"by","offset":80,"start":233.803,"end":233.962,"score":0.999},{"text":"water","offset":83,"start":234.083,"end":234.402,"score":0.995},{"text":"which","offset":89,"start":234.843,"end":235.022,"score":0.98},{"text":"dripped","offset":95,"start":235.102,"end":235.382,"score":0.935},{"text":"continuously","offset":103,"start":235.602,"end":236.362,"score":0.985},{"text":"from","offset":116,"start":236.743,"end":236.882,"score":1.0},{"text":"the","offset":121,"start":236.903,"end":236.982,"score":0.969},{"text":"high","offset":125,"start":237.062,"end":237.382,"score":0.953},{"text":"dome","offset":130,"start":237.463,"end":237.762,"score":0.872},{"text":"above","offset":135,"start":237.822,"end":238.122,"score":0.99},{"text":"them.","offset":141,"start":238.142,"end":238.282,"score":0.999}]],"cues":[{"id":"b3-042-001","sourceId":"b3-042-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"With what does the writer compare the Gouffre Berger?","start":11.8,"end":15.59,"score":0.878,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-002","sourceId":"b3-042-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"Cave exploration, or pot-holing, as it has come to be known, is a relatively new sport.","start":18.24,"end":24.4,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-003-p01","sourceId":"b3-042-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"Perhaps it is the desire for solitude or the chance of making an unexpected discovery","start":25.22,"end":31.04,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-003-p02","sourceId":"b3-042-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[15,25],"wordModel":"mms-fa","text":"that lures people down to the depths of the earth.","start":31.48,"end":34.73,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-004","sourceId":"b3-042-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It is impossible to give a satisfactory explanation for a pot-holer's motives.","start":35.65,"end":40.36,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-005","sourceId":"b3-042-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"For him, caves have the same peculiar fascination which high mountains have for the climber.","start":41.3,"end":47.19,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-006","sourceId":"b3-042-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"They arouse instincts which can only be dimly understood.","start":47.83,"end":51.76,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-007","sourceId":"b3-042-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Exploring really deep caves is not a task for the Sunday afternoon rambler.","start":53.18,"end":58.33,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-008","sourceId":"b3-042-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"Such undertakings require the precise planning and foresight of military operations.","start":59.35,"end":65.03,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-009","sourceId":"b3-042-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,29],"wordModel":"mms-fa","text":"It can take as long as eight days to rig up rope ladders and to establish supply bases before a descent can be made into a very deep cave.","start":66.26,"end":76.4,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-010","sourceId":"b3-042-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"Precautions of this sort are necessary, for it is impossible to foretell the exact nature of the difficulties which will confront the pot-holer.","start":77.6,"end":87.17,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-011","sourceId":"b3-042-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The deepest known cave in the world is the Gouffre Berger near Grenoble.","start":88.01,"end":93.26,"score":0.923,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-012","sourceId":"b3-042-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"It extends to a depth of 3, 723 feet.","start":93.8,"end":98.44,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-013","sourceId":"b3-042-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"This immense chasm has been formed by an underground stream which has tunnelled a course through a flaw in the rocks.","start":99.05,"end":106.99,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-014","sourceId":"b3-042-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The entrance to the cave is on a plateau in the Dauphine Alps.","start":107.76,"end":112.33,"score":0.906,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-015","sourceId":"b3-042-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"As it is only six feet across, it is barely noticeable.","start":113.09,"end":116.63,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-016","sourceId":"b3-042-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The cave might never have been discovered had not the entrance been spotted by the distinguished French pot-holer, Berger.","start":117.38,"end":124.83,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-017","sourceId":"b3-042-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Since its discovery, it has become a sort of pot-holers' Everest.","start":125.57,"end":129.94,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-018","sourceId":"b3-042-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Though a number of descents have been made, much of it still remains to be explored.","start":130.67,"end":135.59,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-019","sourceId":"b3-042-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"A team of pot-holers recently went down the Gouffre Berger.","start":136.7,"end":140.57,"score":0.879,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-020-p01","sourceId":"b3-042-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"After entering the narrow gap on the plateau,","start":141.23,"end":143.74,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-020-p02","sourceId":"b3-042-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"mms-fa","text":"they climbed down the steep sides of the cave until they came to a narrow corridor.","start":144.2,"end":149.36,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-021","sourceId":"b3-042-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"They had to edge their way along this, sometimes wading across shallow streams, or swimming across deep pools.","start":150.14,"end":158.08,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-022","sourceId":"b3-042-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Suddenly they came to a waterfall which dropped into an underground lake at the bottom of the cave.","start":158.95,"end":165.58,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-023-p01","sourceId":"b3-042-023","sourceIndex":22,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"They plunged into the lake, and after loading their gear on an inflatable rubber dinghy,","start":166.36,"end":172.14,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-023-p02","sourceId":"b3-042-023","sourceIndex":22,"part":2,"parts":2,"wordRange":[15,24],"wordModel":"mms-fa","text":"let the current carry them to the other side.","start":172.55,"end":175.65,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-024","sourceId":"b3-042-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"To protect themselves from the icy water, they had to wear special rubber suits.","start":176.62,"end":181.7,"score":0.9,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-025","sourceId":"b3-042-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"At the far end of the lake, they came to huge piles of rubble which had been washed up by the water.","start":182.48,"end":188.2,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-026-p01","sourceId":"b3-042-026","sourceIndex":25,"part":1,"parts":3,"wordRange":[0,6],"wordModel":"mms-fa","text":"In this part of the cave,","start":188.76,"end":190.21,"score":1.0,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-026-p02","sourceId":"b3-042-026","sourceIndex":25,"part":2,"parts":3,"wordRange":[6,13],"wordModel":"mms-fa","text":"they could hear an insistent booming sound","start":190.64,"end":193.64,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-026-p03","sourceId":"b3-042-026","sourceIndex":25,"part":3,"parts":3,"wordRange":[13,33],"wordModel":"mms-fa","text":"which they found was caused by a small waterspout shooting down into a pool from the roof of the cave.","start":193.98,"end":200.29,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-027","sourceId":"b3-042-027","sourceIndex":26,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Squeezing through a cleft in the rocks, the pot-holers arrived at an enormous cavern, the size of a huge concert hall.","start":201.05,"end":208.93,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-028-p01","sourceId":"b3-042-028","sourceIndex":27,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"After switching on powerful arc lights,","start":210.12,"end":212.42,"score":0.888,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-028-p02","sourceId":"b3-042-028","sourceIndex":27,"part":2,"parts":2,"wordRange":[6,27],"wordModel":"mms-fa","text":"they saw great stalagmites--some of them over forty feet high--rising up like tree-trunks to meet the stalactites suspended from the roof.","start":212.72,"end":222.68,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-029","sourceId":"b3-042-029","sourceIndex":28,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Round about, piles of limestone glistened in all the colours of the rainbow.","start":223.44,"end":228.27,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-030-p01","sourceId":"b3-042-030","sourceIndex":29,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"In the eerie silence of the cavern,","start":229.09,"end":231.18,"score":0.894,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-042-030-p02","sourceId":"b3-042-030","sourceIndex":29,"part":2,"parts":2,"wordRange":[7,27],"wordModel":"mms-fa","text":"the only sound that could be heard was made by water which dripped continuously from the high dome above them.","start":231.44,"end":238.49,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
