viewReasons":[]},{"id":"b1-103-018","sourceId":"b1-103-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Perhaps we didn't do too badly.","start":59.58,"end":61.35,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-019","sourceId":"b1-103-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"The guy next to me wrote his name at the top of the paper.","start":62.0,"end":65.09,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-020","sourceId":"b1-103-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"Yes?","start":66.0,"end":66.46,"score":0.999,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-021","sourceId":"b1-103-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Then he sat there and looked at it for three hours!","start":67.26,"end":70.68,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-022","sourceId":"b1-103-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"He didn't write a word!","start":71.18,"end":72.44,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
