ts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"How was the exam, Richard?","start":17.66,"end":19.08,"score":0.876,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-003","sourceId":"b1-103-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"Not too bad.","start":20.18,"end":21.19,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-004","sourceId":"b1-103-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"I think I passed in English and Mathematics.","start":21.68,"end":24.38,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-005","sourceId":"b1-103-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"The questions were very easy.","start":25.04,"end":27.5,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-006","sourceId":"b1-103-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"english-ctc-fallback","text":"How about you, Gary?","start":28.16,"end":29.25,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-007","sourceId":"b1-103-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The English and Maths papers weren't easy enough for me.","start":30.82,"end":34.09,"score":0.906,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-008","sourceId":"b1-103-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I hope I haven't failed.","start":35.0,"end":36.37,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b1-103-009","sourceId":"b1-103-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I think I failed the French paper.","start":38.14,"end":40.17,"score":0.898,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":