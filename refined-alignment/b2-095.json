d":15.74,"score":0.81,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-002","sourceId":"b2-095-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"When the Ambassador of Escalopia returned home for lunch, his wife got a shock.","start":18.38,"end":24.27,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-003","sourceId":"b2-095-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"He looked pale and his clothes were in a frightful state.","start":24.82,"end":29.01,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-004","sourceId":"b2-095-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"english-ctc-fallback","text":"'What has happened?'","start":30.58,"end":31.88,"score":0.981,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-005","sourceId":"b2-095-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"she asked.","start":32.1,"end":33.12,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-006","sourceId":"b2-095-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"'How did your clothes get into such a mess?'","start":33.6,"end":36.448,"score":0.942,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-conflict"]},{"id":"b2-095-007","text":"'A fire extinguisher, my dear,' answered the Ambassador drily.","start":36.448,"end":42.423,"score":0.885,"timingValid":true,"needsReview":true,"sourceId":"b2-095-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment","boundary-conflict"]},{"id":"b2-095-008","sourceId":"b2-095-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"'University students set the Embassy on fire this morning.'","start":43.41,"end":47.3,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-009","sourceId":"b2-095-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"'Good heavens!'","start":48.52,"end":50.463,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-010","sourceId":"b2-095-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"exclaimed his wife.","start":51.07,"end":52.4,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-011","sourceId":"b2-095-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'And where were you at the time?'","start":53.29,"end":55.31,"score":0.979,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-012","sourceId":"b2-095-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"'I was in my office as usual,' answered the Ambassador.","start":57.2,"end":61.4,"score":0.986,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-013","sourceId":"b2-095-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'The fire broke out in the basement.","start":62.22,"end":64.27,"score":0.982,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-014","sourceId":"b2-095-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"I went down immediately, of course, and that fool, Horst, aimed a fire extinguisher at me.","start":65.28,"end":72.7,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-015","sourceId":"b2-095-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"He thought I was on fire.","start":73.58,"end":75.25,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-016","sourceId":"b2-095-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I must definitely get that fellow posted.'","start":76.57,"end":79.96,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-017","sourceId":"b2-095-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The Ambassador's wife went on asking questions, when she suddenly noticed a big hole in her husband's hat.","start":82.1,"end":90.32,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-018","sourceId":"b2-095-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'And how can you explain that?'","start":92.83,"end":95.12,"score":0.99,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-019","sourceId":"b2-095-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"mms-fa","text":"she asked.","start":95.81,"end":96.93,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-020","sourceId":"b2-095-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'Oh, that,' said the Ambassador.","start":98.042,"end":100.66,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-021","sourceId":"b2-095-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"'Someone fired a shot through my office window.","start":101.7,"end":104.76,"score":0.992,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-095-022","sourceId":"b2-095-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"Accurate, don't you think?","start":105.43,"end":106.64,"score":0.867,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-023","sourceId":"b2-095-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Fortunately, I wasn't wearing it at the time.","start":107.91,"end":110.4,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-095-024","sourceId":"b2-095-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"If I had been, I would not have been able to get home for lunch.'","start":111.17,"end":115.58,"score":0.98,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
