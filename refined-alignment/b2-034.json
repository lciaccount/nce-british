975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-034-007","sourceId":"b2-034-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"Five days ago, the policeman told him, the bicycle was picked up in a small village four hundred miles away.","start":53.2,"end":61.64,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-034-008","sourceId":"b2-034-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"It is now being sent to his home by train.","start":62.84,"end":66.22,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-034-009","sourceId":"b2-034-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Dan was most surprised when he heard the news.","start":68.2,"end":71.46,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-034-010","sourceId":"b2-034-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He was amused too, because he never expected the bicycle to be found.","start":72.38,"end":78.6,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-034-011","sourceId":"b2-034-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"It was stolen twenty years ago when Dan was a boy of fifteen!","start":79.86,"end":85.65,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
