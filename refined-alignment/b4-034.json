.995},{"text":"go","offset":17,"start":170.482,"end":170.562,"score":0.999},{"text":"to","offset":20,"start":170.662,"end":170.722,"score":0.994},{"text":"the","offset":23,"start":170.782,"end":170.862,"score":0.995},{"text":"other","offset":27,"start":171.002,"end":171.222,"score":0.946},{"text":"extreme,","offset":33,"start":171.282,"end":171.802,"score":0.936},{"text":"but","offset":42,"start":172.743,"end":172.862,"score":0.99},{"text":"on","offset":46,"start":172.903,"end":172.962,"score":0.967},{"text":"the","offset":49,"start":172.982,"end":173.062,"score":0.969},{"text":"whole","offset":53,"start":173.123,"end":173.382,"score":0.991},{"text":"this","offset":59,"start":173.683,"end":173.822,"score":0.995},{"text":"is","offset":64,"start":173.882,"end":173.962,"score":0.985},{"text":"a","offset":67,"start":174.042,"end":174.062,"score":0.954},{"text":"healthier","offset":69,"start":174.282,"end":174.702,"score":0.807},{"text":"attitude","offset":79,"start":174.782,"end":175.202,"score":0.975},{"text":"both","offset":88,"start":175.523,"end":175.762,"score":0.945},{"text":"for","offset":93,"start":175.923,"end":176.022,"score":0.958},{"text":"the","offset":97,"start":176.062,"end":176.122,"score":0.979},{"text":"child","offset":101,"start":176.202,"end":176.622,"score":0.997},{"text":"and","offset":107,"start":176.882,"end":176.982,"score":0.997},{"text":"the","offset":111,"start":177.023,"end":177.102,"score":0.994},{"text":"parent.","offset":115,"start":177.142,"end":177.502,"score":0.999}],[{"text":"It","offset":0,"start":178.502,"end":178.582,"score":0.985},{"text":"is","offset":3,"start":178.602,"end":178.682,"score":0.99},{"text":"always","offset":6,"start":178.843,"end":179.242,"score":0.995},{"text":"wiser","offset":13,"start":179.382,"end":179.802,"score":0.962},{"text":"and","offset":19,"start":179.903,"end":180.042,"score":0.984},{"text":"safer","offset":23,"start":180.142,"end":180.522,"score":0.988},{"text":"to","offset":29,"start":180.843,"end":180.942,"score":0.999},{"text":"face","offset":32,"start":181.023,"end":181.282,"score":0.937},{"text":"up","offset":37,"start":181.303,"end":181.402,"score":0.999},{"text":"to","offset":40,"start":181.442,"end":181.522,"score":0.998},{"text":"reality,","offset":43,"start":181.602,"end":182.042,"score":1.0},{"text":"however","offset":52,"start":182.662,"end":183.042,"score":0.993},{"text":"painful","offset":60,"start":183.142,"end":183.582,"score":0.999},{"text":"it","offset":68,"start":183.662,"end":183.742,"score":0.999},{"text":"may","offset":71,"start":183.803,"end":183.942,"score":1.0},{"text":"be","offset":75,"start":184.042,"end":184.142,"score":0.999},{"text":"at","offset":78,"start":184.683,"end":184.782,"score":0.998},{"text":"the","offset":81,"start":184.863,"end":184.942,"score":0.997},{"text":"moment.","offset":85,"start":185.002,"end":185.382,"score":0.999}]],"cues":[{"id":"b4-034-001","sourceId":"b4-034-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"What do adolescents respect in parents?","start":11.35,"end":14.59,"score":0.805,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-002-p01","sourceId":"b4-034-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"Parents are often upset when their children praise the homes of their friends and regard it as a slur on their own cooking,","start":17.26,"end":25.36,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-002-p02","sourceId":"b4-034-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[23,41],"wordModel":"mms-fa","text":"or cleaning, or furniture, and often are foolish enough to let the adolescents see that they are annoyed.","start":25.65,"end":32.8,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-003","sourceId":"b4-034-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"They may even accuse them of disloyalty, or make some spiteful remark about the friends' parents.","start":33.74,"end":40.68,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-004-p01","sourceId":"b4-034-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"Such a loss of dignity and descent into childish behaviour on the part of the adults deeply shocks the adolescents,","start":41.61,"end":49.63,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-004-p02","sourceId":"b4-034-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[20,41],"wordModel":"mms-fa","text":"and makes them resolve that in future they will not talk to their parents about the places or people they visit.","start":50.16,"end":57.13,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-005-p01","sourceId":"b4-034-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"Before very long the parents will be complaining that the child is so secretive and never tells them anything,","start":58.24,"end":65.46,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-005-p02","sourceId":"b4-034-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[19,30],"wordModel":"mms-fa","text":"but they seldom realize that they have brought this on themselves.","start":66.04,"end":69.76,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-006","sourceId":"b4-034-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Disillusionment with the parents, however good and adequate they may be both as parents and as individuals, is to some degree inevitable.","start":70.95,"end":80.53,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-007-p01","sourceId":"b4-034-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Most children have such a high ideal of their parents, unless the parents themselves have been unsatisfactory,","start":81.53,"end":88.02,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-007-p02","sourceId":"b4-034-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[17,29],"wordModel":"mms-fa","text":"that it can hardly hope to stand up to a realistic evaluation.","start":88.243,"end":92.37,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-008-p01","sourceId":"b4-034-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"Parents would be greatly surprised and deeply touched if they realized how much belief their children usually have in their character and infallibility,","start":93.68,"end":103.59,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-008-p02","sourceId":"b4-034-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[23,32],"wordModel":"mms-fa","text":"and how much this faith means to a child.","start":104.38,"end":106.92,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-009-p01","sourceId":"b4-034-009","sourceIndex":8,"part":1,"parts":3,"wordRange":[0,8],"wordModel":"mms-fa","text":"If parents were prepared for this adolescent reaction,","start":108.08,"end":111.25,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-009-p02","sourceId":"b4-034-009","sourceIndex":8,"part":2,"parts":3,"wordRange":[8,29],"wordModel":"mms-fa","text":"and realized that was a sign that the child was growing up and developing valuable powers of observation and independent judgment,","start":111.7,"end":120.05,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-009-p03","sourceId":"b4-034-009","sourceIndex":8,"part":3,"parts":3,"wordRange":[29,49],"wordModel":"mms-fa","text":"they would not be so hurt, and therefore would not drive the child into opposition by resenting and resisting it.","start":120.62,"end":128.17,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-010-p01","sourceId":"b4-034-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"The adolescent, with his passion for sincerity, always respects a parent who admits that he is wrong,","start":129.3,"end":136.26,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-010-p02","sourceId":"b4-034-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[17,28],"wordModel":"mms-fa","text":"or ignorant, or even that he has been unfair or unjust.","start":136.55,"end":141.44,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-011","sourceId":"b4-034-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"What the child cannot forgive is the parents' refusal to admit these charges if the child knows them to be true.","start":142.36,"end":149.55,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-012-p01","sourceId":"b4-034-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"mms-fa","text":"Victorian parents believed that they kept their dignity by retreating behind an unreasoning authoritarian attitude in fact they did nothing of the kind,","start":151.05,"end":162.84,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-012-p02","sourceId":"b4-034-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[23,37],"wordModel":"mms-fa","text":"but children were then too cowed to let them know how they really felt.","start":163.36,"end":168.1,"score":0.934,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-013-p01","sourceId":"b4-034-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Today we tend to go to the other extreme,","start":168.97,"end":171.92,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-013-p02","sourceId":"b4-034-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[9,25],"wordModel":"mms-fa","text":"but on the whole this is a healthier attitude both for the child and the parent.","start":172.503,"end":177.58,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-034-014","sourceId":"b4-034-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"It is always wiser and safer to face up to reality, however painful it may be at the moment.","start":178.44,"end":185.46,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
