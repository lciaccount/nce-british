89-003-p01","sourceId":"b2-089-003","sourceIndex":2,"part":1,"parts":3,"wordRange":[0,5],"wordModel":"mms-fa","text":"When the news got round","start":27.62,"end":29.22,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-003-p02","sourceId":"b2-089-003","sourceIndex":2,"part":2,"parts":3,"wordRange":[5,24],"wordModel":"mms-fa","text":"that a comedy show would be presented at our local cinema by the P. and U. Bird Seed Company,","start":29.34,"end":36.32,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-003-p03","sourceId":"b2-089-003","sourceIndex":2,"part":3,"parts":3,"wordRange":[24,30],"wordModel":"mms-fa","text":"we all rushed to see it.","start":37.58,"end":39.33,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-004","sourceId":"b2-089-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"We had to queue for hours to get in and there must have been several hundred people present just before the show began.","start":40.51,"end":48.8,"score":0.94,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b2-089-005","sourceId":"b2-089-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Unfortunately, the show was one of the dullest we have ever seen.","start":50.38,"end":54.94,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-006","sourceId":"b2-089-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Those who failed to get in need not have felt disappointed, as many of the artistes who should have appeared did not come.","start":55.9,"end":64.57,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-007","sourceId":"b2-089-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The only funny things we heard that evening came from the advertiser at the beginning of the programme.","start":65.74,"end":72.02,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-008","sourceId":"b2-089-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"He was obviously very nervous and for some minutes stood awkwardly before the microphone.","start":73.3,"end":80.08,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-009","sourceId":"b2-089-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"As soon as he opened his mouth, everyone burst out laughing.","start":81.47,"end":85.95,"score":0.923,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-010-p01","sourceId":"b2-089-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"We all know what the poor man should have said, but what he actually said was:","start":87.81,"end":93.87,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-010-p02","sourceId":"b2-089-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[16,25],"wordModel":"mms-fa","text":"'This is the Poo and Ee Seed Bird Company.","start":95.02,"end":98.6,"score":0.7,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-089-011","sourceId":"b2-089-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"Good ladies, evening and gentlemen!'","start":99.66,"end":101.77,"score":0.971,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
