view":false,"reviewReasons":[]},{"id":"b2-055-006","sourceId":"b2-055-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Armed with the new machine, a search party went into the cave hoping to find buried treasure.","start":49.63,"end":56.88,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-007-p01","sourceId":"b2-055-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"The leader of the party was examining the soil near the entrance to the cave","start":58.41,"end":63.14,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-007-p02","sourceId":"b2-055-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[15,26],"wordModel":"english-ctc-fallback","text":"when the machine showed that there was gold under the ground.","start":63.99,"end":67.73,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-008","sourceId":"b2-055-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Very excited, the party dug a hole two feet deep.","start":69.16,"end":73.77,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-009","sourceId":"b2-055-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"They finally found a small gold coin which was almost worthless.","start":75.52,"end":79.66,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-010","sourceId":"b2-055-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"The party then searched the whole cave thoroughly but did not find anything except an empty tin trunk.","start":81.2,"end":88.72,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-055-011","sourceId":"b2-055-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"In spite of this, many people are confident that 'The Revealer' may reveal something of value fairly soon.","start":89.88,"end":98.23,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
