":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"What was the joke?","start":13.65,"end":15.21,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-002","sourceId":"b2-076-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"english-ctc-fallback","text":"'To end our special news bulletin,' said the voice of the television announcer, 'we're going over to the macaroni fields of Calabria.","start":17.86,"end":28.583,"score":0.956,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-076-003","sourceId":"b2-076-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"Macaroni has been grown in this area for over six hundred years.","start":29.66,"end":35.37,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-004-p01","sourceId":"b2-076-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Two of the leading growers Giuseppe Moldova and Riccardo Brabante,","start":36.14,"end":42.31,"score":0.912,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-004-p02","sourceId":"b2-076-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[10,29],"wordModel":"mms-fa","text":"tell me that they have been expecting a splendid crop this year and harvesting has begun earlier than usual.","start":43.0,"end":51.23,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-005","sourceId":"b2-076-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Here you can see two workers who, between them, have just finished cutting three cartloads of golden brown macaroni stalks.","start":52.53,"end":63.49,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-006","sourceId":"b2-076-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The whole village has been working day and night gathering and threshing this year's crop before the September rains.","start":64.842,"end":73.55,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-007","sourceId":"b2-076-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"On the right, you can see Mrs. Brabante herself.","start":74.47,"end":78.69,"score":0.913,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-008","sourceId":"b2-076-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"She has been helping her husband for thirty years now.","start":79.4,"end":83.31,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-009","sourceId":"b2-076-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Mrs. Brabante is talking to the manager of the local factory where the crop is processed.","start":84.4,"end":91.06,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-010","sourceId":"b2-076-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"This last scene shows you what will happen at the end of the harvest: the famous Calabrian macaroni-eating competition!","start":92.64,"end":102.56,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-011","sourceId":"b2-076-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"Signor Fratelli, the present champion, has won it every year since 1991.","start":103.84,"end":111.063,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-076-012","text":"And that ends our special bulletin for today, Thursday, April 1st.","start":112.373,"end":118.343,"score":0.911,"timingValid":true,"needsReview":true,"sourceId":"b2-076-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"legacy-review","reviewReasons":["unresolved-word-alignment"]},{"id":"b2-076-013","sourceId":"b2-076-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"We're now going back to the studio.'","start":119.38,"end":121.76,"score":0.992,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
