text":"become","offset":151,"start":157.343,"end":157.762,"score":1.0},{"text":"a","offset":158,"start":157.903,"end":157.922,"score":0.998},{"text":"bird.","offset":160,"start":158.023,"end":158.362,"score":0.835}],[{"text":"And","offset":0,"start":159.502,"end":159.622,"score":0.997},{"text":"so","offset":4,"start":159.702,"end":159.802,"score":0.999},{"text":"with","offset":7,"start":159.942,"end":160.102,"score":0.985},{"text":"solids","offset":12,"start":160.162,"end":160.582,"score":0.996},{"text":"such","offset":19,"start":161.142,"end":161.342,"score":1.0},{"text":"as","offset":24,"start":161.422,"end":161.582,"score":0.998},{"text":"a","offset":27,"start":161.903,"end":161.922,"score":0.998},{"text":"shell,","offset":29,"start":162.062,"end":162.362,"score":0.941},{"text":"a","offset":36,"start":163.042,"end":163.062,"score":0.997},{"text":"nut,","offset":38,"start":163.202,"end":163.462,"score":0.692},{"text":"a","offset":43,"start":164.023,"end":164.042,"score":0.997},{"text":"plum,","offset":45,"start":164.142,"end":164.462,"score":0.993},{"text":"a","offset":51,"start":165.123,"end":165.142,"score":0.995},{"text":"pear,","offset":53,"start":165.282,"end":165.622,"score":0.499},{"text":"a","offset":59,"start":166.243,"end":166.262,"score":0.997},{"text":"tadpole,","offset":61,"start":166.382,"end":166.982,"score":0.866},{"text":"a","offset":70,"start":167.542,"end":167.562,"score":0.997},{"text":"mushroom,","offset":72,"start":167.702,"end":168.162,"score":0.875},{"text":"a","offset":82,"start":168.782,"end":168.802,"score":0.998},{"text":"mountain","offset":84,"start":168.922,"end":169.302,"score":0.99},{"text":"peak,","offset":93,"start":169.382,"end":169.642,"score":0.992},{"text":"a","offset":99,"start":170.363,"end":170.382,"score":0.998},{"text":"kidney,","offset":101,"start":170.542,"end":170.902,"score":0.866},{"text":"a","offset":109,"start":171.623,"end":171.642,"score":0.998},{"text":"carrot,","offset":111,"start":171.822,"end":172.222,"score":0.741},{"text":"a","offset":119,"start":172.903,"end":172.922,"score":0.998},{"text":"tree-trunk,","offset":121,"start":173.023,"end":173.602,"score":0.971},{"text":"a","offset":133,"start":174.222,"end":174.242,"score":0.997},{"text":"bird,","offset":135,"start":174.442,"end":174.882,"score":0.925},{"text":"a","offset":141,"start":175.542,"end":175.562,"score":0.996},{"text":"bud,","offset":143,"start":175.743,"end":176.082,"score":0.968},{"text":"a","offset":148,"start":176.982,"end":177.002,"score":0.997},{"text":"lark,","offset":150,"start":177.142,"end":177.522,"score":0.525},{"text":"a","offset":156,"start":178.343,"end":178.362,"score":0.997},{"text":"ladybird,","offset":158,"start":178.502,"end":179.062,"score":0.956},{"text":"a","offset":168,"start":179.762,"end":179.782,"score":0.997},{"text":"bulrush,","offset":170,"start":179.923,"end":180.422,"score":0.834},{"text":"a","offset":179,"start":181.042,"end":181.062,"score":0.895},{"text":"bone.","offset":181,"start":181.222,"end":181.602,"score":0.949}],[{"text":"From","offset":0,"start":182.683,"end":182.862,"score":0.963},{"text":"these","offset":5,"start":182.963,"end":183.342,"score":0.953},{"text":"he","offset":11,"start":183.762,"end":183.822,"score":0.997},{"text":"can","offset":14,"start":183.882,"end":184.022,"score":0.999},{"text":"go","offset":18,"start":184.062,"end":184.122,"score":0.997},{"text":"on","offset":21,"start":184.222,"end":184.322,"score":0.997},{"text":"to","offset":24,"start":184.382,"end":184.482,"score":0.996},{"text":"appreciate","offset":27,"start":184.623,"end":185.262,"score":0.981},{"text":"more","offset":38,"start":185.542,"end":185.722,"score":0.99},{"text":"complex","offset":43,"start":185.803,"end":186.182,"score":0.986},{"text":"forms","offset":51,"start":186.322,"end":186.742,"score":0.997},{"text":"or","offset":57,"start":187.042,"end":187.122,"score":0.997},{"text":"combinations","offset":60,"start":187.222,"end":187.962,"score":0.998},{"text":"of","offset":73,"start":188.262,"end":188.342,"score":0.998},{"text":"several","offset":76,"start":188.482,"end":188.802,"score":0.999},{"text":"forms.","offset":84,"start":188.882,"end":189.322,"score":0.998}]],"cues":[{"id":"b4-031-001","sourceId":"b4-031-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"What do you have to be able to do to appreciate sculpture?","start":11.62,"end":15.5,"score":0.898,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-002","sourceId":"b4-031-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Appreciation of sculpture depends upon the ability to respond to form in 3 dimensions.","start":18.18,"end":23.94,"score":0.874,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-003-p01","sourceId":"b4-031-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"That is perhaps why sculpture has been described as the most difficult of all arts;","start":24.82,"end":30.22,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-003-p02","sourceId":"b4-031-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[15,34],"wordModel":"mms-fa","text":"certainly it is more difficult than the arts which involve appreciation of flat forms, shape in only two dimensions.","start":31.12,"end":39.54,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-004","sourceId":"b4-031-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Many more people are 'form-blind' than colour-blind.","start":40.72,"end":44.78,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-005","sourceId":"b4-031-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The child learning to see, first distinguishes only two-dimensional shape; it cannot judge distances, depths.","start":45.66,"end":55.3,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-006-p01","sourceId":"b4-031-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"Later, for its personal safety and practical needs,","start":56.23,"end":59.88,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-006-p02","sourceId":"b4-031-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"mms-fa","text":"it has to develop (partly by means of touch) the ability to judge roughly 3-dimensonal distances.","start":60.32,"end":67.43,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-007","sourceId":"b4-031-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"But having satisfied the requirements of practical necessity, most people go no further.","start":68.282,"end":73.78,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-008-p01","sourceId":"b4-031-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"Though they may attain considerable accuracy in the perception of flat form,","start":74.71,"end":79.49,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-008-p02","sourceId":"b4-031-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[12,31],"wordModel":"mms-fa","text":"they do not make the further intellectual and emotional effort needed to comprehend form in its full spatial existence.","start":80.25,"end":88.06,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-009","sourceId":"b4-031-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This is what the sculptor must do.","start":89.342,"end":91.51,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-010","sourceId":"b4-031-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"He must strive continually to think of and use, form in its full spatial completeness.","start":92.14,"end":98.56,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-011-p01","sourceId":"b4-031-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"He gets the solid shape as it were, inside his head--he thinks of it, whatever its size,","start":99.6,"end":106.18,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-011-p02","sourceId":"b4-031-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[17,31],"wordModel":"mms-fa","text":"as if he were holding it completely enclosed in the hollow of his hand.","start":106.56,"end":110.42,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-012-p01","sourceId":"b4-031-012","sourceIndex":11,"part":1,"parts":4,"wordRange":[0,10],"wordModel":"mms-fa","text":"He mentally visualizes a complex form from all round itself;","start":111.163,"end":116.21,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-012-p02","sourceId":"b4-031-012","sourceIndex":11,"part":2,"parts":4,"wordRange":[10,24],"wordModel":"mms-fa","text":"he knows while he looks at one side what the other side is like;","start":117.32,"end":121.1,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-012-p03","sourceId":"b4-031-012","sourceIndex":11,"part":3,"parts":4,"wordRange":[24,36],"wordModel":"mms-fa","text":"he identifies himself with its centre of gravity, its mass, its weight;","start":121.9,"end":127.48,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-012-p04","sourceId":"b4-031-012","sourceIndex":11,"part":4,"parts":4,"wordRange":[36,50],"wordModel":"mms-fa","text":"he realizes its volume as the space that the shape displaces in the air.","start":128.1,"end":133.61,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-013","sourceId":"b4-031-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"And the sensitive observer of sculpture must also learn to feel shape simply as shape, not as description or reminiscence.","start":135.86,"end":144.96,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-014-p01","sourceId":"b4-031-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"He must, for example, perceive an egg as a simple single solid shape quite apart from its significance as food,","start":146.0,"end":153.83,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-014-p02","sourceId":"b4-031-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[20,31],"wordModel":"mms-fa","text":"or from the literary idea that it will become a bird.","start":154.34,"end":158.44,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-015-p01","sourceId":"b4-031-015","sourceIndex":14,"part":1,"parts":3,"wordRange":[0,18],"wordModel":"mms-fa","text":"And so with solids such as a shell, a nut, a plum, a pear, a tadpole, a mushroom,","start":159.44,"end":168.27,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-015-p02","sourceId":"b4-031-015","sourceIndex":14,"part":2,"parts":3,"wordRange":[18,29],"wordModel":"mms-fa","text":"a mountain peak, a kidney, a carrot, a tree-trunk, a bird,","start":168.72,"end":174.96,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-015-p03","sourceId":"b4-031-015","sourceIndex":14,"part":3,"parts":3,"wordRange":[29,39],"wordModel":"mms-fa","text":"a bud, a lark, a ladybird, a bulrush, a bone.","start":175.48,"end":181.7,"score":0.911,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-031-016","sourceId":"b4-031-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"From these he can go on to appreciate more complex forms or combinations of several forms.","start":182.62,"end":189.4,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
