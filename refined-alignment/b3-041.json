"offset":133,"start":203.303,"end":203.362,"score":0.998},{"text":"work","offset":136,"start":203.422,"end":203.642,"score":1.0},{"text":"every","offset":141,"start":203.762,"end":203.982,"score":1.0},{"text":"day","offset":147,"start":204.042,"end":204.282,"score":1.0},{"text":"are","offset":151,"start":204.683,"end":204.802,"score":0.999},{"text":"tucked","offset":155,"start":204.863,"end":205.142,"score":0.985},{"text":"away","offset":162,"start":205.202,"end":205.462,"score":0.999},{"text":"in","offset":167,"start":205.542,"end":205.602,"score":0.934},{"text":"their","offset":170,"start":205.602,"end":205.722,"score":0.61},{"text":"homes","offset":176,"start":205.782,"end":206.162,"score":0.968},{"text":"in","offset":182,"start":206.202,"end":206.262,"score":0.999},{"text":"the","offset":185,"start":206.282,"end":206.362,"score":0.993},{"text":"country.","offset":189,"start":206.403,"end":206.722,"score":1.0}],[{"text":"It","offset":0,"start":207.743,"end":207.802,"score":0.998},{"text":"has","offset":3,"start":207.822,"end":207.902,"score":0.99},{"text":"always","offset":7,"start":207.963,"end":208.202,"score":0.997},{"text":"been","offset":14,"start":208.243,"end":208.382,"score":0.998},{"text":"a","offset":19,"start":208.403,"end":208.422,"score":0.996},{"text":"mystery","offset":21,"start":208.523,"end":208.842,"score":0.843},{"text":"to","offset":29,"start":208.903,"end":208.962,"score":0.999},{"text":"me","offset":32,"start":209.023,"end":209.102,"score":1.0},{"text":"why","offset":35,"start":209.702,"end":209.862,"score":0.997},{"text":"city","offset":39,"start":210.102,"end":210.302,"score":1.0},{"text":"dwellers,","offset":44,"start":210.382,"end":210.822,"score":0.981},{"text":"who","offset":54,"start":211.202,"end":211.302,"score":0.965},{"text":"appreciate","offset":58,"start":211.363,"end":211.942,"score":0.988},{"text":"all","offset":69,"start":212.102,"end":212.242,"score":0.999},{"text":"these","offset":73,"start":212.303,"end":212.542,"score":1.0},{"text":"things,","offset":79,"start":212.583,"end":212.982,"score":0.958},{"text":"obstinately","offset":87,"start":213.642,"end":214.182,"score":0.969},{"text":"pretend","offset":99,"start":214.243,"end":214.682,"score":0.999},{"text":"that","offset":107,"start":215.042,"end":215.182,"score":0.998},{"text":"they","offset":112,"start":215.202,"end":215.322,"score":0.997},{"text":"would","offset":117,"start":215.343,"end":215.502,"score":0.996},{"text":"prefer","offset":123,"start":215.583,"end":216.042,"score":0.996},{"text":"to","offset":130,"start":216.262,"end":216.342,"score":0.999},{"text":"live","offset":133,"start":216.463,"end":216.722,"score":1.0},{"text":"in","offset":138,"start":216.963,"end":217.022,"score":0.999},{"text":"the","offset":141,"start":217.042,"end":217.142,"score":0.946},{"text":"country.","offset":145,"start":217.183,"end":217.502,"score":1.0}]],"cues":[{"id":"b3-041-001","sourceId":"b3-041-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What particular anxiety spoils the country dweller's visit to the theatre?","start":12.99,"end":17.7,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-002","sourceId":"b3-041-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"The quiet life of the country has never appealed to me.","start":20.34,"end":23.85,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-003-p01","sourceId":"b3-041-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"City born and city bred, I have always regarded the country as something you look at through a train window,","start":24.46,"end":30.51,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-003-p02","sourceId":"b3-041-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[20,28],"wordModel":"mms-fa","text":"or something you occasionally visit during the weekend.","start":30.9,"end":33.99,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-004","sourceId":"b3-041-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Most of my friends live in the city, yet they always go into raptures at the mere mention of the country.","start":34.7,"end":40.88,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-005-p01","sourceId":"b3-041-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"Though they extol the virtues of the peaceful life,","start":41.39,"end":44.55,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-005-p02","sourceId":"b3-041-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[9,30],"wordModel":"mms-fa","text":"only one of them has ever gone to live in the country and he was back in town within six months.","start":44.97,"end":50.74,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-006","sourceId":"b3-041-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Even he still lives under the illusion that country life is somehow superior to town life.","start":51.33,"end":56.74,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-007","sourceId":"b3-041-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"english-ctc-fallback","text":"He is forever talking about the friendly people, the clean atmosphere, the closeness to nature and the gentle pace of living.","start":57.27,"end":66.09,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-008-p01","sourceId":"b3-041-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"Nothing can be compared, he maintains, with the first cockcrow,","start":66.91,"end":70.89,"score":0.924,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-008-p02","sourceId":"b3-041-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[10,28],"wordModel":"mms-fa","text":"the twittering of birds at dawn, the sight of the rising sun glinting on the trees and pastures.","start":72.08,"end":78.85,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-009","sourceId":"b3-041-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"This idyllic pastoral scene is only part of the picture.","start":79.81,"end":83.62,"score":0.881,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-010","sourceId":"b3-041-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"My friend fails to mention the long and friendless winter evenings in front of the TV--virtually the only form of entertainment.","start":84.5,"end":93.04,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-011-p01","sourceId":"b3-041-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"He says nothing about the poor selection of goods in the shops,","start":93.76,"end":97.15,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-011-p02","sourceId":"b3-041-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[12,33],"wordModel":"mms-fa","text":"or about those unfortunate people who have to travel from the country to the city every day to get to work.","start":97.74,"end":103.84,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-012","sourceId":"b3-041-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Why people are prepared to tolerate a four-hour journey each day for the dubious privilege of living in the country is beyond me.","start":104.9,"end":112.97,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-013","sourceId":"b3-041-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"They could be saved so much misery and expense if they chose to live in the city where they rightly belong.","start":113.72,"end":119.83,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-014-p01","sourceId":"b3-041-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"If you can do without the few pastoral pleasures of the country,","start":121.08,"end":124.33,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-014-p02","sourceId":"b3-041-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[12,27],"wordModel":"mms-fa","text":"you will find the city can provide you with the best that life can offer.","start":124.8,"end":128.44,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-015","sourceId":"b3-041-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"You never have to travel miles to see your friends.","start":129.18,"end":131.8,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-016","sourceId":"b3-041-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"They invariably live nearby and are always available for an informal chat or an evening's entertainment.","start":132.2,"end":139.28,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-017","sourceId":"b3-041-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"Some of my acquaintances in the country come up to town once or twice a year to visit the theatre as a special treat.","start":140.1,"end":146.9,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-018","sourceId":"b3-041-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"For them this is a major operation which involves considerable planning.","start":147.48,"end":152.35,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-019","sourceId":"b3-041-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"As the play draws to its close, they wonder whether they will ever catch that last train home.","start":153.21,"end":158.91,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-020","sourceId":"b3-041-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"The city dweller never experiences anxieties of this sort.","start":159.68,"end":163.2,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-021","sourceId":"b3-041-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The latest exhibitions, films, or plays are only a short bus ride away.","start":163.88,"end":168.94,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-022","sourceId":"b3-041-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Shopping, too, is always a pleasure.","start":169.57,"end":171.64,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-023","sourceId":"b3-041-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"There is so much variety that you never have to make do with second best.","start":172.47,"end":176.83,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-024","sourceId":"b3-041-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,26],"wordModel":"mms-fa","text":"Country people run wild when they go shopping in the city and stagger home loaded with as many of the exotic items as they can carry.","start":177.42,"end":185.52,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-025","sourceId":"b3-041-025","sourceIndex":24,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Nor is the city without its moments of beauty.","start":186.02,"end":188.3,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-026","sourceId":"b3-041-026","sourceIndex":25,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"There is something comforting about the warm glow shed by advertisements on cold wet winter nights.","start":188.8,"end":194.68,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-027-p01","sourceId":"b3-041-027","sourceIndex":26,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Few things could be more impressive than the peace that descends on deserted city streets at weekends","start":195.42,"end":201.28,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-027-p02","sourceId":"b3-041-027","sourceIndex":26,"part":2,"parts":2,"wordRange":[17,35],"wordModel":"mms-fa","text":"when the thousands that travel to work every day are tucked away in their homes in the country.","start":201.8,"end":206.98,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-028-p01","sourceId":"b3-041-028","sourceIndex":27,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"It has always been a mystery to me why city dwellers, who appreciate all these things,","start":207.68,"end":213.06,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-041-028-p02","sourceId":"b3-041-028","sourceIndex":27,"part":2,"parts":2,"wordRange":[16,27],"wordModel":"mms-fa","text":"obstinately pretend that they would prefer to live in the country.","start":213.55,"end":217.66,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
