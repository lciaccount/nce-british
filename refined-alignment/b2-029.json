asons":[]},{"id":"b2-029-004","sourceId":"b2-029-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"This wonderful plane can carry seven passengers.","start":39.14,"end":43.16,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-005","sourceId":"b2-029-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"The most surprising thing about it, however, is that it can land anywhere: on snow, water, or even on a ploughed field.","start":44.38,"end":54.9,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-006","sourceId":"b2-029-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Captain Fawcett's first passenger was a doctor who flew from Birmingham to a lonely village in the Welsh mountains.","start":57.0,"end":66.14,"score":0.902,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-007","sourceId":"b2-029-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Since then, Captain Fawcett has flown passengers to many unusual places.","start":67.72,"end":73.06,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-008","sourceId":"b2-029-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Once he landed on the roof of a block of flats and on another occasion, he landed in a deserted car park.","start":74.26,"end":82.84,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-009","sourceId":"b2-029-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Captain Fawcett has just refused a strange request from a businessman.","start":84.48,"end":89.96,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-010-p01","sourceId":"b2-029-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,14],"wordModel":"mms-fa","text":"The man wanted to fly to Rockall, a lonely island in the Atlantic Ocean,","start":91.3,"end":96.97,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-029-010-p02","sourceId":"b2-029-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[14,27],"wordModel":"mms-fa","text":"but Captain Fawcett did not take him because the trip was too dangerous.","start":98.24,"end":103.11,"score":0.921,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
