"end":139.862,"score":0.823},{"text":"that","offset":128,"start":140.303,"end":140.462,"score":0.981},{"text":"what","offset":133,"start":140.683,"end":140.842,"score":0.974},{"text":"was","offset":138,"start":140.903,"end":141.042,"score":0.998},{"text":"possible","offset":142,"start":141.123,"end":141.562,"score":0.993},{"text":"has","offset":151,"start":142.002,"end":142.262,"score":0.998},{"text":"been","offset":155,"start":142.343,"end":142.522,"score":0.999},{"text":"done.","offset":160,"start":142.602,"end":142.902,"score":0.999}]],"cues":[{"id":"b4-011-001","sourceId":"b4-011-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"What, according to the author, is the best way to overcome the fear of death as you get older?","start":12.91,"end":19.79,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-002","sourceId":"b4-011-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Some old people are oppressed by the fear of death.","start":22.46,"end":25.88,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-003","sourceId":"b4-011-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"In the young there is a justification for this feeling.","start":27.19,"end":30.23,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-004-p01","sourceId":"b4-011-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"Young men who have reason to fear that they will be killed in battle may justifiably feel bitter in the thought","start":31.022,"end":38.143,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-004-p02","sourceId":"b4-011-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[21,35],"wordModel":"mms-fa","text":"that they have been cheated of the best things that life has to offer.","start":38.22,"end":41.94,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-005-p01","sourceId":"b4-011-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"But in an old man who has known human joys and sorrows,","start":43.023,"end":47.59,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-005-p02","sourceId":"b4-011-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[12,32],"wordModel":"mms-fa","text":"and has achieved whatever work it was in him to do, the fear of death is somewhat abject and ignoble.","start":47.803,"end":55.89,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-006-p01","sourceId":"b4-011-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"mms-fa","text":"The best way to overcome it--so at least it seems to me-- is to make your interests gradually wider and more impersonal,","start":57.32,"end":66.48,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-006-p02","sourceId":"b4-011-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[22,42],"wordModel":"mms-fa","text":"until bit by bit the walls of the ego recede, and your life becomes increasingly merged in the universal life.","start":66.98,"end":76.25,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-007-p01","sourceId":"b4-011-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"An individual human existence should be like a river-- small at first,","start":77.74,"end":83.2,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-007-p02","sourceId":"b4-011-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[12,25],"wordModel":"mms-fa","text":"narrowly contained within its banks, and rushing passionately past boulders and over waterfalls.","start":83.9,"end":90.64,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-008-p01","sourceId":"b4-011-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"Gradually the river grows wider, the banks recede, the waters flow more quietly, and in the end,","start":92.28,"end":100.4,"score":0.863,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-008-p02","sourceId":"b4-011-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[17,32],"wordModel":"mms-fa","text":"without any visiblebreak, they become merged in the sea, and painlessly lose their individual being.","start":100.66,"end":108.42,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-009-p01","sourceId":"b4-011-009","sourceIndex":8,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"The man who, in old age can see his life in this way,","start":109.57,"end":114.2,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-009-p02","sourceId":"b4-011-009","sourceIndex":8,"part":2,"parts":2,"wordRange":[13,29],"wordModel":"mms-fa","text":"will not suffer from the fear of death, since the things he cares for will continue.","start":114.64,"end":120.48,"score":0.935,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-010","sourceId":"b4-011-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"And if, with the decay of vitality, weariness increases, the thought of rest will be not unwelcome.","start":121.78,"end":129.51,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-011-p01","sourceId":"b4-011-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,21],"wordModel":"mms-fa","text":"I should wish to die while still at work, knowing that others will carry on what I can no longer do,","start":130.9,"end":137.66,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-011-011-p02","sourceId":"b4-011-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[21,33],"wordModel":"mms-fa","text":"and content in the thought that what was possible has been done.","start":138.4,"end":143.05,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
