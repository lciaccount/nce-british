ge":[0,8],"wordModel":"mms-fa","text":"Did George get anything for his fifty pence?","start":12.79,"end":15.72,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-002","sourceId":"b3-015-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,1],"wordModel":"mms-fa","text":"What?","start":16.6,"end":17.1,"score":0.842,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-003","sourceId":"b3-015-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"Children always appreciate small gifts of money.","start":19.66,"end":22.4,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-004","sourceId":"b3-015-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"Mum or dad, of course, provides a regular supply of pocket money, but uncles and aunts are always a source of extra income.","start":23.3,"end":31.85,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-005","sourceId":"b3-015-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"With some children, small sums go a long way.","start":33.22,"end":36.69,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-006","sourceId":"b3-015-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"If fifty pence pieces are not exchanged for sweets, they rattle for months inside money boxes.","start":37.97,"end":44.3,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-007","sourceId":"b3-015-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Only very thrifty children manage to fill up a money box.","start":45.24,"end":48.67,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-008","sourceId":"b3-015-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"For most of them, fifty pence is a small price to pay for a nice big bar of chocolate.","start":49.52,"end":54.58,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-009","sourceId":"b3-015-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"My nephew, George, has a money box but it is always empty.","start":56.0,"end":60.68,"score":0.95,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-010","sourceId":"b3-015-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Very few of the fifty pence pieces and pound coins I have given him have found their way there.","start":61.81,"end":67.72,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-011","sourceId":"b3-015-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"I gave him fifty pence yesterday and advised him to save it.","start":68.82,"end":72.9,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-012","sourceId":"b3-015-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Instead, he bought himself fifty pence worth of trouble.","start":73.73,"end":77.16,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-013-p01","sourceId":"b3-015-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"On his way to the sweet shop,","start":78.3,"end":79.76,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-013-p02","sourceId":"b3-015-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[7,24],"wordModel":"mms-fa","text":"he dropped his fifty pence and it bounced along the pavement and then disappeared down a drain.","start":80.22,"end":87.14,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-014","sourceId":"b3-015-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"George took off his jacket, rolled up his sleeves and pushed his right arm through the drain cover.","start":88.02,"end":94.98,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-015","sourceId":"b3-015-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"He could not find his 50 pence piece anywhere, and what is more, he could not get his arm out.","start":96.22,"end":103.14,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-016","sourceId":"b3-015-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"A crowd of people gathered round him and a lady rubbed his arm with soap and butter, but George was firmly stuck.","start":103.81,"end":110.88,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-017","sourceId":"b3-015-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"The fire brigade was called and two fire fighters freed George using a special type of grease.","start":111.82,"end":118.17,"score":0.925,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-015-018-p01","sourceId":"b3-015-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"George was not too upset by his experience","start":119.35,"end":121.78,"score":0.66,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-015-018-p02","sourceId":"b3-015-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[8,29],"wordModel":"mms-fa","text":"because the lady who owns the sweet shop heard about his troubles and rewarded him with a large box of chocolates.","start":122.09,"end":129.86,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
