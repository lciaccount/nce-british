gValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-004","sourceId":"b2-027-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"They were all hungry and the food smelled good.","start":35.1,"end":38.59,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-005","sourceId":"b2-027-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"After a wonderful meal, they told stories and sang songs by the campfire.","start":40.18,"end":46.66,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-006","sourceId":"b2-027-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"But some time later it began to rain.","start":48.16,"end":51.11,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-007","sourceId":"b2-027-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The boys felt tired so they put out the fire and crept into their tent.","start":52.56,"end":58.22,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-008","sourceId":"b2-027-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Their sleeping bags were warm and comfortable, so they all slept soundly.","start":59.82,"end":65.37,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-009","sourceId":"b2-027-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"In the middle of the night, two boys woke up and began shouting.","start":66.86,"end":71.71,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-010","sourceId":"b2-027-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"The tent was full of water!","start":72.4,"end":74.35,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-011","sourceId":"b2-027-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"They all leapt out of their sleeping bags and hurried outside.","start":75.48,"end":79.72,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-012","sourceId":"b2-027-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It was raining heavily and they found that a stream had formed in the field.","start":80.98,"end":86.88,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-027-013","sourceId":"b2-027-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The stream wound its way across the field and then flowed right under their tent!","start":87.59,"end":94.03,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
