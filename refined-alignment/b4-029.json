7},{"text":"bananas","offset":153,"start":155.822,"end":156.442,"score":0.809},{"text":"from","offset":161,"start":156.502,"end":156.642,"score":0.999},{"text":"the","offset":166,"start":156.683,"end":156.762,"score":0.995},{"text":"plantations","offset":170,"start":156.782,"end":157.422,"score":0.999},{"text":"to","offset":182,"start":157.482,"end":157.542,"score":0.995},{"text":"the","offset":185,"start":157.583,"end":157.662,"score":0.991},{"text":"ports;","offset":189,"start":157.722,"end":158.122,"score":0.98},{"text":"giant","offset":196,"start":159.162,"end":159.482,"score":0.429},{"text":"hovercraft","offset":202,"start":159.762,"end":160.362,"score":0.853},{"text":"liners","offset":213,"start":160.422,"end":160.862,"score":0.931},{"text":"could","offset":220,"start":161.322,"end":161.522,"score":0.929},{"text":"span","offset":226,"start":161.583,"end":161.842,"score":0.998},{"text":"the","offset":231,"start":161.882,"end":161.962,"score":0.928},{"text":"Atlantic;","offset":235,"start":162.002,"end":162.462,"score":0.997},{"text":"and","offset":245,"start":163.202,"end":163.322,"score":0.999},{"text":"the","offset":249,"start":163.363,"end":163.442,"score":0.998},{"text":"railway","offset":253,"start":163.623,"end":164.002,"score":0.999},{"text":"of","offset":261,"start":164.102,"end":164.182,"score":0.999},{"text":"the","offset":264,"start":164.222,"end":164.302,"score":0.987},{"text":"future","offset":268,"start":164.363,"end":164.742,"score":0.999},{"text":"may","offset":275,"start":165.183,"end":165.322,"score":0.925},{"text":"well","offset":279,"start":165.442,"end":165.662,"score":0.999},{"text":"be","offset":284,"start":165.762,"end":165.862,"score":1.0},{"text":"the","offset":287,"start":166.363,"end":166.462,"score":0.973},{"text":"'hovertrain',","offset":291,"start":166.602,"end":167.262,"score":0.939},{"text":"riding","offset":305,"start":168.262,"end":168.682,"score":0.976},{"text":"on","offset":312,"start":168.822,"end":168.922,"score":0.999},{"text":"its","offset":315,"start":168.982,"end":169.102,"score":0.997},{"text":"air","offset":319,"start":169.243,"end":169.382,"score":0.871},{"text":"cushion","offset":323,"start":169.482,"end":169.822,"score":0.708},{"text":"over","offset":331,"start":170.202,"end":170.382,"score":0.997},{"text":"a","offset":336,"start":170.463,"end":170.482,"score":0.998},{"text":"single","offset":338,"start":170.623,"end":170.962,"score":0.999},{"text":"rail,","offset":345,"start":171.042,"end":171.362,"score":0.981},{"text":"which","offset":351,"start":171.762,"end":171.942,"score":1.0},{"text":"it","offset":357,"start":171.982,"end":172.082,"score":0.999},{"text":"never","offset":360,"start":172.222,"end":172.482,"score":0.972},{"text":"touches,","offset":366,"start":172.562,"end":173.062,"score":0.97},{"text":"at","offset":375,"start":173.602,"end":173.722,"score":0.999},{"text":"speeds,","offset":378,"start":173.822,"end":174.282,"score":0.998},{"text":"up","offset":386,"start":174.602,"end":174.682,"score":1.0},{"text":"to","offset":389,"start":174.762,"end":174.842,"score":0.999},{"text":"300","offset":392,"start":175.023,"end":175.682,"score":0.445},{"text":"m.p.h.--the","offset":396,"start":175.782,"end":177.342,"score":0.854},{"text":"possibilities","offset":408,"start":177.482,"end":178.322,"score":1.0},{"text":"appear","offset":422,"start":178.743,"end":179.102,"score":0.999},{"text":"unlimited.","offset":429,"start":179.463,"end":180.142,"score":0.899}]],"cues":[{"id":"b4-029-001","sourceId":"b4-029-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What is a hovercraft riding on when it is in motion?","start":11.39,"end":14.94,"score":0.916,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-002","sourceId":"b4-029-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"Many strange new means of transport have been developed in our century, the strangest of them being perhaps the hovercraft.","start":17.462,"end":25.7,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-003-p01","sourceId":"b4-029-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"english-ctc-fallback","text":"In 1953, a former electronics engineer in his fifties, Christopher Cockerell, who had turned to boat-building on the Norfolk Broads,","start":26.84,"end":37.21,"score":0.984,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b4-029-003-p02","sourceId":"b4-029-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[20,39],"wordModel":"english-ctc-fallback","text":"suggested an idea on which he had been working for many years to the British Government and industrial circles.","start":37.783,"end":44.81,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-004-p01","sourceId":"b4-029-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,11],"wordModel":"mms-fa","text":"It was the idea of supporting a craft on a 'pad',","start":45.94,"end":49.8,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-004-p02","sourceId":"b4-029-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[11,24],"wordModel":"mms-fa","text":"or cushion, of low-pressure air, ringed with a curtain of higher pressure air.","start":50.62,"end":56.55,"score":0.884,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-005-p01","sourceId":"b4-029-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Ever since, people have had difficulty in deciding whether the craft should be ranged among ships,","start":57.67,"end":64.39,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-005-p02","sourceId":"b4-029-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[16,30],"wordModel":"mms-fa","text":"planes, or land vehicles--for it is something in between a boat and an aircraft.","start":64.86,"end":71.1,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-006-p01","sourceId":"b4-029-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"As a shipbuilder, Cockerell was trying to find a solution to the problem of the wave resistance","start":72.3,"end":78.42,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-006-p02","sourceId":"b4-029-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[17,31],"wordModel":"mms-fa","text":"which wastes a good deal of a surface ship's power and limits its speed.","start":78.76,"end":83.68,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-007-p01","sourceId":"b4-029-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"His answer was to lift the vessel out of the water by making it ride on a cushion of air,","start":84.66,"end":90.69,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-007-p02","sourceId":"b4-029-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[20,28],"wordModel":"mms-fa","text":"no more than one or two feet thick.","start":91.502,"end":93.97,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-008","sourceId":"b4-029-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"This is done by a great number of ring-shaped air jets on the bottom of the craft.","start":95.01,"end":100.56,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-009","sourceId":"b4-029-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"It 'flies', therefore, but it cannot fly higher--its action depends on the surface, water or ground, over which it rides.","start":101.78,"end":111.78,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-010","sourceId":"b4-029-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"The first tests on the Solent in 1959 caused a sensation.","start":113.69,"end":119.1,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-011","sourceId":"b4-029-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"The hovercraft travelled first over the water, then mounted the beach, climbed up the dunes, and sat down on a road.","start":119.603,"end":128.14,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-012","sourceId":"b4-029-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Later it crossed the Channel, riding smoothly over the waves, which presented no problem.","start":129.05,"end":135.13,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-013","sourceId":"b4-029-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Since that time, various types of hovercraft have appeared and taken up regular service.","start":136.49,"end":142.24,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-014-p01","sourceId":"b4-029-014","sourceIndex":13,"part":1,"parts":4,"wordRange":[0,16],"wordModel":"mms-fa","text":"The hovercraft is particularly useful in large areas with poor communications such as Africa or Australia;","start":143.3,"end":151.74,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-014-p02","sourceId":"b4-029-014","sourceIndex":13,"part":2,"parts":4,"wordRange":[16,37],"wordModel":"mms-fa","text":"it can become a 'flying fruit-bowl', carrying bananas from the plantations to the ports; giant hovercraft liners could span the Atlantic;","start":152.32,"end":162.55,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-014-p03","sourceId":"b4-029-014","sourceIndex":13,"part":3,"parts":4,"wordRange":[37,57],"wordModel":"mms-fa","text":"and the railway of the future may well be the 'hovertrain', riding on its air cushion over a single rail,","start":163.14,"end":171.47,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-029-014-p04","sourceId":"b4-029-014","sourceIndex":13,"part":4,"parts":4,"wordRange":[57,70],"wordModel":"mms-fa","text":"which it never touches, at speeds, up to 300 m.p.h.--the possibilities appear unlimited.","start":171.7,"end":180.22,"score":0.933,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
