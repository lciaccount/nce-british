,"start":136.262,"end":136.322,"score":1.0},{"text":"greater","offset":110,"start":136.423,"end":136.822,"score":0.993},{"text":"than","offset":118,"start":137.142,"end":137.282,"score":0.999},{"text":"the","offset":123,"start":137.322,"end":137.402,"score":0.999},{"text":"total","offset":127,"start":137.523,"end":137.862,"score":1.0},{"text":"weight","offset":133,"start":137.963,"end":138.202,"score":0.708},{"text":"of","offset":140,"start":138.542,"end":138.642,"score":1.0},{"text":"all","offset":143,"start":138.822,"end":138.962,"score":0.989},{"text":"the","offset":147,"start":139.023,"end":139.102,"score":0.999},{"text":"human","offset":151,"start":139.222,"end":139.522,"score":0.998},{"text":"beings","offset":157,"start":139.642,"end":140.042,"score":0.986},{"text":"in","offset":164,"start":140.083,"end":140.142,"score":0.874},{"text":"the","offset":167,"start":140.183,"end":140.242,"score":0.756},{"text":"country.","offset":171,"start":140.303,"end":140.642,"score":0.798}]],"cues":[{"id":"b4-002-001","sourceId":"b4-002-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"How much of each year do spiders spend killing insects?","start":12.42,"end":17.43,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-002","sourceId":"b4-002-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Why, you may wonder, should spiders be our friends?","start":20.07,"end":23.49,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-003","sourceId":"b4-002-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Because they destroy so many insects, and insects include some of the greatest enemies of the human race.","start":24.46,"end":31.36,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-004-p01","sourceId":"b4-002-004","sourceIndex":3,"part":1,"parts":3,"wordRange":[0,12],"wordModel":"mms-fa","text":"Insects would make it impossible for us to live in the world;","start":32.55,"end":36.22,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-004-p02","sourceId":"b4-002-004","sourceIndex":3,"part":2,"parts":3,"wordRange":[12,24],"wordModel":"mms-fa","text":"they would devour all our crops and kill our flocks and herds,","start":37.08,"end":41.35,"score":0.934,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-004-p03","sourceId":"b4-002-004","sourceIndex":3,"part":3,"parts":3,"wordRange":[24,37],"wordModel":"mms-fa","text":"if it were not for the protection we get from insect eating animals.","start":41.94,"end":46.47,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-005-p01","sourceId":"b4-002-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"We owe a lot to the birds and beasts who eat insects","start":47.723,"end":51.89,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-005-p02","sourceId":"b4-002-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[12,28],"wordModel":"mms-fa","text":"but all of them put together kill only a fraction of the number destroyed by spiders.","start":52.19,"end":57.74,"score":0.995,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-006","sourceId":"b4-002-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Moreover, unlike some of the other insect eaters, spiders never do the least harm to us or our belongings.","start":58.71,"end":67.02,"score":0.941,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-007","sourceId":"b4-002-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Spiders are not insects, as many people think, nor even nearly related to them.","start":68.22,"end":74.76,"score":0.922,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-008","sourceId":"b4-002-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"One can tell the difference almost at a glance, for a spider always has eight legs and an insect never more than six.","start":75.89,"end":85.13,"score":0.908,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-009","sourceId":"b4-002-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"How many spiders are engaged in this work on our behalf?","start":86.96,"end":90.29,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-010-p01","sourceId":"b4-002-010","sourceIndex":9,"part":1,"parts":3,"wordRange":[0,19],"wordModel":"mms-fa","text":"One authority on spiders made a census of the spiders in a grass field in the south of England,","start":91.43,"end":97.32,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-010-p02","sourceId":"b4-002-010","sourceIndex":9,"part":2,"parts":3,"wordRange":[19,33],"wordModel":"mms-fa","text":"and he estimated that there were more than 2, 250, 000 in one acre;","start":98.21,"end":104.85,"score":0.689,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-002-010-p03","sourceId":"b4-002-010","sourceIndex":9,"part":3,"parts":3,"wordRange":[33,48],"wordModel":"mms-fa","text":"that is something like 6, 000, 000 spiders of different kinds on a football pitch.","start":105.49,"end":111.25,"score":0.87,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-002-011","sourceId":"b4-002-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Spiders are busy for at least half the year in killing insects.","start":112.35,"end":116.98,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-012-p01","sourceId":"b4-002-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"It is impossible to make more than the wildest guess at how many they kill,","start":118.14,"end":122.79,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-012-p02","sourceId":"b4-002-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[15,28],"wordModel":"mms-fa","text":"but they are hungry creatures, not content with only three meals a day.","start":123.262,"end":128.18,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-002-013","sourceId":"b4-002-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,34],"wordModel":"mms-fa","text":"It has been estimated that the weight of all the insects destroyed by spiders in Britain in one year would be greater than the total weight of all the human beings in the country.","start":128.982,"end":140.77,"score":0.954,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
