,"score":0.999},{"text":"promptly","offset":176,"start":177.562,"end":177.942,"score":0.976},{"text":"bogged","offset":185,"start":178.102,"end":178.422,"score":0.931},{"text":"in","offset":192,"start":178.762,"end":178.842,"score":0.999},{"text":"the","offset":195,"start":178.863,"end":178.942,"score":0.996},{"text":"tar.","offset":199,"start":179.002,"end":179.282,"score":0.976}],[{"text":"And","offset":0,"start":180.243,"end":180.362,"score":0.853},{"text":"then,","offset":4,"start":180.442,"end":180.722,"score":0.986},{"text":"when","offset":10,"start":181.303,"end":181.422,"score":0.996},{"text":"they","offset":15,"start":181.463,"end":181.562,"score":0.997},{"text":"were","offset":20,"start":181.602,"end":181.762,"score":0.994},{"text":"dead,","offset":25,"start":181.843,"end":182.122,"score":0.998},{"text":"the","offset":31,"start":182.762,"end":182.842,"score":0.995},{"text":"carnivores,","offset":35,"start":182.922,"end":183.542,"score":0.538},{"text":"like","offset":47,"start":183.942,"end":184.142,"score":0.996},{"text":"the","offset":52,"start":184.142,"end":184.242,"score":0.859},{"text":"sabretoothed","offset":56,"start":184.463,"end":185.042,"score":0.536},{"text":"cats","offset":69,"start":185.062,"end":185.402,"score":0.997},{"text":"and","offset":74,"start":185.882,"end":185.982,"score":0.939},{"text":"the","offset":78,"start":186.002,"end":186.062,"score":0.991},{"text":"giant","offset":82,"start":186.142,"end":186.462,"score":0.679},{"text":"wolves,","offset":88,"start":186.523,"end":186.942,"score":0.905},{"text":"came","offset":96,"start":187.583,"end":187.802,"score":0.995},{"text":"out","offset":101,"start":187.822,"end":187.942,"score":0.999},{"text":"to","offset":105,"start":187.982,"end":188.042,"score":0.998},{"text":"feed","offset":108,"start":188.142,"end":188.422,"score":1.0},{"text":"and","offset":113,"start":188.762,"end":188.882,"score":0.998},{"text":"suffered","offset":117,"start":188.963,"end":189.262,"score":0.982},{"text":"exactly","offset":126,"start":189.562,"end":190.102,"score":0.978},{"text":"the","offset":134,"start":190.142,"end":190.222,"score":0.998},{"text":"same","offset":138,"start":190.282,"end":190.482,"score":0.96},{"text":"fate.","offset":143,"start":190.523,"end":190.762,"score":0.751}],[{"text":"There","offset":0,"start":191.782,"end":191.922,"score":0.945},{"text":"are","offset":6,"start":191.922,"end":192.022,"score":0.85},{"text":"also","offset":10,"start":192.083,"end":192.322,"score":0.999},{"text":"endless","offset":15,"start":192.523,"end":192.842,"score":0.97},{"text":"numbers","offset":23,"start":192.903,"end":193.202,"score":0.998},{"text":"of","offset":31,"start":193.243,"end":193.322,"score":0.998},{"text":"birds","offset":34,"start":193.403,"end":193.762,"score":0.979},{"text":"in","offset":40,"start":193.803,"end":193.862,"score":0.997},{"text":"the","offset":43,"start":193.903,"end":193.962,"score":0.992},{"text":"tar","offset":47,"start":194.023,"end":194.242,"score":0.693},{"text":"as","offset":51,"start":194.343,"end":194.442,"score":0.998},{"text":"well.","offset":54,"start":194.502,"end":194.762,"score":0.957}]],"cues":[{"id":"b4-026-001","sourceId":"b4-026-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"What is the main condition for the preservation of the remains of any living creature?","start":12.24,"end":17.2,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-002-p01","sourceId":"b4-026-002","sourceIndex":1,"part":1,"parts":4,"wordRange":[0,19],"wordModel":"mms-fa","text":"It is animals and plants which lived in or near water whose remains are most likely to be preserved,","start":19.85,"end":26.44,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-002-p02","sourceId":"b4-026-002","sourceIndex":1,"part":2,"parts":4,"wordRange":[19,30],"wordModel":"mms-fa","text":"for one of the necessary conditions of preservation is quick burial,","start":26.782,"end":31.41,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-002-p03","sourceId":"b4-026-002","sourceIndex":1,"part":3,"parts":4,"wordRange":[30,42],"wordModel":"mms-fa","text":"and it is only in the seas and rivers, and sometimes lakes,","start":32.02,"end":35.84,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-002-p04","sourceId":"b4-026-002","sourceIndex":1,"part":4,"parts":4,"wordRange":[42,62],"wordModel":"mms-fa","text":"where mud and silt have been continuously deposited, that bodies and the like can be rapidly covered over and preserved.","start":36.22,"end":44.08,"score":0.952,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-003","sourceId":"b4-026-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,33],"wordModel":"mms-fa","text":"But even in the most favourable circumstances only a small fraction of the creatures that die are preserved in this way before decay sets in or, even more likely, before scavengers eat them.","start":45.283,"end":58.16,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-004-p01","sourceId":"b4-026-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"After all, all living creatures live by feeding on something else, whether it be plant or animal,","start":59.14,"end":66.22,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-004-p02","sourceId":"b4-026-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[17,32],"wordModel":"mms-fa","text":"dead or alive, and it is only by chance that such a fate is avoided.","start":66.37,"end":71.72,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-005-p01","sourceId":"b4-026-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,15],"wordModel":"mms-fa","text":"The remains of plants and animals that lived on land are much more rarely preserved,","start":72.98,"end":77.92,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-005-p02","sourceId":"b4-026-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[15,24],"wordModel":"mms-fa","text":"for there is seldom anything to cover them over.","start":78.503,"end":81.2,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-006-p01","sourceId":"b4-026-006","sourceIndex":5,"part":1,"parts":3,"wordRange":[0,12],"wordModel":"mms-fa","text":"When you think of the innumerable birds that one sees flying about,","start":82.47,"end":86.32,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-006-p02","sourceId":"b4-026-006","sourceIndex":5,"part":2,"parts":3,"wordRange":[12,30],"wordModel":"mms-fa","text":"not to mention the equally numerous small animals like field mice and voles which you do not see,","start":86.702,"end":93.21,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-006-p03","sourceId":"b4-026-006","sourceIndex":5,"part":3,"parts":3,"wordRange":[30,47],"wordModel":"mms-fa","text":"it is very rarely that one comes across a dead body, except, of course, on the roads.","start":93.862,"end":100.02,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-007","sourceId":"b4-026-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"They decompose and are quickly destroyed by the weather or eaten by some other creature.","start":101.05,"end":107.12,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-008-p01","sourceId":"b4-026-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,22],"wordModel":"mms-fa","text":"It is almost always due to some very special circumstances that traces of land animals survive, as by falling into inaccessible caves,","start":108.443,"end":118.51,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-008-p02","sourceId":"b4-026-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[22,42],"wordModel":"mms-fa","text":"or into an ice crevasse, like the Siberian mammoths, when the whole animal is sometimes preserved, as in a refrigerator.","start":119.25,"end":128.58,"score":0.92,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-009","sourceId":"b4-026-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"This is what happened to the famous Beresovka mammoth which was found preserved and in good condition.","start":129.63,"end":136.13,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-010","sourceId":"b4-026-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,24],"wordModel":"mms-fa","text":"In his mouth were the remains of fir trees--the last meal that he had before he fell into the crevasse and broke his back.","start":137.32,"end":145.04,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-011","sourceId":"b4-026-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The mammoth has now been restored in the Palaeontological Museum in St.Petersburg.","start":145.84,"end":151.32,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-012-p01","sourceId":"b4-026-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"Other animals were trapped in tar pits, like the elephants, sabre-toothed cats,","start":152.47,"end":157.77,"score":0.902,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-012-p02","sourceId":"b4-026-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[12,32],"wordModel":"mms-fa","text":"and numerous other creatures that are found at Rancho la Brea, which is now just a suburb of Los Angeles.","start":157.982,"end":164.94,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-013-p01","sourceId":"b4-026-013","sourceIndex":12,"part":1,"parts":3,"wordRange":[0,11],"wordModel":"mms-fa","text":"Apparently what happened was that water collected on these tar pits","start":165.73,"end":170.03,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-013-p02","sourceId":"b4-026-013","sourceIndex":12,"part":2,"parts":3,"wordRange":[11,28],"wordModel":"mms-fa","text":"and the bigger animals like the elephants ventured out on to the apparently firm surface to drink,","start":170.62,"end":176.46,"score":0.946,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-013-p03","sourceId":"b4-026-013","sourceIndex":12,"part":3,"parts":3,"wordRange":[28,35],"wordModel":"mms-fa","text":"and were promptly bogged in the tar.","start":177.05,"end":179.37,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-014-p01","sourceId":"b4-026-014","sourceIndex":13,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"And then, when they were dead, the carnivores, like the sabretoothed cats and the giant wolves,","start":180.18,"end":187.02,"score":0.891,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-014-p02","sourceId":"b4-026-014","sourceIndex":13,"part":2,"parts":2,"wordRange":[16,26],"wordModel":"mms-fa","text":"came out to feed and suffered exactly the same fate.","start":187.52,"end":190.84,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-026-015","sourceId":"b4-026-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"There are also endless numbers of birds in the tar as well.","start":191.542,"end":194.87,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
