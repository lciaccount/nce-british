ingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-006-p01","sourceId":"b2-014-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"As soon as he had got into the car,","start":41.42,"end":43.87,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-006-p02","sourceId":"b2-014-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[9,24],"wordModel":"mms-fa","text":"I said good morning to him in French and he replied in the same language.","start":44.47,"end":49.95,"score":0.996,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-007","sourceId":"b2-014-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Apart from a few words, I do not know any French at all.","start":51.8,"end":56.27,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-008","sourceId":"b2-014-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"Neither of us spoke during the journey.","start":57.44,"end":59.81,"score":0.928,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-009","sourceId":"b2-014-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"I had nearly reached the town, when the young man suddenly said, very slowly, 'Do you speak English?'","start":61.34,"end":73.41,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-014-010","sourceId":"b2-014-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"As I soon learnt, he was English himself!","start":75.23,"end":79.1,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
