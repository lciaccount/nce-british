nd":164.462,"score":0.998},{"text":"was","offset":71,"start":164.502,"end":164.622,"score":0.996},{"text":"worth","offset":75,"start":164.683,"end":164.882,"score":0.995},{"text":"hundreds","offset":81,"start":164.963,"end":165.402,"score":0.929},{"text":"and","offset":90,"start":165.463,"end":165.582,"score":0.0},{"text":"thousands","offset":94,"start":165.642,"end":166.102,"score":0.947},{"text":"of","offset":104,"start":166.142,"end":166.202,"score":0.962},{"text":"pounds.","offset":107,"start":166.282,"end":166.762,"score":0.914}]],"cues":[{"id":"b3-034-001","sourceId":"b3-034-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"What was the 'happy discovery' ?","start":11.98,"end":14.44,"score":0.759,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-002","sourceId":"b3-034-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Antique shops exert a peculiar fascination on a great many people.","start":17.09,"end":21.95,"score":0.884,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-003","sourceId":"b3-034-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,27],"wordModel":"mms-fa","text":"The more expensive kind of antique shop where rare objects are beautifully displayed in glass cases to keep them free from dust is usually a forbidding place.","start":22.87,"end":33.74,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-004","sourceId":"b3-034-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"But no one has to muster up courage to enter a less pretentious antique shop.","start":34.67,"end":39.86,"score":0.947,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-005-p01","sourceId":"b3-034-005","sourceIndex":4,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"There is always hope that in its labyrinth of musty,","start":40.69,"end":44.01,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-005-p02","sourceId":"b3-034-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[10,29],"wordModel":"mms-fa","text":"dark, disordered rooms a real rarity will be found amongst the piles of assorted junk that litter the floors.","start":44.4,"end":52.16,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-006","sourceId":"b3-034-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"No one discovers a rarity by chance.","start":53.5,"end":56.08,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-007","sourceId":"b3-034-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"mms-fa","text":"A truly dedicated bargain hunter must have patience, and above all, the ability to recognize the worth of something when he sees it.","start":56.75,"end":66.12,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-008","sourceId":"b3-034-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"To do this, he must be at least as knowledgeable as the dealer.","start":67.06,"end":70.97,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-009","sourceId":"b3-034-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Like a scientist bent on making a discovery, he must cherish the hope that one day he will be amply rewarded.","start":71.95,"end":79.68,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-010","sourceId":"b3-034-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"My old friend, Frank Halliday, is just such a person.","start":80.84,"end":84.86,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-011","sourceId":"b3-034-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"He has often described to me how he picked up a masterpiece for a mere ￡50.","start":85.32,"end":90.273,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-012","sourceId":"b3-034-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"One Saturday morning, Frank visited an antique shop in my neighbourhood.","start":90.273,"end":96.44,"score":0.906,"timingValid":true,"needsReview":true,"reviewReasons":["stretched-word"]},{"id":"b3-034-013","sourceId":"b3-034-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"As he had never been there before, he found a great deal to interest him.","start":97.39,"end":101.88,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-014","sourceId":"b3-034-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"The morning passed rapidly and Frank was about to leave when he noticed a large packing case lying on the floor.","start":102.57,"end":109.67,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-015","sourceId":"b3-034-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"The dealer told him that it had just come in, but that he could not be bothered to open it.","start":110.46,"end":115.74,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-016","sourceId":"b3-034-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"english-ctc-fallback","text":"Frank begged him to do so and the dealer reluctantly prised it open.","start":116.53,"end":121.03,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-017","sourceId":"b3-034-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"The contents were disappointing.","start":121.8,"end":123.7,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-018","sourceId":"b3-034-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Apart from an interesting-looking carved dagger, the box was full of crockery, much of it broken.","start":124.21,"end":130.34,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-019","sourceId":"b3-034-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Frank gently lifted the crockery out of the box and suddenly noticed a miniature painting at the bottom of the packing case.","start":130.96,"end":138.94,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-020","sourceId":"b3-034-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"As its composition and line reminded him of an Italian painting he knew well, he decided to buy it.","start":139.68,"end":146.12,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-021","sourceId":"b3-034-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Glancing at it briefly the dealer told him that it was worth ￡50.","start":146.94,"end":151.38,"score":0.962,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-022","sourceId":"b3-034-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Frank could hardly conceal his excitement, for he knew that he had made a real discovery.","start":152.57,"end":158.26,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-034-023","sourceId":"b3-034-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"The tiny painting proved to be an unknown masterpiece by Correggio and was worth hundreds and thousands of pounds.","start":159.03,"end":166.86,"score":0.852,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]}]}
