ewReasons":[]},{"id":"b2-001-008","sourceId":"b2-001-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"I got very angry.","start":40.683,"end":42.4,"score":0.998,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-009","sourceId":"b2-001-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"I could not hear the actors.","start":43.47,"end":45.78,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-010","sourceId":"b2-001-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"I turned round.","start":46.49,"end":48.16,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-011","sourceId":"b2-001-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"I looked at the man and the woman angrily.","start":49.06,"end":52.15,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-012","sourceId":"b2-001-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"They did not pay any attention.","start":53.43,"end":55.63,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-013","sourceId":"b2-001-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"In the end, I could not bear it.","start":56.52,"end":59.53,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-014","sourceId":"b2-001-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"I turned round again.","start":59.79,"end":61.38,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-001-015","sourceId":"b2-001-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"english-ctc-fallback","text":"'I can't hear a word!'","start":62.51,"end":64.66,"score":0.973,"timingVa