0,10],"wordModel":"mms-fa","text":"How does the writer describe sport at the international level?","start":11.77,"end":16.05,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-002-p01","sourceId":"b4-006-002","sourceIndex":1,"part":1,"parts":3,"wordRange":[0,16],"wordModel":"mms-fa","text":"I am always amazed when I hear people saying that sport creates goodwill between the nations,","start":18.72,"end":24.58,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-002-p02","sourceId":"b4-006-002","sourceIndex":1,"part":2,"parts":3,"wordRange":[16,34],"wordModel":"mms-fa","text":"and that if only the common peoples of the world could meet one another at football or cricket,","start":25.26,"end":31.32,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-002-p03","sourceId":"b4-006-002","sourceIndex":1,"part":3,"parts":3,"wordRange":[34,44],"wordModel":"mms-fa","text":"they would have no inclination to meet on the battlefield.","start":31.562,"end":35.26,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-003-p01","sourceId":"b4-006-003","sourceIndex":2,"part":1,"parts":2,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"Even if one didn't know from concrete examples (the 1936 Olympic Games, for instance) that international sporting contests lead to orgies of hatred,","start":36.48,"end":48.4,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-003-p02","sourceId":"b4-006-003","sourceIndex":2,"part":2,"parts":2,"wordRange":[23,30],"wordModel":"english-ctc-fallback","text":"one could deduce it from general principles.","start":49.2,"end":52.29,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-004","sourceId":"b4-006-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"Nearly all the sports practised nowadays are competitive.","start":53.77,"end":57.48,"score":0.973,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-005","sourceId":"b4-006-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"You play to win, and the game has little meaning unless you do your utmost to win.","start":58.39,"end":63.95,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-006-p01","sourceId":"b4-006-006","sourceIndex":5,"part":1,"parts":5,"wordRange":[0,17],"wordModel":"mms-fa","text":"On the village green, where you pick up sides and no feeling of local patriotism is involved,","start":64.82,"end":70.88,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-006-p02","sourceId":"b4-006-006","sourceIndex":5,"part":2,"parts":5,"wordRange":[17,28],"wordModel":"mms-fa","text":"it is possible to play simply for the fun and exercise:","start":71.61,"end":75.48,"score":0.967,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-006-p03","sourceId":"b4-006-006","sourceIndex":5,"part":3,"parts":5,"wordRange":[28,38],"wordModel":"mms-fa","text":"but as soon as a the question of prestige arises,","start":76.34,"end":79.68,"score":0.88,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b4-006-006-p04","sourceId":"b4-006-006","sourceIndex":5,"part":4,"parts":5,"wordRange":[38,55],"wordModel":"mms-fa","text":"as soon as you feel that you and some larger unit will be disgraced if you lose,","start":79.862,"end":85.4,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-006-p05","sourceId":"b4-006-006","sourceIndex":5,"part":5,"parts":5,"wordRange":[55,62],"wordModel":"mms-fa","text":"the most savage combative instincts are aroused.","start":85.862,"end":89.5,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-007","sourceId":"b4-006-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Anyone who has played even in a school football match knows this.","start":90.78,"end":94.82,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-008","sourceId":"b4-006-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"At the international level, sport is frankly mimic warfare.","start":96.07,"end":100.62,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-009-p01","sourceId":"b4-006-009","sourceIndex":8,"part":1,"parts":3,"wordRange":[0,17],"wordModel":"mms-fa","text":"But the significant thing is not the behaviour of the players but the attitude of the spectators:","start":101.383,"end":108.14,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-009-p02","sourceId":"b4-006-009","sourceIndex":8,"part":2,"parts":3,"wordRange":[17,33],"wordModel":"mms-fa","text":"and, behind the spectators, of the nations who work themselves into furies over these absurd contests,","start":108.92,"end":116.67,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-006-009-p03","sourceId":"b4-006-009","sourceIndex":8,"part":3,"parts":3,"wordRange":[33,54],"wordModel":"mms-fa","text":"and seriously believe -- at any rate for short periods -- that running, jumping and kicking a ball are tests of national virtue.","start":117.18,"end":128.07,"score":0.94,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
