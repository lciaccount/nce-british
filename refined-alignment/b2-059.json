27,"end":14.48,"score":0.932,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-002","sourceId":"b2-059-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Our dog, Rex, used to sit outside our front gate and bark.","start":17.22,"end":21.98,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-003","sourceId":"b2-059-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Every time he wanted to come into the garden he would bark until someone opened the gate.","start":23.04,"end":28.71,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-004-p01","sourceId":"b2-059-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,7],"wordModel":"mms-fa","text":"As the neighbours complained of the noise,","start":30.19,"end":32.38,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-004-p02","sourceId":"b2-059-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[7,24],"wordModel":"mms-fa","text":"my husband spent weeks training him to press his paw on the latch to let himself in.","start":32.96,"end":39.86,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-005","sourceId":"b2-059-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Rex soon became an expert at opening the gate.","start":41.34,"end":44.16,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-006","sourceId":"b2-059-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"However, when I was going out shopping last week, I noticed him in the garden near the gate.","start":45.64,"end":52.14,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-007","sourceId":"b2-059-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This time he was barking so that someone would let him out!","start":53.25,"end":56.83,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-008","sourceId":"b2-059-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"Since then, he has developed another bad habit.","start":58.67,"end":62.18,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-009","sourceId":"b2-059-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"As soon as he opens the gate from the outside, he comes into the garden and waits until the gate shuts.","start":63.38,"end":70.32,"score":0.948,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b2-059-010","sourceId":"b2-059-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Then he sits and barks until someone lets him out.","start":71.72,"end":75.03,"score":0.991,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-011","sourceId":"b2-059-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"After this he immediately lets himself in and begins barking again.","start":75.86,"end":80.523,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-059-012","sourceId":"b2-059-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Yesterday my husband removed the gate and Rex got so annoyed we have not seen him since.","start":81.96,"end":88.61,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
