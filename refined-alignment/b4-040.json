":139.542,"score":0.831},{"text":"into","offset":81,"start":139.822,"end":139.982,"score":0.739},{"text":"the","offset":86,"start":140.042,"end":140.122,"score":0.872},{"text":"great","offset":90,"start":140.183,"end":140.442,"score":0.939},{"text":"ocean","offset":96,"start":140.602,"end":140.882,"score":0.723},{"text":"of","offset":102,"start":140.942,"end":141.022,"score":0.974},{"text":"life.","offset":105,"start":141.102,"end":141.402,"score":0.991}],[{"text":"The","offset":0,"start":142.882,"end":142.982,"score":0.972},{"text":"undulating","offset":4,"start":143.202,"end":143.922,"score":0.913},{"text":"waves","offset":15,"start":144.002,"end":144.402,"score":0.956},{"text":"of","offset":21,"start":144.463,"end":144.522,"score":0.999},{"text":"the","offset":24,"start":144.562,"end":144.642,"score":0.929},{"text":"open","offset":28,"start":144.722,"end":144.962,"score":0.998},{"text":"sea","offset":33,"start":145.062,"end":145.262,"score":0.952},{"text":"are","offset":37,"start":145.683,"end":145.822,"score":0.989},{"text":"generated","offset":41,"start":145.903,"end":146.422,"score":0.999},{"text":"by","offset":51,"start":146.482,"end":146.642,"score":0.999},{"text":"three","offset":54,"start":146.743,"end":147.022,"score":0.995},{"text":"natural","offset":60,"start":147.142,"end":147.522,"score":0.989},{"text":"causes:","offset":68,"start":147.583,"end":148.062,"score":0.762},{"text":"wind,","offset":76,"start":149.002,"end":149.362,"score":0.998},{"text":"earth","offset":82,"start":150.202,"end":150.422,"score":0.99},{"text":"movements","offset":88,"start":150.482,"end":150.942,"score":0.972},{"text":"or","offset":98,"start":151.482,"end":151.582,"score":0.993},{"text":"tremors,","offset":101,"start":151.662,"end":152.122,"score":0.791},{"text":"and","offset":110,"start":153.062,"end":153.182,"score":0.997},{"text":"the","offset":114,"start":153.202,"end":153.282,"score":0.993},{"text":"gravitational","offset":118,"start":153.363,"end":154.122,"score":0.978},{"text":"pull","offset":132,"start":154.222,"end":154.482,"score":0.961},{"text":"of","offset":137,"start":154.662,"end":154.722,"score":0.999},{"text":"the","offset":140,"start":154.762,"end":154.842,"score":0.997},{"text":"moon","offset":144,"start":154.903,"end":155.182,"score":0.998},{"text":"and","offset":149,"start":155.363,"end":155.482,"score":0.959},{"text":"the","offset":153,"start":155.523,"end":155.602,"score":0.978},{"text":"sun.","offset":157,"start":155.662,"end":155.902,"score":0.999}],[{"text":"Once","offset":0,"start":157.262,"end":157.502,"score":0.975},{"text":"waves","offset":5,"start":157.562,"end":157.922,"score":0.978},{"text":"have","offset":11,"start":157.942,"end":158.082,"score":0.983},{"text":"been","offset":16,"start":158.102,"end":158.242,"score":0.995},{"text":"generated,","offset":21,"start":158.343,"end":158.842,"score":0.952},{"text":"gravity","offset":32,"start":159.363,"end":159.802,"score":0.957},{"text":"is","offset":40,"start":160.222,"end":160.322,"score":0.999},{"text":"the","offset":43,"start":160.363,"end":160.442,"score":0.997},{"text":"force","offset":47,"start":160.562,"end":160.902,"score":0.994},{"text":"that","offset":53,"start":160.922,"end":161.062,"score":0.95},{"text":"drives","offset":58,"start":161.142,"end":161.482,"score":0.993},{"text":"them","offset":65,"start":161.502,"end":161.622,"score":0.999},{"text":"in","offset":70,"start":161.963,"end":162.042,"score":0.876},{"text":"a","offset":73,"start":162.083,"end":162.102,"score":0.994},{"text":"continual","offset":75,"start":162.162,"end":162.802,"score":0.996},{"text":"attempt","offset":85,"start":162.903,"end":163.362,"score":0.985},{"text":"to","offset":93,"start":163.442,"end":163.522,"score":0.998},{"text":"restore","offset":96,"start":163.562,"end":163.922,"score":0.984},{"text":"the","offset":104,"start":163.942,"end":164.022,"score":0.998},{"text":"ocean","offset":108,"start":164.162,"end":164.462,"score":0.885},{"text":"surface","offset":114,"start":164.542,"end":165.002,"score":0.823},{"text":"to","offset":122,"start":165.282,"end":165.382,"score":0.998},{"text":"a","offset":125,"start":165.482,"end":165.502,"score":0.997},{"text":"flat","offset":127,"start":165.602,"end":165.922,"score":1.0},{"text":"plain.","offset":132,"start":166.023,"end":166.422,"score":0.949}]],"cues":[{"id":"b4-040-001","sourceId":"b4-040-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What false impression does an ocean wave convey to the observer?","start":10.98,"end":14.92,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-002","sourceId":"b4-040-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Waves are the children of the struggle between ocean and atmosphere, the ongoing signatures of infinity.","start":17.62,"end":25.44,"score":0.843,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-003","sourceId":"b4-040-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"Rays from the sun excite and energize the atmosphere of the earth, awakening it to flow, to movement, to rhythm, to life.","start":26.222,"end":35.76,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-004-p01","sourceId":"b4-040-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"The wind then speaks the message of the sun to the sea","start":36.6,"end":40.21,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-004-p02","sourceId":"b4-040-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[12,24],"wordModel":"mms-fa","text":"and the sea transmits it on through waves--an ancient, exquisite powerful message.","start":40.443,"end":47.26,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-005","sourceId":"b4-040-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"These ocean waves are among the earth's most complicated natural phenomena.","start":48.523,"end":53.33,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-006-p01","sourceId":"b4-040-006","sourceIndex":5,"part":1,"parts":4,"wordRange":[0,12],"wordModel":"mms-fa","text":"The basic features include a crest (the highest point of the wave),","start":54.343,"end":59.05,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-006-p02","sourceId":"b4-040-006","sourceIndex":5,"part":2,"parts":4,"wordRange":[12,28],"wordModel":"mms-fa","text":"a trough (the lowest point), a height (the vertical distance from the trough to the crest),","start":59.77,"end":66.83,"score":0.895,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-006-p03","sourceId":"b4-040-006","sourceIndex":5,"part":3,"parts":4,"wordRange":[28,38],"wordModel":"mms-fa","text":"a wave length (the horizontal distance between two wave crests),","start":67.9,"end":72.82,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-006-p04","sourceId":"b4-040-006","sourceIndex":5,"part":4,"parts":4,"wordRange":[38,54],"wordModel":"mms-fa","text":"and a period (which is the time it takes awave crest to travel one wave length).","start":73.5,"end":78.7,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-007-p01","sourceId":"b4-040-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"Although an ocean wave gives the impression of a wall of water moving in your direction,","start":79.97,"end":85.54,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-007-p02","sourceId":"b4-040-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[16,30],"wordModel":"mms-fa","text":"in actuality waves move through the water leaving the water about where it was.","start":86.02,"end":91.58,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-008-p01","sourceId":"b4-040-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"If the water was moving with the wave,","start":92.46,"end":94.62,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-008-p02","sourceId":"b4-040-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[8,25],"wordModel":"mms-fa","text":"the ocean and everything on it would be racing in to the shore with obviously catastrophic results.","start":94.9,"end":101.64,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-009-p01","sourceId":"b4-040-009","sourceIndex":8,"part":1,"parts":3,"wordRange":[0,20],"wordModel":"mms-fa","text":"An ocean wave passing through deep water causes a particle on the surface to move in a roughly circular orbit,","start":102.8,"end":110.67,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-009-p02","sourceId":"b4-040-009","sourceIndex":8,"part":2,"parts":3,"wordRange":[20,28],"wordModel":"mms-fa","text":"drawing the particle first towards the advancing wave,","start":111.35,"end":114.76,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-009-p03","sourceId":"b4-040-009","sourceIndex":8,"part":3,"parts":3,"wordRange":[28,50],"wordModel":"mms-fa","text":"then up into the wave, then forward with it and then--as the wave leaves the particles behind--back to its starting point again.","start":114.982,"end":123.91,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-010","sourceId":"b4-040-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"From both maturity to death, a wave is subject to the same laws as any other 'living' thing.","start":125.26,"end":132.2,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-011","sourceId":"b4-040-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"For a time it assumes a miraculous individuality that, in the end, is reabsorbed into the great ocean of life.","start":132.98,"end":141.49,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-012-p01","sourceId":"b4-040-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"The undulating waves of the open sea are generated by three natural causes:","start":142.642,"end":148.15,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-012-p02","sourceId":"b4-040-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[13,28],"wordModel":"mms-fa","text":"wind, earth movements or tremors, and the gravitational pull of the moon and the sun.","start":148.9,"end":156.09,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-013-p01","sourceId":"b4-040-013","sourceIndex":12,"part":1,"parts":2,"wordRange":[0,5],"wordModel":"mms-fa","text":"Once waves have been generated,","start":157.11,"end":159.07,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b4-040-013-p02","sourceId":"b4-040-013","sourceIndex":12,"part":2,"parts":2,"wordRange":[5,25],"wordModel":"mms-fa","text":"gravity is the force that drives them in a continual attempt to restore the ocean surface to a flat plain.","start":159.23,"end":166.58,"score":0.969,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
