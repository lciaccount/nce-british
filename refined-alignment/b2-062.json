2-062-005-p02","sourceId":"b2-062-005","sourceIndex":4,"part":2,"parts":2,"wordRange":[13,30],"wordModel":"mms-fa","text":"for heavy rain would not only wash away the soil but would cause serious floods as well.","start":51.16,"end":58.13,"score":0.959,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-006-p01","sourceId":"b2-062-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"When the fire had at last been put out,","start":59.78,"end":62.41,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-006-p02","sourceId":"b2-062-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[9,25],"wordModel":"english-ctc-fallback","text":"the forest authorities ordered several tons of a special type of grass-seed which would grow quickly.","start":63.24,"end":70.39,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-007","sourceId":"b2-062-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"The seed was sprayed over the ground in huge quantities by aeroplanes.","start":71.55,"end":77.95,"score":0.929,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-008","sourceId":"b2-062-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"The planes had been planting seed for nearly a month when it began to rain.","start":79.23,"end":84.81,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-009","sourceId":"b2-062-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"By then, however, in many places the grass had already taken root.","start":85.86,"end":91.17,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-010-p01","sourceId":"b2-062-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"In place of the great trees which had been growing there for centuries,","start":92.2,"end":96.24,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-062-010-p02","sourceId":"b2-062-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[13,24],"wordModel":"mms-fa","text":"patches of green had begun to appear in the blackened soil.","start":96.82,"end":100.86,"score":0.957,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
