":205.083,"end":205.242,"score":0.999},{"text":"a","offset":28,"start":205.343,"end":205.362,"score":0.999},{"text":"fussy","offset":30,"start":205.523,"end":205.802,"score":0.959},{"text":"creature,","offset":36,"start":205.922,"end":206.322,"score":0.976},{"text":"but","offset":46,"start":206.863,"end":207.002,"score":1.0},{"text":"since","offset":50,"start":207.102,"end":207.362,"score":0.983},{"text":"the","offset":56,"start":207.382,"end":207.482,"score":0.997},{"text":"porter","offset":60,"start":207.523,"end":207.822,"score":0.946},{"text":"agreed","offset":67,"start":207.863,"end":208.202,"score":1.0},{"text":"with","offset":74,"start":208.243,"end":208.402,"score":0.997},{"text":"him,","offset":79,"start":208.422,"end":208.562,"score":1.0},{"text":"she","offset":84,"start":209.062,"end":209.162,"score":0.998},{"text":"rang","offset":88,"start":209.322,"end":209.602,"score":0.993},{"text":"up","offset":93,"start":209.662,"end":209.762,"score":1.0},{"text":"her","offset":96,"start":209.822,"end":209.942,"score":0.937},{"text":"daughter","offset":100,"start":210.023,"end":210.342,"score":0.985},{"text":"and","offset":109,"start":210.782,"end":210.882,"score":1.0},{"text":"asked","offset":113,"start":211.023,"end":211.282,"score":0.97},{"text":"for","offset":119,"start":211.303,"end":211.402,"score":0.82},{"text":"her","offset":123,"start":211.463,"end":211.562,"score":0.997},{"text":"help","offset":127,"start":211.623,"end":211.862,"score":0.997},{"text":"in","offset":132,"start":212.262,"end":212.342,"score":0.896},{"text":"what","offset":135,"start":212.403,"end":212.562,"score":0.996},{"text":"she","offset":140,"start":212.662,"end":212.782,"score":0.994},{"text":"described","offset":144,"start":212.882,"end":213.442,"score":1.0},{"text":"as","offset":154,"start":213.743,"end":213.882,"score":0.999},{"text":"a","offset":157,"start":214.042,"end":214.062,"score":0.999},{"text":"little","offset":159,"start":214.202,"end":214.502,"score":0.997},{"text":"spot","offset":166,"start":214.623,"end":214.962,"score":0.999},{"text":"of","offset":171,"start":215.062,"end":215.142,"score":0.994},{"text":"bother.","offset":174,"start":215.222,"end":215.562,"score":0.963}]],"cues":[{"id":"b3-058-001","sourceId":"b3-058-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"What did the old lady find when she got home?","start":12.07,"end":15.43,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-002","sourceId":"b3-058-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The old lady was glad to be back at the block of flats where she lived.","start":18.01,"end":22.5,"score":0.85,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-003","sourceId":"b3-058-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"mms-fa","text":"Her shopping had tired her and her basket had grown heavier with every step of the way home.","start":23.56,"end":29.5,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-004-p01","sourceId":"b3-058-004","sourceIndex":3,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"mms-fa","text":"In the lift her thoughts were on lunch and a good rest;","start":30.61,"end":34.38,"score":0.939,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-004-p02","sourceId":"b3-058-004","sourceIndex":3,"part":2,"parts":2,"wordRange":[12,34],"wordModel":"mms-fa","text":"but when she got out at her own floor, both were forgotten in her sudden discovery that her front door was open.","start":34.96,"end":42.57,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-005-p01","sourceId":"b3-058-005","sourceIndex":4,"part":1,"parts":3,"wordRange":[0,20],"wordModel":"mms-fa","text":"She was thinking that she must reprimand her home help the next morning for such a monstrous piece of negligence,","start":43.42,"end":50.38,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-005-p02","sourceId":"b3-058-005","sourceIndex":4,"part":2,"parts":3,"wordRange":[20,34],"wordModel":"mms-fa","text":"when she remembered that she had gone shopping after the home help had left","start":50.67,"end":55.72,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-005-p03","sourceId":"b3-058-005","sourceIndex":4,"part":3,"parts":3,"wordRange":[34,46],"wordModel":"mms-fa","text":"and she knew that she had turned both keys in their locks.","start":56.023,"end":59.65,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-006-p01","sourceId":"b3-058-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,17],"wordModel":"mms-fa","text":"She walked slowly into the hall and at once noticed that all the room doors were open,","start":60.59,"end":66.11,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-006-p02","sourceId":"b3-058-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[17,29],"wordModel":"mms-fa","text":"yet following her regular practice she had shut them before going out.","start":66.94,"end":71.14,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-007","sourceId":"b3-058-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"Looking into the drawing room, she saw a scene of confusion over by her writing desk.","start":72.09,"end":77.92,"score":0.926,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-008","sourceId":"b3-058-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"It was as clear as daylight then that burglars had forced an entry during her absence.","start":78.74,"end":84.46,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-009-p01","sourceId":"b3-058-009","sourceIndex":8,"part":1,"parts":3,"wordRange":[0,14],"wordModel":"mms-fa","text":"Her first impulse was to go round all the rooms looking for the thieves,","start":85.13,"end":89.63,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-009-p02","sourceId":"b3-058-009","sourceIndex":8,"part":2,"parts":3,"wordRange":[14,32],"wordModel":"mms-fa","text":"but then she decided that at her age it might be more prudent to have someone with her,","start":89.91,"end":94.99,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-009-p03","sourceId":"b3-058-009","sourceIndex":8,"part":3,"parts":3,"wordRange":[32,42],"wordModel":"mms-fa","text":"so she went to fetch the porter from his basement.","start":95.57,"end":98.38,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-010-p01","sourceId":"b3-058-010","sourceIndex":9,"part":1,"parts":2,"wordRange":[0,9],"wordModel":"mms-fa","text":"By this time her legs were beginning to tremble,","start":99.05,"end":102.04,"score":0.847,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-010-p02","sourceId":"b3-058-010","sourceIndex":9,"part":2,"parts":2,"wordRange":[9,26],"wordModel":"mms-fa","text":"so she sat down and accepted a cup of very strong tea, while he telephoned the police.","start":102.73,"end":108.44,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-011-p01","sourceId":"b3-058-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"mms-fa","text":"Then, her composure regained, she was ready to set off with the porter's assistance to search for any intruders","start":109.5,"end":117.002,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-011-p02","sourceId":"b3-058-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[19,27],"wordModel":"mms-fa","text":"who might still be lurking in her flat.","start":117.08,"end":119.38,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-012-p01","sourceId":"b3-058-012","sourceIndex":11,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"They went through the rooms, being careful to touch nothing,","start":120.6,"end":123.85,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-012-p02","sourceId":"b3-058-012","sourceIndex":11,"part":2,"parts":2,"wordRange":[10,24],"wordModel":"mms-fa","text":"as they did not want to hinder the police in their search for fingerprints.","start":124.303,"end":128.27,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-013","sourceId":"b3-058-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"The chaos was inconceivable.","start":129.12,"end":131.54,"score":0.905,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-014","sourceId":"b3-058-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,33],"wordModel":"mms-fa","text":"She had lived in the flat for thirty years and was a veritable magpie at hoarding: and it seemed as though everything she possessed had been tossed out and turned over and over.","start":132.01,"end":143.48,"score":0.907,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-015","sourceId":"b3-058-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"At least sorting out the things she should have discarded years ago was now being made easier for her.","start":144.47,"end":150.44,"score":0.953,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-016","sourceId":"b3-058-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"Then a police inspector arrived with a constable and she told them of her discovery of the ransacked flat.","start":151.15,"end":157.86,"score":0.918,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b3-058-017-p01","sourceId":"b3-058-017","sourceIndex":16,"part":1,"parts":2,"wordRange":[0,20],"wordModel":"mms-fa","text":"The inspector began to look for fingerprints, while the constable checked that the front door locks had not been forced,","start":158.79,"end":166.07,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-017-p02","sourceId":"b3-058-017","sourceIndex":16,"part":2,"parts":2,"wordRange":[20,35],"wordModel":"mms-fa","text":"thereby proving that the burglars had either used skeleton keys or entered over the balcony.","start":166.48,"end":172.8,"score":0.936,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-018-p01","sourceId":"b3-058-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,6],"wordModel":"mms-fa","text":"There was no trace of fingerprints,","start":173.62,"end":175.43,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-018-p02","sourceId":"b3-058-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[6,25],"wordModel":"mms-fa","text":"but the inspector found a dirty red bundle that contained jewellery which the old lady said was not hers.","start":175.92,"end":183.56,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-019","sourceId":"b3-058-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"So their entry into this flat was apparently not the burglars' first job that day and they must have been disturbed.","start":184.33,"end":192.46,"score":0.974,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-020-p01","sourceId":"b3-058-020","sourceIndex":19,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"The inspector then asked the old lady to try to check what was missing by the next day,","start":193.02,"end":198.31,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-020-p02","sourceId":"b3-058-020","sourceIndex":19,"part":2,"parts":2,"wordRange":[18,32],"wordModel":"mms-fa","text":"and advised her not to stay alone in the flat for a few nights.","start":198.76,"end":202.55,"score":0.978,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-021-p01","sourceId":"b3-058-021","sourceIndex":20,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"The old lady thought he was a fussy creature, but since the porter agreed with him,","start":203.66,"end":208.66,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-058-021-p02","sourceId":"b3-058-021","sourceIndex":20,"part":2,"parts":2,"wordRange":[16,36],"wordModel":"mms-fa","text":"she rang up her daughter and asked for her help in what she described as a little spot of bother.","start":208.83,"end":215.65,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
