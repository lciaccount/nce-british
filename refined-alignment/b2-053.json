,"sourceId":"b2-053-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"What caused the fire?","start":12.81,"end":14.58,"score":0.885,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-002","sourceId":"b2-053-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"At last firemen have put out a big forest fire in California.","start":17.22,"end":22.71,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-003","sourceId":"b2-053-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"Since then, they have been trying to find out how the fire began.","start":23.89,"end":28.31,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-004","sourceId":"b2-053-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"Forest fires are often caused by broken glass or by cigarette ends which people carelessly throw away.","start":29.57,"end":37.43,"score":0.931,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-005","sourceId":"b2-053-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"Yesterday the firemen examined the ground carefully, but were not able to find any broken glass.","start":38.53,"end":45.84,"score":0.981,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-006","sourceId":"b2-053-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"They were also quite sure that a cigarette end did not start the fire.","start":47.04,"end":51.66,"score":0.961,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-007","sourceId":"b2-053-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"This morning, however, a firemen accidentally discovered the cause.","start":53.22,"end":58.38,"score":0.955,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-008","sourceId":"b2-053-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"He noticed the remains of a snake which was wound round the electric wires of a 16, 000-volt power line.","start":59.68,"end":68.06,"score":0.898,"timingValid":true,"needsReview":true,"reviewReasons":["low-word-confidence"]},{"id":"b2-053-009","sourceId":"b2-053-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"In this way, he was able to solve the mystery.","start":68.98,"end":72.56,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-010","sourceId":"b2-053-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"The explanation was simple but very unusual.","start":73.49,"end":77.65,"score":0.963,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-011","sourceId":"b2-053-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"A bird had snatched up the snake from the ground and then dropped it on to the wires.","start":79.05,"end":85.08,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-012","sourceId":"b2-053-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"The snake then wound itself round the wires.","start":86.17,"end":89.44,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-053-013","sourceId":"b2-053-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"When it did so, it sent sparks down to the ground and these immediately started a fire.","start":90.44,"end":98.19,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
