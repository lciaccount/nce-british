fset":5,"start":152.183,"end":152.442,"score":0.987},{"text":"he","offset":12,"start":152.562,"end":152.682,"score":0.978},{"text":"said","offset":15,"start":152.782,"end":153.002,"score":0.999},{"text":"with","offset":20,"start":153.343,"end":153.482,"score":0.997},{"text":"a","offset":25,"start":153.562,"end":153.582,"score":1.0},{"text":"smile","offset":27,"start":153.683,"end":154.102,"score":0.964},{"text":"as","offset":33,"start":154.482,"end":154.542,"score":1.0},{"text":"if","offset":36,"start":154.642,"end":154.682,"score":1.0},{"text":"he","offset":39,"start":154.743,"end":154.802,"score":1.0},{"text":"were","offset":42,"start":154.863,"end":155.002,"score":0.964},{"text":"talking","offset":47,"start":155.062,"end":155.382,"score":0.991},{"text":"about","offset":55,"start":155.463,"end":155.662,"score":1.0},{"text":"an","offset":61,"start":155.722,"end":155.762,"score":0.997},{"text":"old","offset":64,"start":155.843,"end":155.962,"score":0.996},{"text":"friend.","offset":68,"start":156.042,"end":156.302,"score":0.952}],[{"text":"'That's","offset":0,"start":157.202,"end":157.482,"score":0.943},{"text":"Sebastian.","offset":8,"start":157.583,"end":158.202,"score":0.879}],[{"text":"You","offset":0,"start":159.002,"end":159.102,"score":0.998},{"text":"forget","offset":4,"start":159.202,"end":159.542,"score":1.0},{"text":"that","offset":11,"start":159.923,"end":160.062,"score":0.992},{"text":"I","offset":16,"start":160.142,"end":160.162,"score":1.0},{"text":"was","offset":18,"start":160.243,"end":160.382,"score":0.959},{"text":"a","offset":22,"start":160.463,"end":160.482,"score":1.0},{"text":"medical","offset":24,"start":160.583,"end":160.922,"score":0.974},{"text":"student","offset":32,"start":161.023,"end":161.362,"score":0.991},{"text":"once","offset":40,"start":161.562,"end":161.702,"score":0.991},{"text":"upon","offset":45,"start":161.803,"end":161.962,"score":0.959},{"text":"a","offset":50,"start":162.023,"end":162.042,"score":0.999},{"text":"time.'","offset":52,"start":162.123,"end":162.362,"score":1.0}]],"cues":[{"id":"b3-024-001","sourceId":"b3-024-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"Who was Sebastian?","start":12.44,"end":13.81,"score":0.8,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-002-p01","sourceId":"b3-024-002","sourceIndex":1,"part":1,"parts":2,"wordRange":[0,16],"wordModel":"mms-fa","text":"We often read in novels how a seemingly respectable person or family has some terrible secret","start":16.36,"end":23.13,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-002-p02","sourceId":"b3-024-002","sourceIndex":1,"part":2,"parts":2,"wordRange":[16,24],"wordModel":"mms-fa","text":"which has been concealed from strangers for years.","start":23.3,"end":26.06,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-003","sourceId":"b3-024-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The English language possesses a vivid saying to describe this sort of situation.","start":27.24,"end":32.22,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-004","sourceId":"b3-024-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"The terrible secret is called 'a skeleton in the cupboard'.","start":33.63,"end":37.58,"score":0.863,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-005","sourceId":"b3-024-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,17],"wordModel":"mms-fa","text":"At some dramatic moment in the story, the terrible secret becomes known and a reputation is ruined.","start":38.66,"end":45.56,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-006-p01","sourceId":"b3-024-006","sourceIndex":5,"part":1,"parts":2,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"The reader's hair stands on end when he reads in the final pages of the novel that the heroine,","start":46.07,"end":51.42,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-006-p02","sourceId":"b3-024-006","sourceIndex":5,"part":2,"parts":2,"wordRange":[19,42],"wordModel":"english-ctc-fallback","text":"a dear old lady who had always been so kind to everybody, had, in her youth, poisoned every one of her five husbands.","start":51.71,"end":60.78,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-007","sourceId":"b3-024-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It is all very well for such things to occur in fiction.","start":62.28,"end":65.17,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-008-p01","sourceId":"b3-024-008","sourceIndex":7,"part":1,"parts":2,"wordRange":[0,18],"wordModel":"mms-fa","text":"To varying degrees, we all have secrets which we do not want even our closest friends to learn,","start":66.18,"end":72.2,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-008-p02","sourceId":"b3-024-008","sourceIndex":7,"part":2,"parts":2,"wordRange":[18,27],"wordModel":"mms-fa","text":"but few of us have skeletons in the cupboard.","start":73.1,"end":75.82,"score":0.883,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-009","sourceId":"b3-024-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,23],"wordModel":"english-ctc-fallback","text":"The only person I know who has a skeleton in the cupboard is George Carlton, and he is very proud of the fact.","start":76.77,"end":84.45,"score":0.977,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-010","sourceId":"b3-024-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"George studied medicine in his youth.","start":85.51,"end":87.74,"score":0.945,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-011","sourceId":"b3-024-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Instead of becoming a doctor, however, he became a successful writer of detective stories.","start":88.66,"end":94.3,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-012","sourceId":"b3-024-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"english-ctc-fallback","text":"I once spent an uncomfortable weekend which I shall never forget at his house.","start":95.29,"end":100.55,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-013","sourceId":"b3-024-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"George showed me to the guestroom which, he said, was rarely used.","start":101.69,"end":106.14,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-014","sourceId":"b3-024-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"He told me to unpack my things and then come down to dinner.","start":107.02,"end":110.81,"score":0.972,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-015-p01","sourceId":"b3-024-015","sourceIndex":14,"part":1,"parts":2,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"After I had stacked my shirts and underclothes in two empty drawers,","start":111.74,"end":115.82,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-015-p02","sourceId":"b3-024-015","sourceIndex":14,"part":2,"parts":2,"wordRange":[12,29],"wordModel":"english-ctc-fallback","text":"I decided to hang one of the two suits I had brought with me in the cupboard.","start":116.26,"end":120.75,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-016","sourceId":"b3-024-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"I opened the cupboard door and then stood in front of it petrified.","start":121.58,"end":125.82,"score":0.938,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-017","sourceId":"b3-024-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"A skeleton was dangling before my eyes.","start":126.5,"end":129.13,"score":0.942,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-018-p01","sourceId":"b3-024-018","sourceIndex":17,"part":1,"parts":2,"wordRange":[0,10],"wordModel":"mms-fa","text":"The sudden movement of the door made it sway slightly","start":130.33,"end":133.42,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-018-p02","sourceId":"b3-024-018","sourceIndex":17,"part":2,"parts":2,"wordRange":[10,25],"wordModel":"mms-fa","text":"and it gave me the impression that it was about to leap out at me.","start":133.82,"end":137.4,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-019","sourceId":"b3-024-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"Dropping my suit, I dashed downstairs to tell George.","start":138.23,"end":141.98,"score":0.949,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-020","sourceId":"b3-024-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"This was worse than 'a terrible secret'; this was a real skeleton!","start":142.92,"end":147.8,"score":0.968,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-021","sourceId":"b3-024-021","sourceIndex":20,"part":1,"parts":1,"wordRange":[0,4],"wordModel":"mms-fa","text":"But George was unsympathetic.","start":148.88,"end":150.83,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-022","sourceId":"b3-024-022","sourceIndex":21,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"english-ctc-fallback","text":"'Oh, that,' he said with a smile as if he were talking about an old friend.","start":151.72,"end":156.47,"score":0.983,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-024-023","sourceId":"b3-024-023","sourceIndex":22,"part":1,"parts":1,"wordRange":[0,2],"wordModel":"english-ctc-fallback","text":"'That's Sebastian.","start":157.04,"end":158.37,"score":0.911,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-024-024","sourceId":"b3-024-024","sourceIndex":23,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"english-ctc-fallback","text":"You forget that I was a medical student once upon a time.'","start":158.93,"end":162.48,"score":0.989,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
