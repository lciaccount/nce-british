t":29,"start":98.042,"end":98.163,"score":0.994},{"text":"he","offset":33,"start":98.263,"end":98.363,"score":0.975},{"text":"wanted","offset":36,"start":98.542,"end":98.903,"score":0.943},{"text":"me","offset":43,"start":98.983,"end":99.062,"score":0.997},{"text":"to","offset":46,"start":99.243,"end":99.323,"score":0.994},{"text":"sign","offset":49,"start":99.483,"end":99.823,"score":0.879},{"text":"for","offset":54,"start":99.882,"end":100.003,"score":0.9},{"text":"a","offset":58,"start":100.062,"end":100.083,"score":0.911},{"text":"registered","offset":60,"start":100.222,"end":100.823,"score":0.877},{"text":"letter!","offset":71,"start":100.903,"end":101.263,"score":0.934}]],"cues":[{"id":"b2-054-001","sourceId":"b2-054-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"What two interruptions did the writer have?","start":13.46,"end":17.52,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-002","sourceId":"b2-054-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"After breakfast, I sent the children to school and then I went to the shops.","start":20.28,"end":25.74,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-003","sourceId":"b2-054-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"It was still early when I returned home.","start":27.44,"end":30.07,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-004","sourceId":"b2-054-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"The children were at school, my husband was at work and the house was quiet.","start":31.64,"end":36.7,"score":0.993,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-005","sourceId":"b2-054-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"So I decided to make some meat pies.","start":38.28,"end":41.34,"score":0.944,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-006","sourceId":"b2-054-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"In a short time I was busy mixing butter and flour and my hands were soon covered with sticky pastry.","start":42.743,"end":51.16,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-007","sourceId":"b2-054-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"At exactly that moment, the telephone rang.","start":52.84,"end":56.3,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-008","sourceId":"b2-054-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"mms-fa","text":"Nothing could have been more annoying.","start":57.39,"end":59.51,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-009","sourceId":"b2-054-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,20],"wordModel":"mms-fa","text":"I picked up the receiver between two sticky fingers and was dismayed when I recognized the voice of Helen Bates.","start":60.93,"end":70.323,"score":0.975,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-010","sourceId":"b2-054-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"It took me ten minutes to persuade her to ring back later.","start":71.31,"end":74.89,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-011","sourceId":"b2-054-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"At last I hung up the receiver.","start":76.12,"end":78.36,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-012","sourceId":"b2-054-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,3],"wordModel":"mms-fa","text":"What a mess!","start":79.06,"end":80.83,"score":0.937,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-013","sourceId":"b2-054-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"There was pastry on my fingers, on the telephone, and on the doorknobs.","start":81.82,"end":87.13,"score":0.966,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-014","sourceId":"b2-054-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"I had no sooner got back to the kitchen than the doorbell rang loud enough to wake the dead.","start":88.15,"end":94.7,"score":0.943,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-054-015","sourceId":"b2-054-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"This time it was the postman and he wanted me to sign for a registered letter!","start":95.44,"end":101.35,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
