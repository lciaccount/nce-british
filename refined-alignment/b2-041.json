nutes","offset":4,"start":86.782,"end":87.103,"score":0.82},{"text":"later","offset":12,"start":87.183,"end":87.483,"score":0.957},{"text":"we","offset":18,"start":87.942,"end":88.003,"score":0.999},{"text":"walked","offset":21,"start":88.082,"end":88.363,"score":0.998},{"text":"out","offset":28,"start":88.442,"end":88.623,"score":0.999},{"text":"of","offset":32,"start":88.662,"end":88.723,"score":0.999},{"text":"the","offset":35,"start":88.763,"end":88.823,"score":0.996},{"text":"shop","offset":39,"start":88.903,"end":89.143,"score":0.986},{"text":"together.","offset":44,"start":89.222,"end":89.643,"score":0.989}],[{"text":"My","offset":0,"start":91.722,"end":91.903,"score":0.999},{"text":"wife","offset":3,"start":92.002,"end":92.323,"score":0.999},{"text":"was","offset":8,"start":92.343,"end":92.443,"score":0.998},{"text":"wearing","offset":12,"start":92.502,"end":92.803,"score":0.957},{"text":"a","offset":20,"start":92.843,"end":92.863,"score":0.997},{"text":"hat","offset":22,"start":92.963,"end":93.363,"score":0.902},{"text":"that","offset":26,"start":93.942,"end":94.063,"score":0.974},{"text":"looked","offset":31,"start":94.102,"end":94.283,"score":0.989},{"text":"like","offset":38,"start":94.302,"end":94.463,"score":0.989},{"text":"a","offset":43,"start":94.483,"end":94.503,"score":0.99},{"text":"lighthouse!","offset":45,"start":94.642,"end":95.483,"score":0.944}]],"cues":[{"id":"b2-041-001","sourceId":"b2-041-001","sourceIndex":0,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"What kind of shopping does the writer enjoy, do you think?","start":15.47,"end":20.07,"score":0.96,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-002","sourceId":"b2-041-002","sourceIndex":1,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'Do you call that a hat?'","start":22.82,"end":25.32,"score":0.998,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-003","sourceId":"b2-041-003","sourceIndex":2,"part":1,"parts":1,"wordRange":[0,5],"wordModel":"mms-fa","text":"I said to my wife.","start":26.28,"end":27.46,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-004","sourceId":"b2-041-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,18],"wordModel":"english-ctc-fallback","text":"'You needn't be so rude about it,' my wife answered as she looked at herself in the mirror.","start":28.9,"end":34.66,"score":0.979,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-005","sourceId":"b2-041-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"english-ctc-fallback","text":"I sat down on one of those modern chairs with holes in it and waited.","start":36.53,"end":41.69,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-006","sourceId":"b2-041-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"We had been in the hat shop for half an hour and my wife was still in front of the mirror.","start":43.12,"end":49.54,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-007","sourceId":"b2-041-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"'We mustn't buy things we don't need,' I remarked suddenly.","start":51.8,"end":56.12,"score":0.984,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-008","sourceId":"b2-041-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"I regretted saying it almost at once.","start":57.103,"end":59.86,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-009","sourceId":"b2-041-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"'You needn't have said that,' my wife answered.","start":61.56,"end":64.91,"score":0.983,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-010","sourceId":"b2-041-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"english-ctc-fallback","text":"'I needn't remind you of that terrible tie you bought yesterday.'","start":65.85,"end":71.34,"score":0.989,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-011","sourceId":"b2-041-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,6],"wordModel":"english-ctc-fallback","text":"'I find it beautiful,' I said.","start":73.22,"end":75.57,"score":0.998,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-012","sourceId":"b2-041-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"'A man can never have too many ties.'","start":76.57,"end":79.483,"score":0.899,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-013","sourceId":"b2-041-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"'And a woman can't have too many hats,' she answered.","start":80.482,"end":84.56,"score":0.986,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-041-014","sourceId":"b2-041-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"Ten minutes later we walked out of the shop together.","start":86.44,"end":89.76,"score":0.965,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-041-015","sourceId":"b2-041-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"My wife was wearing a hat that looked like a lighthouse!","start":91.66,"end":95.67,"score":0.976,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
