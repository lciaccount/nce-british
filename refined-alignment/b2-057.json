reviewReasons":[]},{"id":"b2-057-004","sourceId":"b2-057-004","sourceIndex":3,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"The assistant who served her did not like the way she was dressed.","start":32.72,"end":37.0,"score":0.985,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-005","sourceId":"b2-057-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"Glancing at her scornfully, he told her that the dress was sold.","start":38.14,"end":43.22,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-006","sourceId":"b2-057-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,16],"wordModel":"mms-fa","text":"The woman walked out of the shop angrily and decided to punish the assistant next day.","start":45.11,"end":51.51,"score":0.98,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-007-p01","sourceId":"b2-057-007","sourceIndex":6,"part":1,"parts":2,"wordRange":[0,13],"wordModel":"mms-fa","text":"She returned to the shop the following morning dressed in a fur coat,","start":53.27,"end":58.59,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-007-p02","sourceId":"b2-057-007","sourceIndex":6,"part":2,"parts":2,"wordRange":[13,26],"wordModel":"mms-fa","text":"with a handbag in one hand and a long umbrella in the other.","start":59.27,"end":62.94,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-008","sourceId":"b2-057-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,12],"wordModel":"mms-fa","text":"After seeking out the rude assistant, she asked for the same dress.","start":64.92,"end":70.23,"score":0.951,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-009","sourceId":"b2-057-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"Not realizing who she was, the assistant was eager to serve her this time.","start":71.482,"end":76.42,"score":0.971,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-010","sourceId":"b2-057-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"With great difficulty, he climbed into the shop window to get the dress.","start":77.47,"end":82.96,"score":0.874,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-011","sourceId":"b2-057-011","sourceIndex":10,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"As soon as she saw it, the woman said she did not like it.","start":84.74,"end":88.31,"score":0.979,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-057-012","sourceId":"b2-057-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,22],"wordModel":"mms-fa","text":"She enjoyed herself making the assistant bring almost everything in the window before finally buying the dress she had first asked for.","start":89.76,"end":98.89,"score":0.987,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
