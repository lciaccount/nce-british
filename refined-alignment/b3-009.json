:0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-005","sourceId":"b3-009-005","sourceIndex":4,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"mms-fa","text":"As a result, humans have learned to respect feline independence.","start":35.08,"end":39.26,"score":0.984,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-006","sourceId":"b3-009-006","sourceIndex":5,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"Most cats remain suspicious of humans all their lives.","start":40.47,"end":44.41,"score":0.983,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-007","sourceId":"b3-009-007","sourceIndex":6,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"mms-fa","text":"One of the things that fascinates us most about cats is the popular belief that they have nine lives.","start":45.563,"end":52.51,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-008","sourceId":"b3-009-008","sourceIndex":7,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"Apparently, there is a good deal of truth in this idea.","start":53.41,"end":56.54,"score":0.99,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-009","sourceId":"b3-009-009","sourceIndex":8,"part":1,"parts":1,"wordRange":[0,10],"wordModel":"english-ctc-fallback","text":"A cat's ability to survive falls is based on fact.","start":57.08,"end":60.79,"score":0.988,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-010","sourceId":"b3-009-010","sourceIndex":9,"part":1,"parts":1,"wordRange":[0,19],"wordModel":"english-ctc-fallback","text":"Recently the New York Animal Medical Centre made a study of 132 cats over a period of five months.","start":62.22,"end":70.53,"score":0.982,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-011-p01","sourceId":"b3-009-011","sourceIndex":10,"part":1,"parts":2,"wordRange":[0,8],"wordModel":"mms-fa","text":"All these cats had one experience in common:","start":71.87,"end":74.7,"score":0.992,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-011-p02","sourceId":"b3-009-011","sourceIndex":10,"part":2,"parts":2,"wordRange":[8,24],"wordModel":"mms-fa","text":"they had fallen off high buildings, yet only eight of them died from shock or injuries.","start":75.46,"end":81.14,"score":0.964,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-012","sourceId":"b3-009-012","sourceIndex":11,"part":1,"parts":1,"wordRange":[0,21],"wordModel":"mms-fa","text":"Of course, New York is the ideal place for such an interesting study, because there is no shortage of tall buildings.","start":82.04,"end":89.58,"score":0.958,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-013","sourceId":"b3-009-013","sourceIndex":12,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"There are plenty of high-rise windowsills to fall from!","start":90.79,"end":93.73,"score":0.97,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-014","sourceId":"b3-009-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,13],"wordModel":"mms-fa","text":"One cat, Sabrina, fell 32 storeys, yet only suffered from a broken tooth.","start":94.83,"end":102.33,"score":0.862,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-015","sourceId":"b3-009-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"english-ctc-fallback","text":"'Cats behave like well-trained paratroopers,' a doctor said.","start":103.42,"end":107.15,"score":0.983,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b3-009-016","sourceId":"b3-009-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"It seems that the further cats fall, the less they are likely to injure themselves.","start":108.09,"end":113.48,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-017","sourceId":"b3-009-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,14],"wordModel":"mms-fa","text":"In a long drop, they reach speeds of 60 miles an hour and more.","start":114.36,"end":119.16,"score":0.93,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-018","sourceId":"b3-009-018","sourceIndex":17,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"mms-fa","text":"At high speeds, falling cats have time to relax.","start":119.97,"end":123.83,"score":0.986,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-019","sourceId":"b3-009-019","sourceIndex":18,"part":1,"parts":1,"wordRange":[0,8],"wordModel":"mms-fa","text":"They stretch out their legs like flying squirrels.","start":124.49,"end":127.24,"score":0.956,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b3-009-020","sourceId":"b3-009-020","sourceIndex":19,"part":1,"parts":1,"wordRange":[0,15],"wordModel":"mms-fa","text":"This increases their air-resistance and reduces the shock of impact when they hit the ground.","start":128.13,"end":134.1,"score":0.994,"timingValid":true,"needsReview":false,"reviewReasons":[]}]}
