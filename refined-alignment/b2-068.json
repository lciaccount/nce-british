urceId":"b2-068-014","sourceIndex":13,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"mms-fa","text":"he asked, before I had finished speaking.","start":87.0,"end":90.28,"score":0.989,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-068-015","sourceId":"b2-068-015","sourceIndex":14,"part":1,"parts":1,"wordRange":[0,11],"wordModel":"mms-fa","text":"'Not at all,' I lied, 'but I'm going to the dentist.'","start":91.51,"end":96.63,"score":0.948,"timingValid":true,"needsReview":false,"reviewReasons":[]},{"id":"b2-068-016","sourceId":"b2-068-016","sourceIndex":15,"part":1,"parts":1,"wordRange":[0,7],"wordModel":"english-ctc-fallback","text":"'Then I'll come with you,' he answered.","start":97.64,"end":100.55,"score":0.956,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]},{"id":"b2-068-017","sourceId":"b2-068-017","sourceIndex":16,"part":1,"parts":1,"wordRange":[0,9],"wordModel":"english-ctc-fallback","text":"'There's always plenty to read in the waiting room!'","start":101.18,"end":105.12,"score":0.973,"timingValid":true,"needsReview":true,"reviewReasons":["boundary-disagreement"]}]}
