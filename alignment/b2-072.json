{
  "audioSha256": "079e3dd4ad8b23b8d0d441a3c11ed56dd0331fd42a4ace73bd4e6d34343a48d4",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b2-072-001",
      "text": "What mistake was made?",
      "start": 14.132,
      "end": 15.982,
      "score": 0.993,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-002",
      "text": "The great racing driver, Sir Malcolm Campbell, was the first man to drive at over 300 miles per hour.",
      "start": 18.793,
      "end": 27.483,
      "score": 0.985,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-003",
      "text": "He set up a new world record in September 1935 at Bonneville Salt Flats, Utah.",
      "start": 29.093,
      "end": 37.743,
      "score": 0.735,
      "timingValid": true,
      "needsReview": true
    },
    {
      "id": "b2-072-004",
      "text": "Bluebird, the car he was driving, had been specially built for him.",
      "start": 39.513,
      "end": 45.063,
      "score": 0.987,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-005",
      "text": "It was over 30 feet in length and had a 2, 500-horsepower engine.",
      "start": 46.413,
      "end": 52.623,
      "score": 0.978,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-006",
      "text": "Although Campbell reached a speed of over 304 miles per hour, he had great difficulty in controlling the car because a tyre burst during the first run.",
      "start": 54.453,
      "end": 67.503,
      "score": 0.956,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-007",
      "text": "After his attempt, Campbell was disappointed to learn that his average speed had been 299 miles per hour.",
      "start": 69.513,
      "end": 78.563,
      "score": 0.967,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-008",
      "text": "However, a few days later, he was told that a mistake had been made.",
      "start": 80.032,
      "end": 85.123,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-009",
      "text": "His average speed had been 301 miles per hour.",
      "start": 85.933,
      "end": 90.183,
      "score": 0.984,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-010",
      "text": "Since that time, racing drivers have reached speeds over 600 miles an hour.",
      "start": 91.972,
      "end": 98.603,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-011",
      "text": "Following in his father's footsteps many years later, Sir Malcolm's son, Donald, also set up a world record.",
      "start": 99.953,
      "end": 108.783,
      "score": 0.979,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-072-012",
      "text": "Like his father, he was driving a car called Bluebird.",
      "start": 110.032,
      "end": 114.023,
      "score": 0.981,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
