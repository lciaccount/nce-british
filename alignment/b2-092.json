{
  "audioSha256": "fb6f01cf5ce810ced402ada454937abc494164000b29095ba2286a637836e4f8",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b2-092-001",
      "text": "Why did the policeman ask the writer to come to the police station?",
      "start": 12.852,
      "end": 18.282,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-002",
      "text": "It must have been about two in the morning when I returned home.",
      "start": 21.213,
      "end": 25.002,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-003",
      "text": "I tried to wake up my wife by ringing the doorbell, but she was fast asleep, so I got a ladder from the shed in the garden, put it against the wall, and began climbing towards the bedroom window.",
      "start": 26.413,
      "end": 41.783,
      "score": 0.979,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-004",
      "text": "I was almost there when a sarcastic voice below said.",
      "start": 43.873,
      "end": 48.383,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-005",
      "text": "'I don't think the windows need cleaning at this time of the night.'",
      "start": 50.053,
      "end": 54.403,
      "score": 0.937,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-006",
      "text": "I looked down and nearly fell off the ladder when I saw a policeman.",
      "start": 56.672,
      "end": 60.943,
      "score": 0.979,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-007",
      "text": "I immediately regretted answering in the way I did, but I said, 'I enjoy cleaning windows at night.'",
      "start": 62.172,
      "end": 71.008,
      "score": 0.964,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-008",
      "text": "'So do I,' answered the policeman in the same tone.",
      "start": 71.008,
      "end": 76.903,
      "score": 0.935,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-009",
      "text": "Excuse my interrupting you.",
      "start": 77.953,
      "end": 80.123,
      "score": 0.981,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-010",
      "text": "I hate to interrupt a man when he's busy working, but would you mind coming with me to the station?'",
      "start": 81.272,
      "end": 89.167,
      "score": 0.97,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-011",
      "text": "'Well, I'd prefer to stay here,' I said.",
      "start": 89.167,
      "end": 95.207,
      "score": 0.902,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-012",
      "text": "'You see, I've forgotten my key.'",
      "start": 95.207,
      "end": 98.142,
      "score": 0.912,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-013",
      "text": "'Your what?'",
      "start": 100.052,
      "end": 101.343,
      "score": 0.612,
      "timingValid": true,
      "needsReview": true
    },
    {
      "id": "b2-092-014",
      "text": "he called.",
      "start": 102.272,
      "end": 102.998,
      "score": 0.993,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-015",
      "text": "'My key,' I shouted.",
      "start": 102.998,
      "end": 107.763,
      "score": 0.809,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-092-016",
      "text": "Fortunately, the shouting woke up my wife who opened the window just as the policeman had started to climb towards me.",
      "start": 109.112,
      "end": 117.583,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
