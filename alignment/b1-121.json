  "cues": [
    {
      "id": "b1-121-001",
      "text": "Why didn't Caroline recognize the customer straight away?",
      "start": 13.812,
      "end": 17.642,
      "score": 0.946,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-002",
      "text": "I bought two expensive dictionaries here half an hour ago, but I forgot to take them with me.",
      "start": 20.593,
      "end": 27.502,
      "score": 0.987,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-003",
      "text": "Who served you, sir?",
      "start": 29.492,
      "end": 30.922,
      "score": 0.991,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-004",
      "text": "The lady who is standing behind the counter.",
      "start": 32.032,
      "end": 34.763,
      "score": 0.986,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-005",
      "text": "Which books did you buy?",
      "start": 36.573,
      "end": 38.083,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-006",
      "text": "The books which are on the counter.",
