      "end": 51.343,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-009",
      "text": "I can't remember.",
      "start": 52.693,
      "end": 53.963,
      "score": 0.966,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-121-010",
      "text": "The man who I served was wearing a hat.",
