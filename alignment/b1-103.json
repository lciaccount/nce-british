{
  "audioSha256": "8cadec56041b5f5b187542c091a10b231259db7a584c03af92891e8febc54151",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b1-103-001",
      "text": "How long did the exam last?",
      "start": 12.712,
      "end": 14.962,
      "score": 0.984,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-002",
      "text": "How was the exam, Richard?",
      "start": 17.693,
      "end": 19.062,
      "score": 0.99,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-003",
      "text": "Not too bad.",
      "start": 20.213,
      "end": 21.023,
      "score": 0.987,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-004",
      "text": "I think I passed in English and Mathematics.",
      "start": 21.713,
      "end": 24.343,
      "score": 0.973,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-005",
      "text": "The questions were very easy.",
      "start": 25.073,
      "end": 27.442,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-006",
      "text": "How about you, Gary?",
      "start": 28.212,
      "end": 29.242,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-007",
      "text": "The English and Maths papers weren't easy enough for me.",
      "start": 30.852,
      "end": 33.923,
      "score": 0.938,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-008",
      "text": "I hope I haven't failed.",
      "start": 35.032,
      "end": 36.323,
      "score": 0.99,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-009",
      "text": "I think I failed the French paper.",
      "start": 38.172,
      "end": 40.063,
      "score": 0.858,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-010",
      "text": "I could answer sixteen of the questions.",
      "start": 40.973,
      "end": 43.043,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-011",
      "text": "They were very easy.",
      "start": 43.532,
      "end": 44.703,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-012",
      "text": "But I couldn't answer the rest.",
      "start": 45.433,
      "end": 47.143,
      "score": 0.975,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-013",
      "text": "They were too difficult for me.",
      "start": 47.833,
      "end": 49.363,
      "score": 0.974,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-014",
      "text": "French tests are awful, aren't they?",
      "start": 50.752,
      "end": 52.563,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-015",
      "text": "I hate them.",
      "start": 53.752,
      "end": 54.423,
      "score": 0.988,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-016",
      "text": "I'm sure I've got a low mark.",
      "start": 55.153,
      "end": 56.683,
      "score": 0.946,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-017",
      "text": "Oh, cheer up!",
      "start": 58.013,
      "end": 58.923,
      "score": 0.989,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-018",
      "text": "Perhaps we didn't do too badly.",
      "start": 59.612,
      "end": 61.263,
      "score": 0.973,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-019",
      "text": "The guy next to me wrote his name at the top of the paper.",
      "start": 62.032,
      "end": 65.023,
      "score": 0.973,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-020",
      "text": "Yes?",
      "start": 66.013,
      "end": 66.403,
      "score": 0.931,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-021",
      "text": "Then he sat there and looked at it for three hours!",
      "start": 67.272,
      "end": 70.623,
      "score": 0.991,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-103-022",
      "text": "He didn't write a word!",
      "start": 71.213,
      "end": 72.363,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
