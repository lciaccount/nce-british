      "end": 65.263,
      "score": 0.997,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-061-018",
      "text": "Why?",
      "start": 65.892,
      "end": 66.283,
      "score": 0.993,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-061-019",
      "text": "Because he doesn't like school!",
