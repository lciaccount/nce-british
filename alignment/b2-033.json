{
  "audioSha256": "9ff0896ac931c19841daec5ac527c97f67fb49695a39b0bc33f0bdc170c8a9e3",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b2-033-001",
      "text": "Why was the girl in hospital?",
      "start": 14.792,
      "end": 16.962,
      "score": 0.975,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-002",
      "text": "Nearly a week passed before the girl was able to explain what had happened to her.",
      "start": 19.893,
      "end": 26.343,
      "score": 0.973,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-003",
      "text": "One afternoon she set out from the coast in a small boat and was caught in a storm.",
      "start": 28.093,
      "end": 35.043,
      "score": 0.979,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-004",
      "text": "Towards evening, the boat struck a rock and the girl jumped into the sea.",
      "start": 36.873,
      "end": 43.083,
      "score": 0.971,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-005",
      "text": "Then she swam to the shore after spending the whole night in the water.",
      "start": 44.733,
      "end": 50.183,
      "score": 0.971,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-006",
      "text": "During that time she covered a distance of eight miles.",
      "start": 51.773,
      "end": 56.223,
      "score": 0.971,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-007",
      "text": "Early next morning, she saw a light ahead.",
      "start": 58.032,
      "end": 61.163,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-008",
      "text": "She knew she was near the shore because the light was high up on the cliffs.",
      "start": 62.712,
      "end": 67.883,
      "score": 0.981,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-009",
      "text": "On arriving at the shore, the girl struggled up the cliff towards the light she had seen.",
      "start": 70.013,
      "end": 77.023,
      "score": 0.972,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-010",
      "text": "That was all she remembered.",
      "start": 78.873,
      "end": 80.283,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-033-011",
      "text": "When she woke up a day later, she found herself in hospital.",
      "start": 82.153,
      "end": 86.783,
      "score": 0.993,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
