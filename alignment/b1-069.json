  "cues": [
    {
      "id": "b1-069-001",
      "text": "Which car was the winner in 1995?",
      "start": 12.852,
      "end": 16.183,
      "score": 0.606,
      "timingValid": true,
      "needsReview": true
    },
    {
      "id": "b1-069-002",
      "text": "There is a car race near our town every year.",
      "start": 18.933,
      "end": 22.397,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-069-003",
      "text": "In 1995, there was a very big race.",
      "start": 22.397,
      "end": 27.922,
      "score": 0.634,
      "timingValid": true,
      "needsReview": true
    },
    {
      "id": "b1-069-004",
      "text": "There were hundreds of people there.",
      "start": 29.253,
      "end": 31.203,
      "score": 0.958,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-069-005",
      "text": "My wife and I were at the race.",
      "start": 32.433,
      "end": 34.703,
      "score": 0.986,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-069-006",
      "text": "Our friends Julie and Jack were there, too.",
