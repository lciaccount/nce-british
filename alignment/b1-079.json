{
  "audioSha256": "237e42090a9275036dc8c4a9207022d91460589e8d49d94f90c55b79bb36b226",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b1-079-001",
      "text": "What is Carol not going to buy?",
      "start": 14.152,
      "end": 17.082,
      "score": 0.969,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-002",
      "text": "What are you doing, Carol?",
      "start": 19.893,
      "end": 21.302,
      "score": 0.971,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-003",
      "text": "I'm making a shopping list, Tom.",
      "start": 22.233,
      "end": 24.163,
      "score": 0.966,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-004",
      "text": "What do we need?",
      "start": 25.473,
      "end": 26.482,
      "score": 0.961,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-005",
      "text": "We need a lot of things this week.",
      "start": 27.172,
      "end": 29.542,
      "score": 0.986,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-006",
      "text": "I must go to the grocer's.",
      "start": 31.693,
      "end": 33.363,
      "score": 0.93,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-007",
      "text": "We haven't got much tea or coffee, and we haven't got any sugar or jam.",
      "start": 34.553,
      "end": 40.223,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-008",
      "text": "What about vegetables?",
      "start": 41.593,
      "end": 42.963,
      "score": 0.97,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-009",
      "text": "I must go to the greengroce's.",
      "start": 44.672,
      "end": 46.763,
      "score": 0.948,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-010",
      "text": "We haven't got many tomatoes, but we've got a lot of potatoes.",
      "start": 47.573,
      "end": 52.603,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-011",
      "text": "I must go to the butcher's, too.",
      "start": 54.212,
      "end": 56.463,
      "score": 0.961,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-012",
      "text": "We need some meat.",
      "start": 57.153,
      "end": 58.283,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-013",
      "text": "We haven't got any meat at all.",
      "start": 59.053,
      "end": 60.943,
      "score": 0.963,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-014",
      "text": "Have we got any beer and wine?",
      "start": 61.973,
      "end": 64.183,
      "score": 0.99,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-015",
      "text": "No, we haven't.",
      "start": 64.573,
      "end": 65.543,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-016",
      "text": "And I'm not going to get any!",
      "start": 65.713,
      "end": 67.363,
      "score": 0.975,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-017",
      "text": "I hope that you've got some money.",
      "start": 68.933,
      "end": 70.803,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-018",
      "text": "I haven't got much.",
      "start": 71.713,
      "end": 73.063,
      "score": 0.964,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-079-019",
      "text": "Well, I haven't got much either!",
      "start": 73.772,
      "end": 76.023,
      "score": 0.981,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
