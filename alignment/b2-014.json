{
  "audioSha256": "7dd6db1a7e5ee6c6b86679916c1e636c906cdde1701df48a36a69354c38e8b73",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b2-014-001",
      "text": "Did the young man speak English?",
      "start": 13.752,
      "end": 16.602,
      "score": 0.978,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-002",
      "text": "I had an amusing experience last year.",
      "start": 19.533,
      "end": 22.302,
      "score": 0.986,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-003",
      "text": "After I had left a small village in the south of France, I drove on to the next town.",
      "start": 23.933,
      "end": 31.362,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-004",
      "text": "On the way, a young man waved to me.",
      "start": 33.032,
      "end": 36.123,
      "score": 0.992,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-005",
      "text": "I stopped and he asked me for a lift.",
      "start": 37.293,
      "end": 39.923,
      "score": 0.991,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-006",
      "text": "As soon as he had got into the car, I said good morning to him in French and he replied in the same language.",
      "start": 41.453,
      "end": 49.863,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-007",
      "text": "Apart from a few words, I do not know any French at all.",
      "start": 51.852,
      "end": 56.223,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-008",
      "text": "Neither of us spoke during the journey.",
      "start": 57.492,
      "end": 59.763,
      "score": 0.987,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-009",
      "text": "I had nearly reached the town, when the young man suddenly said, very slowly, 'Do you speak English?'",
      "start": 61.373,
      "end": 73.303,
      "score": 0.945,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-014-010",
      "text": "As I soon learnt, he was English himself!",
      "start": 75.453,
      "end": 78.823,
      "score": 0.986,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
