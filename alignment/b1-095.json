      "text": "What!",
      "start": 68.873,
      "end": 69.243,
      "score": 0.969,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-019",
      "text": "It's only eight fifteen.",
      "start": 69.812,
      "end": 71.463,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
