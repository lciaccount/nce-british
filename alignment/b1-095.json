      "end": 20.582,
      "score": 0.974,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-003",
      "text": "What time will the next train leave?",
      "start": 21.573,
      "end": 23.543,
      "score": 0.975,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-004",
      "text": "At nineteen minutes past eight.",
      "start": 24.992,
      "end": 27.322,
      "score": 0.982,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-005",
      "text": "Which platform?",
      "start": 28.532,
      "end": 29.462,
      "score": 0.998,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-006",
      "text": "Platform Two.",
