  "cues": [
    {
      "id": "b1-095-001",
      "text": "Why did George and Ken miss the train?",
      "start": 12.312,
      "end": 15.462,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-002",
