      "text": "Over the bridge.",
      "start": 32.273,
      "end": 33.263,
      "score": 0.974,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-008",
      "text": "What time will the next train leave?",
      "start": 35.293,
      "end": 37.043,
      "score": 0.966,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-009",
      "text": "At eight nineteen.",
      "start": 38.293,
      "end": 39.383,
      "score": 0.985,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-010",
      "text": "We've got plenty of time.",
      "start": 40.513,
      "end": 42.143,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-011",
      "text": "It's only three minutes to eight.",
      "start": 43.572,
      "end": 45.663,
      "score": 0.951,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-012",
      "text": "Let's go and have a drink.",
      "start": 47.032,
      "end": 48.483,
      "score": 0.954,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-013",
      "text": "There's a bar next door to the station.",
