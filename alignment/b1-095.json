      "end": 51.623,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-014",
      "text": "We had better go back to the station now, Ken.",
      "start": 53.933,
      "end": 56.763,
      "score": 0.989,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-015",
      "text": "Tickets, please.",
      "start": 58.972,
      "end": 60.103,
      "score": 0.931,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-016",
      "text": "We want to catch the eight nineteen to London.",
      "start": 61.892,
      "end": 64.883,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b1-095-017",
      "text": "You've just missed it!",
      "start": 66.233,
      "end": 67.783,
      "score": 0.979,
      "timingValid": true,
      "needsReview": false
    },
    {
