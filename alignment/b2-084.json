{
  "audioSha256": "7787dee6aef5477606ad4be5b8b589a66f1e8f9252e15bdc94f9d2e66bc312dd",
  "method": "wav2vec2-base-960h-ctc-v1",
  "cues": [
    {
      "id": "b2-084-001",
      "text": "Who will be driving the buses next week?",
      "start": 12.632,
      "end": 15.223,
      "score": 0.987,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-002",
      "text": "Busmen have decided to go on strike next week.",
      "start": 18.233,
      "end": 21.282,
      "score": 0.965,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-003",
      "text": "The strike is due to begin on Tuesday.",
      "start": 22.473,
      "end": 24.703,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-004",
      "text": "No one knows how long it will last.",
      "start": 25.693,
      "end": 27.602,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-005",
      "text": "The busmen have stated that the strike will continue until general agreement is reached about pay and working conditions.",
      "start": 28.852,
      "end": 36.083,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-006",
      "text": "Most people believe that the strike will last for at least a week.",
      "start": 37.873,
      "end": 41.583,
      "score": 0.984,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-007",
      "text": "Many owners of private cars are going to offer 'free rides' to people on their way to work.",
      "start": 43.273,
      "end": 49.163,
      "score": 0.95,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-008",
      "text": "This will relieve pressure on the trains to some extent.",
      "start": 50.392,
      "end": 54.103,
      "score": 0.976,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-009",
      "text": "Meanwhile, a number of university students have volunteered to drive buses while the strike lasts.",
      "start": 54.953,
      "end": 61.823,
      "score": 0.98,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-010",
      "text": "All the students are expert drivers, but before they drive any of the buses, they will have to pass a special test.",
      "start": 63.053,
      "end": 71.583,
      "score": 0.971,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-011",
      "text": "The students are going to take the test in two days' time.",
      "start": 72.513,
      "end": 75.623,
      "score": 0.962,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-012",
      "text": "Even so, people are going to find it difficult to get to work.",
      "start": 77.213,
      "end": 80.843,
      "score": 0.983,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-013",
      "text": "But so far, the public has expressed its gratitude to the students in lettters to the Press.",
      "start": 81.832,
      "end": 88.043,
      "score": 0.959,
      "timingValid": true,
      "needsReview": false
    },
    {
      "id": "b2-084-014",
      "text": "Only one or two people have objected that the students will drive too fast!",
      "start": 89.013,
      "end": 93.223,
      "score": 0.977,
      "timingValid": true,
      "needsReview": false
    }
  ]
}
